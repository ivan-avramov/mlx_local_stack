+    ladder = next(d.glob("capacity_ladder.*.jsonl"))
+    if damage == "tamper":
+        ladder.write_text(ladder.read_text() + "\n")
+    elif damage == "verdict":
+        receipt = d / f"{leg.name}.receipt.json"
+        receipt.write_text(json.dumps(dict(json.loads(receipt.read_text()), verdict="SPEED_INVALID", speed_valid=False)))
+        manifest = json.loads((d / "SCRUB_MANIFEST.json").read_text())             # keep the manifest honest: only the verdict
+        manifest["files"][f"benchmark/results/p475/{leg.name}/{receipt.name}"]["published_sha256"] = K._sha(receipt.read_bytes())
+        (d / "SCRUB_MANIFEST.json").write_text(json.dumps(manifest))
+    elif damage == "short":
+        rows = good_rows()[:2]
+        ladder.write_text("".join(json.dumps(r) + "\n" for r in rows))
+        manifest = json.loads((d / "SCRUB_MANIFEST.json").read_text())
+        manifest["files"][f"benchmark/results/p475/{leg.name}/{ladder.name}"]["published_sha256"] = K._sha(ladder.read_bytes())
+        (d / "SCRUB_MANIFEST.json").write_text(json.dumps(manifest))
+    elif damage == "no manifest":
+        (d / "SCRUB_MANIFEST.json").unlink()
+    else:
+        (d / "capacity_ladder.p475.other.jsonl").write_text("{}\n")
+        manifest = json.loads((d / "SCRUB_MANIFEST.json").read_text())
+        manifest["files"]["benchmark/results/p475/%s/capacity_ladder.p475.other.jsonl" % leg.name] = dict(
+            published_sha256=K._sha(b"{}\n"))
+        (d / "SCRUB_MANIFEST.json").write_text(json.dumps(manifest))
