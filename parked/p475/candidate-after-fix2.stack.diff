+# ----------------------------------------------------------------------------------------------- registry fixtures
+def entry(name, **kv):
+    e = dict(name=name, hf_path=f"org/{name}", type="vision", context_length=262144, max_kv_cache_size=262144,
+             kv_prealloc_tokens=262144, kv_bits=0, kv_quant_scheme="turboquant", quantized_kv_start=0,
+             attention_policy="fused_v1")
+    e.update(kv)
+    return e
+
+
+def registry_text(arm=None, base=False, extra=None):
+    """The base registry, or the arm's: only the first pick's KV keys differ (+ the PROVISIONAL comment)."""
+    kv = {} if arm is None else dict(K.ARM_KV[arm])
+    models = [entry(FABLE, **kv), entry(UNIFORM, kv_bits=4), entry("Other-model")]
+    doc = {"mlx_port": 8001, "models": models}
+    if extra:
+        doc.update(extra)
+    text = yaml.safe_dump(doc, sort_keys=False)
+    return text + ("# PROVISIONAL P475 arm\n" if arm else "")
+
+
+SUBS = {"src/mlx-vlm": "a" * 40, "src/mlx-serve": "b" * 40}
+
+
+def good_inputs(arm="TQ8", pick="fable", head="h1", worktree="/wt"):
+    """What `git_arm_state` reads for a clean arm one commit on the base `b0` (the arm equal to base: head == base)."""
+    base_arm = head == "b0"
+    return K.ArmInputs(worktree=worktree, branch="main" if base_arm else f"p475-{pick}-{arm}", head=head, base="b0",
+                       parent="x" if base_arm else "b0", clean=True, changed_files=[] if base_arm else ["main_models.yaml"],
+                       ahead=0 if base_arm else 1, submodules=dict(SUBS), base_submodules=dict(SUBS),
+                       checked_out=dict(SUBS), registry_text=registry_text(arm))
+
+
+# ----------------------------------------------------------------------------------------------- schedule
+def test_schedule_is_twenty_abba_legs_picks_sequential():
+    legs = K.schedule()
+    assert len(legs) == 20
+    names = [leg.name for leg in legs]
+    assert names[:5] == [f"fable-{a}-b1" for a in ("N16", "AF8", "TQ8", "AF4", "TQ4")]
+    assert names[5:10] == [f"fable-{a}-b2" for a in ("TQ4", "AF4", "TQ8", "AF8", "N16")]
+    assert names[10:15] == [f"uniform4-{a}-b1" for a in ("N16", "AF8", "TQ8", "AF4", "TQ4")]
+    assert names[15:] == [f"uniform4-{a}-b2" for a in ("TQ4", "AF4", "TQ8", "AF8", "N16")]
