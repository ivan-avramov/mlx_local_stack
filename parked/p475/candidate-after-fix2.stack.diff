+# ----------------------------------------------------------------------------------------------- sequencer
+class Seq:
+    def __init__(self, verdicts=None, metrics_by_leg=None, speed_invalid=(), invalid=(), harvest_fail=False):
+        self.now, self.ran, self.sleeps, self.harvested, self.logs = 1000.0, [], [], [], []
+        self.speed_invalid, self.invalid, self.harvest_fail = set(speed_invalid), set(invalid), harvest_fail
+        self.metrics_by_leg = metrics_by_leg or {}
+        self.verdicts = {}
+
+    def clock(self): return self.now
+
+    def sleep(self, s):
+        self.sleeps.append(s)
+        self.now += s
+
+    def do_leg(self, leg):
+        self.sleeps.append(("start", leg.name, self.now - self.last_end))
+        self.ran.append(leg.name)
+        self.now += 100
+        self.last_end = self.now
+        v = "SPEED_INVALID" if leg.name in self.speed_invalid else "INVALID" if leg.name in self.invalid else "VALID"
+        self.verdicts[leg.name] = v
+        return {"verdict": v}
+
+    last_end = 1000.0
+
+    def harvest(self, leg, receipt):
+        if self.harvest_fail:
+            raise RuntimeError("scrub refused")
+        self.harvested.append(leg.name)
+
+    def metrics_for(self, leg):
+        return self.metrics_by_leg.get((leg.pick, leg.arm, leg.block), metrics())
+
+    def run(self, picks=("fable",), **kw):
+        return K.run(picks, do_leg=self.do_leg, read_verdict=lambda n: self.verdicts.get(n), harvested=lambda n: n in self.harvested,
+                     harvest=self.harvest, metrics_for=self.metrics_for, sleep=self.sleep, clock=self.clock,
+                     log=self.logs.append, **kw)
+
+
