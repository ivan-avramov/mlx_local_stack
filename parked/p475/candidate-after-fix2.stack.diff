+def ratios_vs_n16(by_arm_block):
+    """{arm: {rung: {metric: {block: arm / N16 of the SAME block}}}} for every arm but N16."""
+    base = by_arm_block.get("N16", {})
+    out = {}
+    for arm, blocks in by_arm_block.items():
+        if arm == "N16":
+            continue
+        for block, rungs in blocks.items():
+            for rung, vals in rungs.items():
+                ref = (base.get(block) or {}).get(rung)
+                for metric in METRICS:
+                    if ref and ref.get(metric) and vals.get(metric) is not None:
+                        out.setdefault(arm, {}).setdefault(rung, {}).setdefault(metric, {})[block] = vals[metric] / ref[metric]
+    return out
+
+
+def instability_flags(by_arm_block):
+    """Per arm and rung the blocks' ratios vs N16: a direction reversal, or a spread larger than half the mean ratio's
+    distance from 1.0, triggers a deciding block — but only when the spread exceeds the absolute floor
+    `SPREAD_FLOOR` (two blocks agreeing to within 3 % of N16 are noise, not instability, however close the mean is to 1)."""
+    flags = []
+    for arm, rungs in ratios_vs_n16(by_arm_block).items():
+        for rung, metrics in rungs.items():
+            for metric, per_block in metrics.items():
+                r = list(per_block.values())
+                if len(r) < 2:
+                    continue
+                mean = sum(r) / len(r)
+                spread = max(r) - min(r)
+                if spread <= max(SPREAD_FLOOR, 0.5 * abs(mean - 1.0)):
+                    continue
+                why = "direction reversal" if min(r) < 1.0 < max(r) else "spread"
+                flags.append(dict(arm=arm, rung=rung, metric=metric, why=why, ratios=dict(per_block)))
+    return flags
+
+
+# ----------------------------------------------------------------------------------------------- one leg
+@dataclass
+class Deps:
+    ops_for: object                        # (leg, ArmInputs) -> ChainOps-like
+    arm_inputs: object                     # (leg) -> ArmInputs, read from the worktree's own git AT CALL TIME (entry, exit)
+    read_text: object                      # (path) -> str
+    load_kvmanifest: object                # (worktree) -> module
+    launch_driver: object                  # (argv, env, cwd, stdout_path) -> process (.pid, .wait(timeout))
+    start_watch: object                    # (driver pid, leg[, create_time=]) -> stop() -> {power_failure, exited_early, ticks, tick_times}
+    read_rows: object                      # (path) -> [row]
+    read_json: object                      # (path) -> dict
+    read_worker_log: object                # (ops, model) -> str
+    lock_check: object                     # (workdir) -> [problem]
+    clock: object = field(default=lambda: time.strftime("%Y-%m-%d %H:%M:%S"))
+    stop_driver: object = field(default=lambda proc: [])           # (proc) -> [problem]: terminate -> kill -> wait -> verify
+    run_qualify: object = None                                     # (argv, out_dir, stdout_path, timeout_s) -> rc
+    battery_intervals: object = field(default=lambda worktree, start, end: ([], []))   # -> (intervals, problems)
+    epoch: object = field(default=time.time)
+    monotonic: object = field(default=time.monotonic)               # the measurement interval ONLY (two calls per leg)
+    driver_create_time: object = field(default=lambda pid: None)   # (pid) -> the driver's start time (identity), or None
+    sleep: object = field(default=time.sleep)                       # the KV-line poll
+    poll_clock: object = field(default=time.monotonic)              # the KV-line poll's deadline
+
+
+def results_dir(cfg, leg):
+    return Path(cfg.instrument_root) / "benchmark" / "results" / leg.model
+
+
+def _receipt_path(cfg, leg):
+    return Path(cfg.receipt_dir) / f"{leg.name}.receipt.json"
+
+
+def write_receipt(cfg, leg, receipt):
+    """Atomic and never over an existing receipt (a refusal / rerun lands beside it as `.refused-<ns>`)."""
+    d = Path(cfg.receipt_dir)
+    d.mkdir(parents=True, exist_ok=True)
+    tmp = d / f".{leg.name}.{os.getpid()}.{time.time_ns()}.tmp"
+    tmp.write_text(json.dumps(receipt, indent=1, default=str) + "\n")
+    path = _receipt_path(cfg, leg)
+    if receipt.get("verdict") == "NOT_STARTED":      # a refusal is not the leg's result: the canonical name stays free
+        path = d / f"{leg.name}.ns-{time.time_ns()}.receipt.json"
+    try:
+        while True:
+            try:
+                os.link(tmp, path)
+                break
+            except FileExistsError:
+                path = d / f"{leg.name}.refused-{time.time_ns()}.receipt.json"
+    finally:
+        tmp.unlink(missing_ok=True)
+    return dict(receipt, _path=str(path))
+
+
+def run_leg(leg, cfg, deps, preflighted):
+    """One leg, fail closed; a receipt is written on every path and an interrupt is re-raised after it. The arm's identity
+    is read from its worktree's git at entry AND exit. `preflighted` is the set of (pick, arm) whose live engagement
+    preflight passed (`run_preflight`); an arm outside it is not started."""
+    import yaml
+
+    receipt = dict(name=leg.name, pick=leg.pick, arm=leg.arm, block=leg.block, attempt=leg.attempt, model=leg.model,
+                   grid=list(leg.grid), problems=[], speed_problems=[], preflight=None, arm_identity={},
+                   replacement_cap=cfg.max_deciding_replacements if leg.block == DECIDING_BLOCK else cfg.max_replacements)
+    pre = []
+    try:
+        ai = deps.arm_inputs(leg)
+        receipt["arm_identity"]["entry"] = ai.identity()
+        ops = deps.ops_for(leg, ai)
+        arm_text = deps.read_text(Path(ai.worktree) / "main_models.yaml")
+        entry = _entry(yaml.safe_load(arm_text), leg.model) or {}
+        results = results_dir(cfg, leg)
+        destinations = [results / f"capacity_ladder.{leg.tag}.jsonl", results / f"capacity_ladder.{leg.tag}.manifest.json",
+                        results / f"capacity_retrieval.{leg.tag}.json", Path(cfg.main_root) / RESULTS_P475 / leg.name]
+        if _receipt_path(cfg, leg).exists():
+            pre.append(f"receipt exists: {_receipt_path(cfg, leg)} (a leg is run once)")
+        pre += [f"{p} exists" for p in destinations if p.exists()]
+        pre += identity_problems(ai, cfg.base_commit)
+        pre += arm_problems(leg, ai, cfg.base_registry_text, ai.registry_text)
+        if arm_text != ai.registry_text:
+            pre.append("the served main_models.yaml differs from the committed one")
+        receipt["preflight"] = "passed" if (leg.pick, leg.arm) in preflighted else "MISSING"
+        if receipt["preflight"] != "passed":
+            pre.append(f"no passed live engagement preflight for {leg.pick} {leg.arm}")
+        pre += deps.lock_check(cfg.workdir)
+        if not ops.power_ok():
+            pre.append("power / orphan gate failed at entry (140 W / 28 V / battery > 20 %)")
+        busy = ops.busy_procs()
+        if busy:
+            pre.append("busy processes: " + "; ".join(busy)[:400])
+        owners = ops.listeners()
+        if owners:
+            pre.append(f":8000 already bound by {owners}")
+    except Exception as exc:  # noqa: BLE001 — a pre-check that cannot run refuses the leg, receipted
+        pre.append(f"pre-check error: {type(exc).__name__}: {exc}")
+    if pre:
+        return write_receipt(cfg, leg, dict(receipt, verdict="NOT_STARTED", problems=pre, speed_valid=False))
+
+    problems, speed = receipt["problems"], receipt["speed_problems"]
+    receipt["pre_state"] = ops.start_state()
+    receipt["started"] = deps.clock()
+    stop_watch, interrupted, watched, ident, proc = None, None, None, None, None
+    t_start = e_start = e_end = span_s = None      # the MEASUREMENT interval: driver launch -> driver completion
+    driver_exited = watch_failed = False
+
+    def stop_the_watcher():
+        """Stop the watcher once; its failure is a watcher-lifecycle (speed) problem, never a measurement one."""
+        nonlocal stop_watch, watched, interrupted
+        stop, stop_watch = stop_watch, None
+        if stop is None:
+            return
+        try:
+            watched = stop()
+        except BaseException as exc:  # noqa: BLE001
+            speed.append(f"watch daemon stop failed: {type(exc).__name__}: {exc}")
+            interrupted = interrupted or (exc if not isinstance(exc, Exception) else None)
+
+    try:
+        receipt["router_pid"] = ops.start_router()
+        served = hashlib.sha256(arm_text.encode()).hexdigest()
+        ident = ops.load(leg.model)
+        receipt["worker"] = ident
+        # everything knowable after load is checked BEFORE the (hours-long) driver launches; any failure aborts the leg
+        pre_driver = []
+        if getattr(ops, "router_config_sha", None) != served:
+            pre_driver.append(f"served config {getattr(ops, 'router_config_sha', None)} != the arm registry {served}")
+        pre_driver += worker_argv_problems(ident["cmdline"], entry)
+        pre_driver += predictor_argv_problems(ident["cmdline"])
+        pre_driver += wait_kv_line(lambda: deps.read_worker_log(ops, leg.model), entry, sleep=deps.sleep,
+                                   clock=deps.poll_clock)
+        if hasattr(ops, "proc_env"):                  # the router's and the worker's own environments carry no KV override
+            router_pid = (getattr(ops, "router", None) or {}).get("pid") or receipt["router_pid"]
+            pre_driver += kv_env_problems(ops.proc_env(router_pid), "router")
+            pre_driver += kv_env_problems(ops.proc_env(ident["pid"]), "worker")
+        problems += pre_driver
+        if pre_driver:
+            receipt["driver_launched"] = False
+            receipt["driver_not_launched"] = "pre-driver checks failed; the stack is torn down before any measurement"
+        else:
+            argv = driver_argv(cfg.python, leg, leg.grid)
+            env = driver_env(ops.env_base(), leg)
+            receipt["driver_argv"] = argv
+            Path(cfg.receipt_dir).mkdir(parents=True, exist_ok=True)
+            t_start, e_start = deps.monotonic(), deps.epoch()        # immediately before the driver launches
+            proc = deps.launch_driver(argv, env, str(Path(cfg.instrument_root) / "benchmark"),
+                                      Path(cfg.receipt_dir) / f"{leg.name}.stdout")
+            receipt["driver_launched"] = True
+            try:
+                create_time = deps.driver_create_time(proc.pid)
+            except Exception:  # noqa: BLE001 — identity unavailable: the watcher falls back to pid existence
+                create_time = None
+            receipt["driver_create_time"] = create_time
+            try:
+                stop_watch = (deps.start_watch(proc.pid, leg, create_time=create_time) if create_time is not None
+                              else deps.start_watch(proc.pid, leg))
+            except Exception as exc:  # noqa: BLE001 — no independent power record: the leg cannot be speed-valid
+                watch_failed = True
+                speed.append(f"watch daemon failed to start: {type(exc).__name__}: {exc} "
+                             "(the driver was terminated; the leg is replaced by a rerun)")
+            if not watch_failed:
+                try:
+                    rc = proc.wait(timeout=cfg.timeout_s)
+                    driver_exited = True
+                except subprocess.TimeoutExpired:
+                    rc = None
+                    problems.append(f"driver timed out after {cfg.timeout_s} s (terminated by the orchestrator)")
+                span_s, e_end = deps.monotonic() - t_start, deps.epoch()      # immediately after the driver completes
+                receipt["driver_rc"] = rc
+                if driver_exited:
+                    stop_the_watcher()               # the watcher outlives the driver by nothing: no tick past its end
+                if not ops.power_ok():
+                    speed.append("power / orphan gate failed at exit")
+                if rc not in (0, None):
+                    problems.append(f"driver exit {rc}")
+                rows = deps.read_rows(results / f"capacity_ladder.{leg.tag}.jsonl")
+                if len(rows) != len(leg.grid) or [r.get("ctx") for r in rows] != list(leg.grid):
+                    problems.append(f"rows: {len(rows)} of {len(leg.grid)} rungs {[r.get('ctx') for r in rows]}")
+                for r in rows:
+                    if r.get("p475_valid") is not True or r.get("execution_status") != "completed":
+                        problems.append(f"rung {r.get('ctx')} INVALID: {r.get('invalid_reasons') or r.get('error')}")
+                manifest = None
+                try:
+                    manifest = deps.read_json(results / f"capacity_ladder.{leg.tag}.manifest.json")
+                except Exception as exc:  # noqa: BLE001
+                    problems.append(f"manifest unreadable: {type(exc).__name__}: {exc}")
+                problems += predictor_record_problems(manifest, rows)
+                receipt["metrics"] = {str(k): v for k, v in metrics_from_rows(rows).items()}
+                if not ops.router_ok():
+                    problems.append("router identity / served config changed during the leg")
+                now = ops.worker_ident(leg.model)
+                if not now or (now["pid"], now["create_time"]) != (ident["pid"], ident["create_time"]):
+                    problems.append(f"worker identity changed: {ident['pid']} -> {now}")
+    except BaseException as exc:  # noqa: BLE001 — every path is receipted; interrupts re-raised below
+        problems.append(f"{type(exc).__name__}: {exc}")
+        if not isinstance(exc, Exception):
+            interrupted = exc
+    finally:
+        if t_start is not None and span_s is None:       # the driver never completed normally: the interval ends now
+            span_s, e_end = deps.monotonic() - t_start, deps.epoch()
+        if proc is not None:      # every path (timeout, watcher start failure, error): terminate -> kill -> wait -> verify
+            try:
+                left = deps.stop_driver(proc)
+                receipt["driver_stop"] = left
+                problems += [f"driver lifecycle: {p}" for p in left]
+            except BaseException as exc:  # noqa: BLE001
+                problems.append(f"driver stop failed: {type(exc).__name__}: {exc}")
+                interrupted = interrupted or (exc if not isinstance(exc, Exception) else None)
+        stop_the_watcher()          # a watcher still running (the driver did not exit on its own) stops after the reaping
+        try:
+            teardown = getattr(ops, "teardown_verified", None)
+            if teardown is not None:             # the loaded worker, the listener, the wrapper and the group are VERIFIED gone
+                report = teardown(model=leg.model)
+                receipt["teardown"] = report
+                receipt["router_started"] = bool(report.get("router_started"))
+                problems += [f"teardown: {p}" for p in report.get("problems") or []]
+            else:
+                torn = ops.stop_stack()
+                receipt["router_started"] = "router_pid" in receipt
+                receipt["teardown"] = dict(router_started=receipt["router_started"], via="stop_stack", rc=torn)
+                if torn not in (0, None):
+                    problems.append(f"teardown failed: stop_stack rc {torn}")
+        except BaseException as exc:  # noqa: BLE001
+            receipt["router_started"] = "router_pid" in receipt
+            receipt["teardown"] = dict(router_started=receipt["router_started"], error=f"{type(exc).__name__}: {exc}")
+            problems.append(f"teardown failed: {type(exc).__name__}: {exc}")
+            interrupted = interrupted or (exc if not isinstance(exc, Exception) else None)
+        try:                      # the arm's identity again, from git, at exit
+            exit_ai = deps.arm_inputs(leg)
+            receipt["arm_identity"]["exit"] = exit_ai.identity()
+            problems += identity_drift(receipt["arm_identity"]["entry"], exit_ai.identity())
+            problems += identity_problems(exit_ai, cfg.base_commit)
+        except Exception as exc:  # noqa: BLE001
+            problems.append(f"arm identity unreadable at exit: {type(exc).__name__}: {exc}")
+        if span_s is not None:
+            receipt["span_s"] = round(span_s, 1)
+        if watched is not None:     # watcher lifecycle / coverage failures are SPEED problems: the leg is rerun, not fatal
+            receipt["watch"] = watched
+            if watched.get("exited_early") or not watched.get("ticks"):
+                speed.append(f"watch daemon exited early or logged no tick ({watched})")
+            if watched.get("power_failure"):
+                speed.append(f"power receipt: {watched['power_failure']}")
+            if span_s is not None:
+                speed += watch_coverage_problems(watched, span_s)
+        elif proc is not None and not watch_failed:
+            speed.append("watch daemon produced no report")
+        if e_start is not None:   # `pmset -g log` battery intervals over the measured interval (exact, unlike 5-minute ticks)
+            try:
+                intervals, power_problems = deps.battery_intervals(ai.worktree, e_start, e_end)
+                speed += [f"battery interval {a} -> {b}" for a, b in intervals] + list(power_problems)
+            except Exception as exc:  # noqa: BLE001 — an unreadable power history is a speed problem, never "no outage"
+                speed.append(f"pmset -g log failed: {type(exc).__name__}: {exc}")
+        receipt["ended"] = deps.clock()
+        receipt["speed_valid"] = not speed
+        receipt["verdict"] = "INVALID" if problems else ("SPEED_INVALID" if speed else "VALID")
+        written = write_receipt(cfg, leg, receipt)
+    if interrupted is not None:
+        raise interrupted
+    return written
+
+
+# ----------------------------------------------------------------------------------------------- sequencer
+def _wait_idle(sleep, clock, last_end, idle_s):
+    while True:
+        remaining = idle_s - (clock() - last_end)
+        if remaining <= 0:
+            return
+        sleep(min(remaining, 60.0))
+
+
+QUEUED = "queued"      # `cell`'s answer for a speed-invalid cell whose replacement waits for the end of the planned blocks
+
+
+EXHAUSTED = "exhausted"  # `cell`'s answer for a DECIDING cell that spent its replacements: flagged in the table, not a failure
+
+
+def run(picks, *, do_leg, read_verdict, harvested, harvest, metrics_for, sleep, clock, log, idle_s=IDLE_S,
+        max_replacements=MAX_REPLACEMENTS, max_not_started=MAX_NOT_STARTED, blocks=(1, 2),
+        preflight=None, is_preflighted=lambda pick, arm: True,
+        max_deciding_replacements=MAX_DECIDING_REPLACEMENTS, max_preflight_refusals=MAX_PREFLIGHT_REFUSALS,
+        preflight_refusals=lambda pick, arm: 0, deliver_pick=None):
+    """0 = every cell has a VALID speed-valid leg (or is a flagged exhausted deciding cell) and every pick's table was
+    delivered; 1 = stopped on an INVALID leg, a persistent pre-check refusal or an unusable earlier receipt; 3 = a main-block
+    cell exhausted its replacements; 4 = a harvest failed; 5 = at least one arm's live engagement preflight refused it
+    (`max_preflight_refusals` times; the other arms were measured regardless); 6 = a pick's table could not be delivered.
+    Picks are sequential. Per pick: the arms' preflights, the planned blocks in order, then the replacements of
+    speed-invalid cells (a queue; `max_replacements` is the highest replacement attempt a cell may reach and continues
+    monotonically on resume), then, if the two blocks are unstable, one deciding third block with its OWN replacement cap
+    `max_deciding_replacements`; then `deliver_pick(pick, refused_arms)` writes the pick's table (P479). A receipt whose
+    dossier is missing (a crash between the receipt and the harvest) has its harvest REPLAYED on resume. The idle clock
+    restarts when a leg's harvest has completed (or a preflight / refusal ended)."""
+    state = dict(last_end=clock())
+    by_pick = {}
+    refused = {}                                                         # pick -> {arm}: preflight refused, not measured
+
+    def idle():
+        _wait_idle(sleep, clock, state["last_end"], idle_s)
+
+    def record(leg):
+        by_pick[leg.pick].setdefault(leg.arm, {})[leg.block] = metrics_for(leg)    # from the VALIDATED harvested dossier
+
+    def cell(leg0, replace, cap):
+        attempt = 0
+        while True:
+            leg = dataclasses.replace(leg0, attempt=attempt)
+            verdict = read_verdict(leg.name)
+            if verdict is not None:                                     # resume
+                if not harvested(leg.name):
+                    log(f"{leg.name}: receipt {verdict} but no finalized dossier: replaying the harvest")
+                    try:
+                        harvest(leg, dict(verdict=verdict, replay=True))
+                    except Exception as exc:  # noqa: BLE001
+                        log(f"STOP {leg.name}: harvest replay failed: {type(exc).__name__}: {exc}")
+                        return 4
+                if verdict == "VALID":
+                    try:
+                        record(leg)
+                    except Exception as exc:  # noqa: BLE001 — the harvested dossier is the only source of resumed metrics
+                        log(f"STOP {leg.name}: the harvested dossier does not validate: {type(exc).__name__}: {exc}")
+                        return 1
+                    log(f"{leg.name}: VALID receipt exists, harvested, skipped")
+                    return 0
+                if verdict == "SPEED_INVALID":
+                    attempt += 1
+                    continue
+                log(f"STOP {leg.name}: existing receipt {verdict} (a rerun is an operator decision)")
+                return 1
+            if attempt and not replace:
+                log(f"{leg0.name}: speed-invalid, kept as evidence; replacement {leg.name} queued after the planned blocks")
+                return QUEUED
+            if attempt > cap:
+                if leg0.block == DECIDING_BLOCK:
+                    log(f"{leg0.name}: deciding cell EXHAUSTED its replacements (limit {cap}; --max-deciding-replacements): "
+                        "flagged in the table, the run goes on")
+                    return EXHAUSTED
+                log(f"STOP {leg0.name}: replacements exhausted (limit {cap}; raise --max-replacements to continue)")
+                return 3
+            refused = 0
+            while True:
+                idle()
+                log(f"START {leg.name}")
+                receipt = do_leg(leg)
+                verdict = receipt["verdict"]
+                log(f"END {leg.name}: {verdict}")
+                if verdict != "NOT_STARTED":
+                    break
+                refused += 1
+                state["last_end"] = clock()                              # a refusal is not an idle: wait afresh
+                if refused >= max_not_started:
+                    log(f"STOP {leg.name}: pre-check refused {refused} time(s): {receipt.get('problems')}")
+                    try:
+                        harvest(leg, receipt)
+                    except Exception as exc:  # noqa: BLE001
+                        log(f"HARVEST of the refusals failed: {type(exc).__name__}: {exc}")
+                    return 1
+                log(f"{leg.name}: NOT_STARTED ({refused} of {max_not_started}); retrying after a fresh idle wait")
+            try:
+                harvest(leg, receipt)
+            except Exception as exc:  # noqa: BLE001 — evidence that cannot reach the repo stops the run
+                log(f"STOP {leg.name}: HARVEST failed: {type(exc).__name__}: {exc}")
+                return 4
+            state["last_end"] = clock()                                  # the idle starts AFTER the harvest
+            if verdict == "VALID":
+                try:
+                    record(leg)
+                except Exception as exc:  # noqa: BLE001 — the dossier just written does not validate
+                    log(f"STOP {leg.name}: the harvested dossier does not validate: {type(exc).__name__}: {exc}")
+                    return 4
+                return 0
+            if verdict == "SPEED_INVALID":
+                attempt += 1
+                continue
+            log(f"STOP {leg.name}: {verdict}")
+            return 1
+
+    def plan(pick, blk):
+        cap = max_deciding_replacements if DECIDING_BLOCK in blk else max_replacements
+        queue = []
+        for leg in schedule((pick,), blk):
+            if leg.arm in refused_arms.get(pick, ()):
+                continue
+            rc = cell(leg, replace=False, cap=cap)
+            if rc == QUEUED:
+                queue.append(leg)
+            elif rc and rc != EXHAUSTED:
+                return rc
+        for leg in queue:
+            rc = cell(leg, replace=True, cap=cap)
+            if rc and rc != EXHAUSTED:
+                return rc
+        return 0
+
+    refused_arms = {}                                                    # pick -> {arm}: preflight refused, not measured
+    for pick in picks:
+        by_pick[pick] = {}
+        for arm in ARMS:
+            if preflight is None or is_preflighted(pick, arm):
+                continue
+            first = Leg(pick, arm, blocks[0])
+            refusals = preflight_refusals(pick, arm)
+            while True:
+                if refusals >= max_preflight_refusals:
+                    log(f"{pick} {arm}: live engagement preflight REFUSED the arm {refusals} time(s) (limit "
+                        f"{max_preflight_refusals}; --max-preflight-refusals): recorded as refused, the other arms go on")
+                    refused_arms.setdefault(pick, set()).add(arm)
+                    break
+                idle()
+                log(f"PREFLIGHT {pick} {arm}")
+                rec = preflight(pick, arm, first)
+                if rec["ok"]:
+                    break
+                refusals += 1
+                state["last_end"] = clock()                              # a refusal is not an idle: wait afresh
+                log(f"{pick} {arm}: live engagement preflight REFUSED the arm ({refusals} of {max_preflight_refusals}): "
+                    f"{rec.get('problems')}")
+                try:                                   # its own dossier namespace: `<leg>.preflight-refused-<k>`
+                    harvest(first, dict(verdict=PREFLIGHT_REFUSED, problems=rec.get("problems"), stamp=rec.get("stamp"),
+                                        out_dir=rec.get("out_dir")))
+                except Exception as exc:  # noqa: BLE001
+                    log(f"HARVEST of the preflight refusal failed: {type(exc).__name__}: {exc}")
+            state["last_end"] = clock()
+        rc = plan(pick, blocks)
+        if rc:
+            return rc
+        main_blocks = {arm: {b: m for b, m in per.items() if b in (1, 2)} for arm, per in by_pick[pick].items()}
+        flags = instability_flags(main_blocks)                   # the deciding block never enters its own trigger
+        if flags and 3 not in blocks:
+            log(f"{pick}: unstable ({len(flags)} flags, e.g. {flags[0]['arm']} {flags[0]['metric']} {flags[0]['why']}); "
+                "scheduling the deciding block 3")
+            rc = plan(pick, (3,))
+            if rc:
+                return rc
+        if deliver_pick is not None:                              # P479: the pick's table as soon as its legs are harvested
+            try:
+                log(f"{pick}: {deliver_pick(pick, set(refused_arms.get(pick, ())))}")
+            except Exception as exc:  # noqa: BLE001 — a table that cannot be delivered is not a successful run
+                log(f"STOP {pick}: the pick's table could not be delivered: {type(exc).__name__}: {exc}")
+                return 6
+    if any(refused_arms.values()):
+        log("DONE with refused arm(s): " + "; ".join(f"{p}: {sorted(a)}" for p, a in refused_arms.items() if a))
+        return 5
+    log("DONE: every cell has a VALID speed-valid leg")
+    return 0
+
+
+# ----------------------------------------------------------------------------------------------- harvest
+def notstarted_dossier(cfg, leg):
+    """The first unused `<leg>.notstarted-<k>` dossier name (a refused leg's evidence; the leg's own dossier stays free)."""
+    k = 1
+    while (Path(cfg.main_root) / RESULTS_P475 / f"{leg.name}.notstarted-{k}").exists():
+        k += 1
+    return f"{leg.name}.notstarted-{k}"
+
+
+def preflight_refused_dossier(cfg, leg):
+    """The first unused `<leg>.preflight-refused-<k>` dossier name: a refused arm preflight's own namespace, which never
+    collides with the leg's `.notstarted-<k>` dossiers or its own."""
+    k = 1
+    while (Path(cfg.main_root) / RESULTS_P475 / f"{leg.name}.preflight-refused-{k}").exists():
+        k += 1
+    return f"{leg.name}.preflight-refused-{k}"
+
+
+def harvest_leg(leg, cfg, *, scrub, stdout, log_slice, verdict=None, stamp=None, out_dir=None, replay=False):
+    """Copy one leg's evidence — the ladder rows / manifest / scorecard, the receipts (incl. refusals), watch log, power
+    receipt, driver stdout, worker-log slice, and the qualify output dir of the arm's preflight — to
+    `benchmark/results/p475/<leg>/`, scrubbed as the `evidence` branch is, with a SCRUB_MANIFEST.json. The dossier is STAGED
+    in a hidden sibling directory, verified (read-back sha of every file), and only then atomically renamed into place:
+    a crash or a write failure leaves no half dossier, so `harvested` is true only for a complete one and a resume can
+    replay the harvest (`replay`, recorded in the manifest). Fail closed: an existing destination, residual PII or an
+    oversized file refuses first, and a VALID leg with no ladder rows refuses. A refused leg (`verdict` NOT_STARTED) goes
+    to its own `<leg>.notstarted-<k>` dossier with the receipts only; a refused arm preflight (`verdict`
+    PREFLIGHT_REFUSED, with the record's `stamp` and qualify `out_dir`) to `<leg>.preflight-refused-<k>`, carrying only
+    that attempt's preflight record, stdout and qualify output."""
+    notstarted, pf_refused = verdict == "NOT_STARTED", verdict == PREFLIGHT_REFUSED
+    refused = notstarted or pf_refused
+    name = (preflight_refused_dossier(cfg, leg) if pf_refused else notstarted_dossier(cfg, leg) if notstarted else leg.name)
+    dossier = RESULTS_P475 / name
+    main_root = Path(cfg.main_root)
+    receipts = Path(cfg.receipt_dir)
+    sources = []
+    res = results_dir(cfg, leg)
+    if pf_refused:
+        if not stamp:
+            raise HarvestError(f"{leg.name}: a refused preflight needs its record's stamp")
+        sources += [(p.name, p) for p in sorted(receipts.glob(f"{leg.name}.preflight-{stamp}.*")) if p.is_file()]
+        qdir = Path(out_dir) if out_dir else None
+        if qdir is not None and qdir.is_dir():
+            sources += [(f"qualify-{stamp}/{p.relative_to(qdir)}", p) for p in sorted(q for q in qdir.rglob("*") if q.is_file())]
+    else:
+        if not refused:
+            for pattern in (f"capacity_ladder.{leg.tag}.*", f"capacity_retrieval.{leg.tag}.*"):
+                sources += [(p.name, p) for p in sorted(res.glob(pattern)) if p.is_file()]
+        sources += [(p.name, p) for p in sorted(receipts.glob(f"{leg.name}.*")) if p.is_file()]
+        for pf in sorted(receipts.glob(f"{leg.name}.preflight-*.json")):       # the qualify output dirs
+            rec = json.loads(pf.read_text())
+            qdir = Path(rec["out_dir"]) if rec.get("out_dir") else None      # (Path("") is the cwd: never harvest that)
+            if qdir is not None and qdir.is_dir() and (not refused or not rec.get("ok")):   # a refused leg: REFUSED preflights' dirs
+                sources += [(f"qualify-{pf.stem.rsplit('-', 1)[-1]}/{p.relative_to(qdir)}", p)
+                            for p in sorted(q for q in qdir.rglob("*") if q.is_file())]
+    items = [(n, src, src.read_bytes()) for n, src in sources]
+    if not refused:
+        items += [("leg.stdout", None, stdout or b""), ("server_log_slice.log", None, log_slice or b"")]
+    problems, staged = [], []
+    if verdict == "VALID" and not any(n.startswith(f"capacity_ladder.{leg.tag}.jsonl") for n, _, _ in items):
+        problems.append(f"no capacity_ladder.{leg.tag}.jsonl to harvest (a VALID leg is harvested with its rows)")
+    final = main_root / dossier
+    if final.exists():
+        problems.append(f"{dossier} exists (a leg is harvested once)")
+    for n, src, data in items:
+        rel, scrubbed, published, found = _publish(data, str(dossier / n), scrub, compressible=True)
+        problems += found
+        staged.append((rel, src, data, scrubbed, published))
+    if problems:
+        raise HarvestError(f"{leg.name}: " + "; ".join(problems)[:2000])
+    final.parent.mkdir(parents=True, exist_ok=True)
+    for stale in final.parent.glob(f".{final.name}.staging-*"):        # a crashed earlier harvest's staging area
+        shutil.rmtree(stale, ignore_errors=True)
+    stage = final.parent / f".{final.name}.staging-{os.getpid()}-{time.time_ns()}"
+    manifest = dict(leg=leg.name, files={})
+    if replay:
+        manifest["replayed"] = True
+    try:
+        for rel, src, data, scrubbed, published in staged:
+            dest = stage / Path(rel).relative_to(dossier)
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            dest.write_bytes(published)
+            rec = dict(source=scrub.text(str(src)) if src else None, original_sha256=_sha(data),
+                       scrubbed_sha256=_sha(scrubbed), published_sha256=_sha(published))
+            if published is not scrubbed:
+                rec["compression"] = "xz"
+            manifest["files"][str(rel)] = rec
+        stage.mkdir(parents=True, exist_ok=True)
+        (stage / "SCRUB_MANIFEST.json").write_text(json.dumps(manifest, indent=1, sort_keys=True) + "\n")
+        for rel, rec in manifest["files"].items():
+            if _sha((stage / Path(rel).relative_to(dossier)).read_bytes()) != rec["published_sha256"]:
+                raise HarvestError(f"{rel}: read-back sha mismatch")
+        if final.exists():
+            raise HarvestError(f"{dossier} appeared while staging (a leg is harvested once)")
+        os.rename(stage, final)                                         # atomic: the dossier exists whole or not at all
+    except BaseException:
+        shutil.rmtree(stage, ignore_errors=True)
+        raise
+    return manifest
+
+
+def validated_dossier_metrics(main_root, leg):
+    """The leg's per-rung metrics from its HARVESTED dossier ONLY (never the instrument's expendable output): the
+    SCRUB_MANIFEST's published sha of every file must match, the receipt must be this leg's VALID speed-valid one, and
+    every rung of the grid must be a valid row. Raises ValueError otherwise."""
+    d = Path(main_root) / RESULTS_P475 / leg.name
+    try:
+        manifest = json.loads((d / "SCRUB_MANIFEST.json").read_text())
+    except (OSError, ValueError) as exc:
+        raise ValueError(f"{leg.name}: no readable SCRUB_MANIFEST.json ({exc})") from None
+    for rel, rec in (manifest.get("files") or {}).items():
+        path = Path(main_root) / rel
+        if not path.is_file() or _sha(path.read_bytes()) != rec.get("published_sha256"):
+            raise ValueError(f"{leg.name}: {rel} is missing or differs from its manifest sha")
+    receipt = _canonical_receipt(d)
+    if receipt is None:
+        raise ValueError(f"{leg.name}: the dossier carries no receipt")
+    got = json.loads(receipt.read_text())
+    if (got.get("name"), got.get("verdict"), got.get("speed_valid")) != (leg.name, "VALID", True):
+        raise ValueError(f"{leg.name}: the dossier's receipt is {got.get('name')} {got.get('verdict')} "
+                         f"speed_valid={got.get('speed_valid')}, not this leg VALID and speed-valid")
+    ladders = _ladders(d)
+    if len(ladders) != 1:
+        raise ValueError(f"{leg.name}: {len(ladders)} ladder files in the dossier, expected exactly one")
+    metrics = metrics_from_rows(_ladder_rows(ladders[0]))
+    if not _complete(metrics, leg.grid):
+        raise ValueError(f"{leg.name}: rungs {sorted(metrics)} of {list(leg.grid)} valid in the dossier")
+    return metrics
+
+
+# ----------------------------------------------------------------------------------------------- MATRIX.md
+def _read_text_maybe_xz(path):
+    data = Path(path).read_bytes()
+    return (lzma.decompress(data) if str(path).endswith(".xz") else data).decode("utf-8")
+
+
+MAIN_BLOCKS = (1, 2)       # the order-balanced blocks: means and paired ratios are over these; block 3 is reported apart
+DECIDING_BLOCK = 3
+
+
+def _canonical_receipt(d):
+    names = [p for p in sorted(d.glob("*.receipt.json")) if ".refused-" not in p.name and ".ns-" not in p.name]
+    own = [p for p in names if p.name == f"{d.name}.receipt.json"]
+    return (own or names or [None])[0]
+
+
+def _ladders(d):
+    return sorted(d.glob("capacity_ladder.*.jsonl")) + sorted(d.glob("capacity_ladder.*.jsonl.xz"))
+
+
+def _ladder_rows(path):
+    return [json.loads(ln) for ln in _read_text_maybe_xz(path).splitlines() if ln.strip()]
+
+
+def _dossiers(root):
+    """The finalized dossier directories (a hidden `.…staging-…` directory is a harvest in progress, never a dossier)."""
+    base = Path(root) / RESULTS_P475
+    return sorted(p for p in base.glob("*") if p.is_dir() and not p.name.startswith("."))
+
+
+def _load_harvest(root):
+    """[(receipt, rows)] for every harvested leg, from `benchmark/results/p475/<leg>/` (a `.notstarted-<k>` /
+    `.preflight-refused-<k>` dossier holds refusals only and has no leg receipt). A dossier holds EXACTLY ONE ladder file
+    (none only for a leg that is not VALID); two would silently pick one, so that raises."""
+    legs = []
+    for d in _dossiers(root):
+        path = _canonical_receipt(d)
+        if path is None:
+            continue
+        receipt = json.loads(path.read_text())
+        ladders = _ladders(d)
+        if len(ladders) > 1 or (not ladders and receipt.get("verdict") == "VALID"):
+            raise ValueError(f"{d.name}: {len(ladders)} capacity_ladder file(s) in the dossier, expected exactly one "
+                             f"({[p.name for p in ladders]})")
+        legs.append((receipt, _ladder_rows(ladders[0]) if ladders else []))
+    return legs
+
+
+def _preflight_records(root):
+    for p in sorted((Path(root) / RESULTS_P475).glob("*/*.preflight-*.json")):
+        if p.parent.name.startswith("."):
+            continue
+        try:
+            rec = json.loads(p.read_text())
+        except ValueError:
+            continue
+        if isinstance(rec, dict) and "pick" in rec and "arm" in rec:
+            yield p, rec
+
+
+def _load_preflights(root):
+    """{(pick, arm): the newest PASSED preflight record} from every harvested dossier."""
+    return {(rec["pick"], rec["arm"]): rec for _, rec in _preflight_records(root) if rec.get("ok")}
+
+
+def _load_refused_arms(root):
+    """{(pick, arm): number of refused preflights} for the arms with a `<leg>.preflight-refused-<k>` dossier and NO passed
+    preflight in the harvest: they were not measured, and the tables say so."""
+    passed = _load_preflights(root)
+    out = {}
+    for p, rec in _preflight_records(root):
+        if ".preflight-refused-" in p.parent.name and rec.get("ok") is False and (rec["pick"], rec["arm"]) not in passed:
+            out[(rec["pick"], rec["arm"])] = out.get((rec["pick"], rec["arm"]), 0) + 1
+    return out
+
+
+def _exhausted_deciding(legs, usable):
+    """{(pick, arm)} whose deciding cell spent its replacements: a speed-invalid deciding leg at (or past) the replacement
+    cap its own receipt records, and no usable deciding leg."""
+    out = set()
+    for receipt, _ in legs:
+        key = (receipt["pick"], receipt["arm"], receipt["block"])
+        cap = receipt.get("replacement_cap")
+        if (receipt["block"] == DECIDING_BLOCK and receipt.get("verdict") == "SPEED_INVALID" and cap is not None
+                and receipt.get("attempt", 0) >= cap and key not in usable):
+            out.add((receipt["pick"], receipt["arm"]))
+    return out
+
+
+def _complete(metrics, grid=GRID):
+    return all(ctx in metrics for ctx in grid)
+
+
+def _usable_cells(legs, require_complete=False):
+    """{(pick, arm, block): (attempt, metrics)} of the newest VALID, speed-valid leg (`require_complete`: with every rung of
+    the grid valid — what the canonical matrix needs; a diagnostic shows whatever rows exist)."""
+    usable = {}
+    for receipt, rows in legs:
+        key = (receipt["pick"], receipt["arm"], receipt["block"])
+        metrics = metrics_from_rows(rows)
+        if receipt.get("verdict") == "VALID" and receipt.get("speed_valid") and (not require_complete or _complete(metrics)):
+            if key not in usable or receipt.get("attempt", 0) >= usable[key][0]:
+                usable[key] = (receipt.get("attempt", 0), metrics)
+    return usable
+
+
+def _by_arm_block(usable, pick, blocks=None):
+    by = {}
+    for (p, arm, block), (_, metrics) in usable.items():
+        if p == pick and (blocks is None or block in blocks):
+            by.setdefault(arm, {})[block] = metrics
+    return by
+
+
+@dataclass
+class PickState:
+    """What the harvest says about one pick: `gaps` block its table (it is not delivered), `refused` arms were not measured
+    (their preflight was refused: the table is delivered, labelled INCOMPLETE), `exhausted` arms have a deciding cell that
+    spent its replacements (flagged in the table; not a gap)."""
+    pick: str
+    gaps: list
+    refused: list
+    exhausted: list
+
+    @property
+    def complete(self):
+        return not self.gaps and not self.refused
+
+
+def _pick_states(root, picks):
+    legs = _load_harvest(root)
+    usable = _usable_cells(legs, require_complete=True)
+    pre = _load_preflights(root)
+    refused_all = _load_refused_arms(root)
+    exhausted_all = _exhausted_deciding(legs, usable)
+    states = {}
+    for pick in picks:
+        refused = [arm for arm in ARMS if (pick, arm) in refused_all and (pick, arm) not in pre]
+        measured = [arm for arm in ARMS if arm not in refused]
+        gaps = []
+        if not measured:
+            gaps.append(f"{pick}: every arm's preflight was refused; nothing was measured")
+        for arm in measured:
+            if (pick, arm) not in pre:
+                gaps.append(f"{pick} {arm}: no passed live engagement preflight in the harvest")
+        for block in MAIN_BLOCKS:
+            for arm in measured:
+                if (pick, arm, block) not in usable:
+                    gaps.append(f"{pick} {arm} b{block}: no complete valid speed-valid leg")
+        has_b3 = any(k[0] == pick and k[2] == DECIDING_BLOCK for k in usable) or any(
+            r["pick"] == pick and r["block"] == DECIDING_BLOCK for r, _ in legs)
+        flags = instability_flags(_by_arm_block(usable, pick, MAIN_BLOCKS))
+        if flags and not has_b3:
+            gaps.append(f"{pick}: the two blocks are unstable ({len(flags)} flag(s)) and no deciding block was run")
+        exhausted = sorted((a for a in measured if (pick, a) in exhausted_all), key=ARMS.index)
+        if has_b3:
+            for arm in measured:
+                if (pick, arm, DECIDING_BLOCK) not in usable and arm not in exhausted:
+                    gaps.append(f"{pick} {arm} b{DECIDING_BLOCK}: no complete valid speed-valid leg")
+        states[pick] = PickState(pick, gaps, refused, exhausted)
+    return states
+
+
+def matrix_problems(root, picks=tuple(PICKS)):
+    """Why the matrix is not COMPLETE yet ([] = every requested pick x arm x block has a complete valid, speed-valid leg
+    (replacements done), the live engagement preflight passed per arm, and a needed deciding block ran; a deciding cell that
+    spent its replacements is flagged in the table and is not a gap). A refused arm preflight is listed too: it does not
+    block the pick's table, but it keeps it from being complete."""
+    problems = []
+    for pick, st in _pick_states(root, picks).items():
+        problems += st.gaps
+        problems += [f"{pick} {arm}: live engagement preflight refused (arm not measured)" for arm in st.refused]
+    return problems
+
+
+def _leg_counts(legs, picks):
+    mine = [r for r, _ in legs if r["pick"] in picks]
+    count = lambda v: sum(1 for r in mine if r.get("verdict") == v)      # noqa: E731
+    planned = len(picks) * len(ARMS) * len(MAIN_BLOCKS) + len(ARMS) * len(
+        {r["pick"] for r in mine if r["block"] == DECIDING_BLOCK})
+    return dict(harvested=len(mine), valid=sum(1 for r in mine if r.get("verdict") == "VALID" and r.get("speed_valid")),
+                speed_invalid=count("SPEED_INVALID"), invalid=count("INVALID"), planned=planned,
+                other=len(mine) - count("VALID") - count("SPEED_INVALID") - count("INVALID"))
+
+
+def build_matrix(root, picks=tuple(PICKS), partial=None, regenerated=None):
+    """MATRIX text from the harvested receipts and rows only (never hand-copied). `partial` (the list of what is missing)
+    labels it an incomplete diagnostic; `regenerated` (the operator's reason) labels a deliberate regeneration."""
+    legs = _load_harvest(root)
+    usable = _usable_cells(legs)
+    pre = _load_preflights(root)
+    n = _leg_counts(legs, picks)
+    states = _pick_states(root, picks)
+    refused_by_pick = {p: st.refused for p, st in states.items() if st.refused}
+    exhausted_by_pick = {p: st.exhausted for p, st in states.items() if st.exhausted}
+    suffix = f" — {', '.join(picks)}" if len(picks) < len(PICKS) else ""
+    if partial is not None:
+        head = [f"# P475 — KV-cache format matrix{suffix} — **PARTIAL DIAGNOSTIC, NOT THE MATRIX**", "",
+                "**This run is incomplete; this file is a diagnostic only and must not be cited as the result.** Missing: "
+                + "; ".join(partial or ["(not stated)"]), ""]
+    else:
+        head = [f"# P475 — KV-cache format matrix (stage 1: memory / speed screen){suffix}", ""]
+        if refused_by_pick:
+            head += ["**INCOMPLETE — this table is delivered with arm(s) NOT measured because their live engagement preflight "
+                     "was refused:** " + "; ".join(f"{p}: {', '.join(arms)} (preflight refused)"
+                                                   for p, arms in refused_by_pick.items())
+                     + ". The refusal evidence is in the pick's `<leg>.preflight-refused-<k>` dossier(s).", ""]
+    if regenerated:
+        head += [f"**Deliberate regeneration** — reason: {regenerated}", ""]
+    lines = head + [
+        f"Legs: {n['harvested']} harvested of {n['planned']} planned — {n['valid']} VALID and speed-valid (the legs the tables "
+        f"draw on), {n['speed_invalid']} SPEED_INVALID (kept as evidence, replaced by a rerun), {n['invalid']} INVALID, "
+        f"{n['other']} other.", "",
+        "Generated by `bench.p475_kv` from the harvested receipts and rows under `benchmark/results/p475/`; never "
+        "hand-edited. Labelled **descriptive**: one speed-valid leg per arm per block, the means and paired ratios over the "
+        "two order-balanced blocks (b1, b2); no interval claimed. A deciding block (b3), where one ran, is reported in its "
+        "own section and is not in any mean or paired ratio. Memory is "
+        "the worker's **cumulative high-water** (`peak_memory_gb_cumulative`, process lifetime, including the "
+        "full-cap preallocation of the first request and the calibration) at each rung, never a per-rung peak. "
+        "Prefill tok/s is the backend's `prompt_per_second` (`cache_n == 0`), decode tok/s its "
+        "`predicted_per_second` (a 256-token carrier). Ratios are arm / N16 of the same block.", ""]
+    labels = dict(peak_gb="Cumulative peak GB", prefill_tps="Backend prefill tok/s", decode_tps="Backend decode tok/s")
+    for pick, model in PICKS.items():
+        if pick not in picks:
+            continue
+        by = _by_arm_block(usable, pick, MAIN_BLOCKS)
+        by3 = _by_arm_block(usable, pick, (DECIDING_BLOCK,))
+        if not by and not by3:
+            continue
+        blocks = [b for b in MAIN_BLOCKS if any(b in per for per in by.values())] or list(MAIN_BLOCKS)
+        rungs = sorted({r for per in by.values() for m in per.values() for r in m})
+        ratios = ratios_vs_n16(by)
+        lines += [f"## {pick} — {model}", ""]
+        for metric in METRICS:
+            lines += [f"### {labels[metric]}", "",
+                      "| Arm | Rung | " + " | ".join(f"b{b}" for b in blocks) + " | mean | "
+                      + " | ".join(f"ratio b{b}" for b in blocks) + " | ratio mean |",
+                      "|---|---|" + "---|" * (2 * len(blocks) + 2)]
+            for arm in ARMS:
+                for rung in rungs:
+                    vals = {b: (by.get(arm, {}).get(b, {}).get(rung) or {}).get(metric) for b in blocks}
+                    present = [v for v in vals.values() if v is not None]
+                    if not present:
+                        continue
+                    rat = (ratios.get(arm, {}).get(rung, {}).get(metric, {})) if arm != "N16" else {}
+                    cells = [f"{vals[b]:.1f}" if vals[b] is not None else "–" for b in blocks]
+                    rcells = [f"{rat[b]:.3f}" if b in rat else "–" for b in blocks]
+                    rmean = f"{sum(rat.values()) / len(rat):.3f}" if rat else "–"
+                    lines.append(f"| {arm} | {rung:,} | " + " | ".join(cells) + f" | {sum(present) / len(present):.1f} | "
+                                 + " | ".join(rcells) + f" | {rmean} |")
+            for arm in refused_by_pick.get(pick, ()):
+                lines.append(f"| {arm} | **preflight refused** (not measured) |" + " – |" * (2 * len(blocks) + 2))
+            lines.append("")
+        flags = instability_flags(by)
+        lines += ["Instability flags (blocks b1 / b2 only): " + ("none" if not flags else ""), ""]
+        for f in flags:
+            lines.append(f"- {f['arm']} @ {f['rung']:,} {f['metric']}: {f['why']} (ratios "
+                         + ", ".join(f"b{b} {r:.3f}" for b, r in sorted(f["ratios"].items(), key=lambda kv: str(kv[0]))) + ")")
+        lines.append("")
+        if by3 or exhausted_by_pick.get(pick):
+            ratios3 = ratios_vs_n16(by3)
+            lines += [f"### Deciding block (b{DECIDING_BLOCK}) — reported on its own; not in any mean or paired ratio above", "",
+                      "| Metric | Arm | Rung | b3 | ratio b3 vs N16 b3 |", "|---|---|---|---|---|"]
+            r3 = sorted({r for per in by3.values() for m in per.values() for r in m})
+            for metric in METRICS:
+                for arm in ARMS:
+                    for rung in r3:
+                        v = (by3.get(arm, {}).get(DECIDING_BLOCK, {}).get(rung) or {}).get(metric)
+                        if v is None:
+                            continue
+                        rr = ratios3.get(arm, {}).get(rung, {}).get(metric, {}).get(DECIDING_BLOCK) if arm != "N16" else None
+                        lines.append(f"| {labels[metric]} | {arm} | {rung:,} | {v:.1f} | "
+                                     f"{'–' if rr is None else format(rr, '.3f')} |")
+            for arm in exhausted_by_pick.get(pick, ()):
+                lines.append(f"| all | {arm} | – | **deciding cell EXHAUSTED** (its replacements were spent, every attempt "
+                             "speed-invalid; no b3 value) | – |")
+            lines.append("")
+        cross = [(arm, pre[(pick, arm)]) for arm in ARMS if (pick, arm) in pre]
+        if cross:
+            top = max(GRID)
+            lines += ["### In-process cross-check — qualify (R7) phase peaks, predictor OFF", "",
+                      "A different instrument from the router legs: one in-process request at the context cap, `mx.get_peak_memory` "
+                      f"per phase (GB, 1e9). The last column is the router legs' cumulative peak at {top:,} (mean of b1 / b2).", "",
+                      "| Arm | qualify prefill GB | qualify decode GB | qualify retire GB | router cumulative peak GB |",
+                      "|---|---|---|---|---|"]
+            for arm, rec in cross:
+                peaks = (rec.get("qualify") or {}).get("peaks_gb") or {}
+                routed = [(by.get(arm, {}).get(b, {}).get(top) or {}).get("peak_gb") for b in MAIN_BLOCKS]
+                routed = [v for v in routed if v is not None]
+                fmt = lambda v: "–" if v is None else f"{v:.2f}"      # noqa: E731
+                lines.append(f"| {arm} | {fmt(peaks.get('prefill'))} | {fmt(peaks.get('decode'))} | {fmt(peaks.get('retire'))} | "
+                             f"{fmt(sum(routed) / len(routed) if routed else None)} |")
+            lines.append("")
+    lines += ["## Replaced and excluded legs", ""]
+    excluded = [r for r, _ in legs if r["pick"] in picks and not (r.get("verdict") == "VALID" and r.get("speed_valid"))]
+    if not excluded:
+        lines += ["none", ""]
+    replaced = {(r["pick"], r["arm"], r["block"]) for r in excluded if (r["pick"], r["arm"], r["block"]) in usable}
+    for r in sorted(excluded, key=lambda r: r["name"]):
+        done = (r["pick"], r["arm"], r["block"]) in replaced
+        note = ("kept as evidence, replaced by a rerun" if done else "kept as evidence, NOT replaced") \
+            if r.get("verdict") == "SPEED_INVALID" else "excluded from the tables"
+        lines.append(f"- {r['name']}: {r.get('verdict')} ({note}); problems: "
+                     f"{'; '.join((r.get('problems') or []) + (r.get('speed_problems') or [])) or 'none'}")
+    return "\n".join(lines) + "\n"
+
+
+# ----------------------------------------------------------------------------------------------- CLI
+def _read_jsonl(path):
+    p = Path(path)
+    return [json.loads(ln) for ln in p.read_text().splitlines() if ln.strip()] if p.exists() else []
+
+
+class MatrixRefused(RuntimeError):
+    pass
+
+
+def _create_exclusive(path, text):
+    with open(path, "x") as f:           # never over an existing file
+        f.write(text)
+    return path
+
+
+@dataclass
+class MatrixOutcome:
+    """What one `write_matrices` call did. `ok` = every requested pick is COMPLETE, each pick's table exists, and (when both
+    picks were requested) the combined table exists: anything less is not a successful completion."""
+    picks: tuple
+    written: list = field(default_factory=list)        # files created by this call
+    kept: list = field(default_factory=list)           # canonical files that already existed (never replaced)
+    partial: Path | None = None                        # MATRIX.PARTIAL.md, when some pick has gaps
+    gaps: dict = field(default_factory=dict)           # pick -> [what is missing]
+    refused: dict = field(default_factory=dict)        # pick -> [arms whose preflight was refused] (table delivered, INCOMPLETE)
+    notes: list = field(default_factory=list)          # things the operator must be told (e.g. a regeneration that cannot apply)
+    ok: bool = False
+
+    @property
+    def primary(self):
+        """The one path `_write_matrix` reports: the combined table, else the diagnostic, else the last table written."""
+        combined = [p for p in self.written if p.name in ("MATRIX.md",) or re.fullmatch(r"MATRIX\.\d+\.md", p.name)]
+        return (combined or ([self.partial] if self.partial else []) or self.written or self.kept or [None])[-1]
+
+
+def _create_numbered(d, stem, text, regenerate):
+    """`MATRIX.<stem>.md` exclusive-created; with a stated `regenerate` reason over an existing one, the next free
+    `MATRIX.<stem>.<n>.md` (n >= 2). Returns the path, or None when it exists and there is no reason to regenerate."""
+    base = f"MATRIX.{stem}" if stem else "MATRIX"
+    path = d / f"{base}.md"
+    if path.exists():
+        if not regenerate:
+            return None
+        n = 2
+        while (d / f"{base}.{n}.md").exists():
+            n += 1
+        path = d / f"{base}.{n}.md"
+    return _create_exclusive(path, text)
+
+
+def write_matrices(main_root, picks=tuple(PICKS), regenerate=None, existing="refuse"):
+    """P479: the canonical tables are PER PICK — `MATRIX.<pick>.md`, exclusive-created as soon as that pick has no gap
+    (a pick whose only shortfall is refused arm preflights is delivered labelled INCOMPLETE) — plus the combined
+    `MATRIX.md` only when BOTH picks are requested and complete. A subset run produces only its picks' tables. Gaps in any
+    requested pick write `MATRIX.PARTIAL.md`, a labelled diagnostic. Nothing canonical is ever replaced: a deliberate
+    regeneration (`regenerate` = why) writes the next `MATRIX.<stem>.<n>.md` and states why; a regeneration that cannot
+    apply (nothing complete to regenerate) is said so in `notes`. `existing`: "refuse" (matrix-only) raises
+    `MatrixRefused` when the combined table exists; "keep" (a normal run finishing) leaves it and notes it."""
+    d = Path(main_root) / RESULTS_P475
+    d.mkdir(parents=True, exist_ok=True)
+    picks = tuple(picks)
+    out = MatrixOutcome(picks=picks)
+    combined_wanted = set(picks) == set(PICKS) and len(picks) == len(PICKS)
+    canonical = d / "MATRIX.md"
+    if combined_wanted and canonical.exists() and not regenerate:
+        if existing == "refuse":
+            raise MatrixRefused(f"{canonical} exists: refusing to replace it (a deliberate regeneration needs a stated reason)")
+        out.kept.append(canonical)
+        out.notes.append(f"{canonical.name} already exists and is kept (nothing canonical is replaced)")
+    states = _pick_states(main_root, picks)
+    out.gaps = {p: st.gaps for p, st in states.items() if st.gaps}
+    out.refused = {p: st.refused for p, st in states.items() if st.refused}
+    for pick in picks:
+        st = states[pick]
+        if st.gaps:
+            continue
+        path = _create_numbered(d, pick, build_matrix(main_root, (pick,), regenerated=regenerate), regenerate)
+        if path is None:
+            out.kept.append(d / f"MATRIX.{pick}.md")
+        else:
+            out.written.append(path)
+    partial = d / "MATRIX.PARTIAL.md"
+    if out.gaps:
+        missing = [g for gaps in out.gaps.values() for g in gaps]
+        partial.write_text(build_matrix(main_root, picks, partial=missing))
+        out.partial = partial
+        if regenerate and not out.written:
+            out.notes.append("--regenerate-matrix cannot apply: the harvest is incomplete, so there is no table to regenerate "
+                             f"(only {partial.name} was written; its reason was not recorded)")
+    elif partial.exists() and "PARTIAL DIAGNOSTIC" in partial.read_text()[:400]:
+        partial.unlink()                                  # our own stale diagnostic: nothing is missing any more
+    complete = all(st.complete for st in states.values())
+    if combined_wanted and complete and not (canonical.exists() and not regenerate):
+        out.written.append(_create_numbered(d, "", build_matrix(main_root, picks, regenerated=regenerate), regenerate))
+    out.ok = (not out.gaps and complete
+              and all((d / f"MATRIX.{p}.md").exists() for p in picks)
+              and (not combined_wanted or canonical.exists()))
+    if regenerate and not out.written and not out.gaps:
+        out.notes.append("--regenerate-matrix wrote nothing: every requested table was already regenerated or is not complete")
+    return out
+
+
+def _write_matrix(main_root, picks=tuple(PICKS), regenerate=None):
+    """`write_matrices` in matrix-only mode, reporting its primary path (the combined `MATRIX.md` or its numbered
+    regeneration, else `MATRIX.PARTIAL.md`, else the last per-pick table)."""
+    return write_matrices(main_root, picks, regenerate, existing="refuse").primary
+
+
+def newest_verdict(receipt_dir, name):
+    """A leg's verdict from its NEWEST attempt's receipt (the canonical one or a later `.refused-<ns>` rerun), not the worst
+    of all files; None when it has none. Refusals (`.ns-<ns>`, NOT_STARTED) are not the leg's result and never count."""
+    d = Path(receipt_dir)
+    paths = [p for p in (d / f"{name}.receipt.json", *d.glob(f"{name}.refused-*.receipt.json")) if p.exists()]
+    if not paths:
+        return None
+    newest = max(paths, key=lambda p: (p.stat().st_mtime_ns, p.name))
+    return json.loads(newest.read_text()).get("verdict")
+
+
+def battery_intervals_from_pmset(worktree, start, end, run=subprocess.run):
+    """`pmset -g log` on-battery intervals overlapping [start, end] (epoch s), by the arm worktree's own reviewed
+    `qualify.battery_intervals`; an unreadable log is a problem, never 'no outage'. Returns (intervals, problems)."""
+    got = run(["pmset", "-g", "log"], capture_output=True, text=True, timeout=120)
+    problems = power_history_problems(got.returncode, got.stdout)
+    if problems:
+        return [], problems
+    path = (Path(worktree) / "src" / "mlx-vlm" / "dev" / "p369_phase2" / "qualify.py").resolve()
+    spec = importlib.util.spec_from_file_location("p475_qualify_" + hashlib.sha256(str(path).encode()).hexdigest()[:12], path)
+    qualify = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(qualify)
+    return list(qualify.battery_intervals(got.stdout, start, end)), []
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--main-root", required=True, help="the main checkout the evidence is harvested into")
+    ap.add_argument("--workdir", required=True)
+    ap.add_argument("--out", required=True, help="sequence log, driver stdout and receipts/")
+    ap.add_argument("--base-commit", help="the P476 commit every arm is cut from (rev; resolved to a full sha in --main-root)")
+    ap.add_argument("--production-ref", help="qualify's --production-ref for the live engagement preflight")
+    ap.add_argument("--worktrees-root", help="holds one worktree per arm named p475-<pick>-<arm> "
+                                              "(default: $STACK_WORKDIR/p475/worktrees)")
+    ap.add_argument("--instrument-root", default=str(Path(__file__).resolve().parents[2]))
+    ap.add_argument("--python", default=sys.executable)
+    ap.add_argument("--idle-s", type=float, default=IDLE_S)
+    ap.add_argument("--picks", default=",".join(PICKS))
+    ap.add_argument("--max-replacements", type=int, default=MAX_REPLACEMENTS,
+                    help="the highest replacement attempt a speed-invalid cell may reach; raise it to continue on resume")
+    ap.add_argument("--max-deciding-replacements", type=int, default=MAX_DECIDING_REPLACEMENTS,
+                    help="the deciding block's OWN replacement cap; a deciding cell that spends it is flagged in the table, "
+                         "not a run failure")
+    ap.add_argument("--max-not-started", type=int, default=MAX_NOT_STARTED,
+                    help="attempts of a leg whose pre-check refuses, each after a fresh idle wait, before the run stops")
+    ap.add_argument("--max-preflight-refusals", type=int, default=MAX_PREFLIGHT_REFUSALS,
+                    help="refusals of an arm's live engagement preflight (each retried after a fresh idle wait) before the "
+                         "arm is recorded as refused; the other arms go on and the pick's table is labelled incomplete")
+    ap.add_argument("--smoke", action="store_true", help="one N16 leg at grid 8192 only (acceptance criterion 2)")
+    ap.add_argument("--matrix-only", action="store_true",
+                    help="write the per-pick MATRIX.<pick>.md tables (and MATRIX.md when both picks are complete) or the "
+                         "diagnostic from the harvest and exit")
+    ap.add_argument("--regenerate-matrix", metavar="WHY",
+                    help="a deliberate regeneration over existing tables (writes MATRIX.<pick>.<n>.md / MATRIX.<n>.md and "
+                         "states why); honoured in a normal run too, where it applies once the run ends")
+    args = ap.parse_args(argv)
+    configured = os.environ.get("STACK_WORKDIR")
+    if not configured or Path(configured).resolve() != Path(args.workdir).resolve():
+        print(f"[p475_kv] --workdir {args.workdir} is not $STACK_WORKDIR ({configured})", file=sys.stderr)
+        return 2
+    if args.idle_s < IDLE_S:
+        print(f"[p475_kv] --idle-s {args.idle_s} < {IDLE_S} (spec: >= 600 s idle before every leg)", file=sys.stderr)
+        return 2
+    if (args.max_replacements < 0 or args.max_deciding_replacements < 0 or args.max_not_started < 1
+            or args.max_preflight_refusals < 1):
+        print("[p475_kv] --max-replacements and --max-deciding-replacements must be >= 0; --max-not-started and "
+              "--max-preflight-refusals >= 1", file=sys.stderr)
+        return 2
+    main_root, out = Path(args.main_root).resolve(), Path(args.out).resolve()
+    picks = tuple(p.strip() for p in args.picks.split(","))
+    if not args.picks.strip() or "" in picks:
+        print("[p475_kv] --picks must name at least one pick, with no empty entry", file=sys.stderr)
+        return 2
+    dupes = sorted({p for p in picks if picks.count(p) > 1})
+    if dupes:
+        print(f"[p475_kv] --picks names {dupes} more than once", file=sys.stderr)
+        return 2
+    unknown = [p for p in picks if p not in PICKS]
+    if unknown:
+        print(f"[p475_kv] unknown picks {unknown}", file=sys.stderr)
+        return 2
+    if args.matrix_only:
+        try:
+            outcome = write_matrices(main_root, picks, regenerate=args.regenerate_matrix, existing="refuse")
+        except MatrixRefused as exc:
+            print(f"[p475_kv] {exc}", file=sys.stderr)
+            return 2
+        except Exception as exc:  # noqa: BLE001 — a harvest that cannot be read is not a matrix
+            print(f"[p475_kv] matrix not generated: {type(exc).__name__}: {exc}", file=sys.stderr)
+            return 6
+        for path in outcome.written:
+            print(f"[p475_kv] wrote {path}")
+        if outcome.partial:
+            print(f"[p475_kv] wrote {outcome.partial} (diagnostic only; missing: "
+                  f"{'; '.join(g for gaps in outcome.gaps.values() for g in gaps)})", file=sys.stderr)
+        for pick, arms in outcome.refused.items():
+            print(f"[p475_kv] {pick}: INCOMPLETE table, arm(s) {arms} not measured (preflight refused)", file=sys.stderr)
+        for note in outcome.notes:
+            print(f"[p475_kv] {note}", file=sys.stderr)
+        return 0 if outcome.ok else 1        # 1: incomplete (a diagnostic, or a table labelled INCOMPLETE)
+    if not args.base_commit or not args.production_ref:
+        print("[p475_kv] --base-commit and --production-ref are required for a run", file=sys.stderr)
+        return 2
+
+    workdir = Path(args.workdir).resolve()
+    lock_fh, lock_problems = acquire_sequencer_lock(workdir)        # held (by `lock_fh`) until this process exits
+    if lock_problems:
+        print(f"[p475_kv] {'; '.join(lock_problems)}", file=sys.stderr)
+        return 2
+    receipts = out / "receipts"
+    receipts.mkdir(parents=True, exist_ok=True)
+    try:
+        base_commit = run_git(main_root, "rev-parse", "--verify", f"{args.base_commit}^{{commit}}").strip()
+        base_registry = run_git(main_root, "show", f"{base_commit}:main_models.yaml")
+    except (GitError, OSError) as exc:
+        print(f"[p475_kv] cannot resolve --base-commit {args.base_commit}: {exc}", file=sys.stderr)
+        return 2
+    worktrees = Path(args.worktrees_root).resolve() if args.worktrees_root else workdir / "p475" / "worktrees"
+    cfg = Config(receipt_dir=receipts, workdir=workdir, instrument_root=Path(args.instrument_root).resolve(),
+                 main_root=main_root, base_registry_text=base_registry, python=args.python, base_commit=base_commit,
+                 production_ref=args.production_ref, max_replacements=args.max_replacements,
+                 max_deciding_replacements=args.max_deciding_replacements)
+    host = socket.gethostname()
+    scrub = Scrub(workdir=workdir, repo=main_root, home=Path.home(), user=getpass.getuser(),
+                  hosts=tuple({host, host.split(".")[0]}))
+    ops_by_leg = {}
+
+    def log(msg):
+        line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}"
+        with (out / "sequence.log").open("a") as f:
+            f.write(line + "\n")
+        print(line, flush=True)
+
+    def ops_for(leg, ai):
+        wt = Path(ai.worktree)
+        ops_by_leg[leg.name] = KvArmOps(wt, workdir, str(wt / "main_models.yaml"), log, predictor="off",
+                                        out_root=receipts / leg.name)       # router / worker / driver env: no KV override
+        return ops_by_leg[leg.name]
+
+    def read_worker_log(ops, model):
+        p = Path(ops.tmpdir) / "mlx-manager-logs" / f"{model}.log"
+        return p.read_text(errors="replace") if p.exists() else ""
+
+    stop_driver = make_stop_driver()
+    deps = Deps(ops_for=ops_for,
+                arm_inputs=lambda leg: git_arm_state(run_git, worktrees / arm_branch(leg.pick, leg.arm), cfg.base_commit),
+                read_text=lambda p: Path(p).read_bytes().decode("utf-8"), load_kvmanifest=load_kvmanifest,
+                launch_driver=make_launch_driver(), start_watch=make_start_watch(cfg), read_rows=_read_jsonl,
+                read_json=lambda p: json.loads(Path(p).read_text()), read_worker_log=read_worker_log,
+                lock_check=gate_lock_problems, stop_driver=stop_driver, run_qualify=make_run_qualify(stop_driver),
+                battery_intervals=battery_intervals_from_pmset, driver_create_time=_driver_create_time)
+    preflighted = preflight_passed(receipts)
+    refusal_counts = preflight_refusals(receipts)
+
+    def do_leg(leg):
+        return run_leg(leg, cfg, deps, preflighted)
+
+    def do_preflight(pick, arm, first_leg):
+        rec = run_preflight(pick, arm, first_leg, cfg, deps)
+        if rec["ok"]:
+            preflighted.add((pick, arm))
+        else:
+            refusal_counts[(pick, arm)] = refusal_counts.get((pick, arm), 0) + 1
+        return rec
+
+    def harvest(leg, receipt):
+        ops = ops_by_leg.pop(leg.name, None)
+        verdict = receipt.get("verdict")
+        refused = verdict in ("NOT_STARTED", PREFLIGHT_REFUSED)
+        slice_ = read_worker_log(ops, leg.model).encode() if ops is not None and not refused else b""
+        stdout = receipts / f"{leg.name}.stdout"
+        harvest_leg(leg, cfg, scrub=scrub, stdout=stdout.read_bytes() if stdout.exists() else b"", log_slice=slice_,
+                    verdict=verdict, stamp=receipt.get("stamp"), out_dir=receipt.get("out_dir"),
+                    replay=bool(receipt.get("replay")))
+
+    def metrics_for(leg):
+        return validated_dossier_metrics(main_root, leg)          # the HARVESTED dossier only, never the instrument's output
+
+    def deliver_pick(pick, refused_arms):
+        """P479: this pick's table, as soon as its legs are harvested (exclusive-created; an existing one is kept)."""
+        got = write_matrices(main_root, (pick,), existing="keep")
+        if got.gaps:
+            raise MatrixRefused(f"{pick} is not complete: {'; '.join(g for gaps in got.gaps.values() for g in gaps)}")
+        return "table " + (", ".join(p.name for p in got.written) or f"{[p.name for p in got.kept]} kept") + (
+            f" (INCOMPLETE: {sorted(refused_arms)} preflight refused)" if refused_arms else "")
+
+    def read_verdict(name):
+        return newest_verdict(receipts, name)
+
+    log(f"p475_kv PID {os.getpid()} main_root {main_root} base {base_commit} picks {picks} smoke={args.smoke}")
+    if args.smoke:
+        leg = Leg("fable", "N16", "smoke")
+        if read_verdict(leg.name) is not None:
+            log(f"STOP {leg.name}: existing receipt")
+            return 1
+        _wait_idle(time.sleep, time.monotonic, time.monotonic(), args.idle_s)
+        if ("fable", "N16") not in preflighted:
+            rec = do_preflight("fable", "N16", leg)
+            if not rec["ok"]:
+                log(f"STOP {leg.name}: live engagement preflight REFUSED the arm: {rec['problems']}")
+                harvest(leg, dict(verdict=PREFLIGHT_REFUSED, problems=rec["problems"], stamp=rec.get("stamp"),
+                                  out_dir=rec.get("out_dir")))
+                return 5
+            _wait_idle(time.sleep, time.monotonic, time.monotonic(), args.idle_s)
+        receipt = do_leg(leg)
+        harvest(leg, receipt)
+        log(f"END {leg.name}: {receipt['verdict']}")
+        return 0 if receipt["verdict"] == "VALID" else 1
+    rc = run(picks, do_leg=do_leg, read_verdict=read_verdict,
+             harvested=lambda n: (main_root / RESULTS_P475 / n / "SCRUB_MANIFEST.json").exists(), harvest=harvest,
+             metrics_for=metrics_for, sleep=time.sleep, clock=time.monotonic, log=log, idle_s=args.idle_s,
+             max_replacements=args.max_replacements, max_not_started=args.max_not_started, preflight=do_preflight,
+             is_preflighted=lambda pick, arm: (pick, arm) in preflighted,
+             max_deciding_replacements=args.max_deciding_replacements,
+             max_preflight_refusals=args.max_preflight_refusals,
+             preflight_refusals=lambda pick, arm: refusal_counts.get((pick, arm), 0), deliver_pick=deliver_pick)
+    # The tables are part of a successful completion: a failure, a partial-only output or a table labelled INCOMPLETE is a
+    # nonzero exit (the sequencer's own status wins when it is already nonzero), and the operator is told why.
+    try:
+        outcome = write_matrices(main_root, picks, regenerate=args.regenerate_matrix, existing="keep")
+    except Exception as exc:  # noqa: BLE001
+        log(f"matrix NOT generated: {type(exc).__name__}: {exc}")
+        return rc or 6
+    log("matrix: wrote " + (", ".join(p.name for p in outcome.written) or "nothing new")
+        + (f"; kept {[p.name for p in outcome.kept]}" if outcome.kept else ""))
+    if outcome.partial:
+        log(f"matrix: INCOMPLETE — only the diagnostic {outcome.partial.name} was written for the gaps "
+            f"{'; '.join(g for gaps in outcome.gaps.values() for g in gaps)}")
+    for pick, arms in outcome.refused.items():
+        log(f"matrix: {pick} table is INCOMPLETE — arm(s) {arms} not measured (preflight refused)")
+    for note in outcome.notes:
+        log(f"matrix: {note}")
+    if not outcome.ok and not rc:
+        log("matrix: the run finished but the tables are not complete: exit 6")
+        return 6
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
