+# ----------------------------------------------------------------------------------------------- gate / sequencer lock / argv / watcher
+def gate_lock_problems(workdir):
+    """C227: refuse while a gate holds `$STACK_WORKDIR/gate/RUNNING` (non-blocking flock; an absent file is no gate)."""
+    path = Path(workdir) / "gate" / "RUNNING"
+    if not path.is_file():
+        return []
+    with path.open("r") as fh:
+        try:
+            fcntl.flock(fh, fcntl.LOCK_SH | fcntl.LOCK_NB)
+        except OSError:
+            return [f"a gate is running: {path} is locked"]
+        fcntl.flock(fh, fcntl.LOCK_UN)
+    return []
+
+
+def acquire_sequencer_lock(workdir):
+    """C227: the orchestrator's exclusive non-blocking flock on `$STACK_WORKDIR/p475/SEQUENCER.lock`, held (by the returned
+    file object) for its whole lifetime; a second orchestrator refuses. Returns (fh, problems)."""
+    path = Path(workdir) / "p475" / "SEQUENCER.lock"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fh = open(path, "a+")
+    try:
+        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except OSError:
+        fh.seek(0)
+        holder = fh.read().strip() or "unknown holder"
+        fh.close()
+        return None, [f"another P475 orchestrator holds {path} ({holder})"]
+    fh.seek(0)
+    fh.truncate()
+    fh.write(json.dumps(dict(pid=os.getpid(), started=time.time())) + "\n")
+    fh.flush()
+    return fh, []
+
