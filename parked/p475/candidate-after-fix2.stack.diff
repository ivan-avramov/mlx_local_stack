+    assert path == tmp_path / "benchmark/results/p475/MATRIX.md"
+    text = path.read_text()
+    assert "Legs: 20 harvested of 20 planned — 20 VALID and speed-valid" in text and "PARTIAL" not in text
+    assert "In-process cross-check" in text and "29.50" in text and "31.25" in text      # qualify phase peaks
+    with pytest.raises(K.MatrixRefused):
+        K._write_matrix(tmp_path)
+    assert path.read_text() == text
