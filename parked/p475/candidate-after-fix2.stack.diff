+from bench.capacity_ladder import draft_telemetry_present
+from bench.chain_ops import ChainAbort, ChainOps, argv_flag  # noqa: F401 — ChainAbort is part of this module's surface
+from bench.p426_harvest import HarvestError, Scrub, _publish, _sha
+from bench.p426_leg import power_history_problems
+
+PICKS = {"fable": "Qwen3.8-27B-Fable-Distill-OptiQ-4.5bpw-mixed", "uniform4": "Qwen3.8-27B-mlx-uniform-4bit"}
+ARMS = ("N16", "AF8", "TQ8", "AF4", "TQ4")
+ARM_KV = {
+    "N16": {"kv_bits": 0},
+    "AF8": {"kv_bits": 8, "kv_quant_scheme": "uniform"},
+    "TQ8": {"kv_bits": 8, "kv_quant_scheme": "turboquant"},
+    "AF4": {"kv_bits": 4, "kv_quant_scheme": "uniform"},
+    "TQ4": {"kv_bits": 4, "kv_quant_scheme": "turboquant"},
+}
+GRID = (8192, 131072, 196608, 260096)     # 260,096 = 262,144 - the server's 2,048 minimum output
+SMOKE_GRID = (8192,)
