+def watch_argv(python, root, leg, pid, receipt_dir, rows_path, grid, interval_s=None, create_time=None):
+    rd = Path(receipt_dir)
+    return [python, f"{root}/benchmark/m1/bench_watch.py", "--models", leg.model, "--bench", "capacity_ladder",
+            "--total", str(len(grid)), "--driver-pid", str(pid), "--out", str(rd / f"{leg.name}.watch.log"),
+            "--rows-file", str(rows_path), "--power-receipt", str(rd / f"{leg.name}.power.json"),
+            "--expected-s", ",".join(f"{s:g}" for s in expected_rung_s(leg.arm, grid)),
+            "--flat-escalate", "8", *(["--interval", str(interval_s)] if interval_s else []),
+            *(["--driver-create-time", repr(float(create_time))] if create_time is not None else [])]
+
+
+_TICK = re.compile(r"^===== (\d\d):(\d\d):(\d\d)\s+driver=")
+
+
+def tick_times(log_text):
+    """Seconds since the first tick for every watcher tick header (`===== HH:MM:SS  driver=...`), midnight-safe."""
+    out, prev, offset = [], None, 0
+    for line in (log_text or "").splitlines():
+        m = _TICK.match(line)
+        if not m:
+            continue
+        sod = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3))
+        if prev is not None and sod < prev:
+            offset += 86400
+        prev = sod
+        out.append(sod + offset)
+    return [t - out[0] for t in out]
+
+
+def watch_coverage_problems(watched, span_s, tick_s=TICK_S):
+    """C224 speed validity: the watcher's ticks must cover the leg span at the 5-minute cadence. A gap above 1.5 ticks
+    is a missing tick; so is a last tick more than 1.5 ticks short of the span's end (a hung or killed watcher)."""
+    if not watched:
+        return ["no watcher report"]
+    times = watched.get("tick_times")
+    if times is None:
+        return ["watcher report carries no tick times: coverage of the leg span is unproven"]
+    if not times:
+        return ["watcher logged no tick"]
+    problems = []
+    gaps = [(a, b) for a, b in zip(times, times[1:]) if b - a > 1.5 * tick_s]
+    if gaps:
+        problems.append(f"watcher missed tick(s): gaps above {1.5 * tick_s:.0f} s at {[round(a) for a, _ in gaps]} s")
+    if times[-1] < span_s - 1.5 * tick_s:
+        problems.append(f"watcher ticks end at {times[-1]:.0f} s of a {span_s:.0f} s leg (hung or stopped early)")
+    return problems
+
+
+def make_start_watch(cfg, popen=subprocess.Popen, startup_s=10.0, interval_s=None):
+    """The independent 5-minute daemon (C224), a separate process bound to the driver pid, with its power receipt."""
+    def start(pid, leg, create_time=None):
+        rows = results_dir(cfg, leg) / f"capacity_ladder.{leg.tag}.jsonl"
+        bench_dir = str(Path(cfg.instrument_root) / "benchmark")
+        env = dict(os.environ, PYTHONPATH=os.pathsep.join(p for p in (bench_dir, os.environ.get("PYTHONPATH")) if p))
+        argv = watch_argv(cfg.python, cfg.instrument_root, leg, pid, cfg.receipt_dir, rows, leg.grid, interval_s,
+                          create_time)
+        proc = popen(argv, stdin=subprocess.DEVNULL, start_new_session=True, env=env, cwd=bench_dir)
+        deadline = time.monotonic() + startup_s
+        while time.monotonic() < deadline:
+            if proc.poll() is not None:
+                raise RuntimeError(f"watcher exited at start (rc {proc.returncode})")
+            time.sleep(0.25)
+        power = Path(cfg.receipt_dir) / f"{leg.name}.power.json"
+        log = Path(cfg.receipt_dir) / f"{leg.name}.watch.log"
+
+        def stop():
+            text = log.read_text(errors="replace") if log.exists() else ""
+            # a watcher that left because it saw the driver GONE (its own `DRIVER EXITED` line) did not exit early
+            early = proc.poll() is not None and "DRIVER EXITED" not in text
+            proc.terminate()
+            try:
+                proc.wait(timeout=30)
+            except subprocess.TimeoutExpired:
+                proc.kill()
+            text = log.read_text(errors="replace") if log.exists() else ""
+            times = tick_times(text)
+            return dict(power_failure=json.loads(power.read_text()) if power.exists() else None,
+                        exited_early=early, ticks=len(times), tick_times=times)
+        return stop
+    return start
+
+
+def make_launch_driver(popen=subprocess.Popen):
+    """The capacity driver in its OWN session / process group (pgid == pid), so it can be terminated as a group."""
+    def launch(argv, env, cwd, stdout_path):
+        with open(stdout_path, "ab") as out:
+            return popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
+                         start_new_session=True)
+    return launch
+
+
+def _driver_create_time(pid):
+    """The driver's identity start time (the unadjusted kernel value `ChainOps` records for every process it owns)."""
+    import psutil
+    from bench.proc_guard import start_time
+    return start_time(psutil.Process(int(pid)))
+
+
+def make_stop_driver(term_s=30.0, kill_s=15.0, killpg=os.killpg, sleep=time.sleep, clock=time.monotonic):
+    """terminate -> escalate to kill -> wait -> verify gone, for a driver launched by `make_launch_driver`. Returns the
+    problems ([] = the process and its group are gone)."""
+    def group_alive(pgid):
+        try:
+            killpg(pgid, 0)
+        except ProcessLookupError:
+            return False
+        except PermissionError:
+            return True
+        return True
+
+    def settle(proc, wait_s):
+        deadline = clock() + wait_s
+        while True:
+            proc.poll()                                    # reaps the leader: a zombie still answers signal 0
+            if not group_alive(proc.pid):
+                return True
+            if clock() >= deadline:
+                return False
+            sleep(0.25)
+
+    def stop(proc):
+        if settle(proc, 0):
+            return []
+        steps = []
+        for name, sig, wait_s in (("SIGTERM", signal.SIGTERM, term_s), ("SIGKILL", signal.SIGKILL, kill_s)):
+            try:
+                killpg(proc.pid, sig)
+            except ProcessLookupError:
+                pass
+            steps.append(name)
+            if settle(proc, wait_s):
+                return [f"driver group {proc.pid} did not exit on request: escalated {steps}"] if len(steps) > 1 else []
+        return [f"driver group {proc.pid} is still alive after {steps}"]
+    return stop
+
+
+def make_run_qualify(stop_driver, popen=subprocess.Popen):
+    """qualify.py as a child in its own session; on timeout the whole group is terminated / killed and verified gone."""
+    def run(argv, out_dir, stdout_path, timeout_s):
+        env = {k: v for k, v in strip_kv_env(os.environ).items() if k != "APC_ENABLED"}
+        Path(stdout_path).parent.mkdir(parents=True, exist_ok=True)
+        with open(stdout_path, "ab") as out:
+            proc = popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env,
+                         start_new_session=True)
+            try:
+                return proc.wait(timeout=timeout_s)
+            except BaseException:
+                stop_driver(proc)
+                raise
+    return run
+
