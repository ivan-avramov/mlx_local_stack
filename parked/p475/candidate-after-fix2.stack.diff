+def make_report(rig, observed_arm=None, status="COMPLETED", predictor="off", sha=None, reviewed=None, end_problems=(),
+                template=None, peaks=None):
+    km = K.load_kvmanifest(rig.wt)
+    template = TEMPLATE if template is None else template
+    observed = km.expected_manifest(template, kv_of(km, observed_arm or rig.arm))
+    entry = dict(status=status, arm="mtp_off", reason=None if status == "COMPLETED" else "boom",
+                 record=dict(manifest=observed, template=template,
+                             peaks=peaks or dict(prefill=30e9, decode=31.5e9, retire=None)))
+    return dict(predictor=predictor, registry_sha256=sha or K.hashlib.sha256(registry_text(rig.arm).encode()).hexdigest(),
+                reviewed_head=reviewed or SUBS["src/mlx-vlm"], end_problems=list(end_problems), entries={FABLE: entry},
+                kv_arm=kv_arm_block(rig.arm))
+
+
+def kv_arm_block(arm):
+    """What `qualify.py --kv-arm` records: the entry and `{key: [fixture value, arm value]}` for the keys that differ."""
+    base = yaml.safe_load(registry_text())["models"][0]
+    mine = yaml.safe_load(registry_text(arm))["models"][0]
+    return dict(entry=FABLE, delta={k: [base.get(k), mine.get(k)] for k in K.ARM_KV[arm] if base.get(k) != mine.get(k)})
