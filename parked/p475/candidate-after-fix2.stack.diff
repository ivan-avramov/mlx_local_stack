+# ----------------------------------------------------------------------------------------------- sol 8 / glm 2: teardown
+def killpg_world(killed, group_dies_on):
+    """killpg(pgid, sig): signal 0 asks whether the group lives; it dies on `group_dies_on` ('pids' = once the router pid is
+    dead, 'sigkill' = only after a SIGKILL to the group, None = never)."""
+    state = dict(sent=[], dead=False)
+
+    def killpg(pgid, sig):
+        state["sent"].append((pgid, sig))
+        if sig == signal.SIGKILL and group_dies_on == "sigkill":
+            state["dead"] = True
+        if sig == 0 and (state["dead"] or (group_dies_on == "pids" and 55 in killed)):
+            raise ProcessLookupError(pgid)
+    return killpg, state
+
+
+def loaded_router(ops, tmp_path, group="pids", unload_kills_worker=True):
+    sent, killed = _own_router_ops(ops, tmp_path)
+    ops.killpg, state = killpg_world(killed, group)
+    assert ops.start_router() == 99
+    ops._sh.ps = _worker_ps(PICK1)
+    ops.load(PICK1)
+
+    def http(path, body=None, timeout=900):
+        ops._http_calls.append((path, body))
+        if path.endswith("/unload") and unload_kills_worker:
+            ops._sh.ps = ""
+            killed.add(501)
+        return b"{}"
+    ops._http = http
+    real = ops.create_time
+
+    def create_time(pid):
+        if pid == 501 and 501 in killed:
+            raise ProcessLookupError(pid)
+        return real(pid)
+    ops.create_time = create_time
+    return sent, killed, state
+
+
