+def preflight_rig(tmp_path, arm="TQ8", rc=0, write=True, **report_kw):
+    rig = Rig(tmp_path, arm=arm)
+    rig.qualify_calls = []
+    rig.deps.read_json = lambda p: json.loads(Path(p).read_text())
