+class FakeProc:
+    pid = 4242
+
+    def __init__(self, rc=0, hang=False):
+        self.rc, self.hang = rc, hang
+
+    def wait(self, timeout=None):
+        if self.hang:
+            raise K.subprocess.TimeoutExpired("driver", timeout)
+        return self.rc
+
+
+class Rig:
+    """Everything a leg touches, as recorders."""
+
+    def __init__(self, tmp_path, arm="TQ8", pick="fable", rc=0, power=True, busy=(), listeners=(), rows=None,
+                 log_line=None, cmd=None, draft_kind="off", watch=None, config_sha=None, span=700.0, hang=False,
+                 watch_start_error=None, intervals=(), pmset_problems=(), stop_driver_problems=()):
+        self.tmp, self.events = tmp_path, []
+        self.leg = K.Leg(pick, arm, 1)
+        self.arm = arm
+        self.rows = rows if rows is not None else good_rows()
+        self.rc, self.power, self.busy, self.listeners_ = rc, power, list(busy), list(listeners)
+        self.hang, self.watch_start_error = hang, watch_start_error
+        self.arm_text = registry_text(arm)
+        self.log_line = log_line if log_line is not None else LINE.format(b=8.0, s="turboquant")
+        self.cmd = cmd if cmd is not None else worker_cmd(arm)
+        self.draft_kind = draft_kind
+        self.watch = watch if watch is not None else dict(power_failure=None, exited_early=False, ticks=3,
+                                                          tick_times=[0.0, 300.0, 600.0])
+        self.span, self.mono = span, iter([0.0])
+        self.config_sha = config_sha
+        self.wt = make_worktree(tmp_path)
+        (self.wt / "main_models.yaml").write_text(self.arm_text)
+        self.receipt_dir = tmp_path / "receipts"
+        self.instr = tmp_path / "instr"
+        (self.instr / "benchmark" / "results" / FABLE).mkdir(parents=True)
+        self.launched, self.watched, self.states = [], [], []
+        self.exit_mutation = None                        # fn(ArmInputs) applied to the state read AT EXIT
+        self.intervals, self.pmset_problems = list(intervals), list(pmset_problems)
+        self.stop_driver_problems = list(stop_driver_problems)
+        self.ops = self._ops()
+        self.cfg = K.Config(receipt_dir=self.receipt_dir, workdir=tmp_path / "work", instrument_root=self.instr,
+                            main_root=tmp_path / "main", base_registry_text=registry_text(),
+                            python="/py", timeout_s=60.0, base_commit="b0", production_ref="prod")
+
+        def state(leg):
+            ai = good_inputs(self.arm, leg.pick, worktree=str(self.wt))
+            if self.states and self.exit_mutation:
+                self.exit_mutation(ai)
+            self.states.append(ai)
+            return ai
+        self.deps = K.Deps(
+            ops_for=lambda leg, ai: self.ops, arm_inputs=state,
+            read_text=lambda p: self.arm_text, load_kvmanifest=K.load_kvmanifest,
+            launch_driver=self.launch_driver, start_watch=self.start_watch, read_rows=lambda p: list(self.rows),
+            read_json=self.read_json, read_worker_log=lambda ops, model: self.log_line,
+            lock_check=lambda workdir: [], clock=lambda: "2026-10-25 00:00:00", stop_driver=self.stop_driver,
+            battery_intervals=lambda wt, start, end: (list(self.intervals), list(self.pmset_problems)),
+            monotonic=lambda: next(self.mono, self.span))
+        self.preflighted = {(pick, arm)}
+
+    def _ops(self):
+        rig = self
+        sha = K.hashlib.sha256(self.arm_text.encode()).hexdigest()
+
+        class Ops:
+            router_config_sha = rig.config_sha or sha
+            tmpdir = rig.tmp / "tmp"
+
+            def power_ok(s): rig.events.append("power_ok"); return rig.power
+            def busy_procs(s): rig.events.append("busy"); return rig.busy
+            def listeners(s, port=8000): return rig.listeners_
+            def start_state(s): return {"watts": 140}
+            def start_router(s): rig.events.append("start_router"); return 77
+            def load(s, model):
+                rig.events.append("load")
+                return {"pid": 9, "create_time": 1.0, "cmdline": rig.cmd}
+            def env_base(s): return {"MLX_SERVE_CONFIG": str(rig.wt / "main_models.yaml"), "APC_ENABLED": "1"}
+            def router_ok(s): return True
+            def worker_ident(s, model): return {"pid": 9, "create_time": 1.0}
+            def stop_stack(s): rig.events.append("stop_stack"); return 0
+        return Ops()
+
+    def launch_driver(self, argv, env, cwd, stdout_path):
+        self.events.append("launch_driver")
+        self.launched.append((argv, env, cwd))
+        return FakeProc(self.rc, self.hang)
+
+    def stop_driver(self, proc):
+        self.events.append("stop_driver")
+        return list(self.stop_driver_problems)
+
+    def start_watch(self, pid, leg):
+        self.events.append("start_watch")
+        if self.watch_start_error:
+            raise RuntimeError(self.watch_start_error)
+        self.watched.append(pid)
+        return lambda: (self.events.append("stop_watch"), self.watch)[1]
+
+    def read_json(self, path):
+        return {"runtime": {"draft_kind": self.draft_kind}}
+
+    def run(self):
+        return K.run_leg(self.leg, self.cfg, self.deps, preflighted=self.preflighted)
+
