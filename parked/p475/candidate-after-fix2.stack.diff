+def test_the_run_preflights_each_arm_before_its_first_leg_with_idle_around_it():
+    s = Seq()
+    done, order = set(), []
+
+    def preflight(pick, arm, first):
+        order.append(("pf", arm, first.name, s.now - s.last_end))
+        s.now += 900                                           # qualify is a hot 256K run
+        s.last_end = s.now
+        done.add((pick, arm))
+        return dict(ok=True, problems=[])
+    orig = s.do_leg
+    s.do_leg = lambda leg: (order.append(("leg", leg.name, sorted(done))) or orig(leg))
+    assert s.run(preflight=preflight, is_preflighted=lambda p, a: (p, a) in done) == 0
+    pfs = [o for o in order if o[0] == "pf"]
+    assert [o[1] for o in pfs] == list(K.ARMS) and [o[2] for o in pfs] == [f"fable-{a}-b1" for a in K.ARMS]
+    assert all(o[3] >= 600 for o in pfs)                       # idle before a preflight too
+    first_leg = next(o for o in order if o[0] == "leg")
+    assert len(first_leg[2]) == 5                              # every arm of the pick preflighted before its first leg
+    gaps = [x[2] for x in s.sleeps if isinstance(x, tuple)]
+    assert all(g >= 600 for g in gaps)                         # and 600 s after the last preflight
