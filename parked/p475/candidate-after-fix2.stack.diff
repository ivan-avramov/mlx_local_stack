+    def run_qualify(argv, out, stdout_path, timeout_s):
+        rig.qualify_calls.append((argv, out, timeout_s))
+        out.mkdir(parents=True, exist_ok=True)
+        if write:
+            (out / "report.json").write_text(json.dumps(make_report(rig, **report_kw)))
+            (out / "monitor.log").write_text("tick\n")
+        return rc
+    rig.deps.run_qualify = run_qualify
+    return rig
