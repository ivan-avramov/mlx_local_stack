+def good_rows(peaks=(30.0, 33.0, 36.0, 40.0), prefill=500.0, decode=50.0, grid=K.GRID):
+    return [{"ctx": ctx, "execution_status": "completed", "p475_valid": True, "invalid_reasons": [], "draft": None,
+             "peak_memory_gb_cumulative": p, "prompt_per_second": prefill, "predicted_per_second": decode,
+             "cache_n": 0, "session_id": f"s{i}", "completion_tokens": 256, "finish_reason": "length"}
+            for i, (ctx, p) in enumerate(zip(grid, peaks))]
