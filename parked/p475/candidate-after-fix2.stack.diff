+# ----------------------------------------------------------------------------------------------- finding 6: driver lifecycle
+def spawn(code):
+    """(process in its own session, the pid its `ready <pid>` line names — a grandchild — or None)."""
+    proc = subprocess.Popen([sys.executable, "-u", "-c", code], stdout=subprocess.PIPE, text=True, start_new_session=True)
+    line = proc.stdout.readline().split()
+    assert line and line[0] == "ready"
+    return proc, (int(line[1]) if len(line) > 1 else None)
+
+
+def gone(pid):
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return True
+    return False
+
+
