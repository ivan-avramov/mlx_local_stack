diff --git a/benchmark/bench/tests/test_p475_bench_watch.py b/benchmark/bench/tests/test_p475_bench_watch.py
new file mode 100644
index 00000000..217ad610
--- /dev/null
+++ b/benchmark/bench/tests/test_p475_bench_watch.py
@@ -0,0 +1,55 @@
+"""P475: the watcher's capacity mode. Capacity rows carry `elapsed_s` (not `wall_s`); with the expected rung durations the
+RATE / ETA section compares the observed rate to the prediction. Rows with `wall_s` keep the old behaviour."""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "m1"))
+import bench_watch as W  # noqa: E402
+
+
+def cap_row(ctx, elapsed):
+    return {"ctx": ctx, "execution_status": "completed", "elapsed_s": elapsed, "retrieval_acc": None}
+
+
+def write_rows(tmp_path, rows):
+    p = tmp_path / "rows.jsonl"
+    p.write_text("".join(json.dumps(r) + "\n" for r in rows))
+    return p
+
+
+def assess(tmp_path, rows, **kw):
+    return W.assess("M", "capacity_ladder", 4, None, 0, [], rows_file=write_rows(tmp_path, rows), **kw)[0]
+
+
+def test_capacity_rows_with_elapsed_s_get_a_rate_and_eta_section(tmp_path):
+    rep = assess(tmp_path, [cap_row(8192, 60.0), cap_row(131072, 600.0)])
+    assert "2 RATE" in rep and "mean 330.0s/item" in rep and "ETA" in rep
+
+
+def test_wall_s_still_wins_over_elapsed_s(tmp_path):
+    rep = assess(tmp_path, [{"wall_s": 10.0, "elapsed_s": 999.0}])
+    assert "mean 10.0s/item" in rep
+
+
+def test_expected_durations_give_a_prediction_based_eta_and_ratio(tmp_path):
+    rep = assess(tmp_path, [cap_row(8192, 120.0), cap_row(131072, 1200.0)], expected_s=[60.0, 600.0, 900.0, 1200.0])
+    assert "x2.00 of predicted" in rep
+    assert "ETA 1.2h" in rep            # (900 + 1200) * 2.0 s = 4200 s
+    assert "SLOWER" in rep
+
+
+def test_a_run_on_prediction_is_not_flagged(tmp_path):
+    rep = assess(tmp_path, [cap_row(8192, 60.0), cap_row(131072, 610.0)], expected_s=[60.0, 600.0, 900.0, 1200.0])
+    assert "x1.02 of predicted" in rep and "SLOWER" not in rep and "FASTER" not in rep
+
+
+def test_without_expected_durations_the_output_is_unchanged(tmp_path):
+    rep = assess(tmp_path, [{"wall_s": 20.0}, {"wall_s": 30.0}])
+    assert "predicted" not in rep and "mean 25.0s/item" in rep
+
+
+def test_cli_accepts_a_comma_list_of_expected_durations_and_defaults_to_none():
+    base = ["--models", "M", "--bench", "capacity_ladder", "--total", "4", "--driver-pid", "1", "--out", "o"]
+    assert W._parse_args(base).expected_s is None
+    assert W._parse_args(base + ["--expected-s", "60,600.5"]).expected_s == [60.0, 600.5]
diff --git a/benchmark/bench/tests/test_p475_capacity_strict.py b/benchmark/bench/tests/test_p475_capacity_strict.py
new file mode 100644
index 00000000..baddc788
--- /dev/null
+++ b/benchmark/bench/tests/test_p475_capacity_strict.py
@@ -0,0 +1,199 @@
+"""P475 stage 1: the capacity-instrument extensions (backend timings, cache_n == 0, exact-length decode carrier,
+cumulative-high-water memory). The strictness is opt-in; the default path keeps today's rows."""
+import json
+import os
+
+import pytest
+
+import bench.capacity_ladder as L
+import bench.driver as D
+import bench.run_capacity as R
+
+
+def _timings(**over):
+    t = dict(prompt_n=1000, cache_n=0, prompt_ms=2000.0, prompt_per_second=500.0, predicted_n=256,
+             predicted_ms=5000.0, predicted_per_second=51.2, peak_memory=30.0)
+    t.update(over)
+    return t
+
+
+class StrictDriver:
+    """Scripted per-rung responses: a decode carrier that runs to the cap with backend timings."""
+
+    def __init__(self, peaks=(30.0, 33.0, 36.0, 40.0), **over):
+        self.peaks, self.over, self.calls, self.n = list(peaks), over, [], 0
+
+    def complete(self, model, messages, params, timeout=3600):
+        self.calls.append((messages, params))
+        out = {"content": "1 2 3", "reasoning": "", "prompt_tokens": 1000, "completion_tokens": 256,
+               "finish_reason": "length", "prefill_s": 2.0, "prefill_tps": 500, "decode_tps": 51.2,
+               "peak_mem_gb": self.peaks[self.n], "session_id": f"p475-x-{self.n:04d}",
+               "raw_timings": _timings(peak_memory=self.peaks[self.n])}
+        for k, v in self.over.items():
+            if k in ("prompt_n", "cache_n", "prompt_ms", "prompt_per_second", "predicted_per_second"):
+                out["raw_timings"][k] = v
+            else:
+                out[k] = v
+        self.n += 1
+        return out
+
+
+class FakeSampler:
+    def __init__(self, **kw): pass
+    def __enter__(self): return self
+    def __exit__(self, *a): pass
+    peak_rss_gb = 20.0
+    system_peak_gb = 25.0
+
+
+def _ladder(driver, strict=True, grid=(8192, 16384), **kw):
+    return L.run_ladder(driver, "m", chars_per_token=4.0, idle_baseline_gb=0.0, model_pid=1,
+                        params={"max_tokens": 256}, grid=grid, sampler_factory=FakeSampler,
+                        strict_p475=strict, **kw)
+
+
+# ---- driver: the backend block reaches the ladder untouched (its key set is pinned by test_conftest_fakes)
+def test_driver_passes_the_backend_timings_block_through_and_keeps_the_old_derivation(monkeypatch):
+    raw = _timings()
+    monkeypatch.setattr(D.client, "probe", lambda *a, **k: dict(
+        content="x", reasoning="", tool_calls=[], prompt_tokens=1000, completion_tokens=256, decode_tps=51.2,
+        peak_mem_gb=30.0, wall_s=9.0, finish_reason="length", raw_timings=raw, session_id="s1"))
+    out = D.MlxServeDriver().complete("m", [], {})
+    for k in ("prompt_ms", "prompt_per_second", "prompt_n", "cache_n", "predicted_per_second"):
+        assert out["raw_timings"][k] == raw[k]
+    assert out["session_id"] == "s1"
+    assert out["prefill_s"] == round(9.0 - 5.0, 2) and out["decode_tps"] == 51.2   # today's derivation, unchanged
+
+
+# ---- ladder: strict rows
+def test_strict_rows_persist_backend_timings_and_cumulative_memory():
+    recs = _ladder(StrictDriver())
+    r = recs[0]
+    assert r["execution_status"] == "completed" and r["p475_valid"] is True and r["invalid_reasons"] == []
+    assert (r["prompt_ms"], r["prompt_per_second"], r["prompt_n"], r["cache_n"]) == (2000.0, 500.0, 1000, 0)
+    assert r["predicted_per_second"] == 51.2 and r["session_id"] == "p475-x-0000"
+    assert r["peak_memory_gb_cumulative"] == 30.0 and r["memory_semantics"] == "worker_cumulative_high_water"
+    assert r["server_peak_gb"] == 30.0                  # the old field keeps its meaning
+    assert recs[1]["peak_memory_gb_cumulative"] == 33.0
+
+
+def test_strict_request_is_the_fixed_carrier_not_the_retrieval_question():
+    d = StrictDriver()
+    recs = _ladder(d, grid=(8192,))
+    prompt = d.calls[0][0][-1]["content"]
+    assert L.CARRIER_INSTRUCTION in prompt and recs[0]["retrieval_acc"] is None
+
+
+@pytest.mark.parametrize("over,reason", [
+    ({"cache_n": 512}, "cache_n"),
+    ({"cache_n": None}, "cache_n"),
+    ({"completion_tokens": 255}, "completion_tokens"),
+    ({"completion_tokens": 257}, "completion_tokens"),
+    ({"finish_reason": "stop"}, "finish_reason"),
+    ({"prompt_ms": None}, "prompt_ms"),
+    ({"prompt_per_second": None}, "prompt_per_second"),
+    ({"predicted_per_second": None}, "predicted_per_second"),
+    ({"prompt_n": None}, "prompt_n"),
+    ({"session_id": None}, "session_id"),
+])
+def test_strict_rung_is_invalid_and_stops_the_ladder(over, reason):
