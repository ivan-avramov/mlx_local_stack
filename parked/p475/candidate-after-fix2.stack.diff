+# ----------------------------------------------------------------------------------------------- sol 3: the interval
+def test_the_measurement_interval_runs_from_driver_launch_to_driver_completion(tmp_path):
+    rig = Rig(tmp_path)
+    stamps = iter([1000.0, 1900.0, 5000.0])
+    rig.deps.epoch = lambda: (rig.events.append("epoch"), next(stamps))[1]
+    seen = []
+    rig.deps.battery_intervals = lambda wt, a, b: (seen.append((a, b)), ([], []))[1]
+    r = rig.run()
+    assert r["verdict"] == "VALID" and seen == [(1000.0, 1900.0)]          # not load, not teardown
+    ev = rig.events
