+def expected_rung_s(arm, grid):
+    """The watcher's expected seconds per rung: the spec's per-arm leg estimate, split by each rung's share of the full
+    grid's prompt tokens (prefill dominates; the 256-token decode carrier is small)."""
+    total = sum(GRID)
+    return [round(EXPECTED_LEG_MIN[arm] * 60.0 * ctx / total, 1) for ctx in grid]
