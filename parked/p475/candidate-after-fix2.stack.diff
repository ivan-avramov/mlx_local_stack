+# ----------------------------------------------------------------------------------------------- rows -> metrics
+def metrics_from_rows(rows):
+    return {r["ctx"]: dict(peak_gb=r.get("peak_memory_gb_cumulative"), prefill_tps=r.get("prompt_per_second"),
+                           decode_tps=r.get("predicted_per_second"))
+            for r in rows if r.get("p475_valid")}
