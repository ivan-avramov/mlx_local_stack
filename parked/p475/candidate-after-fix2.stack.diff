+def _driver_alive(pid: int, create_time: float | None = None) -> bool:
+    """P475: liveness of THE driver. With `create_time` (the start time the launcher recorded) a recycled pid is a different
+    process: gone. Without it, or when the identity cannot be read, the pid-existence check of `_pid_alive` stands."""
