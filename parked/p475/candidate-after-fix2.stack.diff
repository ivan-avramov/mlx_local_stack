+        return SMOKE_GRID if self.block == "smoke" else GRID
+
+
+def block_arms(block):
+    """Block 1 (and the deciding block 3) N16 -> TQ4, block 2 the reverse (ABBA)."""
+    return tuple(reversed(ARMS)) if block == 2 else ARMS
+
+
+def schedule(picks=tuple(PICKS), blocks=(1, 2)):
+    return [Leg(pick, arm, block) for pick in picks for block in blocks for arm in block_arms(block)]
+
+
+def arm_branch(pick, arm):
+    return f"p475-{pick}-{arm}"
+
+
+@dataclass
+class ArmInputs:
+    """One arm's identity as read from the worktree's own git (`git_arm_state`), never from an input file; this module
+    creates neither a commit nor a worktree."""
+    worktree: str
+    branch: str
+    head: str
+    base: str                              # `git merge-base HEAD <pinned base>`
+    parent: str                            # the parent of `head`
+    clean: bool
+    changed_files: list                    # `git diff --name-only <pinned base> HEAD`
+    ahead: int | None = None               # commits `head` is ahead of the pinned base
+    submodules: dict = field(default_factory=dict)         # gitlinks of HEAD's tree: path -> commit
+    base_submodules: dict = field(default_factory=dict)    # gitlinks of the pinned base's tree
+    checked_out: dict = field(default_factory=dict)        # `git rev-parse HEAD` inside each checked-out submodule
+    registry_text: str = ""                # `main_models.yaml` as committed at HEAD
+
+    def identity(self):
+        """What must not change between a leg's entry and exit (and goes into the receipt)."""
+        return dict(head=self.head, parent=self.parent, branch=self.branch, base=self.base, clean=self.clean,
+                    ahead=self.ahead, changed_files=list(self.changed_files), submodules=dict(self.submodules),
+                    base_submodules=dict(self.base_submodules), checked_out=dict(self.checked_out),
+                    registry_sha256=hashlib.sha256(self.registry_text.encode()).hexdigest())
+
+
+@dataclass
