+
+def arm_problems(leg, ai, base_text, arm_text):
+    """The arm commit / worktree / registry: only the pick's KV keys differ from the base, to exactly the arm's values."""
+    import yaml
+
+    problems = []
+    base_arm = ai.head == ai.base                     # the arm equal to the committed registry uses the base commit
+    if not ai.clean:
+        problems.append("arm worktree is dirty")
+    if not base_arm:
+        if ai.branch != arm_branch(leg.pick, leg.arm):
+            problems.append(f"branch {ai.branch!r} != {arm_branch(leg.pick, leg.arm)!r}")
+        if ai.parent != ai.base:
+            problems.append(f"arm commit parent {ai.parent!r} != the base commit {ai.base!r}")
+        if list(ai.changed_files) != ["main_models.yaml"]:
+            problems.append(f"changed files {list(ai.changed_files)} != ['main_models.yaml']")
+        if "PROVISIONAL P475 arm" not in arm_text:
+            problems.append("the arm commit lacks the `PROVISIONAL P475 arm` comment")
+    try:
+        base, arm = yaml.safe_load(base_text), yaml.safe_load(arm_text)
+    except yaml.YAMLError as exc:
+        return problems + [f"registry unreadable: {exc}"]
+    be, ae = _entry(base, leg.model), _entry(arm, leg.model)
+    if be is None or ae is None:
+        return problems + [f"{leg.model}: not in the base / arm registry"]
+    want = ARM_KV[leg.arm]
+    for key, value in want.items():
+        if ae.get(key) != value:
+            problems.append(f"{key} {ae.get(key)!r} != {value!r} (arm {leg.arm})")
+    if ae.get("quantized_kv_start") != 0:
+        problems.append(f"quantized_kv_start {ae.get('quantized_kv_start')!r} != 0")
+    if any(k.startswith("draft") for k in ae):
+        problems.append("the arm registry entry enables a predictor (draft_*)")
+    strip = lambda e: {k: v for k, v in e.items() if k not in want}      # noqa: E731
+    if strip(be) != strip(ae):
+        changed = sorted(k for k in set(be) | set(ae) if k not in want and be.get(k) != ae.get(k))
+        problems.append(f"the entry differs from the base beyond the KV keys: {changed}")
+    others = lambda d: {**{k: v for k, v in d.items() if k != "models"},      # noqa: E731
+                        "models": [m for m in d.get("models") or [] if m.get("name") != leg.model]}
+    if others(base) != others(arm):
+        problems.append("the registry differs from the base outside the pick's entry")
+    return problems
+
+
+class GitError(RuntimeError):
+    pass
+
+
+def run_git(cwd, *args, timeout=120):
+    got = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True, timeout=timeout)
+    if got.returncode != 0:
+        raise GitError(f"git {' '.join(args)} (in {cwd}) exited {got.returncode}: {got.stderr.strip()[:300]}")
+    return got.stdout
+
+
+def _gitlinks(git, cwd, rev):
+    """{path: commit} of the submodule gitlinks (mode 160000) of `rev`'s tree, for the SUBMODULES paths."""
+    out = {}
+    for line in git(cwd, "ls-tree", rev, "--", *SUBMODULES).splitlines():
+        meta, _, path = line.partition("\t")
+        mode, kind, sha = meta.split()
+        if mode == "160000" and kind == "commit":
+            out[path] = sha
+    return out
+
+
+def git_arm_state(git, worktree, pinned_base):
+    """The arm's identity read from the worktree's own git, now: its commit, parent, diff vs the pinned base, cleanliness
+    (tracked, untracked and submodule state) and the submodule commits (gitlinks and what is checked out)."""
+    wt = str(worktree)
+    head = git(wt, "rev-parse", "HEAD").strip()
+    try:
+        parent = git(wt, "rev-parse", "HEAD^").strip()
+    except GitError:
+        parent = ""
+    checked = {}
+    for path in SUBMODULES:
+        try:
+            checked[path] = git(Path(wt) / path, "rev-parse", "HEAD").strip()
+        except (GitError, OSError):
+            checked[path] = ""
+    return ArmInputs(
+        worktree=wt, branch=git(wt, "branch", "--show-current").strip(), head=head,
+        base=git(wt, "merge-base", "HEAD", pinned_base).strip(), parent=parent,
+        clean=not git(wt, "status", "--porcelain=v1", "--untracked-files=all", "--ignore-submodules=none").strip(),
+        changed_files=[ln for ln in git(wt, "diff", "--name-only", pinned_base, "HEAD").splitlines() if ln],
+        ahead=int(git(wt, "rev-list", "--count", f"{pinned_base}..HEAD").strip()),
+        submodules=_gitlinks(git, wt, "HEAD"), base_submodules=_gitlinks(git, wt, pinned_base), checked_out=checked,
+        registry_text=git(wt, "show", "HEAD:main_models.yaml"))
+
+
+def identity_problems(ai, pinned_base, base_arm_expected=None):
+    """What the worktree's git must show: one common pinned base, the arm exactly one commit on it (none for the arm equal to
+    the committed registry), and the `src/mlx-vlm` / `src/mlx-serve` gitlinks equal to the base's and actually checked out."""
+    problems = []
+    if not pinned_base:
+        problems.append("no pinned base commit: the arm cannot be tied to the common base")
+    elif ai.base != pinned_base:
+        problems.append(f"arm merge-base {ai.base!r} != the pinned base {pinned_base!r}")
+    want_ahead = 0 if ai.head == ai.base else 1
+    if ai.ahead != want_ahead:
+        problems.append(f"arm is {ai.ahead} commit(s) ahead of the base, expected {want_ahead}")
+    if set(ai.submodules) != set(SUBMODULES) or set(ai.base_submodules) != set(SUBMODULES):
+        problems.append(f"submodule gitlinks {sorted(ai.submodules)} / base {sorted(ai.base_submodules)} != {list(SUBMODULES)}")
+    elif ai.submodules != ai.base_submodules:
+        problems.append(f"submodule gitlinks differ from the base's: {ai.submodules} vs {ai.base_submodules}")
+    if ai.checked_out != ai.submodules:
+        problems.append(f"checked-out submodule commits {ai.checked_out} != the gitlinks {ai.submodules}")
+    if not ai.registry_text:
+        problems.append("the committed main_models.yaml was not read from git")
+    return problems
+
+
+def identity_drift(entry, exit_):
+    return [f"arm identity drifted during the leg: {k} {entry.get(k)!r} -> {exit_.get(k)!r}"
+            for k in sorted(set(entry) | set(exit_)) if entry.get(k) != exit_.get(k)]
+
+
+def expected_kv_argv(entry):
+    """The KV flags mlx-serve emits for a registry entry (`process_manager._build_command`): flag -> values."""
+    bits = entry.get("kv_bits") or 0
+    return {"--kv-bits": [str(bits)] if bits > 0 else [],
+            "--kv-quant-scheme": [entry["kv_quant_scheme"]] if entry.get("kv_quant_scheme") else [],
+            "--quantized-kv-start": [str(int(entry.get("quantized_kv_start") or 0))]}
+
+
+def worker_argv_problems(cmdline, entry):
+    toks = cmdline.split()
+    problems = []
+    for flag, want in expected_kv_argv(entry).items():
+        got = argv_flag(toks, flag)
+        same = len(got) == len(want) and all(
+            (float(g) == float(w)) if flag == "--kv-bits" and g is not None else g == w for g, w in zip(got, want))
+        if not same:
+            problems.append(f"kv flag {flag} {got} != {want} (worker argv)")
+    return problems
+
+
+_KV_ENV_PREFIXES = ("KV_", "TQ_")                       # every `KV_*` / `TQ_*` the fork's server and kernels read
+_KV_ENV_NAMES = ("QUANTIZED_KV_START", "MAX_KV_SIZE")   # the KV-sizing overrides that do not carry the prefix
+_KV_ENV_RE = re.compile(r"(?<![A-Za-z0-9_])((?:KV|TQ)_[A-Z0-9_]*|QUANTIZED_KV_START|MAX_KV_SIZE)=")
+
+
+def is_kv_env(name):
+    return name.startswith(_KV_ENV_PREFIXES) or name in _KV_ENV_NAMES
+
+
+def strip_kv_env(env):
+    """`env` without any KV-related override (split key / value bits and schemes, group size, `TQ_*` incl. the TurboQuant
+    mode, `QUANTIZED_KV_START`, `MAX_KV_SIZE`, any `KV_*`): the arm's KV format comes from the committed registry ONLY."""
+    return {k: v for k, v in env.items() if not is_kv_env(k)}
+
+
+def kv_env_problems(env_text, who):
+    """KV override names visible in a process's `ps -E` environment text (names only, never values)."""
+    names = sorted(set(_KV_ENV_RE.findall(env_text or "")))
+    return [f"{who} environment carries KV override(s) {names}"] if names else []
+
+
+class KvArmOps(ChainOps):
+    """`ChainOps` whose router environment (and so the worker's, and the driver's `env_base()`) carries no KV override."""
+
+    def env_base(self):
+        return strip_kv_env(super().env_base())
+
+
+def _kv_number(text):
+    """A logged numeric field: float, or None for `None`; raises ValueError for anything else."""
+    return None if text in (None, "None") else float(text)
+
+
+def kv_line_problems(log_text, entry):
+    """The worker log's (last) `KV cache resolved:` line must agree with the arm in EVERY field — the secondary record:
+    `kv_bits`, the split `kv_key_bits` / `kv_value_bits` / `kv_key_scheme` / `kv_value_scheme` (none in a P475 arm),
+    `kv_quant_scheme`, `kv_group_size`, `quantized_kv_start` and the TurboQuant mode `TQ_KV_QUANT_MODE`. A field the line
+    does not carry (but `quantized_kv_start`, read as 0 when omitted) is a problem."""
+    all_lines = log_text if isinstance(log_text, (list, tuple)) else (log_text or "").splitlines()
+    lines = [ln for ln in all_lines if "KV cache resolved:" in ln]
+    if not lines:
+        return ["no `KV cache resolved:` line in the worker log"]
+    got = {k: v.strip("'\"") for k, v in re.findall(r"(\w+)=('[^']*'|\"[^\"]*\"|\S+)", lines[-1])}
+    problems = []
+
+    def numeric(field, want):
+        if field not in got:
+            problems.append(f"KV cache resolved: {field} missing from the line")
+            return
+        try:
+            seen = _kv_number(got[field])
+        except ValueError:
+            problems.append(f"KV cache resolved: {field}={got[field]} is not a number")
+            return
+        if seen != (None if want is None else float(want)):
+            problems.append(f"KV cache resolved: {field}={got[field]} != {want}")
+
+    bits = entry.get("kv_bits") or 0
+    if "kv_bits" not in got:
+        problems.append("KV cache resolved: kv_bits missing from the line")
+    else:
+        seen = got["kv_bits"]
+        native = seen in ("None", "0", "0.0")
+        try:
+            if bits > 0 and (native or float(seen) != float(bits)):
+                problems.append(f"KV cache resolved: kv_bits={seen} != {bits}")
+            elif not bits and not native:
+                problems.append(f"KV cache resolved: kv_bits={seen} != native16")
+        except ValueError:
+            problems.append(f"KV cache resolved: kv_bits={seen} is not a number")
+    for field in ("kv_key_bits", "kv_value_bits"):
+        numeric(field, entry.get(field))
+    for field in ("kv_key_scheme", "kv_value_scheme"):
+        if field not in got:
+            problems.append(f"KV cache resolved: {field} missing from the line")
+        elif got[field] != str(entry.get(field)):
+            problems.append(f"KV cache resolved: {field}={got[field]} != {entry.get(field)}")
+    want_scheme = entry.get("kv_quant_scheme") or DEFAULT_KV_QUANT_SCHEME
+    if got.get("kv_quant_scheme") != want_scheme:
+        problems.append(f"KV cache resolved: kv_quant_scheme={got.get('kv_quant_scheme')} != {want_scheme}")
+    numeric("kv_group_size", entry.get("kv_group_size") or DEFAULT_KV_GROUP_SIZE)
+    want_start = float(entry.get("quantized_kv_start") or 0)
+    try:
+        seen_start = float(got.get("quantized_kv_start") or 0)       # numeric: `0`, `0.0` and an omitted field are all 0
+    except ValueError:
+        seen_start = None
+    if seen_start != want_start:
+        problems.append(f"KV cache resolved: quantized_kv_start={got.get('quantized_kv_start')} != {want_start:g}")
+    want_mode = str(entry.get("kv_quant_mode") or DEFAULT_TQ_MODE).lower()
+    if "TQ_KV_QUANT_MODE" not in got:
+        problems.append("KV cache resolved: TQ_KV_QUANT_MODE missing from the line")
+    elif got["TQ_KV_QUANT_MODE"].lower() != want_mode:
+        problems.append(f"KV cache resolved: TQ_KV_QUANT_MODE={got['TQ_KV_QUANT_MODE']} != {want_mode}")
+    return problems
+
+
+def wait_kv_line(read_log, entry, *, sleep=time.sleep, clock=time.monotonic, wait_s=KV_LINE_WAIT_S, poll_s=KV_LINE_POLL_S):
+    """The worker logs `KV cache resolved:` while it sets its cache up, which can trail the worker's appearance in `ps`:
+    poll the log (bounded) until the line exists, then judge it. No line after `wait_s` is the refusal."""
+    deadline = clock() + wait_s
+    while True:
+        text = read_log()
+        if any("KV cache resolved:" in ln for ln in (text if isinstance(text, (list, tuple)) else (text or "").splitlines())):
+            return kv_line_problems(text, entry)
+        if clock() >= deadline:
+            return kv_line_problems(text, entry)
+        sleep(poll_s)
+
+
+def predictor_argv_problems(cmdline):
+    """No `--draft-kind` / `--draft-model` in the worker argv (known right after load, before the driver launches)."""
+    toks = cmdline.split()
+    return [f"draft: {flag} in the worker argv" for flag in ("--draft-kind", "--draft-model") if argv_flag(toks, flag)]
+
+
+def predictor_record_problems(manifest, rows):
+    """The manifest's `runtime.draft_kind` observed null (provenance writes an absent entry as "off") and no draft
+    telemetry on any request record (`draft_telemetry_present`: a non-null `draft_*` key, the structured `draft` field)."""
+    problems = []
+    runtime = (manifest or {}).get("runtime")
+    if not isinstance(runtime, dict) or "draft_kind" not in runtime:
+        problems.append("draft: the manifest's runtime.draft_kind is not observed")
+    elif runtime["draft_kind"] not in OFF_VALUES:
+        problems.append(f"draft: manifest runtime.draft_kind {runtime['draft_kind']!r}")
+    for row in rows or []:
+        if row.get("draft") or draft_telemetry_present(row) or draft_telemetry_present(row.get("raw_timings")):
+            problems.append(f"draft: fields on the request record at ctx {row.get('ctx')}")
+    return problems
+
+
+def predictor_off_problems(cmdline, manifest, rows):
+    """Predictor-OFF proof: the argv part, the manifest part and the request-record part."""
+    return predictor_argv_problems(cmdline) + predictor_record_problems(manifest, rows)
+
+
+# ----------------------------------------------------------------------------------------------- manifest preflight
+def load_kvmanifest(worktree):
+    """The arm worktree's OWN `src/mlx-vlm/dev/p369_phase2/kvmanifest.py`, loaded from that file path under a unique name
+    (as `bench.p426_overlay.load_registry_states` does) — never a module cached from another checkout."""
+    path = (Path(worktree) / "src" / "mlx-vlm" / "dev" / "p369_phase2" / "kvmanifest.py").resolve()
+    if not path.is_file():
+        raise RuntimeError(f"{path}: no kvmanifest in the arm worktree")
+    name = "p475_kvmanifest_" + hashlib.sha256(str(path).encode()).hexdigest()[:12]
+    spec = importlib.util.spec_from_file_location(name, path)
+    km = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(km)
+    if Path(km.__file__).resolve() != path:
+        raise RuntimeError(f"loaded {km.__file__}, wanted {path}")
+    missing = [n for n in ("kv_from_argv", "manifest", "manifest_problems", "expected_manifest") if not hasattr(km, n)]
+    if missing:
+        raise RuntimeError(f"{path}: kvmanifest lacks {missing}")
+    return km
+
+
+# ----------------------------------------------------------------------------------------------- live engagement preflight
+def qualify_argv(worktree, model, fork_sha, production_ref, out):
+    """The fork's reviewed in-process R7 tool, run from the ARM WORKTREE with its own fork venv, predictor OFF, in its
+    `--kv-arm` mode (P475a: a registry that differs from an accepted state in exactly the one entry's KV-format keys)."""
+    fork = Path(worktree) / "src" / "mlx-vlm"
+    return [str(fork / ".venv" / "bin" / "python"), str(fork / "dev" / "p369_phase2" / "qualify.py"),
+            "--stack-root", str(worktree), "--fork-root", str(fork), "--entry", model, "--predictor", "off", "--kv-arm",
+            "--reviewed-head", fork_sha, "--production-ref", production_ref, "--out", str(out)]
+
+
+def kv_arm_report_problems(report, model, entry):
+    """P475a: qualify's `kv_arm: {entry, delta}` must name this entry and its `delta` ({key: [fixture value, arm value]})
+    may hold only the arm's own KV keys, each with the arm registry's value (= the arm's: `arm_problems` pins that)."""
+    kv_arm = (report or {}).get("kv_arm")
+    if not isinstance(kv_arm, dict):
+        return ["qualify report carries no kv_arm (the report is not from `qualify.py --kv-arm`)"]
+    problems = []
+    if kv_arm.get("entry") != model:
+        problems.append(f"qualify kv_arm entry {kv_arm.get('entry')!r} != {model!r}")
+    delta = kv_arm.get("delta")
+    if not isinstance(delta, dict):
+        return problems + [f"qualify kv_arm delta {delta!r} is not a mapping"]
+    for key, pair in delta.items():
+        if key not in ("kv_bits", "kv_quant_scheme"):
+            problems.append(f"qualify kv_arm delta carries {key!r}, which is not a KV-format key")
+        elif not (isinstance(pair, (list, tuple)) and len(pair) == 2):
+            problems.append(f"qualify kv_arm delta[{key!r}] = {pair!r} is not a [fixture, arm] pair")
+        elif pair[1] != entry.get(key):
+            problems.append(f"qualify kv_arm delta[{key!r}] arm value {pair[1]!r} != the arm's {entry.get(key)!r}")
+    return problems
+
+
+def _kv_leaves(manifest):
+    return [m for m in manifest or [] if m.get("kind") in ("tq", "affine", "native")]
+
+
+def qualify_report_problems(report, model, entry, km, registry_sha, fork_sha):
+    """The arm passes only if qualify's report says the entry COMPLETED, predictor OFF, on this registry and this reviewed
+    head, with the EXACT per-layer cache manifest for the arm's KV config (the worktree's own `kvmanifest`)."""
+    if not isinstance(report, dict):
+        return ["qualify report is unreadable"]
+    state = (report.get("entries") or {}).get(model)
+    if not state:
+        return [f"qualify report has no entry for {model}"]
+    problems = []          # (the `kv_arm` delta is judged by `run_preflight` via `kv_arm_report_problems`)
+    if state.get("status") != "COMPLETED":
+        problems.append(f"qualify entry status {state.get('status')!r}: "
+                        f"{state.get('reason') or '; '.join(map(str, state.get('problems') or []))[:400]}")
+    if report.get("predictor") != "off" or state.get("arm") not in ("mtp_off", "served"):
+        problems.append(f"qualify ran predictor {report.get('predictor')!r} / arm {state.get('arm')!r}, not predictor OFF")
+    if report.get("registry_sha256") != registry_sha:
+        problems.append(f"qualify served registry {report.get('registry_sha256')} != the arm's {registry_sha}")
+    if report.get("reviewed_head") != fork_sha:
+        problems.append(f"qualify reviewed head {report.get('reviewed_head')} != the arm's fork gitlink {fork_sha}")
+    if report.get("end_problems"):
+        problems.append(f"qualify end problems: {report['end_problems']}")
+    rec = state.get("record") or {}
+    observed, template = rec.get("manifest"), rec.get("template")
+    if not observed or not template:
+        return problems + ["qualify record carries no leaf manifest / template of the measured cache"]
+    try:
+        flags = [t for flag, vals in expected_kv_argv(entry).items() for v in vals for t in (flag, v)]
+        kv = km.kv_from_argv(["--model", entry.get("hf_path", "m"), *flags])
+        bits = entry.get("kv_bits") or 0
+        if (kv["kv_bits"] or 0) != bits or (bits and kv["kv_quant_scheme"] != entry.get("kv_quant_scheme")):
+            problems.append(f"the arm's argv resolves to kv_bits {kv['kv_bits']} / {kv['kv_quant_scheme']}")
+        found = km.manifest_problems(observed, template, kv)
+        if found:
+            problems.append(f"per-layer cache manifest differs from the arm's KV config: {found[:3]}")
+        kinds = {m["kind"] for m in _kv_leaves(observed)}
+        want = {"native"} if not bits else ({"tq", "native"} if entry.get("kv_quant_scheme") == "turboquant" else {"affine"})
+        must = "native" if not bits else ("tq" if entry.get("kv_quant_scheme") == "turboquant" else "affine")
+        if must not in kinds or not kinds <= want:
+            problems.append(f"observed KV leaf kinds {sorted(kinds)} are not the arm's ({sorted(want)})")
+    except Exception as exc:  # noqa: BLE001 — a manifest that cannot be judged refuses the arm
+        problems.append(f"manifest check error: {type(exc).__name__}: {exc}")
+    return problems
+
+
+def qualify_peaks_gb(report, model):
+    peaks = (((report or {}).get("entries") or {}).get(model, {}).get("record") or {}).get("peaks") or {}
+    return {k: (round(v / 1e9, 3) if isinstance(v, (int, float)) else None) for k, v in sorted(peaks.items())}
+
+
+def _write_json_once(path, obj):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "x") as f:
+        f.write(json.dumps(obj, indent=1, default=str) + "\n")
+
+
+def run_preflight(pick, arm, first_leg, cfg, deps):
+    """The live engagement preflight of ONE arm, before its first router leg. Returns the preflight record (also written to
+    `<first leg>.preflight-<ns>.json` beside the receipts, which `harvest_leg` collects with the qualify output dir).
+    `ok` only when every pre-check passes and qualify's report proves the arm's exact per-layer cache manifest."""
+    import yaml
+
+    stamp = time.time_ns()
+    out = Path(cfg.workdir) / "p369" / "phase2" / f"p475-{first_leg.name}-{stamp}"
+    rec = dict(pick=pick, arm=arm, leg=first_leg.name, model=first_leg.model, ok=False, problems=[], out_dir=str(out),
+               stamp=stamp, argv=None, rc=None, qualify=None, started=deps.clock())
+    try:
+        ai = deps.arm_inputs(first_leg)
+        rec["arm_identity"] = ai.identity()
+        entry = _entry(yaml.safe_load(ai.registry_text), first_leg.model) or {}
+        pre = identity_problems(ai, cfg.base_commit) + arm_problems(first_leg, ai, cfg.base_registry_text, ai.registry_text)
+        pre += deps.lock_check(cfg.workdir)
+        ops = deps.ops_for(first_leg, ai)
+        if not ops.power_ok():
+            pre.append("power / orphan gate failed before the preflight (140 W / 28 V / battery > 20 %)")
+        if ops.busy_procs():
+            pre.append("busy processes before the preflight: " + "; ".join(ops.busy_procs())[:400])
+        if ops.listeners():
+            pre.append(f":8000 already bound by {ops.listeners()}")
+        if pre:
+            rec["problems"] = pre
+        else:
+            km = deps.load_kvmanifest(ai.worktree)
+            argv = qualify_argv(ai.worktree, first_leg.model, ai.submodules["src/mlx-vlm"], cfg.production_ref, out)
+            rec["argv"] = argv
+            rec["rc"] = deps.run_qualify(argv, out, Path(cfg.receipt_dir) / f"{first_leg.name}.preflight-{stamp}.stdout",
+                                         cfg.qualify_timeout_s)
+            report = None
+            try:
+                report = deps.read_json(out / "report.json")
+            except Exception as exc:  # noqa: BLE001 — a refusal / crash before the report is a refusal of the arm
+                rec["problems"].append(f"qualify wrote no readable report (rc {rec['rc']}): {type(exc).__name__}: {exc}")
+            if report is not None:
+                rec["problems"] += kv_arm_report_problems(report, first_leg.model, entry)
+                rec["problems"] += qualify_report_problems(
+                    report, first_leg.model, entry, km, hashlib.sha256(ai.registry_text.encode()).hexdigest(),
+                    ai.submodules["src/mlx-vlm"])
+                rec["qualify"] = dict(status=((report.get("entries") or {}).get(first_leg.model) or {}).get("status"),
+                                      peaks_gb=qualify_peaks_gb(report, first_leg.model))
+            if rec["rc"] not in (0, None) and not rec["problems"]:
+                rec["problems"].append(f"qualify exit {rec['rc']}")
+            after = deps.arm_inputs(first_leg)
+            rec["problems"] += identity_drift(ai.identity(), after.identity())
+    except Exception as exc:  # noqa: BLE001 — a preflight that cannot run refuses the arm
+        rec["problems"].append(f"preflight error: {type(exc).__name__}: {exc}")
+    rec["ok"] = not rec["problems"]
+    rec["ended"] = deps.clock()
+    _write_json_once(Path(cfg.receipt_dir) / f"{first_leg.name}.preflight-{stamp}.json", rec)
+    return rec
+
+
+def preflight_passed(receipt_dir):
+    """{(pick, arm)} that have a passed preflight record (resume re-reads them from disk)."""
+    done = set()
+    for p in sorted(Path(receipt_dir).glob("*.preflight-*.json")):
+        try:
+            rec = json.loads(p.read_text())
+        except ValueError:
+            continue
+        if rec.get("ok"):
+            done.add((rec["pick"], rec["arm"]))
+    return done
+
+
+def preflight_refusals(receipt_dir):
+    """{(pick, arm): number of REFUSED preflight records} (resume re-reads them: the bound is monotonic across restarts)."""
+    counts = {}
+    for p in sorted(Path(receipt_dir).glob("*.preflight-*.json")):
+        try:
+            rec = json.loads(p.read_text())
+        except ValueError:
+            continue
+        if rec.get("ok") is False:
+            key = (rec.get("pick"), rec.get("arm"))
+            counts[key] = counts.get(key, 0) + 1
+    return counts
+
