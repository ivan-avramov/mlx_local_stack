+    production_ref: str = ""               # qualify's `--production-ref`
+    qualify_timeout_s: float = 2 * 3600
+    max_replacements: int = MAX_REPLACEMENTS                    # recorded in every receipt (`replacement_cap`): the matrix
+    max_deciding_replacements: int = MAX_DECIDING_REPLACEMENTS  # tells an exhausted deciding cell from one still running
+
