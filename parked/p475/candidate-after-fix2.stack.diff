+def harvest_all(root, blocks=(1, 2), picks=("fable", "uniform4"), preflights=True, rows=None, overrides=None):
+    """Every pick x arm x block harvested VALID and speed-valid (`overrides`: {(pick, arm, block): rows})."""
+    for pick in picks:
+        for block in blocks:
+            for arm in K.ARMS:
+                leg = K.Leg(pick, arm, block)
+                write_leg(root, leg, (overrides or {}).get((pick, arm, block), rows or good_rows()))
+                if preflights and block == blocks[0]:
+                    (root / "benchmark/results/p475" / leg.name / f"{leg.name}.preflight-1.json").write_text(json.dumps(
+                        dict(pick=pick, arm=arm, leg=leg.name, ok=True, qualify=dict(
+                            status="COMPLETED", peaks_gb=dict(prefill=29.5, decode=31.25, retire=None)))))
