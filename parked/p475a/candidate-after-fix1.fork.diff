+def _serve_argv(block, venv_bin):
+    """mlx-serve ``process_manager._build_command`` (type vision), spelled flag by flag from its source: the defaults it
+    reads (``ModelConfig``) and the ``if`` that gates each flag."""
+    cmd = [str(Path(venv_bin) / "mlx_vlm.server"), "--model", block["hf_path"]]
+    cmd += ["--host", "127.0.0.1", "--port", "8091"]
+    if block.get("context_length", 0) > 0:
+        cmd += ["--max-tokens", str(block["context_length"])]
+    if block.get("max_kv_cache_size", 0) > 0:
+        cmd += ["--max-kv-size", str(block["max_kv_cache_size"])]
+    if block.get("kv_prealloc_tokens", 0) > 0:
+        cmd += ["--kv-prealloc-tokens", str(block["kv_prealloc_tokens"])]
+    if block.get("cache_session_shrink") is not None:
+        cmd += ["--cache-session-shrink", "on" if block["cache_session_shrink"] else "off"]
+    if block.get("attention_policy", "") not in ("", "auto"):
+        cmd += ["--attention-policy", block["attention_policy"]]
+    if block.get("lazy_prompt_embeddings") is True:
+        cmd += ["--lazy-prompt-embeddings"]
+    if block.get("mtp_verify_scan", "") not in ("", "per_query"):
+        cmd += ["--mtp-verify-scan", block["mtp_verify_scan"]]
+    if block.get("kv_bits", 0) > 0:
+        cmd += ["--kv-bits", str(block["kv_bits"])]
+    if block.get("kv_quant_scheme"):
+        cmd += ["--kv-quant-scheme", block["kv_quant_scheme"]]
+    if block.get("kv_quant_mode"):
+        cmd += ["--kv-quant-mode", block["kv_quant_mode"]]
+    if block.get("prefill_step_size"):
+        cmd += ["--prefill-step-size", str(block["prefill_step_size"])]
+    if block.get("generation_defaults"):
+        cmd += ["--generation-defaults", json.dumps(block["generation_defaults"])]
+    if block.get("draft_kind"):
+        cmd += ["--draft-kind", block["draft_kind"]]
+        if block.get("draft_model"):
+            cmd += ["--draft-model", block["draft_model"]]
+    cmd += ["--quantized-kv-start", str(block.get("quantized_kv_start", 0))]
+    if block.get("cache_limit_gb", 0.0) > 0:
+        cmd += ["--cache-limit-gb", str(block["cache_limit_gb"])]
+    cmd += ["--memory-limit-frac", str(block.get("memory_limit_frac", 0.85))]
+    return cmd
+
+
+def _cell_record(expected, sdpa_forced):
+    """A request record whose cache is exactly the cell's expected manifest."""
+    from p369_phase2 import kvmanifest
+
+    template = t415._template()
+    manifest = kvmanifest.expected_manifest(template, qualify.expected_kv(expected))
+    caps = {
+        o["path"]: expected["prealloc"]
+        for o in manifest
+        if o["kind"] in ("tq", "affine", "native")
+    }
+    defaults = expected["generation_defaults"]
+    changes = dict(
+        sdpa_forced=sdpa_forced,
+        manifest=manifest,
+        template=template,
+        capacities_by_path=caps,
+        resolved=dict(defaults, max_tokens=2048, thinking_budget=1638, seed=7),
+        server_defaults=defaults,
+        drafter_live_checks=None,
+        lazy_calls=1 if expected["lazy_embeddings"] else 0,
+        shrink_calls=1 if expected["shrink"] else 0,
+        peaks=dict(
+            prefill=36.5e9,
+            decode=36.9e9,
+            retire=37.1e9 if expected["shrink"] else None,
+        ),
+        memory=dict(
+            t415._record()["memory"],
+            set_cache_limit=[qualify.expected_cache_limit(24, expected)],
+        ),
+    )
+    return t415._record(**changes)
+
