+def _required_forced(entry, arm):
+    """The attention rule per cell, written out: only the fused_v1 pick, and only where a native leaf attends."""
+    return entry == FABLE and FUSED_FORCED[arm]
+
+
+def _drive_cell(tmp_path, monkeypatch, pruned, entry, arm, sdpa_forced):
+    """``qualify --kv-arm`` over the cell's real arm registry with the REAL ``classify_kv_arm`` (spied) and ``classify``
+    forbidden; returns ``(code, report, classify_kv_arm calls, classify calls)``."""
+    import argparse
+
+    from p369_phase2 import orchestrate
+
+    text = _cell_registry(pruned, entry, arm)
+    block = _cell_block(text, entry)
+    expected = qualify.expected_config(block)
+    record = _cell_record(expected, sdpa_forced)
+    arm_calls, classify_calls = [], []
+    real = rs.classify_kv_arm
+
+    def spy(text_, fixture, name):
+        arm_calls.append(name)
+        return real(text_, fixture, name)
+
+    def forbidden(text_, fixture):
+        classify_calls.append(text_)
+        raise AssertionError("classify called under --kv-arm")
+
+    for name, value in dict(
+        acquire_lock=lambda lock: 3,
+        release_lock=lambda fd: None,
+        lock_path=lambda env: tmp_path / ".lock",
+        preflight=lambda args, out: dict(problems=[]),
+        read_registry=lambda p: text,
+        sha256_file=lambda p: "s",
+        fork_versions=lambda f: {"mlx": "0.32.3"},
+        overlay_registry=lambda text_, name, fixture: (text_, True),
+        weights_record=lambda m: dict(revision="r", files={}),
+        worker_env=lambda env: env,
+        run_job=lambda job, *a, **k: dict(requests=[dict(qualify=record)]),
+    ).items():
+        monkeypatch.setattr(orchestrate, name, value)
+    monkeypatch.setattr(orchestrate, "Monitor", t415._NullMonitor)
+    monkeypatch.setattr(rs, "fixture_text", lambda d: FIXTURE)
+    monkeypatch.setattr(rs, "classify", forbidden)
+    monkeypatch.setattr(rs, "classify_kv_arm", spy)
+    monkeypatch.setattr(qualify, "load_references", lambda p, **k: {})
+    monkeypatch.setattr(qualify, "_resolve_ref", lambda path, ref: "a" * 40)
+    monkeypatch.setattr(
+        qualify,
+        "_tree_state",
+        lambda fork, stack: dict(fork_head="a" * 40, fork_clean=True, stack_head="s" * 40),
+    )
+    monkeypatch.setattr(
+        qualify,
+        "console_script_info",
+        lambda stack: dict(
+            shebang=str(Path(stack) / ".venv" / "bin" / "python"),
+            entry="mlx_vlm.server:main",
+            stack_mlx_vlm="x",
+        ),
+    )
+    monkeypatch.setattr(qualify, "_last_tick_age", lambda p: 1.0)
+    monkeypatch.setattr(qualify, "_pmset_log", lambda: (0, t415.PMSET))
+    monkeypatch.setattr(qualify, "interference", lambda o: dict(ok=True, why=None))
+    monkeypatch.setattr(qualify, "binding_problems", lambda *a: [])
+    monkeypatch.setattr(qualify, "_git_head", lambda p: "h")
+    monkeypatch.setattr(
+        qualify, "full_command", lambda stack, path, name: (_serve_argv(block, Path(stack) / ".venv" / "bin"), "m")
+    )
+    monkeypatch.setattr("time.sleep", lambda s: None)
+    args = argparse.Namespace(
+        stack_root=str(tmp_path / "stack"),
+        fork_root=str(tmp_path / "fork"),
+        out=str(tmp_path / "run"),
+        entry=[entry],
+        p369_summary=None,
+        idle_s=600.0,
+        reviewed_head="a" * 40,
+        predictor="off",
+        kv_arm=True,
+    )
+    (tmp_path / "stack" / ".venv" / "bin").mkdir(parents=True)
+    code = qualify.drive(args)
+    report = json.loads((tmp_path / "run" / "report.json").read_text())
+    return code, report, arm_calls, classify_calls
+
