+++ b/mlx_vlm/tests/test_p475a_qualify_kv_arm.py
@@ -0,0 +1,811 @@
+"""P475a: `qualify --kv-arm` — a registry differing from an accepted state in exactly the KV-format keys of the ONE entry
+under test (fork-only, dev, CPU; nothing loads a model).
+
+`registry_states.classify_kv_arm` is `classify` plus a KV delta on one entry; `qualify` applies it under `--kv-arm`, checks
+the live cache against the ARM's own manifest, labels the reference comparison non-comparable, and (for every run) asserts
+the quantized-attention path (`sdpa_forced == 0`) exactly when the expected manifest has no native attention leaf.
+"""
+
+import json
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+DEV = Path(__file__).resolve().parents[2] / "dev"
+sys.path.insert(0, str(DEV))
+
+from mlx_vlm.tests import test_p415_qualify as t415  # noqa: E402
+from p369_phase2 import qualify  # noqa: E402
+from p369_phase2 import registry_states as rs  # noqa: E402
+
+FIXTURE = rs.fixture_text(Path(__file__).resolve().parent / "fixtures")
+FABLE = t415.FABLE
+UNIFORM = t415.UNIFORM
+PICKS = (FABLE, UNIFORM)
+ARMS = {  # P475 arm -> (kv_bits, kv_quant_scheme)
+    "N16": (0, "turboquant"),
+    "AF8": (8, "uniform"),
+    "TQ8": (8, "turboquant"),
+    "AF4": (4, "uniform"),
+    "TQ4": (4, "turboquant"),
+}
+
+
+def _set(text, entry, **keys):
+    """``text`` with the named keys of ``entry``'s block set (the line rewritten in place, comments dropped)."""
+    lines = text.split("\n")
+    start, end = rs._span(lines, entry)
+    for key, value in keys.items():
+        hits = [
+            i for i in range(start, end) if re.match(rf"^    {key}:", lines[i])
+        ]
+        assert len(hits) == 1, (entry, key)
+        lines[hits[0]] = f"    {key}: {value}"
+    return "\n".join(lines)
+
+
+def _arm_text(entry, arm, base=FIXTURE):
+    bits, scheme = ARMS[arm]
+    return _set(base, entry, kv_bits=bits, kv_quant_scheme=scheme)
+
+
+def _fixture_kv(entry):
+    e = rs.settings(FIXTURE)[entry]
+    return e["kv_bits"], e["kv_quant_scheme"]
+
+
+# ------------------------------------------------------------------ criterion 1: classify_kv_arm
+def test_the_arm_keys():
+    assert rs.KV_ARM_KEYS == ("kv_bits", "kv_quant_scheme")
+
+
+@pytest.mark.parametrize("arm", ARMS)
+@pytest.mark.parametrize("entry", PICKS)
+def test_every_arm_of_each_pick_is_accepted_with_the_right_delta(entry, arm):
+    got = rs.classify_kv_arm(_arm_text(entry, arm), FIXTURE, entry)
+    bits, scheme = ARMS[arm]
+    fbits, fscheme = _fixture_kv(entry)
+    want = {}
+    if bits != fbits:
+        want["kv_bits"] = (fbits, bits)
+    if scheme != fscheme:
+        want["kv_quant_scheme"] = (fscheme, scheme)
+    assert got == (frozenset(), want)
+
+
+@pytest.mark.parametrize("entry", PICKS)
+def test_an_arm_on_top_of_an_mtp_off_state_is_accepted(entry):
+    text = _arm_text(entry, "AF8", rs.apply(FIXTURE, {entry}))
+    off, delta = rs.classify_kv_arm(text, FIXTURE, entry)
+    assert off == frozenset({entry}) and delta["kv_bits"][1] == 8
+
+
+@pytest.mark.parametrize("state", [frozenset(), frozenset(PICKS)])
+def test_an_empty_delta_equals_classify(state):
+    text = rs.apply(FIXTURE, state)
+    assert rs.classify(text, FIXTURE) == state
+    for entry in PICKS:
+        assert rs.classify_kv_arm(text, FIXTURE, entry) == (state, {})
+
+
+def test_a_second_entry_changed_refuses():
+    text = _arm_text(FABLE, "AF8")
+    other = _set(text, UNIFORM, kv_bits=8)
+    assert rs.classify_kv_arm(other, FIXTURE, FABLE) is None
+    assert rs.classify_kv_arm(other, FIXTURE, UNIFORM) is None
+    # a different entry's KV change is not the entry under test's
+    assert rs.classify_kv_arm(_arm_text(UNIFORM, "AF8"), FIXTURE, FABLE) is None
+
+
+@pytest.mark.parametrize(
+    "key,value",
+    [
+        ("kv_prealloc_tokens", 131072),
+        ("max_kv_cache_size", 131072),
+        ("prefill_step_size", 1024),
+        ("type", "text"),
+    ],
+)
+def test_a_non_kv_key_changed_refuses(key, value):
+    text = _set(_arm_text(FABLE, "AF8"), FABLE, **{key: value})
+    assert rs.classify_kv_arm(text, FIXTURE, FABLE) is None
+
+
+def test_a_changed_top_level_setting_refuses():
+    text = _arm_text(FABLE, "AF8")
+    assert rs.classify_kv_arm("x_extra: 1\n" + text, FIXTURE, FABLE) is None
+
+
+@pytest.mark.parametrize("start", [5000, 1, '"0"', "false"])
+def test_quantized_kv_start_must_stay_zero(start):
+    text = _set(_arm_text(FABLE, "AF8"), FABLE, quantized_kv_start=start)
+    assert rs.classify_kv_arm(text, FIXTURE, FABLE) is None
+
+
+@pytest.mark.parametrize(
+    "bits,scheme",
+    [(-4, "turboquant"), ('"8"', "uniform"), (4, "bogus"), (True, "uniform")],
+)
+def test_values_the_manifest_cannot_model_refuse(bits, scheme):
+    text = _set(FIXTURE, FABLE, kv_bits=bits, kv_quant_scheme=scheme)
+    assert rs.classify_kv_arm(text, FIXTURE, FABLE) is None
+
+
+def test_an_mtp_key_change_outside_the_16_states_plus_a_kv_change_refuses():
+    old, _ = rs.ENTRY_OFF[FABLE][1]  # draft_kind alone commented out: a half state
+    off = rs.apply(FIXTURE, {FABLE})
+    half = off.replace(rs.ENTRY_OFF[FABLE][1][1], old, 1)
+    assert rs.classify(half, FIXTURE) is None
+    assert rs.classify_kv_arm(_arm_text(FABLE, "AF8", half), FIXTURE, FABLE) is None
+    # and a KV change on a half-removed MTP state of the OTHER pick
+    half2 = rs.apply(FIXTURE, {UNIFORM}).replace(
+        rs.ENTRY_OFF[UNIFORM][1][1], rs.ENTRY_OFF[UNIFORM][1][0], 1
+    )
+    assert rs.classify_kv_arm(_arm_text(FABLE, "AF8", half2), FIXTURE, FABLE) is None
+
+
+def test_an_unknown_entry_refuses():
+    assert rs.classify_kv_arm(FIXTURE, FIXTURE, "no-such-entry") is None
+
+
+def test_unparseable_text_refuses():
+    assert rs.classify_kv_arm("a: 1\na: 2\n", FIXTURE, FABLE) is None
+    assert rs.classify_kv_arm(FIXTURE.replace("\n", "\r\n"), FIXTURE, FABLE) is None
+
+
+# ------------------------------------------------------------------ criterion 0: the attention rule
+AF_TEMPLATE = t415._template()
+
+
+def _affine_manifest(bits):
+    return [
+        (
+            dict(
+                path=t["path"],
+                kind="affine",
+                cls="PreallocQuantizedKVCache",
+                batch=False,
+                bits=bits,
+                group_size=64,
+            )
+            if t["kind"] == "native"
+            else dict(t)
+        )
+        for t in AF_TEMPLATE
+    ]
+
+
+def _fable_arm_entry(bits, scheme):
+    return dict(t415.FABLE_ENTRY, kv_bits=bits, kv_quant_scheme=scheme)
+
+
+@pytest.mark.parametrize("bits", [8, 4])
+def test_affine_arms_of_the_fused_pick_pass_with_no_forced_sdpa(bits):
+    expected = qualify.expected_config(_fable_arm_entry(bits, "uniform"))
+    assert expected["attention_policy"] == "fused_v1"
+    rec = t415._record(
+        sdpa_forced=0,
+        manifest=_affine_manifest(bits),
+        memory=dict(
+            t415._record()["memory"],
+            set_cache_limit=[qualify.expected_cache_limit(24, expected)],
+        ),
+    )
+    assert qualify.request_problems(rec, expected) == []
+    forced = dict(rec, sdpa_forced=640)
+    assert any("sdpa_forced" in p for p in qualify.request_problems(forced, expected))
+
+
+def test_native_and_turboquant_arms_still_require_forced_calls():
+    for entry, manifest in (
+        (_fable_arm_entry(0, "uniform"), t415._native_manifest()),
+        (_fable_arm_entry(4, "turboquant"), t415._tq_manifest()),
+        (_fable_arm_entry(8, "turboquant"), None),
+    ):
+        expected = qualify.expected_config(entry)
+        manifest = manifest or _tq8_manifest()
+        for forced, ok in ((640, True), (0, False)):
+            rec = t415._record(
+                sdpa_forced=forced,
+                manifest=manifest,
+                memory=dict(
+                    t415._record()["memory"],
+                    set_cache_limit=[qualify.expected_cache_limit(24, expected)],
+                ),
+            )
+            got = [p for p in qualify.request_problems(rec, expected) if "sdpa" in p]
+            assert (got == []) is ok, (entry["kv_bits"], forced, got)
+
+
+def _tq8_manifest():
+    out = t415._tq_manifest()
+    out[1] = dict(out[1], bits=8.0, key_bits=8.0, value_bits=8.0)
+    return out
+
+
+def test_the_no_flag_rule_for_a_non_fused_entry_is_unchanged():
+    expected = qualify.expected_config(t415.STATIC_ENTRY)
+    assert expected["attention_policy"] == "auto"
+    rec = t415._record(
+        sdpa_forced=3,
+        lazy_calls=0,
+        shrink_calls=0,
+        drafter_live_checks=None,
+        peaks=dict(prefill=30e9, decode=30.2e9, retire=None),
+        manifest=t415._tq_manifest(),
+        memory=dict(
+            t415._record()["memory"],
+            set_cache_limit=[qualify.expected_cache_limit(24, expected)],
+        ),
+    )
+    assert any("sdpa_forced" in p for p in qualify.request_problems(rec, expected))
+
+
+# ------------------------------------------------------------------ criterion 2: qualify --kv-arm
+def test_the_parser_has_the_flag_and_defaults_off():
+    ap = qualify.build_parser()
+    base = ["--stack-root", "s", "--fork-root", "f", "--out", "o", "--reviewed-head", "h"]
+    assert ap.parse_args(base).kv_arm is False
+    assert ap.parse_args(base + ["--kv-arm"]).kv_arm is True
+
+
+def _drive_arm(
+    tmp_path,
+    monkeypatch,
+    *,
+    arm=(
+        frozenset({FABLE}),
+        {"kv_bits": (0, 8), "kv_quant_scheme": ("turboquant", "uniform")},
+    ),
+    kv_arm=True,
+    predictor="off",
+    names=(FABLE,),
+    run_job=None,
+    refs=None,
+):
+    """t415._drive with the registry classified by ``classify_kv_arm`` (→ ``arm``); ``classify`` must not be called."""
+    from p369_phase2 import registry_states
+
+    calls = []
+    real_drive = qualify.drive
+
+    def drive(args):
+        args.predictor = predictor
+        args.kv_arm = kv_arm
+        monkeypatch.setattr(
+            registry_states,
+            "classify_kv_arm",
+            lambda text, fx, entry: calls.append(entry) or arm,
+            raising=False,
+        )
+
+        def forbidden(text, fx):
+            raise AssertionError("classify called under --kv-arm")
+
+        if kv_arm:
+            monkeypatch.setattr(registry_states, "classify", forbidden)
+        return real_drive(args)
+
+    monkeypatch.setattr(qualify, "drive", drive)
+    entry = {
