+def classify(text, fixture):
+    """C203: the frozenset of MTP-OFF entries if ``text``'s SETTINGS are one of the 16 states, else None."""
+    try:
+        doc, ref = parse(text), parse(fixture)
+    except ValueError:
+        return None
+    got = _classify_docs(doc, ref)
+    return None if got is None else got[0]
+
+
+KV_ARM_ENTRIES = (  # P475a: the two picks the matrix measures; any other entry refuses
+    "Qwen3.8-27B-Fable-Distill-OptiQ-4.5bpw-mixed",
+    "Qwen3.8-27B-mlx-uniform-4bit",
+)
+KV_ARM_SCHEMES = ("uniform", "turboquant")
+
+
+def _kv_arm_valid(arm):
+    """The arm's KV values are in the P475 arm set: ``kv_bits`` the integer 0 (native; the scheme is inert there, absent or
+    either), 8 or 4, and for 4 / 8 a scheme of ``KV_ARM_SCHEMES``."""
+    bits, scheme = arm.get("kv_bits"), arm.get("kv_quant_scheme")
+    if type(bits) is not int or bits not in (0, 4, 8):
+        return False
+    return scheme in KV_ARM_SCHEMES or (bits == 0 and scheme is None)
+
+
+def _models_ok(doc):
+    """``doc`` is a mapping whose ``models`` (if any) is a list of mappings with string names (what ``_classify_docs`` reads)."""
+    if not isinstance(doc, dict):
+        return False
+    models = doc.get("models")
+    return models is None or (
+        isinstance(models, list)
+        and all(isinstance(m, dict) and isinstance(m.get("name"), str) for m in models)
+    )
+
+
+def classify_kv_arm(text, fixture, entry):
+    """P475a: ``(off set, {key: (fixture value, arm value)})`` if ``text`` is one of the 16 states except that ``entry`` (one of
+    ``KV_ARM_ENTRIES``) may ALSO differ in ``KV_ARM_KEYS`` (values of the P475 arm set). Any other difference (a changed
+    ``quantized_kv_start`` included), a second entry differing, another ``entry`` or a malformed document is None, never an
+    exception. An empty delta is ``classify``'s answer.
+    """
+    if entry not in KV_ARM_ENTRIES:
+        return None
+    try:
+        doc, ref = parse(text), parse(fixture)
+    except ValueError:
+        return None
+    if not (_models_ok(doc) and _models_ok(ref)):
+        return None
+    got = _classify_docs(doc, ref, arm=entry)
+    if got is None or entry not in {m.get("name") for m in ref.get("models") or []}:
+        return None
+    off, delta = got
+    if delta:
+        arm = next(m for m in doc["models"] if m.get("name") == entry)
+        if not _kv_arm_valid(arm):
+            return None
+    return off, delta
 
 
