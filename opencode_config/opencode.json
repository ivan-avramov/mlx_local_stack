{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mlx-serve (local)",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma-4-26b-moe-8-128": {
          "name": "gemma-4-26b-moe-8-128",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": {
            "context": 98304,
            "output": 32768
          },
          "options": {
            "temperature": 0.7,
            "top_p": 0.95,
            "top_k": 64,
            "repetition_penalty": 1.08,
            "max_tokens": 32768,
            "enable_thinking": true,
            "thinking_budget": 16384
          }
        },
        "Qwen3.6-27B-UD-MLX-6bit": {
          "name": "Qwen3.6 27B (thinking)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
