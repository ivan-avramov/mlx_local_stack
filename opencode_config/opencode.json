{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "compaction": {
    "auto": true
  },
  "plugins": [
    "-opencode.provider.vllm",
    "-opencode.provider.ollama",
    "-opencode.provider.lmstudio",
    "-opencode.config.compatibility"
