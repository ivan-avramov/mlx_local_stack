          "limit": {
            "context": 262144,
            "output": 102400
          },
          "options": {
            "temperature": 0.4,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "max_tokens": 102400,
