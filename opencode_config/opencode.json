      "name": "mlx task model (local)",
      "options": {
        "baseURL": "http://localhost:8092/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "mlx-community/Qwen2.5-1.5B-Instruct-4bit": {
          "name": "Task 1.5B (titles/summaries)",
          "tool_call": false,
