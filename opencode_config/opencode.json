            "context": 180224,
            "output": 81920
          },
          "options": {
            "temperature": 0.7,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.03,
            "presence_penalty": 0.3,
            "max_tokens": 81920,
