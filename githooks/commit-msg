#!/usr/bin/env bash
# AGENTS.md model-naming rule, applied to the commit message (O24).
# The rule says "reports, results, docs AND commits"; messages were where it actually failed.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv-bench/bin/python"
[ -x "$PY" ] || exit 0
PYTHONPATH="$ROOT/benchmark" "$PY" -m bench.modelnames --commit-msg "$1"
