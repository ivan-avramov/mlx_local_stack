def proverb(*pieces, qualifier=None):
    """Return the lines of the proverb rhyme for the given pieces.

    Each consecutive pair of pieces yields a "For want of a X the Y was lost."
    line, and the final line references the first piece (with an optional
    qualifier). Returns an empty list when no pieces are given.
    """
    if not pieces:
        return []

    lines = [
        f"For want of a {first} the {second} was lost."
        for first, second in zip(pieces, pieces[1:])
    ]
    first = pieces[0]
    if qualifier:
        first = f"{qualifier} {first}"
    lines.append(f"And all for the want of a {first}.")
    return lines
