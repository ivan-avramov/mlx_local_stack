_NUMBERS = {
    0: "no",
    1: "One",
    2: "Two",
    3: "Three",
    4: "Four",
    5: "Five",
    6: "Six",
    7: "Seven",
    8: "Eight",
    9: "Nine",
    10: "Ten",
}


def _bottles(count, capitalize=True):
    number = _NUMBERS[count]
    if not capitalize:
        number = number.lower()
    return f"{number} green bottle{'s' if count != 1 else ''} hanging on the wall"


def recite(start, take=1):
    lines = []
    for count in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.extend([
            f"{_bottles(count)},",
            f"{_bottles(count)},",
            "And if one green bottle should accidentally fall,",
            f"There'll be {_bottles(count - 1, capitalize=False)}.",
        ])
    return lines
