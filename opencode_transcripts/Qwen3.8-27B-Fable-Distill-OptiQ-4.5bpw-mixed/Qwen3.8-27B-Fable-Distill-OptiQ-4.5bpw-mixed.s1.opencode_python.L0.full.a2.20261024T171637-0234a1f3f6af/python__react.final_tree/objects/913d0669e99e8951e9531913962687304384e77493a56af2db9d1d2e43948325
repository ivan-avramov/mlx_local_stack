class Cell:
    def __init__(self):
        self._value = None
        self._callbacks = []
        self._dependents = []

    @property
    def value(self):
        return self._value

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self._callbacks:
            self._callbacks.remove(callback)

    def _add_dependent(self, dependent):
        self._dependents.append(dependent)


class InputCell(Cell):
    def __init__(self, initial_value):
        super().__init__()
        self._value = initial_value

    @Cell.value.setter
    def value(self, new_value):
        self._value = new_value
        dirty = []
        for dependent in self._dependents:
            dependent._mark_dirty(dirty)
        for cell in dirty:
            cell._recompute()
        for cell in dirty:
            cell._fire_callbacks()


class ComputeCell(Cell):
    def __init__(self, inputs, compute_function):
        super().__init__()
        self._inputs = inputs
        self._compute_function = compute_function
        self._dirty = False
        self._changed = False
        self._value = compute_function([i.value for i in inputs])
        for i in inputs:
            i._add_dependent(self)

    def _mark_dirty(self, dirty):
        if not self._dirty:
            self._dirty = True
            dirty.append(self)
            for dependent in self._dependents:
                dependent._mark_dirty(dirty)

    def _recompute(self):
        if not self._dirty:
            return
        for i in self._inputs:
            if isinstance(i, ComputeCell):
                i._recompute()
        old_value = self._value
        self._value = self._compute_function([i.value for i in self._inputs])
        self._dirty = False
        self._changed = self._value != old_value

    def _fire_callbacks(self):
        if self._changed:
            for callback in self._callbacks:
                callback(self._value)
        self._changed = False
