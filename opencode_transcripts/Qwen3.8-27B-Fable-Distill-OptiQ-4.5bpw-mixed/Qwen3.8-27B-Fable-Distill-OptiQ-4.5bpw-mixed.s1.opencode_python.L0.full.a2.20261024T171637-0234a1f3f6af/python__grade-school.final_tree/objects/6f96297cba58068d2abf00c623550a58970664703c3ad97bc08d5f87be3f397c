class School:
    def __init__(self):
        self._students = {}
        self._enrolled = set()
        self._added = []

    def add_student(self, name, grade):
        if name in self._enrolled:
            self._added.append(False)
            return
        self._enrolled.add(name)
        self._students.setdefault(grade, set()).add(name)
        self._added.append(True)

    def roster(self):
        return [
            student
            for grade in sorted(self._students)
            for student in sorted(self._students[grade])
        ]

    def grade(self, grade_number):
        return sorted(self._students.get(grade_number, set()))

    def added(self):
        return self._added
