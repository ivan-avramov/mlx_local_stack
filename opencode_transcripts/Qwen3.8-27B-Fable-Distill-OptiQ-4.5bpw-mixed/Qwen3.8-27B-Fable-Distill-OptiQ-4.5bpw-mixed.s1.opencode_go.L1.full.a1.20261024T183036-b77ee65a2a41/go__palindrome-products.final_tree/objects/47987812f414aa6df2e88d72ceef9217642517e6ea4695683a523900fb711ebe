package palindrome

import (
	"errors"
	"fmt"
)

// Product holds a palindromic product and all of its factorizations
// within the given range, ordered by first factor then second factor.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of two
// numbers within the inclusive range [fmin, fmax].
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	var min, max Product
	minFound, maxFound := false, false

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if !isPalindrome(p) {
				continue
			}
			if !minFound || p < min.Value {
				min = Product{Value: p, Factorizations: [][2]int{{i, j}}}
				minFound = true
			} else if p == min.Value {
				min.Factorizations = append(min.Factorizations, [2]int{i, j})
			}
			if !maxFound || p > max.Value {
				max = Product{Value: p, Factorizations: [][2]int{{i, j}}}
				maxFound = true
			} else if p == max.Value {
				max.Factorizations = append(max.Factorizations, [2]int{i, j})
			}
		}
	}

	if !minFound {
		return Product{}, Product{}, errors.New("no palindromes found")
	}

	return min, max, nil
}

func isPalindrome(n int) bool {
	s := fmt.Sprintf("%d", n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
