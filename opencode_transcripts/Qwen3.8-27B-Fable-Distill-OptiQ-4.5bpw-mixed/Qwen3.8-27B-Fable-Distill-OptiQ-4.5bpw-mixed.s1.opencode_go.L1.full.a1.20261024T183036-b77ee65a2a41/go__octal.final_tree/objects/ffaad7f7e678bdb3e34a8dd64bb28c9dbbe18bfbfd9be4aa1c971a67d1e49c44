package octal

import (
	"errors"
)

// ParseOctal converts an octal number represented as a string (e.g. "1735263")
// to its decimal equivalent, computing the conversion from first principles
// (no built-in base conversion is used). Invalid input is treated as octal 0
// and an error is returned.
func ParseOctal(input string) (int64, error) {
	var result int64
	for _, r := range input {
		if r < '0' || r > '7' {
			return 0, errors.New("invalid octal input")
		}
		result = result*8 + int64(r-'0')
	}
	return result, nil
}
