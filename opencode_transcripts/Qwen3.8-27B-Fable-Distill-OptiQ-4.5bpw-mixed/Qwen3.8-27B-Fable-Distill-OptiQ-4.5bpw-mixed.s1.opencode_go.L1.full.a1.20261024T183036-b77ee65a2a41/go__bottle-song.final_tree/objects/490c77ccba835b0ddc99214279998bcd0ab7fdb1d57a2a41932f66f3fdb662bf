package bottlesong

import (
	"fmt"
	"strings"
)

var numbers = []string{"no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"}

func Recite(startBottles, takeDown int) []string {
	var lines []string
	for i := startBottles; i > startBottles-takeDown; i-- {
		if len(lines) > 0 {
			lines = append(lines, "")
		}
		lines = append(lines,
			fmt.Sprintf("%s green bottle%s hanging on the wall,", capitalize(numbers[i]), plural(i)),
			fmt.Sprintf("%s green bottle%s hanging on the wall,", capitalize(numbers[i]), plural(i)),
			"And if one green bottle should accidentally fall,",
			fmt.Sprintf("There'll be %s green bottle%s hanging on the wall.", numbers[i-1], plural(i-1)),
		)
	}
	return lines
}

func plural(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}
