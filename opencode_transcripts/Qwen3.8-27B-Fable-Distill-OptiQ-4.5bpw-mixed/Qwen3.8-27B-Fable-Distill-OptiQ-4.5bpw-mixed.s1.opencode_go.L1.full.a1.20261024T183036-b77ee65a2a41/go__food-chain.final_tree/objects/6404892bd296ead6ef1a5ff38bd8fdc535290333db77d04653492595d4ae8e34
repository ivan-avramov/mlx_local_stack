package foodchain

import "strings"

var animals = []string{
	"fly",
	"spider",
	"bird",
	"cat",
	"dog",
	"goat",
	"cow",
	"horse",
}

var comments = []string{
	"I don't know why she swallowed the fly. Perhaps she'll die.",
	"It wriggled and jiggled and tickled inside her.",
	"How absurd to swallow a bird!",
	"Imagine that, to swallow a cat!",
	"What a hog, to swallow a dog!",
	"Just opened her throat and swallowed a goat!",
	"I don't know how she swallowed a cow!",
	"She's dead, of course!",
}

var catchSuffixes = []string{
	"",
	" that wriggled and jiggled and tickled inside her",
	"",
	"",
	"",
	"",
	"",
}

// Verse returns the verse for the given animal (1-based index).
func Verse(v int) string {
	if v < 1 || v > len(animals) {
		panic("invalid verse number")
	}
	i := v - 1
	var b strings.Builder
	b.WriteString("I know an old lady who swallowed a ")
	b.WriteString(animals[i])
	b.WriteString(".\n")
	b.WriteString(comments[i])
	if i == 0 || i == len(animals)-1 {
		return b.String()
	}
	for j := i; j > 0; j-- {
		b.WriteString("\nShe swallowed the ")
		b.WriteString(animals[j])
		b.WriteString(" to catch the ")
		b.WriteString(animals[j-1])
		b.WriteString(catchSuffixes[j-1])
		b.WriteString(".")
	}
	b.WriteString("\nI don't know why she swallowed the fly. Perhaps she'll die.")
	return b.String()
}

// Verses returns the verses from start to end, inclusive, separated by a blank line.
func Verses(start, end int) string {
	var verses []string
	for v := start; v <= end; v++ {
		verses = append(verses, Verse(v))
	}
	return strings.Join(verses, "\n\n")
}

// Song returns the entire song.
func Song() string {
	return Verses(1, len(animals))
}
