package piglatin

import (
	"strings"
)

// Sentence translates a sentence from English to Pig Latin.
func Sentence(sentence string) string {
	words := strings.Fields(sentence)
	for i, word := range words {
		words[i] = pigLatinWord(word)
	}
	return strings.Join(words, " ")
}

func pigLatinWord(word string) string {
	if startsWithVowel(word) || strings.HasPrefix(word, "xr") || strings.HasPrefix(word, "yt") {
		return word + "ay"
	}

	// Find where the leading consonant cluster ends.
	i := 0
	for i < len(word) {
		c := word[i]
		if isVowel(c) {
			break
		}
		if c == 'q' && i+1 < len(word) && word[i+1] == 'u' {
			i += 2
			break
		}
		if c == 'y' && i > 0 {
			break
		}
		i++
	}

	return word[i:] + word[:i] + "ay"
}

func startsWithVowel(word string) bool {
	return len(word) > 0 && isVowel(word[0])
}

func isVowel(c byte) bool {
	switch c {
	case 'a', 'e', 'i', 'o', 'u':
		return true
	}
	return false
}
