package bottlesong

import (
	"fmt"
	"strings"
)

var numbers = []string{"no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"}

func Recite(startBottles, takeDown int) []string {
	var verses []string
	for i := 0; i < takeDown; i++ {
		n := startBottles - i
		verse := fmt.Sprintf("%s green bottle%s hanging on the wall,\n"+
			"%s green bottle%s hanging on the wall,\n"+
			"And if one green bottle should accidentally fall,\n"+
			"There'll be %s green bottle%s hanging on the wall.",
			Title(numbers[n]), bottle(n),
			Title(numbers[n]), bottle(n),
			numbers[n-1], bottle(n-1))
		verses = append(verses, verse)
	}

	return strings.Split(strings.Join(verses, "\n\n"), "\n")
}

func bottle(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
