package octal

import "errors"

// ParseOctal converts an octal number, represented as a string, to its
// decimal equivalent. Invalid input (any character that is not an octal
// digit) yields 0 and an error.
func ParseOctal(input string) (int64, error) {
	var result int64
	for _, c := range input {
		if c < '0' || c > '7' {
			return 0, errors.New("invalid octal input: " + input)
		}
		result = result*8 + int64(c-'0')
	}
	return result, nil
}
