def _bottles(count):
    if count == 0:
        return "no more bottles"
    if count == 1:
        return "1 bottle"
    return f"{count} bottles"


def _verse(count):
    if count == 0:
        return [
            "No more bottles of beer on the wall, no more bottles of beer.",
            "Go to the store and buy some more, 99 bottles of beer on the wall.",
        ]
    return [
        f"{_bottles(count)} of beer on the wall, {_bottles(count)} of beer.",
        f"Take {'it' if count == 1 else 'one'} down and pass it around, "
        f"{_bottles(count - 1)} of beer on the wall.",
    ]


def recite(start, take=1):
    lines = []
    for i in range(take):
        if lines:
            lines.append("")
        lines.extend(_verse(start - i))
    return lines
