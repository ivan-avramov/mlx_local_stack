def can_chain(dominoes):
    if not dominoes:
        return []

    def backtrack(remaining, chain, end):
        if not remaining:
            if chain[0][0] == end:
                return chain
            return None
        for i, (a, b) in enumerate(remaining):
            rest = remaining[:i] + remaining[i + 1:]
            if a == end:
                result = backtrack(rest, chain + [(a, b)], b)
                if result:
                    return result
            if b == end and a != b:
                result = backtrack(rest, chain + [(b, a)], a)
                if result:
                    return result
        return None

    for i, (a, b) in enumerate(dominoes):
        rest = dominoes[:i] + dominoes[i + 1:]
        result = backtrack(rest, [(a, b)], b)
        if result:
            return result
        if a != b:
            result = backtrack(rest, [(b, a)], a)
            if result:
                return result
    return None
