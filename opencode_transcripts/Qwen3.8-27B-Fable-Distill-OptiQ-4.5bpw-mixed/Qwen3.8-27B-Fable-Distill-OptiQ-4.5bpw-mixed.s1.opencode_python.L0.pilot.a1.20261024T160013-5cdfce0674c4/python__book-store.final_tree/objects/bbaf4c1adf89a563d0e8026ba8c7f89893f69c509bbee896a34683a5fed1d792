from collections import Counter

COSTS = {1: 800, 2: 1520, 3: 2160, 4: 2560, 5: 3000}


def total(basket):
    counts = Counter(basket)
    price = 0
    while counts:
        # Form a group from the titles with the most remaining copies.
        size = min(5, len(counts))
        for _ in range(size):
            title = max(counts, key=counts.get)
            counts[title] -= 1
            if counts[title] == 0:
                del counts[title]
        price += COSTS[size]
    return price
