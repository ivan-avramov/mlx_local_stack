def _bottles(count):
    if count == 0:
        return "no more bottles"
    if count == 1:
        return "1 bottle"
    return f"{count} bottles"


def recite(start, take=1):
    lines = []
    for count in range(start, start - take, -1):
        if count > 1:
            second = (
                f"Take one down and pass it around, "
                f"{_bottles(count - 1)} of beer on the wall."
            )
        elif count == 1:
            second = (
                "Take it down and pass it around, "
                "no more bottles of beer on the wall."
            )
        else:
            second = (
                "Go to the store and buy some more, "
                "99 bottles of beer on the wall."
            )
        lines.append(f"{_bottles(count).capitalize()} of beer on the wall, "
                     f"{_bottles(count)} of beer.")
        lines.append(second)
        if count > start - take + 1:
            lines.append("")
    return lines
