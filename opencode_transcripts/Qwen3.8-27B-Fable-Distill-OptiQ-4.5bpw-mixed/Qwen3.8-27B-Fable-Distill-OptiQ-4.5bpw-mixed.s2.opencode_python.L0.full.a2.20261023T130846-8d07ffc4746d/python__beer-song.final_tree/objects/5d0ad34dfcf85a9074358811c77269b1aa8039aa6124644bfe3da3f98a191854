def _bottles(n):
    if n == 0:
        return "No more bottles"
    if n == 1:
        return "1 bottle"
    return f"{n} bottles"


def _verse(n):
    action = {
        0: "Go to the store and buy some more",
        1: "Take it down and pass it around",
    }.get(n, "Take one down and pass it around")
    next_n = 99 if n == 0 else n - 1
    return [
        f"{_bottles(n)} of beer on the wall, {_bottles(n).lower()} of beer.",
        f"{action}, {_bottles(next_n).lower()} of beer on the wall.",
    ]


def recite(start, take=1):
    lines = []
    for n in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.extend(_verse(n))
    return lines
