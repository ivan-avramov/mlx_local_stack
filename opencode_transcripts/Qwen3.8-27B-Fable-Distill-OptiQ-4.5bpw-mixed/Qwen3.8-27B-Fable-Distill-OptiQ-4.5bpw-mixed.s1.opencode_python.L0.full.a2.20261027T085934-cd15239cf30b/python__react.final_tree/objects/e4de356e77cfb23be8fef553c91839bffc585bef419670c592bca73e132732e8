class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._dependents = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        self._value = new_value
        self._propagate()

    def _propagate(self):
        # Collect every reachable cell in postorder (a cell appears after the
        # cells it depends on), then recompute in reverse so each compute cell
        # is evaluated exactly once, after all of its dependencies have their
        # final values. This guarantees callbacks fire once, with the value
        # from the new stable state.
        order = []
        visited = set()

        def visit(cell):
            if id(cell) in visited:
                return
            visited.add(id(cell))
            for dependent in cell._dependents:
                visit(dependent)
            order.append(cell)

        visit(self)
        for cell in reversed(order):
            if isinstance(cell, ComputeCell):
                cell._recompute()


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = list(inputs)
        self._compute_function = compute_function
        self._callbacks = []
        self._dependents = []
        self.value = None
        for cell in self._inputs:
            cell._dependents.append(self)
        self._recompute()

    def _recompute(self):
        old_value = self.value
        self.value = self._compute_function([cell.value for cell in self._inputs])
        if self.value != old_value:
            for callback in self._callbacks:
                callback(self.value)

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self._callbacks:
            self._callbacks.remove(callback)
