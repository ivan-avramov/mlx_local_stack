class School:
    def __init__(self):
        self._students = {}
        self._enrolled = set()
        self._added = []

    def add_student(self, name, grade):
        added = name not in self._enrolled
        if added:
            self._enrolled.add(name)
            self._students.setdefault(grade, set()).add(name)
        self._added.append(added)

    def roster(self):
        return [
            name
            for grade in sorted(self._students)
            for name in sorted(self._students[grade])
        ]

    def grade(self, grade_number):
        return sorted(self._students.get(grade_number, set()))

    def added(self):
        return self._added
