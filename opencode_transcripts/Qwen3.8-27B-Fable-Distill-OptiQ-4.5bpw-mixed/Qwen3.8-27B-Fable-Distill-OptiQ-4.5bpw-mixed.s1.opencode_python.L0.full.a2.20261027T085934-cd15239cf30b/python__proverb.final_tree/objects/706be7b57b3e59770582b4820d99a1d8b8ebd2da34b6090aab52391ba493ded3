def proverb(*pieces, qualifier=None):
    lines = [
        f"For want of a {cause} the {effect} was lost."
        for cause, effect in zip(pieces, pieces[1:])
    ]
    if pieces:
        first = pieces[0]
        if qualifier:
            first = f"{qualifier} {first}"
        lines.append(f"And all for the want of a {first}.")
    return lines
