_NUMBERS = {
    0: "no",
    1: "One",
    2: "Two",
    3: "Three",
    4: "Four",
    5: "Five",
    6: "Six",
    7: "Seven",
    8: "Eight",
    9: "Nine",
    10: "Ten",
}


def _word(n, upper=True):
    w = _NUMBERS[n]
    return w if upper else w.lower()


def _bottles(n):
    return "bottle" if n == 1 else "bottles"


def recite(start, take=1):
    lines = []
    for i in range(take):
        n = start - i
        lines.extend(
            [
                f"{_word(n)} green {_bottles(n)} hanging on the wall,",
                f"{_word(n)} green {_bottles(n)} hanging on the wall,",
                "And if one green bottle should accidentally fall,",
                f"There'll be {_word(n - 1, upper=False)} green {_bottles(n - 1)} hanging on the wall.",
            ]
        )
        if i < take - 1:
            lines.append("")
    return lines
