package bottlesong

import (
	"fmt"
	"strings"
)

var numberNames = map[int]string{
	0:  "no",
	1:  "One",
	2:  "Two",
	3:  "Three",
	4:  "Four",
	5:  "Five",
	6:  "Six",
	7:  "Seven",
	8:  "Eight",
	9:  "Nine",
	10: "Ten",
}

// bottlePhrase returns the human-readable form of a bottle count,
// e.g. "Ten green bottles" or "One green bottle".
func bottlePhrase(n int, capitalized bool) string {
	name := numberNames[n]
	if !capitalized {
		name = strings.ToLower(name)
	}
	plural := "bottles"
	if n == 1 {
		plural = "bottle"
	}
	return fmt.Sprintf("%s green %s", name, plural)
}

func Recite(startBottles, takeDown int) []string {
	var verses []string
	for n := startBottles; n > startBottles-takeDown; n-- {
		verse := []string{
			bottlePhrase(n, true) + " hanging on the wall,",
			bottlePhrase(n, true) + " hanging on the wall,",
			"And if one green bottle should accidentally fall,",
			"There'll be " + bottlePhrase(n-1, false) + " hanging on the wall.",
		}
		verses = append(verses, verse...)
		if n > startBottles-takeDown+1 {
			verses = append(verses, "")
		}
	}
	return verses
}
