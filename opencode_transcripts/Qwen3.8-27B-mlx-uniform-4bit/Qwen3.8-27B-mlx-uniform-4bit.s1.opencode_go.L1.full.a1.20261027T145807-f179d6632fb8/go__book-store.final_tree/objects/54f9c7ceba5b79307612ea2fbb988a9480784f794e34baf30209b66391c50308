package bookstore

import "sort"

// Cost calculates the total cost (in cents) of a basket of books,
// applying the largest possible discount.
//
// Books are numbered 1-5. A single book costs 800. Groups of distinct
// titles are discounted: 2 -> 5%, 3 -> 10%, 4 -> 20%, 5 -> 25%.
func Cost(books []int) int {
	var counts [5]int
	for _, b := range books {
		if b >= 1 && b <= 5 {
			counts[b-1]++
		}
	}
	sort.Ints(counts[:])

	// Price of a group of 1..5 distinct books.
	price := [6]int{0, 800, 1520, 2160, 2560, 3000}

	// Greedily form the largest groups first: as many groups of 5 as
	// possible, then 4, then 3, then 2, then 1.
	groups5 := counts[0]
	for i := 0; i < 5; i++ {
		counts[i] -= groups5
	}
	groups4 := counts[1]
	for i := 1; i < 5; i++ {
		counts[i] -= groups4
	}
	groups3 := counts[2]
	for i := 2; i < 5; i++ {
		counts[i] -= groups3
	}
	groups2 := counts[3]
	counts[3] -= groups2
	counts[4] -= groups2
	groups1 := counts[4]

	// A group of 5 plus a group of 3 costs 5160, while two groups of 4
	// cost 5120. Swap as many 5+3 pairs as possible for 4+4 pairs.
	swap := groups5
	if groups3 < swap {
		swap = groups3
	}
	groups5 -= swap
	groups3 -= swap
	groups4 += 2 * swap

	return groups5*price[5] + groups4*price[4] + groups3*price[3] + groups2*price[2] + groups1*price[1]
}
