def _bottles(n):
    if n == 0:
        return "no more bottles"
    if n == 1:
        return "1 bottle"
    return f"{n} bottles"


def _verse(n):
    first = f"{_bottles(n)} of beer on the wall, {_bottles(n)} of beer."
    if n == 0:
        first = first[0].upper() + first[1:]
        second = "Go to the store and buy some more, 99 bottles of beer on the wall."
    elif n == 1:
        second = "Take it down and pass it around, no more bottles of beer on the wall."
    else:
        second = f"Take one down and pass it around, {_bottles(n - 1)} of beer on the wall."
    return [first, second]


def recite(start, take=1):
    lines = []
    for i in range(take):
        if i:
            lines.append("")
        lines.extend(_verse(start - i))
    return lines
