def _bottles(n):
    if n == 0:
        return "no more bottles of beer"
    if n == 1:
        return "1 bottle of beer"
    return f"{n} bottles of beer"


def _verse(n):
    phrase = _bottles(n)
    first_phrase = phrase[0].upper() + phrase[1:]
    first = f"{first_phrase} on the wall, {phrase}."
    if n == 0:
        second = "Go to the store and buy some more, 99 bottles of beer on the wall."
    else:
        action = "it" if n == 1 else "one"
        second = f"Take {action} down and pass it around, {_bottles(n - 1)} on the wall."
    return [first, second]


def recite(start, take=1):
    lines = []
    for i in range(take):
        if i > 0:
            lines.append("")
        lines.extend(_verse(start - i))
    return lines
