VOWELS = "aeiou"


def _translate_word(word):
    # Rule 1: begins with a vowel, or with "xr" or "yt"
    if word[0] in VOWELS or word.startswith(("xr", "yt")):
        return word + "ay"

    # Find where the leading consonant cluster ends.
    split = len(word)
    for i, ch in enumerate(word):
        if word.startswith("qu", i):
            # Rule 3: consonants (if any) plus "qu" move to the end
            split = i + 2
            break
        if ch in VOWELS:
            # Rule 2: consonants before the first vowel move to the end
            split = i
            break
        if ch == "y" and i > 0:
            # Rule 4: consonants before "y" move to the end
            split = i
            break

    return word[split:] + word[:split] + "ay"


def translate(text):
    return " ".join(_translate_word(word) for word in text.split(" "))
