package beer

import (
	"errors"
	"fmt"
	"strings"
)

const maxBottles = 99

// Song returns the entire song, from 99 bottles down to no more.
func Song() string {
	s, _ := Verses(maxBottles, 0)
	return s
}

// Verses returns the verses from start down to and including stop,
// separated by blank lines.
func Verses(start, stop int) (string, error) {
	if start < 0 || start > maxBottles || stop < 0 || start < stop {
		return "", errors.New("invalid verse range")
	}
	var b strings.Builder
	for n := start; n >= stop; n-- {
		verse, _ := Verse(n)
		b.WriteString(verse)
		b.WriteString("\n")
	}
	return b.String(), nil
}

// Verse returns the verse for the given number of bottles.
func Verse(n int) (string, error) {
	if n < 0 || n > maxBottles {
		return "", fmt.Errorf("verse %d is out of range", n)
	}
	switch n {
	case 0:
		return "No more bottles of beer on the wall, no more bottles of beer.\n" +
			"Go to the store and buy some more, 99 bottles of beer on the wall.\n", nil
	case 1:
		return "1 bottle of beer on the wall, 1 bottle of beer.\n" +
			"Take it down and pass it around, no more bottles of beer on the wall.\n", nil
	default:
		return fmt.Sprintf(
			"%s of beer on the wall, %s of beer.\n"+
				"Take one down and pass it around, %s of beer on the wall.\n",
			bottles(n), bottles(n), bottles(n-1)), nil
	}
}

// bottles renders the count phrase, e.g. "no more bottles", "1 bottle", "7 bottles".
func bottles(n int) string {
	switch n {
	case 0:
		return "no more bottles"
	case 1:
		return "1 bottle"
	default:
		return fmt.Sprintf("%d bottles", n)
	}
}
