class School:
    def __init__(self):
        self._grades = {}
        self._added = []

    def add_student(self, name, grade):
        for students in self._grades.values():
            if name in students:
                self._added.append(False)
                return False
        self._grades.setdefault(grade, []).append(name)
        self._added.append(True)
        return True

    def roster(self):
        students = []
        for grade in sorted(self._grades):
            students.extend(sorted(self._grades[grade]))
        return students

    def grade(self, grade_number):
        return sorted(self._grades.get(grade_number, []))

    def added(self):
        return self._added
