NUMBERS = {
    0: "no",
    1: "one",
    2: "two",
    3: "three",
    4: "four",
    5: "five",
    6: "six",
    7: "seven",
    8: "eight",
    9: "nine",
    10: "Ten",
}


def _bottles(count):
    return f"{NUMBERS[count]} green bottle{'s' if count != 1 else ''}"


def _verse(count):
    return [
        f"{_bottles(count).capitalize()} hanging on the wall,",
        f"{_bottles(count).capitalize()} hanging on the wall,",
        "And if one green bottle should accidentally fall,",
        f"There'll be {_bottles(count - 1)} hanging on the wall.",
    ]


def recite(start, take=1):
    lines = []
    for count in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.extend(_verse(count))
    return lines
