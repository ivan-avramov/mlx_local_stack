package kindergarten

import (
	"errors"
	"fmt"
	"sort"
	"strings"
)

// Garden holds the plant diagram and the alphabetized order of the
// children assigned to it.
type Garden struct {
	rows     [2]string
	children []string
}

var plantNames = map[rune]string{
	'G': "grass",
	'C': "clover",
	'R': "radishes",
	'V': "violets",
}

// NewGarden parses a two-row plant diagram (each row prefixed with a
// newline so Go raw string literals read naturally) and the list of
// children responsible for it. The children are assigned to cups
// alphabetically, two cups per row. The children slice is not modified.
func NewGarden(diagram string, children []string) (*Garden, error) {
	if !strings.HasPrefix(diagram, "\n") {
		return nil, errors.New("diagram must start with a newline")
	}
	rows := strings.Split(diagram[1:], "\n")
	if len(rows) != 2 {
		return nil, errors.New("diagram must have exactly two rows")
	}
	if len(rows[0]) != len(rows[1]) {
		return nil, errors.New("diagram rows must be the same length")
	}
	if len(rows[0])%2 != 0 {
		return nil, errors.New("diagram must contain an even number of cups")
	}
	for _, row := range rows {
		for _, c := range row {
			if _, ok := plantNames[c]; !ok {
				return nil, fmt.Errorf("invalid cup code %q", c)
			}
		}
	}

	seen := make(map[string]bool, len(children))
	for _, child := range children {
		if seen[child] {
			return nil, fmt.Errorf("duplicate child %q", child)
		}
		seen[child] = true
	}

	sorted := make([]string, len(children))
	copy(sorted, children)
	sort.Strings(sorted)

	return &Garden{
		rows:     [2]string{rows[0], rows[1]},
		children: sorted,
	}, nil
}

// Plants returns the four plants belonging to the named child: the two
// cups on the window row, then the two cups on the far row. The second
// return value is false if the child is not in the garden.
func (g *Garden) Plants(child string) ([]string, bool) {
	idx := sort.SearchStrings(g.children, child)
	if idx >= len(g.children) || g.children[idx] != child {
		return nil, false
	}
	plants := make([]string, 0, 4)
	for _, row := range g.rows {
		plants = append(plants, plantNames[rune(row[idx*2])], plantNames[rune(row[idx*2+1])])
	}
	return plants, true
}
