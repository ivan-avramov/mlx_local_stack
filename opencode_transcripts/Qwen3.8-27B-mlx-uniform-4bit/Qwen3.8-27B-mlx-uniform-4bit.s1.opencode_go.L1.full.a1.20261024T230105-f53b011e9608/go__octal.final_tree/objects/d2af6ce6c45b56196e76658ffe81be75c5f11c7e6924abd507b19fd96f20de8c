package octal

import (
	"errors"
)

// ParseOctal converts an octal number, represented as a string, to its
// decimal equivalent using first principles.
//
// Each digit is accumulated into the result by multiplying the running total
// by 8 and adding the digit's value, which is equivalent to summing each
// digit weighted by its power of 8.
//
// Invalid input (a string containing any character other than 0-7) is
// treated as octal 0 and an error is returned.
func ParseOctal(input string) (int64, error) {
	var result int64
	for _, r := range input {
		if r < '0' || r > '7' {
			return 0, errors.New("invalid octal input: " + input)
		}
		result = result*8 + int64(r-'0')
	}
	return result, nil
}
