package paasio

import (
	"io"
	"sync"
)

// readCounter is a wrapper around an io.Reader that counts the total number
// of bytes read along with the total number of calls to Read().
type readCounter struct {
	reader io.Reader

	mu   sync.Mutex
	n    int64
	nops int
}

// writeCounter is a wrapper around an io.Writer that counts the total number
// of bytes written along with the total number of calls to Write().
type writeCounter struct {
	writer io.Writer

	mu   sync.Mutex
	n    int64
	nops int
}

// readWriteCounter is a wrapper around an io.ReadWriter that counts both
// reads and writes. It satisfies the ReadWriteCounter interface.
type readWriteCounter struct {
	*readCounter
	*writeCounter
}

// NewWriteCounter returns a WriteCounter that wraps writer.
func NewWriteCounter(writer io.Writer) WriteCounter {
	return &writeCounter{writer: writer}
}

// NewReadCounter returns a ReadCounter that wraps reader.
func NewReadCounter(reader io.Reader) ReadCounter {
	return &readCounter{reader: reader}
}

// NewReadWriteCounter returns a ReadWriteCounter that wraps readwriter.
func NewReadWriteCounter(readwriter io.ReadWriter) ReadWriteCounter {
	return &readWriteCounter{
		readCounter:  NewReadCounter(readwriter).(*readCounter),
		writeCounter: NewWriteCounter(readwriter).(*writeCounter),
	}
}

func (rc *readCounter) Read(p []byte) (int, error) {
	n, err := rc.reader.Read(p)
	rc.mu.Lock()
	rc.n += int64(n)
	rc.nops++
	rc.mu.Unlock()
	return n, err
}

// ReadCount returns the total number of bytes successfully read along with
// the total number of calls to Read(). Both values are read under the same
// lock so callers always observe a consistent snapshot, even while other
// goroutines are concurrently calling Read.
func (rc *readCounter) ReadCount() (int64, int) {
	rc.mu.Lock()
	defer rc.mu.Unlock()
	return rc.n, rc.nops
}

func (wc *writeCounter) Write(p []byte) (int, error) {
	n, err := wc.writer.Write(p)
	wc.mu.Lock()
	wc.n += int64(n)
	wc.nops++
	wc.mu.Unlock()
	return n, err
}

// WriteCount returns the total number of bytes successfully written along
// with the total number of calls to Write(). Both values are read under the
// same lock so callers always observe a consistent snapshot, even while
// other goroutines are concurrently calling Write.
func (wc *writeCounter) WriteCount() (int64, int) {
	wc.mu.Lock()
	defer wc.mu.Unlock()
	return wc.n, wc.nops
}
