package bottlesong

import (
	"fmt"
	"strings"
)

var numberWords = map[int]string{
	0:  "no",
	1:  "one",
	2:  "two",
	3:  "three",
	4:  "four",
	5:  "five",
	6:  "six",
	7:  "seven",
	8:  "eight",
	9:  "nine",
	10: "ten",
}

func Recite(startBottles, takeDown int) []string {
	var lines []string
	for i := 0; i < takeDown; i++ {
		n := startBottles - i
		lines = append(lines,
			fmt.Sprintf("%s green bottle%s hanging on the wall,", bottlePhrase(n, true), bottlePlural(n)),
			fmt.Sprintf("%s green bottle%s hanging on the wall,", bottlePhrase(n, true), bottlePlural(n)),
			"And if one green bottle should accidentally fall,",
			fmt.Sprintf("There'll be %s green bottle%s hanging on the wall.", bottlePhrase(n-1, false), bottlePlural(n-1)),
		)
		if i < takeDown-1 {
			lines = append(lines, "")
		}
	}
	return lines
}

// bottlePhrase returns the word for the count, e.g. "ten", "one", "no".
// If capitalize is true, the first letter is uppercased.
func bottlePhrase(n int, capitalize bool) string {
	w := numberWords[n]
	if !capitalize {
		return w
	}
	return strings.ToUpper(w[:1]) + w[1:]
}

// bottlePlural returns the plural suffix for the count: "" for one, "s" otherwise.
func bottlePlural(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
