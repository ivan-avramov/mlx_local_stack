def proverb(*pieces, qualifier=None):
    lines = [
        f"For want of a {a} the {b} was lost."
        for a, b in zip(pieces, pieces[1:])
    ]
    if pieces:
        if qualifier:
            lines.append(f"And all for the want of a {qualifier} {pieces[0]}.")
        else:
            lines.append(f"And all for the want of a {pieces[0]}.")
    return lines
