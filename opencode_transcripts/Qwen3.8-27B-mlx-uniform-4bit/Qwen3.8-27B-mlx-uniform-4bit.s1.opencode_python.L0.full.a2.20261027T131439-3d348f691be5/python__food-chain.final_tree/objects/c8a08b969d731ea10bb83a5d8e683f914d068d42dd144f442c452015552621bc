"""Lyrics for 'I Know an Old Lady Who Swallowed a Fly' (cumulative song)."""

_ANIMALS = ["fly", "spider", "bird", "cat", "dog", "goat", "cow", "horse"]

_COMMENTS = {
    2: "It wriggled and jiggled and tickled inside her.",
    3: "How absurd to swallow a bird!",
    4: "Imagine that, to swallow a cat!",
    5: "What a hog, to swallow a dog!",
    6: "Just opened her throat and swallowed a goat!",
    7: "I don't know how she swallowed a cow!",
    8: "She's dead, of course!",
}

_SPIDER_REF = "the spider that wriggled and jiggled and tickled inside her"


def _refers_to(verse):
    """How the animal swallowed in `verse` is referred to as prey."""
    if verse == 2:
        return _SPIDER_REF
    return f"the {_ANIMALS[verse - 1]}"


def _verse(verse):
    lines = [f"I know an old lady who swallowed a {_ANIMALS[verse - 1]}."]
    if verse in _COMMENTS:
        lines.append(_COMMENTS[verse])
    if verse == 8:
        return lines
    for k in range(verse, 1, -1):
        lines.append(
            f"She swallowed the {_ANIMALS[k - 1]} to catch {_refers_to(k - 1)}."
        )
    lines.append("I don't know why she swallowed the fly. Perhaps she'll die.")
    return lines


def recite(start_verse, end_verse):
    lines = []
    for verse in range(start_verse, end_verse + 1):
        if lines:
            lines.append("")
        lines.extend(_verse(verse))
    return lines
