import math
import string

ALPHABET = string.ascii_lowercase
M = len(ALPHABET)


def _check_coprime(a):
    if math.gcd(a, M) != 1:
        raise ValueError("a and m must be coprime.")


def encode(plain_text, a, b):
    _check_coprime(a)
    encoded = []
    for char in plain_text.lower():
        if char in ALPHABET:
            i = ALPHABET.index(char)
            encoded.append(ALPHABET[(a * i + b) % M])
        elif char.isdigit():
            encoded.append(char)
    return " ".join("".join(encoded)[i:i + 5] for i in range(0, len(encoded), 5))


def decode(ciphered_text, a, b):
    _check_coprime(a)
    a_inv = pow(a, -1, M)
    decoded = []
    for char in ciphered_text:
        if char in ALPHABET:
            y = ALPHABET.index(char)
            decoded.append(ALPHABET[(a_inv * (y - b)) % M])
        elif char.isdigit():
            decoded.append(char)
    return "".join(decoded)
