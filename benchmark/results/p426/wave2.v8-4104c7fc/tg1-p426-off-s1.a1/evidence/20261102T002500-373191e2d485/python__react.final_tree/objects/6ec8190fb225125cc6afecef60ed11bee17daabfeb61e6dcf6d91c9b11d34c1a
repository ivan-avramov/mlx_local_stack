class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._observers = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        self._value = new_value
        _propagate(self)


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = inputs
        self._compute_function = compute_function
        self._callbacks = []
        self._observers = []
        self.value = self._compute()
        for cell in inputs:
            cell._observers.append(self)

    def _compute(self):
        return self._compute_function([cell.value for cell in self._inputs])

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        try:
            self._callbacks.remove(callback)
        except ValueError:
            pass


def _propagate(source):
    """Recompute every cell that depends on ``source`` until the system
    reaches a new stable state, then fire the callbacks of the cells whose
    value changed from the previous stable state (each exactly once)."""
    affected = set()
    stack = list(source._observers)
    while stack:
        cell = stack.pop()
        if cell not in affected:
            affected.add(cell)
            stack.extend(cell._observers)

    changed = set()
    remaining = set(affected)
    while remaining:
        progressed = False
        for cell in list(remaining):
            if all(dep not in remaining for dep in cell._inputs):
                old_value = cell.value
                cell.value = cell._compute()
                if cell.value != old_value:
                    changed.add(cell)
                remaining.discard(cell)
                progressed = True
        if not progressed:
            break  # cycle in the dependency graph; avoid an infinite loop

    for cell in changed:
        for callback in list(cell._callbacks):
            callback(cell.value)
