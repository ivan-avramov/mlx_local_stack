package ledger

// Refactoring log:
//
// The original implementation mixed concerns and used several obscure tricks:
// a hand-rolled selection sort driven by boolean->int maps, a goroutine-per-row
// fan-out over a channel to build rows "in parallel", and a recursive call to
// FormatLedger just to validate the currency when the entry list was empty.
//
// The rewrite keeps the exact output identical (all tests pass) but splits the
// work into small, named helpers:
//   - FormatLedger validates the currency and locale, sorts a copy of the input
//     (so the caller's slice is never mutated), then renders the header and one
//     row per entry.
//   - header/locale-specific labels, formatDate, formatDescription and
//     formatAmount each handle a single formatting concern.
//   - formatCents turns an absolute cent amount into a grouped number using the
//     locale's thousands and decimal separators.
//
// Sorting is expressed with sort.Slice using the same (date, description,
// change) ordering the original produced.

import (
	"errors"
	"sort"
	"strconv"
	"strings"
	"unicode/utf8"
)

type Entry struct {
	Date        string // "Y-m-d"
	Description string
	Change      int // in cents
}

var errInvalidInput = errors.New("invalid input")

const (
	dateColumnWidth    = 10
	descriptionWidth   = 25
	changeColumnWidth  = 13
	descriptionMaxLen  = 25
	descriptionTruncAt = 22
)

func FormatLedger(currency string, locale string, entries []Entry) (string, error) {
	if err := validate(currency, locale); err != nil {
		return "", err
	}

	sorted := make([]Entry, len(entries))
	copy(sorted, entries)
	sort.Slice(sorted, func(i, j int) bool {
		if sorted[i].Date != sorted[j].Date {
			return sorted[i].Date < sorted[j].Date
		}
		if sorted[i].Description != sorted[j].Description {
			return sorted[i].Description < sorted[j].Description
		}
		return sorted[i].Change < sorted[j].Change
	})

	var b strings.Builder
	b.WriteString(header(locale))
	for _, entry := range sorted {
		line, err := formatRow(currency, locale, entry)
		if err != nil {
			return "", err
		}
		b.WriteString(line)
	}
	return b.String(), nil
}

// validate rejects currencies and locales that are not supported.
func validate(currency, locale string) error {
	if currency != "USD" && currency != "EUR" {
		return errInvalidInput
	}
	if locale != "en-US" && locale != "nl-NL" {
		return errInvalidInput
	}
	return nil
}

func header(locale string) string {
	dateHeader, descHeader, changeHeader := "Date", "Description", "Change"
	if locale == "nl-NL" {
		dateHeader, descHeader, changeHeader = "Datum", "Omschrijving", "Verandering"
	}
	return dateHeader + strings.Repeat(" ", dateColumnWidth-len(dateHeader)) + " | " +
		descHeader + strings.Repeat(" ", descriptionWidth-len(descHeader)) + " | " +
		changeHeader + "\n"
}

func formatRow(currency, locale string, entry Entry) (string, error) {
	date, err := formatDate(locale, entry.Date)
	if err != nil {
		return "", err
	}
	description := formatDescription(entry.Description)
	amount := formatAmount(currency, locale, entry.Change)
	return date + strings.Repeat(" ", dateColumnWidth-len(date)) + " | " +
		description + " | " +
		strings.Repeat(" ", changeColumnWidth-utf8.RuneCountInString(amount)) + amount + "\n", nil
}

// formatDate renders "YYYY-MM-DD" as "MM/DD/YYYY" (en-US) or "DD-MM-YYYY" (nl-NL).
func formatDate(locale, date string) (string, error) {
	if len(date) != 10 || date[4] != '-' || date[7] != '-' {
		return "", errInvalidInput
	}
	year := date[0:4]
	month := date[5:7]
	day := date[8:10]
	if locale == "nl-NL" {
		return day + "-" + month + "-" + year, nil
	}
	return month + "/" + day + "/" + year, nil
}

// formatDescription pads the description to a fixed width, truncating overlong
// values with an ellipsis.
func formatDescription(description string) string {
	if len(description) > descriptionMaxLen {
		return description[:descriptionTruncAt] + "..."
	}
	return description + strings.Repeat(" ", descriptionWidth-len(description))
}

// formatAmount renders a signed amount in cents for the given currency and locale.
func formatAmount(currency, locale string, cents int) string {
	negative := cents < 0
	if negative {
		cents = -cents
	}
	symbol := currencySymbol(currency)

	var a string
	if locale == "nl-NL" {
		// Dutch: symbol, space, number, then a trailing - or space.
		a = symbol + " " + formatCents(cents, ".", ",")
		if negative {
			a += "-"
		} else {
			a += " "
		}
	} else {
		// American: optional parentheses around the amount, or a trailing space.
		if negative {
			a = "(" + symbol + formatCents(cents, ",", ".") + ")"
		} else {
			a = symbol + formatCents(cents, ",", ".") + " "
		}
	}
	return a
}

func currencySymbol(currency string) string {
	if currency == "EUR" {
		return "€"
	}
	return "$"
}

// formatCents turns a non-negative cent amount into a grouped number with two
// decimal places, using the supplied thousands and decimal separators.
func formatCents(cents int, thousandsSep, decimalSep string) string {
	s := strconv.Itoa(cents)
	switch len(s) {
	case 1:
		s = "00" + s
	case 2:
		s = "0" + s
	}
	intPart := s[:len(s)-2]
	decPart := s[len(s)-2:]

	var grouped string
	for len(intPart) > 3 {
		grouped = thousandsSep + intPart[len(intPart)-3:] + grouped
		intPart = intPart[:len(intPart)-3]
	}
	return intPart + grouped + decimalSep + decPart
}
