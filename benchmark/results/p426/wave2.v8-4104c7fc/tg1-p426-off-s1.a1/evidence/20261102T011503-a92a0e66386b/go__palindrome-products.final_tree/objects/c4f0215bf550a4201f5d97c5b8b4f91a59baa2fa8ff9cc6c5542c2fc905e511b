package palindrome

import (
	"errors"
	"fmt"
)

// Product represents a palindromic product and its factorizations.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products returns the smallest and largest palindromic products of two
// numbers within the range [fmin, fmax] (both inclusive), along with all
// factor pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	var min, max Product
	min.Value = -1
	for a := fmin; a <= fmax; a++ {
		for b := a; b <= fmax; b++ {
			p := a * b
			if !isPalindrome(p) {
				continue
			}
			if min.Value == -1 || p < min.Value {
				min = Product{p, [][2]int{{a, b}}}
			} else if p == min.Value {
				min.Factorizations = append(min.Factorizations, [2]int{a, b})
			}
			if p > max.Value {
				max = Product{p, [][2]int{{a, b}}}
			} else if p == max.Value {
				max.Factorizations = append(max.Factorizations, [2]int{a, b})
			}
		}
	}
	if min.Value == -1 {
		return Product{}, Product{}, errors.New("no palindromes")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	if n < 0 {
		return false
	}
	s := fmt.Sprintf("%d", n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
