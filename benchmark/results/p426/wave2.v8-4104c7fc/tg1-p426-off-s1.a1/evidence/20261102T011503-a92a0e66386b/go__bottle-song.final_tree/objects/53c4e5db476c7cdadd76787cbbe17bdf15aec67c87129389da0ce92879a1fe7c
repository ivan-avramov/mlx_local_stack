package bottlesong

import (
	"fmt"
	"strings"
)

var bottleCounts = map[int]string{
	0: "no", 1: "one", 2: "two", 3: "three", 4: "four",
	5: "five", 6: "six", 7: "seven", 8: "eight",
	9: "nine", 10: "ten",
}

func Recite(startBottles, takeDown int) []string {
	var lines []string
	for n := startBottles; n > startBottles-takeDown; n-- {
		if len(lines) > 0 {
			lines = append(lines, "")
		}
		lines = append(lines,
			fmt.Sprintf("%s green bottle%s hanging on the wall,", capitalize(bottleCounts[n]), plural(n)),
			fmt.Sprintf("%s green bottle%s hanging on the wall,", capitalize(bottleCounts[n]), plural(n)),
			"And if one green bottle should accidentally fall,",
			fmt.Sprintf("There'll be %s green bottle%s hanging on the wall.", bottleCounts[n-1], plural(n-1)),
		)
	}
	return lines
}

func plural(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

// capitalize capitalizes the first rune of s.
func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(string(s[0])) + s[1:]
}
