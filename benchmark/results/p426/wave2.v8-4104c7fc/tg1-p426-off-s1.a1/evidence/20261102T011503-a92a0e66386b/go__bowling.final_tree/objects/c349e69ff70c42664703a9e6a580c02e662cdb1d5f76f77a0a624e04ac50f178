package bowling

import "errors"

// Errors returned by Game methods.
var (
	errNegativeRoll = errors.New("Negative roll is invalid")
	errPinCount     = errors.New("Pin count exceeds pins on the lane")
	errGameOver     = errors.New("Cannot roll after game is over")
	errNotComplete  = errors.New("Score cannot be taken until the end of the game")
)

// Game keeps track of a bowling game and computes its score.
type Game struct {
	rolls       []int
	frame       int // current frame, 1-indexed; 11 means the game is over
	rollInFrame int // index of the roll about to be made in the current frame (0, 1, or 2)
}

// NewGame returns a new, unstarted bowling game.
func NewGame() *Game {
	return &Game{frame: 1}
}

// Roll records a single throw of the ball that knocks down pins pins.
func (g *Game) Roll(pins int) error {
	if pins < 0 {
		return errNegativeRoll
	}
	if pins > 10 {
		return errPinCount
	}
	if g.gameOver() {
		return errGameOver
	}
	if err := g.validateRoll(pins); err != nil {
		return err
	}
	g.rolls = append(g.rolls, pins)
	g.advance()
	return nil
}

// Score returns the total score of a completed game.
func (g *Game) Score() (int, error) {
	if !g.gameOver() {
		return 0, errNotComplete
	}
	return g.totalScore(), nil
}

// gameOver reports whether all frames have been completed.
func (g *Game) gameOver() bool {
	return g.frame > 10
}

// validateRoll ensures pins does not exceed the pins still standing for the
// roll about to be made.
func (g *Game) validateRoll(pins int) error {
	n := len(g.rolls)
	if g.frame < 10 {
		if g.rollInFrame == 1 {
			first := g.rolls[n-1]
			if pins > 10-first {
				return errPinCount
			}
		}
		return nil
	}
	// Tenth frame.
	switch g.rollInFrame {
	case 0:
		return nil
	case 1:
		roll1 := g.rolls[n-1]
		if roll1 < 10 && pins > 10-roll1 {
			return errPinCount
		}
		return nil
	case 2:
		roll1 := g.rolls[n-2]
		roll2 := g.rolls[n-1]
		if roll1 == 10 && roll2 < 10 && pins > 10-roll2 {
			return errPinCount
		}
		return nil
	}
	return nil
}

// advance moves the game state forward after a roll has been recorded.
func (g *Game) advance() {
	last := g.rolls[len(g.rolls)-1]
	if g.frame < 10 {
		if g.rollInFrame == 0 {
			if last == 10 {
				g.frame++
				g.rollInFrame = 0
			} else {
				g.rollInFrame = 1
			}
		} else {
			g.frame++
			g.rollInFrame = 0
		}
		return
	}
	// Tenth frame.
	switch g.rollInFrame {
	case 0:
		g.rollInFrame = 1
	case 1:
		roll1 := g.rolls[len(g.rolls)-2]
		if roll1 == 10 || roll1+last == 10 {
			g.rollInFrame = 2
		} else {
			g.frame = 11
		}
	case 2:
		g.frame = 11
	}
}

// totalScore computes the score of a completed game.
func (g *Game) totalScore() int {
	total := 0
	i := 0
	for frame := 1; frame <= 10; frame++ {
		if frame < 10 {
			switch {
			case g.rolls[i] == 10:
				total += 10 + g.rolls[i+1] + g.rolls[i+2]
				i++
			case g.rolls[i]+g.rolls[i+1] == 10:
				total += 10 + g.rolls[i+2]
				i += 2
			default:
				total += g.rolls[i] + g.rolls[i+1]
				i += 2
			}
		} else {
			for ; i < len(g.rolls); i++ {
				total += g.rolls[i]
			}
		}
	}
	return total
}
