package alphametics

import (
	"errors"
	"sort"
	"strings"
)

// Solve finds a digit for every letter in the puzzle such that the equation
// holds. The puzzle has the form "WORD + WORD + ... == WORD". Each letter
// maps to a distinct digit, and the leading letter of a multi-letter word may
// not map to zero. It returns an error if the puzzle is invalid or has no
// solution.
func Solve(puzzle string) (map[string]int, error) {
	parts := strings.Split(puzzle, "==")
	if len(parts) != 2 {
		return nil, errors.New("invalid puzzle: expected exactly one '=='")
	}

	addends := strings.Split(parts[0], "+")
	for i, w := range addends {
		addends[i] = strings.TrimSpace(w)
	}
	for _, w := range addends {
		if w == "" {
			return nil, errors.New("invalid puzzle: empty word")
		}
	}
	result := strings.TrimSpace(parts[1])
	if result == "" {
		return nil, errors.New("invalid puzzle: empty result")
	}

	letterSet := make(map[string]struct{})
	leading := make(map[string]bool)
	add := func(word string) {
		for _, ch := range word {
			letterSet[string(ch)] = struct{}{}
		}
		if len(word) > 1 {
			leading[word[:1]] = true
		}
	}
	for _, w := range addends {
		add(w)
	}
	add(result)

	if len(letterSet) > 10 {
		return nil, errors.New("puzzle has more than ten distinct letters")
	}

	letters := make([]string, 0, len(letterSet))
	for l := range letterSet {
		letters = append(letters, l)
	}

	type term struct {
		word string
		sign int
	}
	terms := make([]term, 0, len(addends)+1)
	for _, w := range addends {
		terms = append(terms, term{w, 1})
	}
	terms = append(terms, term{result, -1})

	maxLen := 0
	for _, t := range terms {
		if len(t.word) > maxLen {
			maxLen = len(t.word)
		}
	}

	assign := make(map[string]int, len(letters))
	used := make([]bool, 10)

	// Backtrack column by column from right to left, carrying the running
	// carry into the next column.
	var solve func(col, carry int) bool
	solve = func(col, carry int) bool {
		if col == maxLen {
			return carry == 0
		}

		// Signed coefficient of each letter appearing in this column.
		coeff := make(map[string]int)
		for _, t := range terms {
			idx := len(t.word) - 1 - col
			if idx < 0 {
				continue
			}
			coeff[t.word[idx:idx+1]] += t.sign
		}

		var sum int
		var unassigned []string
		for l, c := range coeff {
			if d, ok := assign[l]; ok {
				sum += c * d
			} else {
				unassigned = append(unassigned, l)
			}
		}
		sort.Strings(unassigned)

		var assignOne func(i, sum int) bool
		assignOne = func(i, sum int) bool {
			if i == len(unassigned) {
				total := sum + carry
				if total%10 != 0 {
					return false
				}
				return solve(col+1, total/10)
			}
			l := unassigned[i]
			c := coeff[l]
			for d := 0; d < 10; d++ {
				if used[d] || (leading[l] && d == 0) {
					continue
				}
				used[d] = true
				assign[l] = d
				if assignOne(i+1, sum+c*d) {
					return true
				}
				used[d] = false
				delete(assign, l)
			}
			return false
		}
		return assignOne(0, sum)
	}

	if !solve(0, 0) {
		return nil, errors.New("puzzle has no solution")
	}
	return assign, nil
}
