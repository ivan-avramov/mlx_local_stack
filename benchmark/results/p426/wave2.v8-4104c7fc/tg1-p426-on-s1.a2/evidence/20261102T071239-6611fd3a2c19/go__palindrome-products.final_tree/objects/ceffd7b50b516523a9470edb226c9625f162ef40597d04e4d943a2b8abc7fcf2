package palindrome

import (
	"errors"
	"fmt"
	"math"
)

// Product is a palindromic product and the pairs of factors
// (within the given range) that produce it.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products returns the smallest and largest palindromic products
// of two numbers in the range [fmin, fmax], along with all factor
// pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	palindromes := make(map[int][][2]int)
	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if isPalindrome(p) {
				palindromes[p] = append(palindromes[p], [2]int{i, j})
			}
		}
	}

	if len(palindromes) == 0 {
		return Product{}, Product{}, errors.New("no palindromes found")
	}

	min, max := math.MaxInt64, math.MinInt64
	for p := range palindromes {
		if p < min {
			min = p
		}
		if p > max {
			max = p
		}
	}

	return Product{min, palindromes[min]}, Product{max, palindromes[max]}, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	s := fmt.Sprintf("%d", n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
