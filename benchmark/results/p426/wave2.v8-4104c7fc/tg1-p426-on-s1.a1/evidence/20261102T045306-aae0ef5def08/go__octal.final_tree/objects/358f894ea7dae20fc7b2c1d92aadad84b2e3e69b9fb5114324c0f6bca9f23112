package octal

import "errors"

// ParseOctal converts an octal number represented as a string to its
// decimal equivalent. Invalid input (empty string or any character
// outside 0-7) returns 0 and an error.
func ParseOctal(input string) (int64, error) {
	if input == "" {
		return 0, errors.New("empty input is not a valid octal number")
	}

	var result int64
	for _, c := range input {
		if c < '0' || c > '7' {
			return 0, errors.New("invalid octal digit: " + string(c))
		}
		// Horner's method: result = result*8 + digit
		result = result*8 + int64(c-'0')
	}
	return result, nil
}
