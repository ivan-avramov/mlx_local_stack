VOWELS = "aeiou"


def _translate_word(word):
    if word[0] in VOWELS or word.startswith(("xr", "yt")):
        return word + "ay"

    # Find the end of the leading consonant cluster.
    # A "y" after at least one consonant counts as a vowel.
    i = 0
    while i < len(word) and word[i] not in VOWELS and not (i > 0 and word[i] == "y"):
        i += 1

    # If "qu" ends the consonant cluster, move it along with the consonants.
    if i > 0 and word[i - 1] == "q" and word[i] == "u":
        i += 1
    elif word[:2] == "qu":
        i += 2

    return word[i:] + word[:i] + "ay"


def translate(text):
    return " ".join(_translate_word(word) for word in text.split(" "))
