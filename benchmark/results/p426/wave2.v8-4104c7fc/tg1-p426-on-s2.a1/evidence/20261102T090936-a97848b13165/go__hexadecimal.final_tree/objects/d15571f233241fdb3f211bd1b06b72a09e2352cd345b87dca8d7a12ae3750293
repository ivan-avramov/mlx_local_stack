package hexadecimal

import (
	"errors"
	"fmt"
	"math"
	"strings"
)

// ParseHex converts a hexadecimal string (e.g. "10af8c") to its decimal
// equivalent, using first principles. It returns an error whose message
// contains "syntax" for invalid characters or an empty input, or "range"
// when the value does not fit in an int64.
func ParseHex(in string) (int64, error) {
	if in == "" {
		return 0, errors.New("syntax error: empty input")
	}

	var out int64
	for _, c := range in {
		var digit int64
		switch {
		case c >= '0' && c <= '9':
			digit = int64(c - '0')
		case c >= 'a' && c <= 'f':
			digit = int64(c-'a') + 10
		case c >= 'A' && c <= 'F':
			digit = int64(c-'A') + 10
		default:
			return 0, fmt.Errorf("syntax error: invalid hex character %q", c)
		}

		// Check for overflow before shifting/adding.
		if out > (math.MaxInt64-digit)/16 {
			return 0, fmt.Errorf("range error: value %q does not fit in an int64", in)
		}
		out = out<<4 + digit
	}
	return out, nil
}

// HandleErrors calls ParseHex on each input and returns a matching list of
// error cases: "none", "syntax", or "range".
func HandleErrors(inputs []string) []string {
	results := make([]string, len(inputs))
	for i, in := range inputs {
		_, err := ParseHex(in)
		if err == nil {
			results[i] = "none"
		} else if strings.Contains(err.Error(), "syntax") {
			results[i] = "syntax"
		} else {
			results[i] = "range"
		}
	}
	return results
}
