package palindrome

import "errors"

// Product holds a palindromic product and all factor pairs that produce it.
type Product struct {
	Product        int
	Factorizations [][2]int
}

// Products returns the smallest and largest palindromic products of two
// numbers within [fmin, fmax], along with all factor pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	var min, max Product
	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if !isPalindrome(p) {
				continue
			}
			if len(min.Factorizations) == 0 || p < min.Product {
				min = Product{p, [][2]int{{i, j}}}
			} else if p == min.Product {
				min.Factorizations = append(min.Factorizations, [2]int{i, j})
			}
			if len(max.Factorizations) == 0 || p > max.Product {
				max = Product{p, [][2]int{{i, j}}}
			} else if p == max.Product {
				max.Factorizations = append(max.Factorizations, [2]int{i, j})
			}
		}
	}

	if len(min.Factorizations) == 0 {
		return Product{}, Product{}, errors.New("no palindromes found")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	if n < 0 {
		return false
	}
	orig := n
	reversed := 0
	for n > 0 {
		reversed = reversed*10 + n%10
		n /= 10
	}
	return orig == reversed
}
