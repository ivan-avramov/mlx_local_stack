package beer

import (
	"errors"
	"fmt"
	"strings"
)

// Song returns the entire song, verses 99 down to 0.
func Song() string {
	song, _ := Verses(99, 0)
	return song
}

// Verses returns the verses from start down to stop, inclusive.
func Verses(start, stop int) (string, error) {
	if start < stop || start > 99 || stop < 0 {
		return "", errors.New("invalid verse range")
	}
	var b strings.Builder
	for n := start; n >= stop; n-- {
		verse, _ := Verse(n)
		b.WriteString(verse)
		b.WriteString("\n")
	}
	return b.String(), nil
}

// Verse returns the verse for the given number of bottles.
func Verse(n int) (string, error) {
	if n < 0 || n > 99 {
		return "", errors.New("invalid verse")
	}
	if n == 0 {
		return "No more bottles of beer on the wall, no more bottles of beer.\n" +
			"Go to the store and buy some more, 99 bottles of beer on the wall.\n", nil
	}
	return fmt.Sprintf("%s on the wall, %s.\n%s, %s on the wall.\n",
		bottles(n), bottles(n), action(n), bottles(n-1)), nil
}

// bottles returns the phrase for a count of bottles, e.g. "99 bottles of beer".
func bottles(n int) string {
	switch {
	case n == 0:
		return "no more bottles of beer"
	case n == 1:
		return "1 bottle of beer"
	default:
		return fmt.Sprintf("%d bottles of beer", n)
	}
}

// action returns the second line of a verse for the given count.
func action(n int) string {
	if n == 1 {
		return "Take it down and pass it around"
	}
	return "Take one down and pass it around"
}
