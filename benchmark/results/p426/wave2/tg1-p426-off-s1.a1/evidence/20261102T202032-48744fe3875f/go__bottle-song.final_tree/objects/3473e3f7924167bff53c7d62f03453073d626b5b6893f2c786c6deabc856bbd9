package bottlesong

import (
	"fmt"
	"strings"
)

var numbers = []string{
	"no", "one", "two", "three", "four", "five",
	"six", "seven", "eight", "nine", "ten",
}

func Recite(startBottles, takeDown int) []string {
	var verses []string
	for i := 0; i < takeDown; i++ {
		verses = append(verses, verse(startBottles-i)...)
		if i < takeDown-1 {
			verses = append(verses, "")
		}
	}
	return verses
}

func verse(n int) []string {
	line1 := fmt.Sprintf("%s green %s hanging on the wall,", title(numbers[n]), bottleWord(n))
	return []string{
		line1,
		line1,
		"And if one green bottle should accidentally fall,",
		fmt.Sprintf("There'll be %s green %s hanging on the wall.", numbers[n-1], bottleWord(n-1)),
	}
}

func bottleWord(n int) string {
	if n == 1 {
		return "bottle"
	}
	return "bottles"
}

func title(s string) string {
	r := []rune(s)
	r[0] = []rune(strings.ToUpper(string(r[0])))[0]
	return string(r)
}
