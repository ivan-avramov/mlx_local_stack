package palindrome

import (
	"errors"
	"strconv"
)

// Product represents a palindromic product and all of its factorizations
// within the given range.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of two
// numbers in the inclusive range [fmin, fmax].
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	var min, max Product
	for a := fmin; a <= fmax; a++ {
		for b := a; b <= fmax; b++ {
			p := a * b
			if !isPalindrome(p) {
				continue
			}
			if p < min.Value || len(min.Factorizations) == 0 {
				min = Product{Value: p, Factorizations: [][2]int{{a, b}}}
			} else if p == min.Value {
				min.Factorizations = append(min.Factorizations, [2]int{a, b})
			}
			if p > max.Value || len(max.Factorizations) == 0 {
				max = Product{Value: p, Factorizations: [][2]int{{a, b}}}
			} else if p == max.Value {
				max.Factorizations = append(max.Factorizations, [2]int{a, b})
			}
		}
	}

	if len(min.Factorizations) == 0 {
		return Product{}, Product{}, errors.New("no palindromes")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	s := strconv.Itoa(n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
