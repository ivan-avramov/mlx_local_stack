class BowlingGame:
    def __init__(self):
        self.rolls = []

    def roll(self, pins):
        if pins < 0 or pins > 10:
            raise Exception(f"Roll of {pins} pins is not allowed")
        if self._is_game_over():
            raise Exception("Cannot roll after game is over")
        self._validate_frame(pins)
        self.rolls.append(pins)

    def score(self):
        if not self._is_game_over():
            raise Exception("Cannot score an incomplete game")
        rolls = self.rolls
        total = 0
        i = 0
        for frame in range(1, 11):
            if rolls[i] == 10:
                if frame == 10:
                    total += rolls[i] + rolls[i + 1] + rolls[i + 2]
                else:
                    total += 10 + rolls[i + 1] + rolls[i + 2]
                i += 1
            else:
                if rolls[i] + rolls[i + 1] == 10:
                    total += 10 + rolls[i + 2]
                else:
                    total += rolls[i] + rolls[i + 1]
                i += 2
        return total

    def _is_game_over(self):
        rolls = self.rolls
        n = len(rolls)
        i = 0
        for frame in range(1, 11):
            if i >= n:
                return False
            if rolls[i] == 10:
                if frame == 10:
                    return i + 3 <= n
                i += 1
            else:
                if i + 1 >= n:
                    return False
                if frame == 10:
                    if rolls[i] + rolls[i + 1] == 10:
                        return i + 3 <= n
                    return i + 2 <= n
                i += 2
        return True

    def _current_frame(self):
        """Return (frame_number, start_index) of the frame the next roll belongs to."""
        rolls = self.rolls
        i = 0
        frame = 1
        while i < len(rolls):
            if rolls[i] == 10:
                if frame == 10:
                    return frame, i
                i += 1
                frame += 1
            else:
                if i + 1 >= len(rolls):
                    return frame, i
                if frame == 10:
                    return frame, i
                i += 2
                frame += 1
        return frame, i

    def _validate_frame(self, pins):
        frame, i = self._current_frame()
        rolls = self.rolls
        rolls_in_frame = len(rolls) - i
        if frame < 10:
            if rolls_in_frame == 1 and rolls[i] + pins > 10:
                raise Exception("Roll of more than 10 pins in a frame is not allowed")
        else:
            # Second roll of the tenth frame: must not exceed 10 unless the
            # first roll was a strike.
            if rolls_in_frame == 1 and rolls[i] != 10 and rolls[i] + pins > 10:
                raise Exception("Roll of more than 10 pins in a frame is not allowed")
            # Third roll of the tenth frame: if the first roll was a strike and
            # the second was not, the second and third rolls must not exceed 10.
            if (
                rolls_in_frame == 2
                and rolls[i] == 10
                and rolls[i + 1] != 10
                and rolls[i + 1] + pins > 10
            ):
                raise Exception("Roll of more than 10 pins in a frame is not allowed")
