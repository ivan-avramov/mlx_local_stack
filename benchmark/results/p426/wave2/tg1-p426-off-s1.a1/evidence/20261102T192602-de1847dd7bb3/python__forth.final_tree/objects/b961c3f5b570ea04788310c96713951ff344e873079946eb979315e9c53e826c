class StackUnderflowError(Exception):
    pass


def _is_number(token):
    return token.lstrip("-").isdigit()


def _underflow():
    raise StackUnderflowError("Insufficient number of items in stack")


def _pop_two(stack):
    if len(stack) < 2:
        _underflow()
    return stack.pop(), stack.pop()


def _pop_one(stack):
    if not stack:
        _underflow()
    return stack.pop()


def _resolve(tokens, words):
    """Replace user-defined words in a definition with their current bodies."""
    resolved = []
    for token in tokens:
        if token in words:
            resolved.extend(words[token])
        else:
            resolved.append(token)
    return resolved


def _execute(token, stack, words):
    if _is_number(token):
        stack.append(int(token))
    elif token in words:
        for word in words[token]:
            _execute(word, stack, words)
    elif token == "+":
        b, a = _pop_two(stack)
        stack.append(a + b)
    elif token == "-":
        b, a = _pop_two(stack)
        stack.append(a - b)
    elif token == "*":
        b, a = _pop_two(stack)
        stack.append(a * b)
    elif token == "/":
        b, a = _pop_two(stack)
        if b == 0:
            raise ZeroDivisionError("divide by zero")
        stack.append(a // b)
    elif token == "dup":
        if not stack:
            _underflow()
        stack.append(stack[-1])
    elif token == "drop":
        _pop_one(stack)
    elif token == "swap":
        if len(stack) < 2:
            _underflow()
        stack[-1], stack[-2] = stack[-2], stack[-1]
    elif token == "over":
        if len(stack) < 2:
            _underflow()
        stack.append(stack[-2])
    else:
        raise ValueError("undefined operation")


def evaluate(input_data):
    stack = []
    words = {}

    for line in input_data:
        tokens = line.lower().split()
        i = 0
        while i < len(tokens):
            if tokens[i] == ":":
                name = tokens[i + 1]
                if _is_number(name):
                    raise ValueError("illegal operation")
                end = tokens.index(";", i + 2)
                words[name] = _resolve(tokens[i + 2 : end], words)
                i = end + 1
            else:
                _execute(tokens[i], stack, words)
                i += 1

    return stack
