package bottlesong

import (
	"fmt"
	"strings"
)

var numberWords = map[int]string{
	10: "ten", 9: "nine", 8: "eight", 7: "seven", 6: "six",
	5: "five", 4: "four", 3: "three", 2: "two", 1: "one", 0: "no",
}

// bottlePhrase returns the phrase for a given count, e.g. "two green bottles"
// or "one green bottle" (singular for one, "no green bottles" for zero).
func bottlePhrase(n int) string {
	plural := "s"
	if n == 1 {
		plural = ""
	}
	return fmt.Sprintf("%s green bottle%s", numberWords[n], plural)
}

// Recite returns the lyrics for takeDown consecutive verses, starting
// with startBottles bottles. Verses are separated by a blank line.
func Recite(startBottles, takeDown int) []string {
	var lines []string
	for n := startBottles; n > startBottles-takeDown; n-- {
		phrase := bottlePhrase(n)
		lines = append(lines,
			strings.ToUpper(phrase[:1])+phrase[1:]+",",
			strings.ToUpper(phrase[:1])+phrase[1:]+",",
			"And if one green bottle should accidentally fall,",
			"There'll be "+bottlePhrase(n-1)+" hanging on the wall.",
		)
		if n > startBottles-takeDown+1 {
			lines = append(lines, "")
		}
	}
	return lines
}
