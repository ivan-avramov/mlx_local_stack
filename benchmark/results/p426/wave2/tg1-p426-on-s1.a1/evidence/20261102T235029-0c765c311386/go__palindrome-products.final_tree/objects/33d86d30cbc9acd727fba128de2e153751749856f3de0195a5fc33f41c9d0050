package palindrome

import (
	"errors"
	"fmt"
)

// Product holds a palindromic product and the factor pairs within the
// given range that produce it.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of two
// numbers within the range [fmin, fmax], along with all factor pairs
// of each within the range.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, fmt.Errorf("fmin > fmax")
	}

	var min, max Product
	minSet, maxSet := false, false

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if !isPalindrome(p) {
				continue
			}
			if !minSet || p < min.Value {
				min = Product{Value: p}
				minSet = true
			}
			if !maxSet || p > max.Value {
				max = Product{Value: p}
				maxSet = true
			}
			if p == min.Value {
				min.Factorizations = append(min.Factorizations, [2]int{i, j})
			}
			if p == max.Value {
				max.Factorizations = append(max.Factorizations, [2]int{i, j})
			}
		}
	}

	if !minSet {
		return Product{}, Product{}, errors.New("no palindromes")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
// Negative numbers are not palindromes.
func isPalindrome(n int) bool {
	if n < 0 {
		return false
	}
	orig := n
	reversed := 0
	for n > 0 {
		reversed = reversed*10 + n%10
		n /= 10
	}
	return reversed == orig
}
