package bottlesong

import "strings"

var numberWords = map[int]string{
	0: "no",
	1: "one",
	2: "two",
	3: "three",
	4: "four",
	5: "five",
	6: "six",
	7: "seven",
	8: "eight",
	9: "nine",
	10: "ten",
}

// bottlePhrase returns the "<number> green bottle(s)" fragment for a count.
func bottlePhrase(count int) string {
	noun := "bottles"
	if count == 1 {
		noun = "bottle"
	}
	return numberWords[count] + " green " + noun
}

// capitalize uppercases the first rune of s.
func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// Recite returns the lyrics for takeDown verses, starting with the verse
// that has startBottles bottles on the wall. Verses are separated by a
// blank line.
func Recite(startBottles, takeDown int) []string {
	var lines []string
	for i := 0; i < takeDown; i++ {
		count := startBottles - i
		phrase := bottlePhrase(count)
		lines = append(lines,
			capitalize(phrase)+" hanging on the wall,",
			capitalize(phrase)+" hanging on the wall,",
			"And if one green bottle should accidentally fall,",
			"There'll be "+bottlePhrase(count-1)+" hanging on the wall.",
		)
		if i < takeDown-1 {
			lines = append(lines, "")
		}
	}
	return lines
}
