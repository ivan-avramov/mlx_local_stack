package matrix

import (
	"errors"
	"strconv"
	"strings"
)

// Matrix is a rectangular grid of integers.
type Matrix [][]int

// New parses a string of newline-separated rows of space-separated
// integers into a Matrix. It returns an error if any row is empty,
// rows have uneven lengths, or a value is not an integer.
func New(s string) (Matrix, error) {
	var m [][]int
	for _, line := range strings.Split(s, "\n") {
		fields := strings.Fields(line)
		if len(fields) == 0 {
			return nil, errors.New("matrix: empty row")
		}
		row := make([]int, len(fields))
		for i, f := range fields {
			v, err := strconv.Atoi(f)
			if err != nil {
				return nil, errors.New("matrix: invalid integer " + strconv.Quote(f))
			}
			row[i] = v
		}
		if len(m) > 0 && len(row) != len(m[0]) {
			return nil, errors.New("matrix: uneven rows")
		}
		m = append(m, row)
	}
	return m, nil
}

// Cols returns the columns of the matrix, read top-to-bottom,
// left-to-right. The result is a copy; mutating it does not
// affect the matrix.
func (m Matrix) Cols() [][]int {
	if len(m) == 0 {
		return nil
	}
	cols := make([][]int, len(m[0]))
	for _, row := range m {
		for c, v := range row {
			cols[c] = append(cols[c], v)
		}
	}
	return cols
}

// Rows returns the rows of the matrix, read left-to-right,
// top-to-bottom. The result is a copy; mutating it does not
// affect the matrix.
func (m Matrix) Rows() [][]int {
	rows := make([][]int, len(m))
	for i, row := range m {
		rows[i] = make([]int, len(row))
		copy(rows[i], row)
	}
	return rows
}

// Set sets the element at row, col to val. It returns false if
// either index is out of range, leaving the matrix unchanged.
func (m Matrix) Set(row, col, val int) bool {
	if row < 0 || row >= len(m) || col < 0 || col >= len(m[row]) {
		return false
	}
	m[row][col] = val
	return true
}
