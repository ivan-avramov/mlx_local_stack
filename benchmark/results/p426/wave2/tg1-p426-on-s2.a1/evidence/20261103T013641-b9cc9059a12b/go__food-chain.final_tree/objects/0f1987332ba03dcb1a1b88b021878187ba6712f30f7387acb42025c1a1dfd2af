package foodchain

import "fmt"

var animals = []struct {
	name    string
	comment string
}{
	{"fly", ""},
	{"spider", "It wriggled and jiggled and tickled inside her."},
	{"bird", "How absurd to swallow a bird!"},
	{"cat", "Imagine that, to swallow a cat!"},
	{"dog", "What a hog, to swallow a dog!"},
	{"goat", "Just opened her throat and swallowed a goat!"},
	{"cow", "I don't know how she swallowed a cow!"},
	{"horse", "She's dead, of course!"},
}

func Verse(v int) string {
	var lines []string
	lines = append(lines, fmt.Sprintf("I know an old lady who swallowed a %s.", animals[v-1].name))
	if comment := animals[v-1].comment; comment != "" {
		lines = append(lines, comment)
	}

	// The cumulative "to catch" chain, starting from the current animal
	// down to the spider, which was swallowed to catch the fly.
	// The fly and horse verses have no chain.
	if v > 1 && v < len(animals) {
		for i := v - 1; i >= 1; i-- {
			target := animals[i-1].name
			if target == "spider" {
				target += " that wriggled and jiggled and tickled inside her"
			}
			lines = append(lines, fmt.Sprintf("She swallowed the %s to catch the %s.", animals[i].name, target))
		}
	}

	if v < len(animals) {
		lines = append(lines, "I don't know why she swallowed the fly. Perhaps she'll die.")
	}

	out := ""
	for i, line := range lines {
		if i > 0 {
			out += "\n"
		}
		out += line
	}
	return out
}

func Verses(start, end int) string {
	out := ""
	for v := start; v <= end; v++ {
		if v > start {
			out += "\n\n"
		}
		out += Verse(v)
	}
	return out
}

func Song() string {
	return Verses(1, len(animals))
}
