package piglatin

import "strings"

func Sentence(sentence string) string {
	words := strings.Split(sentence, " ")
	for i, w := range words {
		words[i] = word(w)
	}
	return strings.Join(words, " ")
}

func word(w string) string {
	if w == "" {
		return w
	}
	if isVowel(w[0]) || strings.HasPrefix(w, "xr") || strings.HasPrefix(w, "yt") {
		return w + "ay"
	}
	i := 0
	for i < len(w) {
		if w[i] == 'q' && i+1 < len(w) && w[i+1] == 'u' {
			i += 2
			break
		}
		if i > 0 && (isVowel(w[i]) || w[i] == 'y') {
			break
		}
		i++
	}
	return w[i:] + w[:i] + "ay"
}

func isVowel(c byte) bool {
	switch c {
	case 'a', 'e', 'i', 'o', 'u':
		return true
	}
	return false
}
