package paasio

import (
	"io"
	"sync"
)

// readCounter wraps an io.Reader and counts the total number of bytes
// and operations read.
type readCounter struct {
	r       io.Reader
	mu      sync.Mutex
	n       int64
	nops    int
}

func NewReadCounter(reader io.Reader) ReadCounter {
	return &readCounter{r: reader}
}

func (rc *readCounter) Read(p []byte) (int, error) {
	n, err := rc.r.Read(p)
	rc.mu.Lock()
	rc.n += int64(n)
	rc.nops++
	rc.mu.Unlock()
	return n, err
}

func (rc *readCounter) ReadCount() (int64, int) {
	rc.mu.Lock()
	defer rc.mu.Unlock()
	return rc.n, rc.nops
}

// writeCounter wraps an io.Writer and counts the total number of bytes
// and operations written.
type writeCounter struct {
	w       io.Writer
	mu      sync.Mutex
	n       int64
	nops    int
}

func NewWriteCounter(writer io.Writer) WriteCounter {
	return &writeCounter{w: writer}
}

func (wc *writeCounter) Write(p []byte) (int, error) {
	n, err := wc.w.Write(p)
	wc.mu.Lock()
	wc.n += int64(n)
	wc.nops++
	wc.mu.Unlock()
	return n, err
}

func (wc *writeCounter) WriteCount() (int64, int) {
	wc.mu.Lock()
	defer wc.mu.Unlock()
	return wc.n, wc.nops
}

// readWriteCounter wraps an io.ReadWriter and counts the total number of
// bytes and operations read and written.
type readWriteCounter struct {
	readCounter
	writeCounter
}

func NewReadWriteCounter(readwriter io.ReadWriter) ReadWriteCounter {
	return &readWriteCounter{
		readCounter: readCounter{r: readwriter},
		writeCounter: writeCounter{w: readwriter},
	}
}
