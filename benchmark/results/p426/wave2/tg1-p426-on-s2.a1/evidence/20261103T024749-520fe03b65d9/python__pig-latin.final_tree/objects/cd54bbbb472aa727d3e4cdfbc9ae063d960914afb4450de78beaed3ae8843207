VOWELS = "aeiou"


def _translate_word(word):
    if word[0] in VOWELS or word[:2] in ("xr", "yt"):
        return word + "ay"

    i = 1
    while i < len(word) and word[i] not in VOWELS and word[i] != "y":
        i += 1

    # A "u" right after a "q" belongs to the "qu" cluster (rule 3).
    if i < len(word) and word[i] == "u" and word[i - 1] == "q":
        i += 1

    return word[i:] + word[:i] + "ay"


def translate(text):
    return " ".join(_translate_word(word) for word in text.split())
