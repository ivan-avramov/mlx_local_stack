from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def from_pov(self, from_node):
        path = self._find_path(from_node)
        if path is None:
            raise ValueError("Tree could not be reoriented")
        return self._reorient(path, None)

    def _find_path(self, label):
        if self.label == label:
            return [self.label]
        for child in self.children:
            path = child._find_path(label)
            if path is not None:
                return [self.label] + path
        return None

    def _reorient(self, path, parent):
        # path[0] == self.label; `parent` is the re-oriented former parent
        # (or None for the original root).
        if len(path) == 1:
            # This node is the target: it becomes the new root, keeping its
            # own children and gaining its former parent as a child.
            children = list(self.children)
            if parent is not None:
                children.append(parent)
            return Tree(self.label, children)
        child = next(c for c in self.children if c.label == path[1])
        # Re-orient this ancestor: drop the child on the path (it now points
        # back up to us) and gain our re-oriented former parent.
        children = [c for c in self.children if c is not child]
        if parent is not None:
            children.append(parent)
        new_self = Tree(self.label, children)
        return child._reorient(path[1:], new_self)

    def path_to(self, from_node, to_node):
        path = self.from_pov(from_node)._path_to(to_node)
        if path is None:
            raise ValueError("No path found")
        return path

    def _path_to(self, to_node):
        if self.label == to_node:
            return [self.label]
        for child in self.children:
            path = child._path_to(to_node)
            if path is not None:
                return [self.label] + path
        return None
