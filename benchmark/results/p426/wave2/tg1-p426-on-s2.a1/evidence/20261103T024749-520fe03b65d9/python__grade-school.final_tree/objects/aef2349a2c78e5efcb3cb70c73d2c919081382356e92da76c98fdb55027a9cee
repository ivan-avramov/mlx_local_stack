class School:
    def __init__(self):
        self._students = {}  # grade -> list of names
        self._added = []    # True/False per add_student call
        self._enrolled = set()  # names already in the roster

    def add_student(self, name, grade):
        if name in self._enrolled:
            self._added.append(False)
            return False
        self._students.setdefault(grade, []).append(name)
        self._enrolled.add(name)
        self._added.append(True)
        return True

    def roster(self):
        result = []
        for grade in sorted(self._students):
            result.extend(sorted(self._students[grade]))
        return result

    def grade(self, grade_number):
        return sorted(self._students.get(grade_number, []))

    def added(self):
        return self._added
