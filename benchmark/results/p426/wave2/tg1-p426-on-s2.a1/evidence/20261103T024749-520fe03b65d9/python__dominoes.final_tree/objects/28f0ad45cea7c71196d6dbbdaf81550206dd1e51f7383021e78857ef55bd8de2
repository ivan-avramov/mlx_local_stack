def can_chain(dominoes):
    """Return a list of dominoes forming a closed chain, or None if impossible."""
    if not dominoes:
        return []

    def backtrack(remaining, chain):
        if not remaining:
            return chain
        for i, (a, b) in enumerate(remaining):
            for x, y in ((a, b), (b, a)):
                if x == chain[-1][1]:
                    result = backtrack(
                        remaining[:i] + remaining[i + 1:], chain + [(x, y)]
                    )
                    if result is not None:
                        return result
        return None

    for i, (a, b) in enumerate(dominoes):
        for x, y in ((a, b), (b, a)):
            result = backtrack(dominoes[:i] + dominoes[i + 1:], [(x, y)])
            if result is not None and result[-1][1] == result[0][0]:
                return result
    return None
