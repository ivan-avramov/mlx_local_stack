def can_chain(dominoes):
    if not dominoes:
        return []

    def backtrack(remaining, chain, start):
        if not remaining:
            if chain[-1][1] == start:
                return chain
            return None
        current_end = chain[-1][1]
        for i, (a, b) in enumerate(remaining):
            rest = remaining[:i] + remaining[i + 1:]
            if a == current_end:
                result = backtrack(rest, chain + [(a, b)], start)
                if result is not None:
                    return result
            if b == current_end and b != a:
                result = backtrack(rest, chain + [(b, a)], start)
                if result is not None:
                    return result
        return None

    for i, (a, b) in enumerate(dominoes):
        rest = dominoes[:i] + dominoes[i + 1:]
        result = backtrack(rest, [(a, b)], a)
        if result is not None:
            return result
        if a != b:
            result = backtrack(rest, [(b, a)], b)
            if result is not None:
                return result
    return None
