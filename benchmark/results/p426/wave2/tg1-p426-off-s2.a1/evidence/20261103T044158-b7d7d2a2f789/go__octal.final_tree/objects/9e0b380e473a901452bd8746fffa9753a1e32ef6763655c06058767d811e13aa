package octal

import "errors"

// ParseOctal converts an octal number, represented as a string,
// to its decimal equivalent.
//
// Invalid input (any character outside '0'-'7') is treated as octal 0
// and an error is returned.
func ParseOctal(input string) (int64, error) {
	var result int64
	for _, r := range input {
		if r < '0' || r > '7' {
			return 0, errors.New("invalid octal input")
		}
		result = result*8 + int64(r-'0')
	}
	return result, nil
}
