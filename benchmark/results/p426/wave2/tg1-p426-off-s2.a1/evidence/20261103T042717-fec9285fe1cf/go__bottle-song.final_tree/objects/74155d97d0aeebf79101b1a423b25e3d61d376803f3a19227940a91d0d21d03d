package bottlesong

import (
	"fmt"
	"strings"
)

// numberWords maps a bottle count to its lowercase word form.
// Index 0 is "no", used when the count reaches zero.
var numberWords = []string{
	"no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
}

// Recite returns the lyrics for the given number of verses.
func Recite(startBottles, takeDown int) []string {
	var result []string
	for i := startBottles; i > startBottles-takeDown; i-- {
		if i < startBottles {
			result = append(result, "")
		}
		result = append(result, verse(i)...)
	}
	return result
}

func verse(n int) []string {
	return []string{
		fmt.Sprintf("%s green %s hanging on the wall,", capitalize(numberWords[n]), bottleWord(n)),
		fmt.Sprintf("%s green %s hanging on the wall,", capitalize(numberWords[n]), bottleWord(n)),
		"And if one green bottle should accidentally fall,",
		fmt.Sprintf("There'll be %s green %s hanging on the wall.", numberWords[n-1], bottleWord(n-1)),
	}
}

func bottleWord(n int) string {
	if n == 1 {
		return "bottle"
	}
	return "bottles"
}

func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}
