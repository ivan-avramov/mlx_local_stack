class BowlingGame:
    def __init__(self):
        self.rolls = []
        self.frames = 0
        self.current_frame = []

    def roll(self, pins):
        if pins < 0:
            raise Exception("Pin count cannot be negative")
        if pins > 10:
            raise Exception("Pin count cannot score more than 10 points")
        if self.frames >= 10:
            raise Exception("Cannot roll after game is over")

        self.rolls.append(pins)
        self.current_frame.append(pins)

        if self._frame_is_complete():
            self.frames += 1
            self.current_frame = []

    def _frame_is_complete(self):
        rolls = self.current_frame

        if self.frames < 9:
            if rolls[0] == 10:
                return True
            if len(rolls) == 2:
                if sum(rolls) > 10:
                    raise Exception("Frame cannot score more than 10 points")
                return True
            return False

        # Tenth frame: extra bonus rolls for strikes or spares.
        if len(rolls) == 3:
            if rolls[0] == 10 and rolls[1] != 10 and sum(rolls[1:]) > 10:
                raise Exception("Frame cannot score more than 10 points")
            return True
        if len(rolls) == 2:
            return sum(rolls) < 10  # open frame; spare/strike needs a bonus roll
        return False

    def score(self):
        if self.frames < 10:
            raise Exception("Score cannot be taken until the end of the game")

        total = 0
        idx = 0
        for _ in range(10):
            if self.rolls[idx] == 10:
                total += 10 + self.rolls[idx + 1] + self.rolls[idx + 2]
                idx += 1
            elif self.rolls[idx] + self.rolls[idx + 1] == 10:
                total += 10 + self.rolls[idx + 2]
                idx += 2
            else:
                total += self.rolls[idx] + self.rolls[idx + 1]
                idx += 2
        return total
