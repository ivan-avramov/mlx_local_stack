def _bottle_phrase(count):
    if count == 0:
        return "no more bottles"
    if count == 1:
        return "1 bottle"
    return f"{count} bottles"


def _verse(n):
    first = f"{_bottle_phrase(n).capitalize()} of beer on the wall, {_bottle_phrase(n)} of beer."
    if n == 0:
        second = "Go to the store and buy some more, 99 bottles of beer on the wall."
    elif n == 1:
        second = "Take it down and pass it around, no more bottles of beer on the wall."
    else:
        second = (
            "Take one down and pass it around, "
            f"{_bottle_phrase(n - 1)} of beer on the wall."
        )
    return [first, second]


def recite(start, take=1):
    lines = []
    for i in range(take):
        if i > 0:
            lines.append("")
        lines.extend(_verse(start - i))
    return lines
