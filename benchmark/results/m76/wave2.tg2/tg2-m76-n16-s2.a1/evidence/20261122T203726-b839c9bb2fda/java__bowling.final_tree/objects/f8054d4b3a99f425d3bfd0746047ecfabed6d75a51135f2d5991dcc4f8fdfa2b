import java.util.ArrayList;
import java.util.List;

public class BowlingGame {

    private static final int PINS = 10;
    private static final int FRAMES = 10;

    private final List<Integer> rolls = new ArrayList<>();
    private int frame = 1;
    private int rollsInFrame = 0;
    private int pinsDownInFrame = 0;
    private boolean gameComplete = false;

    public void roll(int pins) {
        if (gameComplete) {
            throw new IllegalStateException("Cannot roll after game is over");
        }
        if (pins < 0) {
            throw new IllegalStateException("Negative roll is invalid");
        }
        if (pins > PINS) {
            throw new IllegalStateException("Pin count exceeds pins on the lane");
        }
        if (pinsDownInFrame + pins > PINS) {
            throw new IllegalStateException("Pin count exceeds pins on the lane");
        }

        rolls.add(pins);
        rollsInFrame++;
        pinsDownInFrame += pins;

        if (pins == PINS) {
            // A strike clears the lane, so the next roll starts from 10 pins.
            pinsDownInFrame = 0;
        }

        if (frame < FRAMES) {
            if (rollsInFrame == 2 || pins == PINS) {
                nextFrame();
            }
        } else {
            int firstRoll = rolls.get(rolls.size() - rollsInFrame);
            if (rollsInFrame == 3) {
                gameComplete = true;
            } else if (rollsInFrame == 2 && firstRoll != PINS) {
                if (pinsDownInFrame == PINS) {
                    // Spare: the bonus roll starts from a fresh set of pins.
                    pinsDownInFrame = 0;
                } else {
                    gameComplete = true;
                }
            }
        }
    }

    public int score() {
        if (!gameComplete) {
            throw new IllegalStateException("Score cannot be taken until the end of the game");
        }

        int total = 0;
        int i = 0;
        for (int f = 1; f <= FRAMES; f++) {
            if (rolls.get(i) == PINS) {
                total += PINS + rolls.get(i + 1) + rolls.get(i + 2);
                i += 1;
            } else if (rolls.get(i) + rolls.get(i + 1) == PINS) {
                total += PINS + rolls.get(i + 2);
                i += 2;
            } else {
                total += rolls.get(i) + rolls.get(i + 1);
                i += 2;
            }
        }
        return total;
    }

    private void nextFrame() {
        frame++;
        rollsInFrame = 0;
        pinsDownInFrame = 0;
    }
}
