export class Rational {
  constructor(numerator, denominator) {
    this.numerator = numerator;
    this.denominator = denominator;
  }

  add(other) {
    return this._result(
      this.numerator * other.denominator + other.numerator * this.denominator,
      this.denominator * other.denominator
    );
  }

  sub(other) {
    return this._result(
      this.numerator * other.denominator - other.numerator * this.denominator,
      this.denominator * other.denominator
    );
  }

  mul(other) {
    return this._result(
      this.numerator * other.numerator,
      this.denominator * other.denominator
    );
  }

  div(other) {
    return this._result(
      this.numerator * other.denominator,
      this.denominator * other.numerator
    );
  }

  abs() {
    return this._result(Math.abs(this.numerator), Math.abs(this.denominator));
  }

  exprational(power) {
    if (!Number.isInteger(power)) {
      // (a/b)^x = (a^x)/(b^x), a real number.
      return Math.pow(this.numerator / this.denominator, power);
    }
    if (power === 0) {
      return new Rational(1, 1);
    }
    const magnitude = Math.abs(power);
    const numerator = Math.pow(this.numerator, magnitude);
    const denominator = Math.pow(this.denominator, magnitude);
    return this._result(
      power < 0 ? denominator : numerator,
      power < 0 ? numerator : denominator
    );
  }

  expreal(base) {
    // x^(a/b) = root(x^a, b) = (root(x, b))^a
    return Math.pow(Math.pow(base, 1 / this.denominator), this.numerator);
  }

  reduce() {
    return this._result(this.numerator, this.denominator);
  }

  _result(numerator, denominator) {
    const divisor = gcd(Math.abs(numerator), Math.abs(denominator));
    let n = numerator / divisor;
    let d = denominator / divisor;
    if (d < 0) {
      n = -n;
      d = -d;
    }
    return new Rational(n, d);
  }
}

function gcd(a, b) {
  while (b !== 0) {
    [a, b] = [b, a % b];
  }
  return a;
}
