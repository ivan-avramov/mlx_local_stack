export const transpose = (rows) => {
  if (rows.length === 0) {
    return [];
  }

  const cols = Math.max(...rows.map((row) => row.length));
  const transposed = [];

  for (let col = 0; col < cols; col += 1) {
    // The last input row that has a character in this column. Cells beyond
    // it would be right-padding, which must not appear in the output, while
    // spaces that come from the input itself are kept.
    let last = -1;
    rows.forEach((row, i) => {
      if (row.length > col) {
        last = i;
      }
    });

    let line = '';
    for (let i = 0; i <= last; i += 1) {
      line += rows[i].length > col ? rows[i][col] : ' ';
    }
    transposed.push(line);
  }

  return transposed;
};
