const DIGITS = [
  [' _ ', '| |', '|_|'],
  ['   ', '  |', '  |'],
  [' _ ', ' _|', '|_ '],
  [' _ ', ' _|', ' _|'],
  ['   ', '|_|', '  |'],
  [' _ ', '|_ ', ' _|'],
  [' _ ', '|_ ', '|_|'],
  [' _ ', '  |', '  |'],
  [' _ ', '|_|', '|_|'],
  [' _ ', '|_|', ' _|'],
];

const convertLine = (rows) => {
  const width = rows[0].length;
  let result = '';
  for (let i = 0; i < width; i += 3) {
    const index = DIGITS.findIndex((digit) =>
      [0, 1, 2].every((r) => rows[r].slice(i, i + 3) === digit[r]),
    );
    result += index === -1 ? '?' : String(index);
  }
  return result;
};

export const convert = (input) => {
  const rows = input.split('\n');
  if (rows.length % 4 !== 0) {
    throw new Error('Input height, must be a multiple of four');
  }
  for (const row of rows) {
    if (row.length % 3 !== 0) {
      throw new Error('Input row length must be a multiple of three');
    }
  }

  const lines = [];
  for (let i = 0; i < rows.length; i += 4) {
    lines.push(convertLine(rows.slice(i, i + 4)));
  }
  return lines.join(',');
};
