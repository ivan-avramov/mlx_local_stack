export class Zipper {
  constructor(tree, path) {
    this.tree = tree;
    this.path = path;
  }

  static fromTree(tree) {
    return new Zipper(tree, []);
  }

  toTree() {
    let tree = this.tree;
    for (let i = this.path.length - 1; i >= 0; i--) {
      const { parent, direction } = this.path[i];
      tree = { ...parent, [direction]: tree };
    }
    return tree;
  }

  value() {
    return this.tree.value;
  }

  left() {
    if (this.tree.left === null) {
      return null;
    }
    return new Zipper(this.tree.left, [
      ...this.path,
      { parent: this.tree, direction: 'left' },
    ]);
  }

  right() {
    if (this.tree.right === null) {
      return null;
    }
    return new Zipper(this.tree.right, [
      ...this.path,
      { parent: this.tree, direction: 'right' },
    ]);
  }

  up() {
    if (this.path.length === 0) {
      return null;
    }
    const path = this.path.slice(0, -1);
    const { parent, direction } = this.path[path.length];
    const tree = { ...parent, [direction]: this.tree };
    return new Zipper(tree, path);
  }

  setValue(value) {
    return new Zipper({ ...this.tree, value }, this.path);
  }

  setLeft(left) {
    return new Zipper({ ...this.tree, left }, this.path);
  }

  setRight(right) {
    return new Zipper({ ...this.tree, right }, this.path);
  }
}
