//

export class GradeSchool {
  constructor() {
    // Maps a grade (number) to a Set of student names in that grade.
    this.students = {};
  }

  add(name, grade) {
    // A student can only be in one grade at a time, so remove them from any
    // grade they may currently be enrolled in before adding them to the new one.
    for (const g of Object.keys(this.students)) {
      if (this.students[g].has(name)) {
        this.students[g].delete(name);
        if (this.students[g].size === 0) {
          delete this.students[g];
        }
      }
    }

    if (!this.students[grade]) {
      this.students[grade] = new Set();
    }
    this.students[grade].add(name);
  }

  grade(grade) {
    return [...(this.students[grade] || [])].sort();
  }

  roster() {
    const result = {};
    const grades = Object.keys(this.students).sort((a, b) => Number(a) - Number(b));
    for (const grade of grades) {
      result[grade] = [...this.students[grade]].sort();
    }
    return result;
  }
}
