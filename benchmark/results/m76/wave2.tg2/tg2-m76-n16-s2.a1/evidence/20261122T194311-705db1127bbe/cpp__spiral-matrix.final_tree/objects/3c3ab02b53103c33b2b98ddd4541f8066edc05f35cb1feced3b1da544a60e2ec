#include "spiral_matrix.h"

namespace spiral_matrix {

std::vector<std::vector<uint32_t>> spiral_matrix(uint32_t size) {
    std::vector<std::vector<uint32_t>> matrix(size, std::vector<uint32_t>(size, 0));

    uint32_t value = 1;
    uint32_t top = 0, bottom = size;
    uint32_t left = 0, right = size;

    while (top < bottom && left < right) {
        for (uint32_t col = left; col < right; ++col) {
            matrix[top][col] = value++;
        }
        ++top;

        for (uint32_t row = top; row < bottom; ++row) {
            matrix[row][right - 1] = value++;
        }
        --right;

        if (top < bottom) {
            for (uint32_t col = right; col > left; --col) {
                matrix[bottom - 1][col - 1] = value++;
            }
            --bottom;
        }

        if (left < right) {
            for (uint32_t row = bottom; row > top; --row) {
                matrix[row - 1][left] = value++;
            }
            ++left;
        }
    }

    return matrix;
}

}  // namespace spiral_matrix
