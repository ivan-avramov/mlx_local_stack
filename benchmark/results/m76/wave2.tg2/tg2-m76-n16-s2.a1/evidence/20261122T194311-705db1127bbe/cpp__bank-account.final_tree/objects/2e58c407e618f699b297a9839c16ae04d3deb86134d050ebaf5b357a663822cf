#include "bank_account.h"

#include <stdexcept>

namespace Bankaccount {

void Bankaccount::open() {
    std::lock_guard<std::mutex> lock(mutex_);
    if (opened_) {
        throw std::runtime_error("Account already open");
    }
    opened_ = true;
    balance_ = 0;
}

void Bankaccount::close() {
    std::lock_guard<std::mutex> lock(mutex_);
    if (!opened_) {
        throw std::runtime_error("Account not open");
    }
    opened_ = false;
    balance_ = 0;
}

long Bankaccount::balance() {
    std::lock_guard<std::mutex> lock(mutex_);
    if (!opened_) {
        throw std::runtime_error("Account not open");
    }
    return balance_;
}

void Bankaccount::deposit(long amount) {
    std::lock_guard<std::mutex> lock(mutex_);
    if (!opened_) {
        throw std::runtime_error("Account not open");
    }
    if (amount < 0) {
        throw std::runtime_error("Cannot deposit a negative amount");
    }
    balance_ += amount;
}

void Bankaccount::withdraw(long amount) {
    std::lock_guard<std::mutex> lock(mutex_);
    if (!opened_) {
        throw std::runtime_error("Account not open");
    }
    if (amount < 0) {
        throw std::runtime_error("Cannot withdraw a negative amount");
    }
    if (amount > balance_) {
        throw std::runtime_error("Cannot withdraw more than the balance");
    }
    balance_ -= amount;
}

}  // namespace Bankaccount
