pub fn abbreviate(phrase: &str) -> String {
    let mut acronym = String::new();
    let mut last_alpha: Option<char> = None;
    let mut at_word_start = true;

    for c in phrase.chars() {
        if c.is_alphabetic() {
            let is_camel_hump = c.is_uppercase() && last_alpha.map_or(false, |p| p.is_lowercase());
            if at_word_start || is_camel_hump {
                acronym.push(c.to_ascii_uppercase());
            }
            last_alpha = Some(c);
            at_word_start = false;
        } else {
            // Whitespace and hyphens separate words; all other punctuation is removed.
            at_word_start = c.is_whitespace() || c == '-';
        }
    }

    acronym
}
