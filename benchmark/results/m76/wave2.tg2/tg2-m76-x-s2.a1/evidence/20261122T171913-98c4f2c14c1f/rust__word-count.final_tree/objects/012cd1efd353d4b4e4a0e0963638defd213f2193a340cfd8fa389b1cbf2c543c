use std::collections::HashMap;

/// Count occurrences of words.
pub fn word_count(words: &str) -> HashMap<String, u32> {
    let mut counts = HashMap::new();

    // Words are separated by anything that is not alphanumeric or an
    // apostrophe (the apostrophe only joins parts of a contraction).
    for token in words.split(|c: char| !c.is_alphanumeric() && c != '\'') {
        // Apostrophes at the edges of a token are quotes, not contractions.
        let word = token.trim_matches('\'').to_lowercase();
        if !word.is_empty() {
            *counts.entry(word).or_insert(0) += 1;
        }
    }

    counts
}
