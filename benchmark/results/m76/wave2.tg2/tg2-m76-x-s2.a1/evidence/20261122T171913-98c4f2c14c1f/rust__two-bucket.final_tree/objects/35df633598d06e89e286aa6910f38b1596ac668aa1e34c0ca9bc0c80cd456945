#[derive(PartialEq, Eq, Debug)]
pub enum Bucket {
    One,
    Two,
}

/// A struct to hold your results in.
#[derive(PartialEq, Eq, Debug)]
pub struct BucketStats {
    /// The total number of "moves" it should take to reach the desired number of liters, including
    /// the first fill.
    pub moves: u8,
    /// Which bucket should end up with the desired number of liters? (Either "one" or "two")
    pub goal_bucket: Bucket,
    /// How many liters are left in the other bucket?
    pub other_bucket: u8,
}

/// Solve the bucket problem
pub fn solve(
    capacity_1: u8,
    capacity_2: u8,
    goal: u8,
    start_bucket: &Bucket,
) -> Option<BucketStats> {
    if goal > capacity_1 && goal > capacity_2 {
        return None;
    }

    // 0 = bucket one, 1 = bucket two
    let start = match start_bucket {
        Bucket::One => 0,
        Bucket::Two => 1,
    };

    let mut visited = vec![false; (capacity_1 as usize + 1) * (capacity_2 as usize + 1)];
    let mut queue = std::collections::VecDeque::new();
    queue.push_back((0u8, 0u8, 0u16));
    visited[0] = true;

    while let Some((a, b, moves)) = queue.pop_front() {
        let mut next_states = Vec::new();
        next_states.push((capacity_1, b)); // fill bucket one
        next_states.push((a, capacity_2)); // fill bucket two
        next_states.push((0, b)); // empty bucket one
        next_states.push((a, 0)); // empty bucket two
        let pour = a.min(capacity_2 - b); // pour one into two
        next_states.push((a - pour, b + pour));
        let pour = b.min(capacity_1 - a); // pour two into one
        next_states.push((a + pour, b - pour));

        for (na, nb) in next_states {
            // Rule: after an action, the starting bucket may not be empty
            // while the other bucket is full.
            if start == 0 && na == 0 && nb == capacity_2 {
                continue;
            }
            if start == 1 && na == capacity_1 && nb == 0 {
                continue;
            }

            let idx = na as usize * (capacity_2 as usize + 1) + nb as usize;
            if visited[idx] {
                continue;
            }
            visited[idx] = true;

            let moves = moves + 1;
            if na == goal || nb == goal {
                let moves = moves.try_into().ok()?;
                let (goal_bucket, other_bucket) = if na == goal {
                    (Bucket::One, nb)
                } else {
                    (Bucket::Two, na)
                };
                return Some(BucketStats {
                    moves,
                    goal_bucket,
                    other_bucket,
                });
            }

            queue.push_back((na, nb, moves));
        }
    }

    None
}
