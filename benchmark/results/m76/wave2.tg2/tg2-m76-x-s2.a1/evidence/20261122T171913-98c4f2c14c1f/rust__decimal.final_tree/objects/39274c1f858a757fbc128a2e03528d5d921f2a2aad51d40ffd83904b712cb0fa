use std::cmp::Ordering;
use std::fmt;
use std::ops::{Add, Mul, Sub};

/// A decimal number with arbitrary precision.
///
/// The value is stored as a sign and two sequences of base-10 digits, most
/// significant first: the integer part and the fractional part. The integer
/// part never has leading zeros (it is `[0]` when the value is zero) and the
/// fractional part never has trailing zeros, so every value has exactly one
/// representation.
#[derive(Clone)]
pub struct Decimal {
    /// -1, 0, or 1
    sign: i8,
    /// integer digits (always non-empty)
    integer: Vec<u8>,
    /// fractional digits (empty when there is no fraction)
    fractional: Vec<u8>,
}

impl Decimal {
    /// Create a new decimal from a string like `"123.456"`, `"-0.5"`, or `"+7"`.
    ///
    /// Returns `None` if the input is not a valid decimal literal.
    pub fn try_from(input: &str) -> Option<Decimal> {
        let mut rest = input;
        let mut sign: i8 = 1;
        if let Some(r) = rest.strip_prefix('+') {
            rest = r;
        } else if let Some(r) = rest.strip_prefix('-') {
            sign = -1;
            rest = r;
        }

        let (int_part, frac_part) = match rest.split_once('.') {
            Some((i, f)) => (i, f),
            None => (rest, ""),
        };
        if int_part.is_empty() && frac_part.is_empty() {
            return None;
        }

        let integer: Vec<u8> = int_part.bytes().map(|b| b.wrapping_sub(b'0')).collect();
        let fractional: Vec<u8> = frac_part.bytes().map(|b| b.wrapping_sub(b'0')).collect();
        if integer.iter().chain(fractional.iter()).any(|&d| d > 9) {
            return None;
        }

        Some(Self::normalize(sign, integer, fractional))
    }

    /// Turn raw (possibly untrimmed) digit parts into a normalized `Decimal`.
    fn normalize(sign: i8, mut integer: Vec<u8>, mut fractional: Vec<u8>) -> Decimal {
        match integer.iter().position(|&d| d != 0) {
            Some(i) => integer = integer.split_off(i),
            None => integer = vec![0],
        }
        match fractional.iter().rposition(|&d| d != 0) {
            Some(i) => fractional.truncate(i + 1),
            None => fractional.clear(),
        }
        let is_zero = integer == [0] && fractional.is_empty();
        Decimal {
            sign: if is_zero { 0 } else { sign },
            integer,
            fractional,
        }
    }

    fn zero() -> Decimal {
        Decimal {
            sign: 0,
            integer: vec![0],
            fractional: vec![],
        }
    }

    /// Total ordering of two decimals.
    fn compare(&self, other: &Decimal) -> Ordering {
        if self.sign != other.sign {
            return self.sign.cmp(&other.sign);
        }
        let int_cmp = self.integer.cmp(&other.integer);
        if int_cmp != Ordering::Equal {
            return if self.sign >= 0 { int_cmp } else { int_cmp.reverse() };
        }
        let frac_cmp = Self::compare_fractional(&self.fractional, &other.fractional);
        if self.sign >= 0 {
            frac_cmp
        } else {
            frac_cmp.reverse()
        }
    }

    /// Compare magnitudes, ignoring sign.
    fn compare_magnitude(&self, other: &Decimal) -> Ordering {
        let int_cmp = self.integer.cmp(&other.integer);
        if int_cmp != Ordering::Equal {
            return int_cmp;
        }
        Self::compare_fractional(&self.fractional, &other.fractional)
    }

    /// Compare fractional parts, treating missing trailing digits as zeros.
    fn compare_fractional(a: &[u8], b: &[u8]) -> Ordering {
        for i in 0..a.len().max(b.len()) {
            let da = a.get(i).copied().unwrap_or(0);
            let db = b.get(i).copied().unwrap_or(0);
            if da != db {
                return da.cmp(&db);
            }
        }
        Ordering::Equal
    }

    fn add_ref(&self, other: &Decimal) -> Decimal {
        if self.sign == 0 {
            return other.clone();
        }
        if other.sign == 0 {
            return self.clone();
        }
        if self.sign == other.sign {
            Self::add_magnitudes(self, other, self.sign)
        } else {
            match self.compare_magnitude(other) {
                Ordering::Greater => Self::sub_magnitudes(self, other, self.sign),
                Ordering::Less => Self::sub_magnitudes(other, self, other.sign),
                Ordering::Equal => Self::zero(),
            }
        }
    }

    fn sub_ref(&self, other: &Decimal) -> Decimal {
        let negated = Decimal {
            sign: -other.sign,
            integer: other.integer.clone(),
            fractional: other.fractional.clone(),
        };
        self.add_ref(&negated)
    }

    fn mul_ref(&self, other: &Decimal) -> Decimal {
        if self.sign == 0 || other.sign == 0 {
            return Self::zero();
        }
        let sign = self.sign * other.sign;

        // Treat each value as an integer scaled by 10^fractional_len, multiply
        // those integers, then re-split the product at the combined scale.
        let mut a_digits = self.integer.clone();
        a_digits.extend_from_slice(&self.fractional);
        let mut b_digits = other.integer.clone();
        b_digits.extend_from_slice(&other.fractional);

        let product = Self::mul_digits(&a_digits, &b_digits);
        let scale = self.fractional.len() + other.fractional.len();
        let int_len = product.len().saturating_sub(scale);
        let integer = product[..int_len].to_vec();
        let fractional = product[int_len..].to_vec();
        Self::normalize(sign, integer, fractional)
    }

    /// Add two magnitudes (signs ignored); `sign` is the sign of the result.
    fn add_magnitudes(a: &Decimal, b: &Decimal, sign: i8) -> Decimal {
        let frac_len = a.fractional.len().max(b.fractional.len());
        let mut result_frac = vec![0u8; frac_len];
        let mut carry = 0u8;
        for i in 0..frac_len {
            let idx = frac_len - 1 - i;
            let sum = a.fractional.get(idx).copied().unwrap_or(0)
                + b.fractional.get(idx).copied().unwrap_or(0)
                + carry;
            result_frac[idx] = sum % 10;
            carry = sum / 10;
        }

        let mut result_int = Self::pad_left(a.integer.clone(), b.integer.len());
        let mut int_carry = carry;
        for i in (0..result_int.len()).rev() {
            let sum = result_int[i] + b.integer.get(i).copied().unwrap_or(0) + int_carry;
            result_int[i] = sum % 10;
            int_carry = sum / 10;
        }
        while int_carry > 0 {
            result_int.insert(0, int_carry % 10);
            int_carry /= 10;
        }

        Self::normalize(sign, result_int, result_frac)
    }

    /// Subtract two magnitudes, requiring `a >= b`; `sign` is the result's sign.
    fn sub_magnitudes(a: &Decimal, b: &Decimal, sign: i8) -> Decimal {
        let frac_len = a.fractional.len().max(b.fractional.len());
        let mut result_frac = vec![0u8; frac_len];
        let mut borrow = 0u8;
        for i in 0..frac_len {
            let idx = frac_len - 1 - i;
            let mut diff = a.fractional.get(idx).copied().unwrap_or(0) as i8
                - b.fractional.get(idx).copied().unwrap_or(0) as i8
                - borrow as i8;
            if diff < 0 {
                diff += 10;
                borrow = 1;
            } else {
                borrow = 0;
            }
            result_frac[idx] = diff as u8;
        }

        let mut result_int = Self::pad_left(a.integer.clone(), b.integer.len());
        let mut int_borrow = borrow;
        for i in (0..result_int.len()).rev() {
            let mut diff = result_int[i] as i8 - b.integer[i] as i8 - int_borrow as i8;
            if diff < 0 {
                diff += 10;
                int_borrow = 1;
            } else {
                int_borrow = 0;
            }
            result_int[i] = diff as u8;
        }

        Self::normalize(sign, result_int, result_frac)
    }

    /// Grade-school multiplication of digit vectors, returned most-significant
    /// first.
    fn mul_digits(a: &[u8], b: &[u8]) -> Vec<u8> {
        let mut result = vec![0u8; a.len() + b.len()];
        for (i, &da) in a.iter().rev().enumerate() {
            for (j, &db) in b.iter().rev().enumerate() {
                let mut carry = da as u32 * db as u32 + result[i + j] as u32;
                result[i + j] = (carry % 10) as u8;
                carry /= 10;
                let mut k = i + j + 1;
                while carry > 0 {
                    carry += result[k] as u32;
                    result[k] = (carry % 10) as u8;
                    carry /= 10;
                    k += 1;
                }
            }
        }
        result.reverse();
        result
    }

    /// Left-pad `digits` with zeros to at least `len` digits.
    fn pad_left(mut digits: Vec<u8>, len: usize) -> Vec<u8> {
        if digits.len() < len {
            let mut padded = vec![0u8; len - digits.len()];
            padded.append(&mut digits);
            padded
        } else {
            digits
        }
    }
}

impl PartialEq for Decimal {
    fn eq(&self, other: &Decimal) -> bool {
        self.compare(other) == Ordering::Equal
    }
}

impl Eq for Decimal {}

impl PartialOrd for Decimal {
    fn partial_cmp(&self, other: &Decimal) -> Option<Ordering> {
        Some(self.compare(other))
    }
}

impl Ord for Decimal {
    fn cmp(&self, other: &Decimal) -> Ordering {
        self.compare(other)
    }
}

impl fmt::Display for Decimal {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        if self.sign == -1 {
            f.write_str("-")?;
        }
        for &digit in &self.integer {
            write!(f, "{digit}")?;
        }
        if !self.fractional.is_empty() {
            f.write_str(".")?;
            for &digit in &self.fractional {
                write!(f, "{digit}")?;
            }
        }
        Ok(())
    }
}

impl fmt::Debug for Decimal {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "Decimal({self})")
    }
}

macro_rules! impl_binop {
    ($trait:ident, $method:ident, $ref_method:ident) => {
        impl $trait<Decimal> for Decimal {
            type Output = Decimal;
            fn $method(self, rhs: Decimal) -> Decimal {
                self.$ref_method(&rhs)
            }
        }
        impl $trait<&Decimal> for &Decimal {
            type Output = Decimal;
            fn $method(self, rhs: &Decimal) -> Decimal {
                self.$ref_method(rhs)
            }
        }
        impl $trait<Decimal> for &Decimal {
            type Output = Decimal;
            fn $method(self, rhs: Decimal) -> Decimal {
                self.$ref_method(&rhs)
            }
        }
        impl $trait<&Decimal> for Decimal {
            type Output = Decimal;
            fn $method(self, rhs: &Decimal) -> Decimal {
                self.$ref_method(rhs)
            }
        }
    };
}

impl_binop!(Add, add, add_ref);
impl_binop!(Sub, sub, sub_ref);
impl_binop!(Mul, mul, mul_ref);
