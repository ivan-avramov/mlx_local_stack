pub struct Luhn {
    input: String,
}

impl Luhn {
    pub fn is_valid(&self) -> bool {
        let mut digits = Vec::new();

        for c in self.input.chars() {
            if c.is_whitespace() {
                continue;
            }
            match c.to_digit(10) {
                Some(d) => digits.push(d),
                // Any non-digit, non-whitespace character makes the input invalid.
                None => return false,
            }
        }

        // A single digit (or empty) input is never a valid Luhn number.
        if digits.len() <= 1 {
            return false;
        }

        // Starting from the rightmost digit, double every second digit.
        // If doubling produces a value greater than 9, subtract 9.
        let sum: u32 = digits
            .iter()
            .rev()
            .enumerate()
            .map(|(i, d)| {
                if i % 2 == 1 {
                    let doubled = d * 2;
                    if doubled > 9 {
                        doubled - 9
                    } else {
                        doubled
                    }
                } else {
                    *d
                }
            })
            .sum();

        sum % 10 == 0
    }
}

/// Implement `From` for any type that can be rendered as a string. This single
/// blanket implementation covers `&str`, `String`, and every unsigned integer
/// type (and would keep working if a new `ToString` type were presented).
impl<T: ToString> From<T> for Luhn {
    fn from(input: T) -> Self {
        Luhn {
            input: input.to_string(),
        }
    }
}
