const WEEKDAYS = {
  Sunday: 0,
  Monday: 1,
  Tuesday: 2,
  Wednesday: 3,
  Thursday: 4,
  Friday: 5,
  Saturday: 6,
};

export const meetup = (year, month, week, weekday) => {
  const target = WEEKDAYS[weekday];

  const dates = [];
  for (let day = 1; day <= 31; day += 1) {
    const date = new Date(year, month - 1, day);
    if (date.getMonth() === month - 1 && date.getDay() === target) {
      dates.push(date);
    }
  }

  switch (week) {
    case 'teenth':
      return dates.find((date) => date.getDate() >= 13 && date.getDate() <= 19);
    case 'last':
      return dates[dates.length - 1];
    default:
      return dates[['first', 'second', 'third', 'fourth'].indexOf(week)];
  }
};
