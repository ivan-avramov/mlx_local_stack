export const transpose = (text) => {
  const cols = text.reduce((max, row) => Math.max(max, row.length), 0);
  const result = [];

  for (let col = 0; col < cols; col += 1) {
    // Find the last input row that has a character in this column.
    let last = -1;
    for (let i = 0; i < text.length; i += 1) {
      if (text[i].length > col) {
        last = i;
      }
    }

    let row = '';
    for (let i = 0; i <= last; i += 1) {
      row += text[i].length > col ? text[i][col] : ' ';
    }
    result.push(row);
  }

  return result;
};
