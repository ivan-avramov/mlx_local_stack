export class GradeSchool {
  constructor() {
    this.db = {};
  }

  add(name, grade) {
    // A student can only be enrolled once, so remove them from any
    // grade they may already be in before placing them in the new one.
    for (const g of Object.keys(this.db)) {
      const index = this.db[g].indexOf(name);
      if (index !== -1) {
        this.db[g].splice(index, 1);
      }
    }

    if (!this.db[grade]) {
      this.db[grade] = [];
    }
    this.db[grade].push(name);
  }

  grade(grade) {
    return (this.db[grade] || []).slice().sort((a, b) => a.localeCompare(b));
  }

  roster() {
    const result = {};
    for (const g of Object.keys(this.db)) {
      result[g] = this.db[g].slice().sort((a, b) => a.localeCompare(b));
    }
    return result;
  }
}
