// convenience to get you started writing code faster.
//

export class QueenAttack {
  constructor({
    black: [blackRow, blackColumn] = [0, 3],
    white: [whiteRow, whiteColumn] = [7, 3],
  } = {}) {
    for (const [row, column] of [[blackRow, blackColumn], [whiteRow, whiteColumn]]) {
      if (row < 0 || row > 7 || column < 0 || column > 7) {
        throw new Error('Queen must be placed on the board');
      }
    }
    if (blackRow === whiteRow && blackColumn === whiteColumn) {
      throw new Error('Queens cannot share the same space');
    }
    this.black = [blackRow, blackColumn];
    this.white = [whiteRow, whiteColumn];
  }

  toString() {
    const rows = [];
    for (let row = 0; row < 8; row++) {
      const columns = [];
      for (let column = 0; column < 8; column++) {
        if (this.white[0] === row && this.white[1] === column) {
          columns.push('W');
        } else if (this.black[0] === row && this.black[1] === column) {
          columns.push('B');
        } else {
          columns.push('_');
        }
      }
      rows.push(columns.join(' '));
    }
    return rows.join('\n');
  }

  get canAttack() {
    const [bRow, bColumn] = this.black;
    const [wRow, wColumn] = this.white;
    return (
      bRow === wRow ||
      bColumn === wColumn ||
      Math.abs(bRow - wRow) === Math.abs(bColumn - wColumn)
    );
  }
}
