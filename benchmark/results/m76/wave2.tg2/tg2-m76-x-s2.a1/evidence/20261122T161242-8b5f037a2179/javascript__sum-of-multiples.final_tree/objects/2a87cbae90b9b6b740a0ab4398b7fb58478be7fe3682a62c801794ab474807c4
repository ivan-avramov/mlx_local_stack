export const sum = (factors, limit) => {
  const multiples = new Set();
  for (const factor of factors) {
    if (factor === 0) continue;
    for (let n = factor; n < limit; n += factor) {
      multiples.add(n);
    }
  }
  return [...multiples].reduce((total, n) => total + n, 0);
};
