const UNITS = [
  '',
  'thousand',
  'million',
  'billion',
];

const ONES = [
  '',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
  'eleven',
  'twelve',
  'thirteen',
  'fourteen',
  'fifteen',
  'sixteen',
  'seventeen',
  'eighteen',
  'nineteen',
];

const TENS = [
  '',
  '',
  'twenty',
  'thirty',
  'forty',
  'fifty',
  'sixty',
  'seventy',
  'eighty',
  'ninety',
];

const sayBelowHundred = (n) => {
  if (n < 20) {
    return ONES[n];
  }

  const tens = TENS[Math.floor(n / 10)];
  const ones = n % 10;

  return ones === 0 ? tens : `${tens}-${ONES[ones]}`;
};

const sayBelowThousand = (n) => {
  const hundreds = Math.floor(n / 100);
  const remainder = n % 100;

  const parts = [];

  if (hundreds > 0) {
    parts.push(`${ONES[hundreds]} hundred`);
  }

  if (remainder > 0) {
    parts.push(sayBelowHundred(remainder));
  }

  return parts.join(' ');
};

export const say = (n) => {
  if (n < 0 || n > 999999999999) {
    throw new Error('Number must be between 0 and 999,999,999,999.');
  }

  if (n === 0) {
    return 'zero';
  }

  const chunks = [];

  let rest = n;

  while (rest > 0) {
    chunks.unshift(rest % 1000);
    rest = Math.floor(rest / 1000);
  }

  const parts = [];

  chunks.forEach((chunk, i) => {
    if (chunk === 0) {
      return;
    }

    const unit = UNITS[chunks.length - 1 - i];

    parts.push(
      unit === ''
        ? sayBelowThousand(chunk)
        : `${sayBelowThousand(chunk)} ${unit}`,
    );
  });

  return parts.join(' ');
};
