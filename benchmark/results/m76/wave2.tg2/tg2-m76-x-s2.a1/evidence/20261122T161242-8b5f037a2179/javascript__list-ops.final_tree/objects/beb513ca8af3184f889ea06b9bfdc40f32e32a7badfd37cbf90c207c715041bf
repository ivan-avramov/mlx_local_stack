export class List {
  constructor(values = []) {
    this.values = values;
  }

  append(list2) {
    const result = new List([]);
    for (let i = 0; i < this.values.length; i++) {
      result.values[result.values.length] = this.values[i];
    }
    for (let i = 0; i < list2.values.length; i++) {
      result.values[result.values.length] = list2.values[i];
    }
    return result;
  }

  concat(list2) {
    const result = new List([]);
    for (let i = 0; i < this.values.length; i++) {
      const item = this.values[i];
      if (item instanceof List) {
        const appended = result.concat(item);
        result.values = appended.values;
      } else {
        result.values[result.values.length] = item;
      }
    }
    for (let i = 0; i < list2.values.length; i++) {
      const item = list2.values[i];
      if (item instanceof List) {
        const appended = result.concat(item);
        result.values = appended.values;
      } else {
        result.values[result.values.length] = item;
      }
    }
    return result;
  }

  filter(predicate) {
    const result = new List([]);
    for (let i = 0; i < this.values.length; i++) {
      if (predicate(this.values[i])) {
        result.values[result.values.length] = this.values[i];
      }
    }
    return result;
  }

  map(fn) {
    const result = new List([]);
    for (let i = 0; i < this.values.length; i++) {
      result.values[result.values.length] = fn(this.values[i]);
    }
    return result;
  }

  length() {
    let count = 0;
    for (const _ of this.values) {
      count++;
    }
    return count;
  }

  foldl(fn, acc) {
    for (let i = 0; i < this.values.length; i++) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  foldr(fn, acc) {
    for (let i = this.values.length - 1; i >= 0; i--) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  reverse() {
    const result = new List([]);
    for (let i = this.values.length - 1; i >= 0; i--) {
      result.values[result.values.length] = this.values[i];
    }
    return result;
  }
}
