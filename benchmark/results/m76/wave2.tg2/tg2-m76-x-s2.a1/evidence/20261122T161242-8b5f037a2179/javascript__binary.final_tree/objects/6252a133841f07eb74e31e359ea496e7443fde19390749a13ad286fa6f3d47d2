export class Binary {
  constructor(binaryString) {
    this.binaryString = binaryString;
  }

  toDecimal() {
    if (!/^[01]+$/.test(this.binaryString)) {
      return null;
    }

    return this.binaryString
      .split('')
      .reduce((total, digit) => total * 2 + Number(digit), 0);
  }
}
