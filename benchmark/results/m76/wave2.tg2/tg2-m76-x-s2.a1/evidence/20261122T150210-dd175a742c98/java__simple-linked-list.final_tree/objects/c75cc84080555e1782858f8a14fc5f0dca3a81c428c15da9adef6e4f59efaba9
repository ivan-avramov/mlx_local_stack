class SimpleLinkedList<T> {

    private Node head;
    private int size;

    SimpleLinkedList() {
    }

    SimpleLinkedList(T[] values) {
        for (T value : values) {
            push(value);
        }
    }

    void push(T value) {
        head = new Node(value, head);
        size++;
    }

    T pop() {
        if (head == null) {
            throw new java.util.NoSuchElementException();
        }
        T value = head.value;
        head = head.next;
        size--;
        return value;
    }

    void reverse() {
        Node current = head;
        Node previous = null;
        while (current != null) {
            Node next = current.next;
            current.next = previous;
            previous = current;
            current = next;
        }
        head = previous;
    }

    T[] asArray(Class<T> clazz) {
        @SuppressWarnings("unchecked")
        T[] array = (T[]) java.lang.reflect.Array.newInstance(clazz, size);
        int index = 0;
        for (Node node = head; node != null; node = node.next) {
            array[index++] = node.value;
        }
        return array;
    }

    int size() {
        return size;
    }

    private class Node {
        final T value;
        Node next;

        Node(T value, Node next) {
            this.value = value;
            this.next = next;
        }
    }
}
