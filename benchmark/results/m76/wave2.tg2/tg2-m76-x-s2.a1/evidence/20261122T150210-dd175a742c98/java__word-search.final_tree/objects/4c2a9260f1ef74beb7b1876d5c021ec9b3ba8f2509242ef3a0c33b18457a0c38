import java.util.HashMap;
import java.util.Map;
import java.util.Optional;
import java.util.Set;

class WordSearcher {

    private static final int[][] DIRECTIONS = {
            {1, 0},    // left to right
            {-1, 0},   // right to left
            {0, 1},    // top to bottom
            {0, -1},   // bottom to top
            {1, 1},    // top-left to bottom-right
            {1, -1},   // top-right to bottom-left
            {-1, 1},   // bottom-left to top-right
            {-1, -1}   // bottom-right to top-left
    };

    Map<String, Optional<WordLocation>> search(final Set<String> words, final char[][] grid) {
        final Map<String, Optional<WordLocation>> locations = new HashMap<>();

        for (final String word : words) {
            locations.put(word, findWord(word, grid));
        }

        return locations;
    }

    private Optional<WordLocation> findWord(final String word, final char[][] grid) {
        final int rows = grid.length;

        for (int y = 0; y < rows; y++) {
            for (int x = 0; x < grid[y].length; x++) {
                for (final int[] direction : DIRECTIONS) {
                    final Optional<WordLocation> location =
                            matches(word, grid, x, y, direction[0], direction[1]);
                    if (location.isPresent()) {
                        return location;
                    }
                }
            }
        }

        return Optional.empty();
    }

    private Optional<WordLocation> matches(final String word, final char[][] grid,
                                           final int startX, final int startY,
                                           final int dx, final int dy) {
        final int rows = grid.length;

        for (int i = 0; i < word.length(); i++) {
            final int x = startX + dx * i;
            final int y = startY + dy * i;

            if (x < 0 || y < 0 || y >= rows || x >= grid[y].length || grid[y][x] != word.charAt(i)) {
                return Optional.empty();
            }
        }

        final int endX = startX + dx * (word.length() - 1);
        final int endY = startY + dy * (word.length() - 1);

        return Optional.of(new WordLocation(new Pair(startX + 1, startY + 1), new Pair(endX + 1, endY + 1)));
    }
}
