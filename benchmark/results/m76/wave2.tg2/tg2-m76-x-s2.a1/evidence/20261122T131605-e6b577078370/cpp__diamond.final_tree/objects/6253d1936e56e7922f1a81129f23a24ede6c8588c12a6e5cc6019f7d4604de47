#include "diamond.h"

#include <string>
#include <vector>

namespace diamond {

std::vector<std::string> rows(char letter) {
	const int n = letter - 'A';
	const int width = 2 * n + 1;
	std::vector<std::string> result;
	result.reserve(2 * n + 1);

	for (int i = 0; i <= 2 * n; ++i) {
		const int k = i <= n ? i : 2 * n - i;  // letter index for this row
		std::string row(width, ' ');
		row[n] = 'A' + k;
		if (k > 0) {
			row[n - k] = row[n + k] = 'A' + k;
		}
		result.push_back(std::move(row));
	}

	return result;
}

}  // namespace diamond
