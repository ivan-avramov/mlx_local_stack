#include "space_age.h"

namespace space_age {

namespace {

constexpr double earth_year_seconds = 31557600.0;

constexpr double orbital_period_earth_years[] = {
    0.2408467,   // Mercury
    0.61519726,  // Venus
    1.0,         // Earth
    1.8808158,   // Mars
    11.862615,   // Jupiter
    29.447498,   // Saturn
    84.016846,   // Uranus
    164.79132    // Neptune
};

}  // namespace

space_age::space_age(int seconds) : _seconds(seconds) {}

int space_age::seconds() const {
    return _seconds;
}

double space_age::on_earth() const {
    return static_cast<double>(_seconds) / earth_year_seconds;
}

double space_age::on_mercury() const {
    return on_earth() / orbital_period_earth_years[0];
}

double space_age::on_venus() const {
    return on_earth() / orbital_period_earth_years[1];
}

double space_age::on_mars() const {
    return on_earth() / orbital_period_earth_years[3];
}

double space_age::on_jupiter() const {
    return on_earth() / orbital_period_earth_years[4];
}

double space_age::on_saturn() const {
    return on_earth() / orbital_period_earth_years[5];
}

double space_age::on_uranus() const {
    return on_earth() / orbital_period_earth_years[6];
}

double space_age::on_neptune() const {
    return on_earth() / orbital_period_earth_years[7];
}

}  // namespace space_age
