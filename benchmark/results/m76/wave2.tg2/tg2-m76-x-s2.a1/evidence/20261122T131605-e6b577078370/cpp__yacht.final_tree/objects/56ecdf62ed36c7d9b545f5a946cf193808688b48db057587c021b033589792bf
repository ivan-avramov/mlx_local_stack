#include "yacht.h"

#include <array>

namespace yacht {

namespace {

int face_value(const std::string& category) {
    if (category == "ones") return 1;
    if (category == "twos") return 2;
    if (category == "threes") return 3;
    if (category == "fours") return 4;
    if (category == "fives") return 5;
    if (category == "sixes") return 6;
    return 0;
}

}  // namespace

int score(std::initializer_list<int> dice, const std::string& category) {
    std::array<int, 7> counts{};
    int sum = 0;
    for (const int die : dice) {
        ++counts[die];
        sum += die;
    }

    const int face = face_value(category);
    if (face != 0) {
        return face * counts[face];
    }

    if (category == "full house") {
        bool has_three = false;
        bool has_two = false;
        for (const int c : counts) {
            if (c == 3) has_three = true;
            if (c == 2) has_two = true;
        }
        return has_three && has_two ? sum : 0;
    }

    if (category == "four of a kind") {
        for (int f = 1; f <= 6; ++f) {
            if (counts[f] >= 4) return 4 * f;
        }
        return 0;
    }

    if (category == "little straight") {
        for (int f = 1; f <= 5; ++f) {
            if (counts[f] != 1) return 0;
        }
        return 30;
    }

    if (category == "big straight") {
        for (int f = 2; f <= 6; ++f) {
            if (counts[f] != 1) return 0;
        }
        return 30;
    }

    if (category == "choice") {
        return sum;
    }

    if (category == "yacht") {
        for (int f = 1; f <= 6; ++f) {
            if (counts[f] == 5) return 50;
        }
        return 0;
    }

    return 0;
}

}  // namespace yacht
