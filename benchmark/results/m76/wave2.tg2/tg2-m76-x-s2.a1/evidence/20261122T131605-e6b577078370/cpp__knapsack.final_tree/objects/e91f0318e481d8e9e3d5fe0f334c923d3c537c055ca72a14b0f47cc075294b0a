#include "knapsack.h"

#include <algorithm>
#include <vector>

namespace knapsack
{

int maximum_value(int max_weight, const std::vector<Item>& items)
{
    // best[w] = maximum value achievable using the items considered so far
    // with a total weight of at most w
    std::vector<int> best(max_weight + 1, 0);

    for (const Item& item : items)
    {
        // Iterate weights from high to low so each item is used at most once
        for (int w = max_weight; w >= item.weight; --w)
        {
            best[w] = std::max(best[w], best[w - item.weight] + item.value);
        }
    }

    return best[max_weight];
}

} // namespace knapsack
