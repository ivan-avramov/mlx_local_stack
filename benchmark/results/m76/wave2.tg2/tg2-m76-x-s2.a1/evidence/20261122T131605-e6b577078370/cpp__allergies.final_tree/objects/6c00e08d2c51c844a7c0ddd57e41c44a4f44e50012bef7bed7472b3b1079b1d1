#include "allergies.h"

namespace allergies {

namespace {

struct allergen_bit {
  const char* name;
  unsigned bit;
};

const allergen_bit kAllergens[] = {
    {"eggs", 1},
    {"peanuts", 2},
    {"shellfish", 4},
    {"strawberries", 8},
    {"tomatoes", 16},
    {"chocolate", 32},
    {"pollen", 64},
    {"cats", 128},
};

}  // namespace

allergy_result::allergy_result(unsigned score) : score_(score) {}

bool allergy_result::is_allergic_to(const std::string& allergen) const {
  for (const auto& a : kAllergens) {
    if (allergen == a.name) {
      return (score_ & a.bit) != 0;
    }
  }
  return false;
}

std::unordered_set<std::string> allergy_result::get_allergies() const {
  std::unordered_set<std::string> result;
  for (const auto& a : kAllergens) {
    if ((score_ & a.bit) != 0) {
      result.emplace(a.name);
    }
  }
  return result;
}

allergy_result allergy_test(unsigned score) {
  return allergy_result(score);
}

}  // namespace allergies
