#pragma once

namespace dnd_character {

// Computes the ability modifier for a given ability score:
// subtract 10, divide by 2, and round down.
int modifier(int score);

// Rolls four 6-sided dice and returns the sum of the largest three.
int ability();

// A character with six randomly generated abilities and their
// initial hitpoints (10 + constitution modifier).
struct Character {
    Character();

    int strength;
    int dexterity;
    int constitution;
    int intelligence;
    int wisdom;
    int charisma;
    int hitpoints;
};

}  // namespace dnd_character
