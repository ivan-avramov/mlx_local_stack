import java.util.HashMap;
import java.util.Map;
import java.util.Optional;
import java.util.Set;

class WordSearcher {

    private static final int[][] DIRECTIONS = {
            {1, 0}, {-1, 0},   // left-to-right, right-to-left
            {0, 1}, {0, -1},   // top-to-bottom, bottom-to-top
            {1, 1}, {1, -1},   // top-left to bottom-right, top-right to bottom-left
            {-1, 1}, {-1, -1}  // bottom-left to top-right, bottom-right to top-left
    };

    Map<String, Optional<WordLocation>> search(final Set<String> words, final char[][] grid) {
        Map<String, Optional<WordLocation>> locations = new HashMap<>();

        for (String word : words) {
            locations.put(word, findLocation(word, grid));
        }

        return locations;
    }

    private Optional<WordLocation> findLocation(final String word, final char[][] grid) {
        int rows = grid.length;
        int cols = rows > 0 ? grid[0].length : 0;

        for (int row = 0; row < rows; row++) {
            for (int col = 0; col < cols; col++) {
                for (int[] direction : DIRECTIONS) {
                    WordLocation location = tryMatch(word, grid, row, col, direction[0], direction[1]);
                    if (location != null) {
                        return Optional.of(location);
                    }
                }
            }
        }

        return Optional.empty();
    }

    private WordLocation tryMatch(final String word, final char[][] grid,
                                  final int row, final int col,
                                  final int dx, final int dy) {
        int length = word.length();
        int endRow = row + dy * (length - 1);
        int endCol = col + dx * (length - 1);

        if (endRow < 0 || endRow >= grid.length || endCol < 0 || endCol >= grid[0].length) {
            return null;
        }

        for (int i = 0; i < length; i++) {
            if (grid[row + dy * i][col + dx * i] != word.charAt(i)) {
                return null;
            }
        }

        return new WordLocation(
                new Pair(col + 1, row + 1),
                new Pair(endCol + 1, endRow + 1));
    }
}
