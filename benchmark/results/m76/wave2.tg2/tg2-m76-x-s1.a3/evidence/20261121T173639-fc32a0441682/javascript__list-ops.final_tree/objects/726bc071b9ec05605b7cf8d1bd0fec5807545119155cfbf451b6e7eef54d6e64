export class List {
  constructor(values = []) {
    this.values = values;
  }

  append(other) {
    const values = [];
    let i = 0;
    for (let j = 0; j < this.values.length; j++) {
      values[i++] = this.values[j];
    }
    for (let j = 0; j < other.values.length; j++) {
      values[i++] = other.values[j];
    }
    return new List(values);
  }

  concat(other) {
    const values = [];
    let i = 0;
    for (let j = 0; j < this.values.length; j++) {
      values[i++] = this.values[j];
    }
    for (let j = 0; j < other.values.length; j++) {
      const item = other.values[j];
      if (item instanceof List) {
        for (let k = 0; k < item.values.length; k++) {
          values[i++] = item.values[k];
        }
      } else {
        values[i++] = item;
      }
    }
    return new List(values);
  }

  filter(predicate) {
    const values = [];
    let i = 0;
    for (let j = 0; j < this.values.length; j++) {
      if (predicate(this.values[j])) {
        values[i++] = this.values[j];
      }
    }
    return new List(values);
  }

  map(fn) {
    const values = [];
    for (let j = 0; j < this.values.length; j++) {
      values[j] = fn(this.values[j]);
    }
    return new List(values);
  }

  length() {
    return this.values.length;
  }

  foldl(fn, acc) {
    for (let j = 0; j < this.values.length; j++) {
      acc = fn(acc, this.values[j]);
    }
    return acc;
  }

  foldr(fn, acc) {
    for (let j = this.values.length - 1; j >= 0; j--) {
      acc = fn(acc, this.values[j]);
    }
    return acc;
  }

  reverse() {
    const values = [];
    for (let j = 0; j < this.values.length; j++) {
      values[j] = this.values[this.values.length - 1 - j];
    }
    return new List(values);
  }
}
