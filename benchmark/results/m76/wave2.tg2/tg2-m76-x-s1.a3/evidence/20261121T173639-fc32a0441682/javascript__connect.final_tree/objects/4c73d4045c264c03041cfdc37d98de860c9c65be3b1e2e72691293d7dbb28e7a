export class Board {
  constructor(lines) {
    this.board = lines.map((line) => line.trim().split(' '));
    this.rows = this.board.length;
    this.cols = this.board[0].length;
  }

  winner() {
    if (this._connects('X')) {
      return 'X';
    }
    if (this._connects('O')) {
      return 'O';
    }
    return '';
  }

  _connects(player) {
    const { board, rows, cols } = this;
    const isX = player === 'X';
    // X connects the left and right sides; O connects the top and bottom sides.
    const onStartSide = (r, c) => (isX ? c === 0 : r === 0);
    const onEndSide = (r, c) => (isX ? c === cols - 1 : r === rows - 1);

    const visited = new Set();
    const queue = [];
    for (let r = 0; r < rows; r += 1) {
      for (let c = 0; c < cols; c += 1) {
        if (board[r][c] === player && onStartSide(r, c)) {
          visited.add(`${r},${c}`);
          queue.push([r, c]);
        }
      }
    }

    while (queue.length > 0) {
      const [r, c] = queue.shift();
      if (onEndSide(r, c)) {
        return true;
      }
      for (const [nr, nc] of this._neighbors(r, c)) {
        if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
          continue;
        }
        const key = `${nr},${nc}`;
        if (visited.has(key) || board[nr][nc] !== player) {
          continue;
        }
        visited.add(key);
        queue.push([nr, nc]);
      }
    }
    return false;
  }

  _neighbors(r, c) {
    return [
      [r, c - 1],
      [r, c + 1],
      [r + 1, c - 1],
      [r + 1, c],
      [r - 1, c],
      [r - 1, c + 1],
    ];
  }
}
