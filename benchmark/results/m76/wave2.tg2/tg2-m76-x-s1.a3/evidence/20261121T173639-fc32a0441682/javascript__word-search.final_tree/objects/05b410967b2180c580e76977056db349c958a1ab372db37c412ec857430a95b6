// Directions to search in, as [rowDelta, colDelta].
// Order matters: the first matching direction wins.
const DIRECTIONS = [
  [0, 1], // left to right
  [0, -1], // right to left
  [1, 0], // top to bottom
  [-1, 0], // bottom to top
  [1, 1], // top left to bottom right
  [1, -1], // top right to bottom left
  [-1, 1], // bottom left to top right
  [-1, -1], // bottom right to top left
];

class WordSearch {
  constructor(grid) {
    this.grid = grid;
  }

  find(words) {
    const results = {};
    for (const word of words) {
      results[word] = this.#locate(word);
    }
    return results;
  }

  #locate(word) {
    const rows = this.grid.length;
    const cols = this.grid[0].length;

    for (const [dr, dc] of DIRECTIONS) {
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (this.#matches(word, r, c, dr, dc)) {
            return {
              start: [r + 1, c + 1],
              end: [
                r + dr * (word.length - 1) + 1,
                c + dc * (word.length - 1) + 1,
              ],
            };
          }
        }
      }
    }

    return undefined;
  }

  #matches(word, r, c, dr, dc) {
    const rows = this.grid.length;
    const cols = this.grid[0].length;

    for (let i = 0; i < word.length; i++) {
      const rr = r + dr * i;
      const cc = c + dc * i;
      if (rr < 0 || rr >= rows || cc < 0 || cc >= cols) {
        return false;
      }
      if (this.grid[rr][cc] !== word[i]) {
        return false;
      }
    }

    return true;
  }
}

export default WordSearch;
