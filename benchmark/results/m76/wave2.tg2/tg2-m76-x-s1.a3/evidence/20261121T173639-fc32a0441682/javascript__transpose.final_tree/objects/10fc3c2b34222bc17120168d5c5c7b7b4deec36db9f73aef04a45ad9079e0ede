export const transpose = (lines) => {
  const width = Math.max(0, ...lines.map((line) => line.length));
  return Array.from({ length: width }, (_, col) => {
    // Last input row that actually has a character in this column;
    // rows beyond it would only contribute right-side padding, which
    // is not part of the output.
    const last = lines.reduce(
      (acc, line, i) => (line.length > col ? i : acc),
      -1,
    );
    return lines
      .slice(0, last + 1)
      .map((line) => (line.length > col ? line[col] : ' '))
      .join('');
  });
};
