export class GradeSchool {
  constructor() {
    this._studentGrades = new Map(); // name -> grade
    this._grades = new Map(); // grade -> Set of names
  }

  roster() {
    const result = {};
    for (const [grade, names] of this._grades) {
      result[grade] = [...names].sort();
    }
    return result;
  }

  add(name, grade) {
    const previousGrade = this._studentGrades.get(name);
    if (previousGrade !== undefined) {
      // A student can only be in one grade: remove them from the old one.
      const previousNames = this._grades.get(previousGrade);
      previousNames.delete(name);
      if (previousNames.size === 0) {
        this._grades.delete(previousGrade);
      }
    }
    this._studentGrades.set(name, grade);
    if (!this._grades.has(grade)) {
      this._grades.set(grade, new Set());
    }
    this._grades.get(grade).add(name);
  }

  grade(grade) {
    const names = this._grades.get(grade);
    return names ? [...names].sort() : [];
  }
}
