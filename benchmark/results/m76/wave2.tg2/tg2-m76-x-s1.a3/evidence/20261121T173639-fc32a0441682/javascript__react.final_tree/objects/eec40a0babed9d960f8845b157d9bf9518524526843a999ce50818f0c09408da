// Recomputes all cells that transitively depend on `source`, in dependency
// order (a cell is only recomputed after all of its affected inputs have been
// recomputed). A cell's callbacks are invoked only when its value in the new
// stable state differs from the previous stable state.
function propagate(source) {
  // Collect every cell that may be affected by the change.
  const affected = new Set([source]);
  const stack = [...source.dependents];
  while (stack.length > 0) {
    const cell = stack.pop();
    if (!affected.has(cell)) {
      affected.add(cell);
      for (const dependent of cell.dependents) {
        stack.push(dependent);
      }
    }
  }

  // pending[cell] = how many of `cell`'s affected inputs still need to be
  // processed before it can be recomputed. Cells with none are ready now.
  const pending = new Map();
  const queue = [];
  for (const cell of affected) {
    if (cell === source) {
      continue;
    }
    let count = 0;
    for (const input of cell.inputCells) {
      if (affected.has(input) && input !== source) {
        count += 1;
      }
    }
    if (count === 0) {
      queue.push(cell);
    } else {
      pending.set(cell, count);
    }
  }

  let head = 0;
  while (head < queue.length) {
    const cell = queue[head++];

    const newValue = cell.fn(cell.inputCells);
    if (newValue !== cell.value) {
      cell.value = newValue;
      for (const callback of cell.callbacks) {
        if (typeof callback === 'function') {
          callback(cell);
        } else {
          callback.call(cell);
        }
      }
    }

    for (const dependent of cell.dependents) {
      if (!pending.has(dependent)) {
        continue;
      }
      const remaining = pending.get(dependent) - 1;
      if (remaining <= 0) {
        pending.delete(dependent);
        queue.push(dependent);
      } else {
        pending.set(dependent, remaining);
      }
    }
  }
}

export class InputCell {
  constructor(value) {
    this.value = value;
    this.dependents = new Set();
  }

  setValue(value) {
    if (this.value === value) {
      return;
    }
    this.value = value;
    propagate(this);
  }
}

export class ComputeCell {
  constructor(inputCells, fn) {
    this.inputCells = inputCells;
    this.fn = fn;
    this.value = fn(inputCells);
    this.callbacks = new Set();
    this.dependents = new Set();

    for (const inputCell of inputCells) {
      inputCell.dependents.add(this);
    }
  }

  addCallback(callback) {
    this.callbacks.add(callback);
  }

  removeCallback(callback) {
    this.callbacks.delete(callback);
  }
}

export class CallbackCell {
  constructor(fn) {
    this.fn = fn;
    this.values = [];
  }

  // Invoked by a ComputeCell when its value has changed in a new stable state.
  call(cell) {
    this.values.push(this.fn(cell));
  }
}
