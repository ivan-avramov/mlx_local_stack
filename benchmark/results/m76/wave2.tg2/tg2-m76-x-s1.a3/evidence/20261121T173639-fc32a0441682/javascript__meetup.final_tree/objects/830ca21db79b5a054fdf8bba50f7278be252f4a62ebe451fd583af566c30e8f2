const WEEKDAYS = [
  'Sunday',
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
];

const ORDINALS = { first: 1, second: 2, third: 3, fourth: 4 };

export const meetup = (year, month, week, weekday) => {
  const target = WEEKDAYS.indexOf(weekday);
  const daysInMonth = new Date(year, month, 0).getDate();

  const matches = (day) => new Date(year, month - 1, day).getDay() === target;

  if (week === 'teenth') {
    for (let day = 13; day <= 19; day++) {
      if (matches(day)) return new Date(year, month - 1, day);
    }
  }

  if (week === 'last') {
    for (let day = daysInMonth; day >= 1; day--) {
      if (matches(day)) return new Date(year, month - 1, day);
    }
  }

  const ordinal = ORDINALS[week];
  let count = 0;
  for (let day = 1; day <= daysInMonth; day++) {
    if (matches(day)) {
      count++;
      if (count === ordinal) return new Date(year, month - 1, day);
    }
  }

  throw new Error(`Unknown week: ${week}`);
};
