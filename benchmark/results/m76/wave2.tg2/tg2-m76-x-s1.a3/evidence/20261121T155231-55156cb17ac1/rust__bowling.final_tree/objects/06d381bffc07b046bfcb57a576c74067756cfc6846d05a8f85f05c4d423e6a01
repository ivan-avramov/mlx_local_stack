#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    rolls: Vec<u16>,
    /// Current frame, 0..=9; 10 once the game is over.
    frame: u8,
    /// Pins knocked down in the current frame (frames 1-9 only).
    pins_in_frame: u16,
    /// Rolls made in the current frame (frames 1-9 only).
    rolls_in_frame: u8,
    /// Number of rolls made in the tenth frame.
    tenth_rolls: u8,
}

impl BowlingGame {
    pub fn new() -> Self {
        Self {
            rolls: Vec::new(),
            frame: 0,
            pins_in_frame: 0,
            rolls_in_frame: 0,
            tenth_rolls: 0,
        }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.frame == 10 {
            return Err(Error::GameComplete);
        }

        if self.frame < 9 {
            if pins > 10 - self.pins_in_frame {
                return Err(Error::NotEnoughPinsLeft);
            }
        } else if pins > self.tenth_frame_available() {
            return Err(Error::NotEnoughPinsLeft);
        }

        self.rolls.push(pins);

        if self.frame < 9 {
            self.pins_in_frame += pins;
            self.rolls_in_frame += 1;
            if self.pins_in_frame == 10 || self.rolls_in_frame == 2 {
                self.frame += 1;
                self.pins_in_frame = 0;
                self.rolls_in_frame = 0;
            }
        } else {
            self.tenth_rolls += 1;
            if self.tenth_rolls == 2 {
                // The tenth frame is complete once the two rolls do not
                // knock down all ten pins; a strike or spare earns a
                // fill ball.
                if self.tenth_frame_total() < 10 {
                    self.frame = 10;
                }
            } else if self.tenth_rolls == 3 {
                self.frame = 10;
            }
        }

        Ok(())
    }

    /// Pins available to knock down on the next ball of the tenth frame.
    fn tenth_frame_available(&self) -> u16 {
        match self.tenth_rolls {
            0 => 10,
            1 => {
                // Second ball: a strike resets the rack, otherwise the
                // remaining pins of the first ball are still standing.
                let first = self.rolls[self.rolls.len() - 1];
                if first == 10 {
                    10
                } else {
                    10 - first
                }
            }
            _ => {
                // Third ball: the rack is fresh when the second ball
                // completed the frame (a spare, or a second strike);
                // otherwise the pins left standing by the second ball
                // are still there.
                let len = self.rolls.len();
                let first = self.rolls[len - 2];
                let second = self.rolls[len - 1];
                if second == 10 || first + second == 10 {
                    10
                } else {
                    10 - second
                }
            }
        }
    }

    /// Pins knocked down so far in the tenth frame.
    fn tenth_frame_total(&self) -> u16 {
        self.rolls
            .iter()
            .skip(self.rolls.len() - self.tenth_rolls as usize)
            .sum()
    }

    pub fn score(&self) -> Option<u16> {
        if self.frame != 10 {
            return None;
        }

        let mut total = 0u16;
        let mut i = 0;
        for _ in 0..10 {
            if self.rolls[i] == 10 {
                total += 10 + self.rolls[i + 1] + self.rolls[i + 2];
                i += 1;
            } else if self.rolls[i] + self.rolls[i + 1] == 10 {
                total += 10 + self.rolls[i + 2];
                i += 2;
            } else {
                total += self.rolls[i] + self.rolls[i + 1];
                i += 2;
            }
        }
        Some(total)
    }
}
