#[derive(PartialEq, Eq, Debug)]
pub enum Bucket {
    One,
    Two,
}

/// A struct to hold your results in.
#[derive(PartialEq, Eq, Debug)]
pub struct BucketStats {
    /// The total number of "moves" it should take to reach the desired number of liters, including
    /// the first fill.
    pub moves: u8,
    /// Which bucket should end up with the desired number of liters? (Either "one" or "two")
    pub goal_bucket: Bucket,
    /// How many liters are left in the other bucket?
    pub other_bucket: u8,
}

/// Solve the bucket problem
pub fn solve(
    capacity_1: u8,
    capacity_2: u8,
    goal: u8,
    start_bucket: &Bucket,
) -> Option<BucketStats> {
    if goal > capacity_1.max(capacity_2) {
        return None;
    }

    let c1 = capacity_1 as u16;
    let c2 = capacity_2 as u16;
    let goal = goal as u16;
    let start_is_one = *start_bucket == Bucket::One;

    // Breadth-first search over (bucket one, bucket two) states. Because every
    // action costs one and BFS explores states in order of move count, the
    // first time the goal is reached is the minimum number of moves.
    let width = (c2 + 1) as usize;
    let mut visited = vec![false; (c1 + 1) as usize * width];
    let mut queue = std::collections::VecDeque::new();
    queue.push_back((0u16, 0u16, 0u16));
    visited[0] = true;

    while let Some((a, b, moves)) = queue.pop_front() {
        for (na, nb) in successors(a, b, c1, c2) {
            // After any action the starting bucket may not be empty while the
            // other bucket is full.
            if start_is_one && na == 0 && nb == c2 {
                continue;
            }
            if !start_is_one && na == c1 && nb == 0 {
                continue;
            }

            let idx = na as usize * width + nb as usize;
            if visited[idx] {
                continue;
            }

            let next_moves = moves + 1;
            if na == goal {
                return Some(BucketStats {
                    moves: next_moves as u8,
                    goal_bucket: Bucket::One,
                    other_bucket: nb as u8,
                });
            }
            if nb == goal {
                return Some(BucketStats {
                    moves: next_moves as u8,
                    goal_bucket: Bucket::Two,
                    other_bucket: na as u8,
                });
            }

            visited[idx] = true;
            queue.push_back((na, nb, next_moves));
        }
    }

    None
}

/// All states reachable from `(a, b)` in a single action, skipping actions
/// that leave the state unchanged.
fn successors(a: u16, b: u16, c1: u16, c2: u16) -> impl Iterator<Item = (u16, u16)> {
    let pour_1_to_2 = a.min(c2 - b);
    let pour_2_to_1 = b.min(c1 - a);
    [
        (c1, b), // fill bucket one
        (a, c2), // fill bucket two
        (0, b), // empty bucket one
        (a, 0), // empty bucket two
        (a - pour_1_to_2, b + pour_1_to_2), // pour one into two
        (a + pour_2_to_1, b - pour_2_to_1), // pour two into one
    ]
    .into_iter()
    .filter(move |(na, nb)| *na != a || *nb != b)
}
