use std::collections::HashMap;

/// Cost (in cents) of a group of `n` distinct books, after the discount.
fn group_cost(n: usize) -> u32 {
    match n {
        1 => 800,
        2 => 1520,
        3 => 2160,
        4 => 2560,
        5 => 3000,
        _ => unreachable!("a group holds at most 5 books"),
    }
}

/// Minimum price (in cents) for a basket containing the given number of copies
/// of each of the five books, given as counts sorted in descending order.
///
/// Because the counts are sorted, any optimal grouping can be built one group
/// at a time by always taking one copy from the `k` most plentiful remaining
/// books, for some `k` in 1..=5. Trying every `k` and memoizing the sorted
/// count state yields the optimal total.
fn min_price(counts: &[u32; 5], memo: &mut HashMap<[u32; 5], u32>) -> u32 {
    if counts.iter().all(|&c| c == 0) {
        return 0;
    }
    if let Some(&price) = memo.get(counts) {
        return price;
    }
    let mut best = u32::MAX;
    for k in 1..=5 {
        if counts[k - 1] == 0 {
            break;
        }
        let mut next = *counts;
        for c in next.iter_mut().take(k) {
            *c -= 1;
        }
        next.sort_unstable_by(|a, b| b.cmp(a));
        best = best.min(group_cost(k) + min_price(&next, memo));
    }
    memo.insert(*counts, best);
    best
}

pub fn lowest_price(books: &[u32]) -> u32 {
    let mut counts = [0u32; 5];
    for &book in books {
        counts[(book - 1) as usize] += 1;
    }
    counts.sort_unstable_by(|a, b| b.cmp(a));
    let mut memo = HashMap::new();
    min_price(&counts, &mut memo)
}
