#include "phone_number.h"

#include <cctype>

namespace phone_number {

phone_number::phone_number(const std::string& raw_number) {
    for (char c : raw_number) {
        if (std::isdigit(static_cast<unsigned char>(c))) {
            digits_.push_back(c);
        } else if (c == '+') {
            // A '+' is only valid as a leading country-code marker.
            if (!digits_.empty()) {
                throw std::domain_error("invalid phone number");
            }
        } else if (c == '-' || c == '.' || c == ' ' || c == '(' || c == ')') {
            // Allowed punctuation; ignore it.
        } else {
            throw std::domain_error("invalid phone number");
        }
    }

    if (digits_.size() == 11) {
        if (digits_.front() != '1') {
            throw std::domain_error("invalid phone number");
        }
        digits_ = digits_.substr(1);
    } else if (digits_.size() != 10) {
        throw std::domain_error("invalid phone number");
    }

    // Area code and exchange code must start with a digit 2-9.
    if (digits_[0] < '2' || digits_[3] < '2') {
        throw std::domain_error("invalid phone number");
    }
}

std::string phone_number::number() const {
    return digits_;
}

}  // namespace phone_number
