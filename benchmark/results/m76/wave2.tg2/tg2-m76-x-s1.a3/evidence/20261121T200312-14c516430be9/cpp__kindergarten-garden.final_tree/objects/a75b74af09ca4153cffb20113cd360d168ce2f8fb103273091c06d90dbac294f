#include "kindergarten_garden.h"

#include <algorithm>

namespace kindergarten_garden {

namespace {

const std::array<std::string, 12> kStudents = {
    "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
    "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"};

Plants plant_from_char(char c) {
  switch (c) {
    case 'G': return Plants::grass;
    case 'C': return Plants::clover;
    case 'R': return Plants::radishes;
    case 'V': return Plants::violets;
    default: return Plants::grass;
  }
}

}  // namespace

std::array<Plants, 4> plants(const std::string& diagram, const std::string& student) {
  const auto newline = diagram.find('\n');
  const std::string first_row = diagram.substr(0, newline);
  const std::string second_row = diagram.substr(newline + 1);

  const auto it = std::find(kStudents.begin(), kStudents.end(), student);
  const size_t column = static_cast<size_t>(it - kStudents.begin()) * 2;

  return {
      plant_from_char(first_row[column]),
      plant_from_char(first_row[column + 1]),
      plant_from_char(second_row[column]),
      plant_from_char(second_row[column + 1])
  };
}

}  // namespace kindergarten_garden
