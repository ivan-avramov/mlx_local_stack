#if !defined(ALL_YOUR_BASE_H)
#define ALL_YOUR_BASE_H

#include <vector>

namespace all_your_base {

// Convert a number written as `in_digits` in base `in_base` into a
// sequence of digits in base `out_base`.
//
// Digits are ordered most-significant first. Zero is represented by an
// empty sequence. Throws std::invalid_argument if either base is less
// than 2, or if any digit is not a valid digit of `in_base`.
std::vector<unsigned int> convert(unsigned int in_base,
                                  const std::vector<unsigned int>& in_digits,
                                  unsigned int out_base);

}  // namespace all_your_base

#endif // ALL_YOUR_BASE_H
