#include "diamond.h"

namespace diamond {

std::vector<std::string> rows(char letter) {
	const int n = letter - 'A';  // index of the widest letter
	const int size = 2 * n + 1;  // width and height of the diamond

	std::vector<std::string> result;
	result.reserve(size);

	for (int row = 0; row < size; ++row) {
		// Top half ascends, bottom half descends.
		const int k = row <= n ? row : size - 1 - row;

		std::string line(size, ' ');
		if (k == 0) {
			line[n] = 'A';
		} else {
			line[n - k] = 'A' + k;
			line[n + k] = 'A' + k;
		}
		result.push_back(line);
	}

	return result;
}

}  // namespace diamond
