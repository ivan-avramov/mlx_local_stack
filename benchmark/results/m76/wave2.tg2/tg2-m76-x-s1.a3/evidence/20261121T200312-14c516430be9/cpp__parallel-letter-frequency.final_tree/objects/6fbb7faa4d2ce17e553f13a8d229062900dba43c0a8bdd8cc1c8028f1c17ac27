#if !defined(PARALLEL_LETTER_FREQUENCY_H)
#define PARALLEL_LETTER_FREQUENCY_H

#include <map>
#include <string_view>
#include <vector>

namespace parallel_letter_frequency {

// Counts the total frequency of each letter across the given texts.
//
// Only alphabetic characters are counted; whitespace, punctuation and
// digits are ignored. Letter casing is ignored, so 'A' and 'a' both
// contribute to the count for 'a'.
//
// The texts are processed in parallel, one chunk per worker thread.
std::map<char, int> frequency(const std::vector<std::string_view>& texts);

}  // namespace parallel_letter_frequency

#endif  // PARALLEL_LETTER_FREQUENCY_H
