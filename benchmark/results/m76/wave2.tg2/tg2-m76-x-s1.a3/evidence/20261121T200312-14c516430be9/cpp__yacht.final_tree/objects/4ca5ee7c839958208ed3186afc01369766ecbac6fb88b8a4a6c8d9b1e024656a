#include "yacht.h"

namespace yacht {

int score(const std::vector<int>& dice, const std::string& category) {
    int counts[7] = {0};
    int total = 0;
    for (int die : dice) {
        ++counts[die];
        total += die;
    }

    if (category == "ones") {
        return counts[1];
    }
    if (category == "twos") {
        return 2 * counts[2];
    }
    if (category == "threes") {
        return 3 * counts[3];
    }
    if (category == "fours") {
        return 4 * counts[4];
    }
    if (category == "fives") {
        return 5 * counts[5];
    }
    if (category == "sixes") {
        return 6 * counts[6];
    }
    if (category == "full house") {
        bool has_three = false;
        bool has_two = false;
        for (int face = 1; face <= 6; ++face) {
            if (counts[face] == 3) {
                has_three = true;
            }
            if (counts[face] == 2) {
                has_two = true;
            }
        }
        return (has_three && has_two) ? total : 0;
    }
    if (category == "four of a kind") {
        for (int face = 1; face <= 6; ++face) {
            if (counts[face] >= 4) {
                return 4 * face;
            }
        }
        return 0;
    }
    if (category == "little straight") {
        return (counts[1] && counts[2] && counts[3] && counts[4] && counts[5]) ? 30 : 0;
    }
    if (category == "big straight") {
        return (counts[2] && counts[3] && counts[4] && counts[5] && counts[6]) ? 30 : 0;
    }
    if (category == "choice") {
        return total;
    }
    if (category == "yacht") {
        return total == 5 * dice[0] ? 50 : 0;
    }
    return 0;
}

}  // namespace yacht
