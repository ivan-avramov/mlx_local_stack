#include "allergies.h"

#include <array>
#include <utility>

namespace allergies {

namespace {

const std::array<std::pair<unsigned, const char*>, 8> k_allergens = {{
    {1, "eggs"},
    {2, "peanuts"},
    {4, "shellfish"},
    {8, "strawberries"},
    {16, "tomatoes"},
    {32, "chocolate"},
    {64, "pollen"},
    {128, "cats"},
}};

}  // namespace

allergy_test::allergy_test(unsigned score) : score_(score) {}

bool allergy_test::is_allergic_to(const std::string& allergen) const {
    return get_allergies().count(allergen) > 0;
}

std::unordered_set<std::string> allergy_test::get_allergies() const {
    std::unordered_set<std::string> result;
    for (const auto& [bit, name] : k_allergens) {
        if (score_ & bit) {
            result.emplace(name);
        }
    }
    return result;
}

}  // namespace allergies
