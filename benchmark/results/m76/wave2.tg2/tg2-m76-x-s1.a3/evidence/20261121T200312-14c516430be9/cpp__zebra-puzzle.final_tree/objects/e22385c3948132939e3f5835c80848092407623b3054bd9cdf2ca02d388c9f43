#include "zebra_puzzle.cpp"
#include <cstdio>

using namespace zebra_puzzle;

int main() {
    std::array<House, 5> houses{};
    houses[2].drink = 2;
    houses[0].nationality = 3;
    (void)solveRecursively(houses, 0, 0);
    for (int i = 0; i < 5; ++i) {
        printf("House %d: %s / %s / %s / %s / %s\n", i + 1,
               colors[houses[i].color], nationalities[houses[i].nationality],
               drinks[houses[i].drink], pets[houses[i].pet],
               hobbies[houses[i].hobby]);
    }
    return 0;
}
