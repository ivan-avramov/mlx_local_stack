import java.util.ArrayList;
import java.util.List;

class BowlingGame {

    private static final int PINS = 10;
    private static final int FRAMES = 10;

    private final List<Integer> rolls = new ArrayList<>();
    private int frame = 0;
    private int rollInFrame = 0;
    private int pinsStanding = PINS;

    void roll(int pins) {
        if (frame == FRAMES) {
            throw new IllegalStateException("Cannot roll after game is over");
        }
        if (pins < 0) {
            throw new IllegalStateException("Negative roll is invalid");
        }
        if (pins > pinsStanding) {
            throw new IllegalStateException("Pin count exceeds pins on the lane");
        }
        rolls.add(pins);
        pinsStanding -= pins;
        rollInFrame++;
        boolean cleared = pinsStanding == 0;
        if (frameComplete(cleared)) {
            frame++;
            rollInFrame = 0;
            pinsStanding = PINS;
        } else if (cleared) {
            // Tenth frame: a strike or spare earns a bonus roll on a fresh rack.
            pinsStanding = PINS;
        }
    }

    int score() {
        if (frame != FRAMES) {
            throw new IllegalStateException("Score cannot be taken until the end of the game");
        }
        int total = 0;
        int i = 0;
        for (int f = 0; f < FRAMES; f++) {
            if (f < FRAMES - 1) {
                if (rolls.get(i) == PINS) {
                    total += PINS + rolls.get(i + 1) + rolls.get(i + 2);
                    i += 1;
                } else if (rolls.get(i) + rolls.get(i + 1) == PINS) {
                    total += PINS + rolls.get(i + 2);
                    i += 2;
                } else {
                    total += rolls.get(i) + rolls.get(i + 1);
                    i += 2;
                }
            } else {
                // Tenth frame: total value is simply all pins knocked down.
                while (i < rolls.size()) {
                    total += rolls.get(i);
                    i++;
                }
            }
        }
        return total;
    }

    private boolean frameComplete(boolean cleared) {
        if (frame < FRAMES - 1) {
            // Frames 1-9 end after a strike/spare or after two rolls.
            return cleared || rollInFrame == 2;
        }
        // Tenth frame: always two rolls, plus a bonus roll after a strike or spare.
        if (rollInFrame < 2) {
            return false;
        }
        if (rollInFrame >= 3) {
            return true;
        }
        int first = rolls.get(rolls.size() - 2);
        int second = rolls.get(rolls.size() - 1);
        return first + second < PINS;
    }

}
