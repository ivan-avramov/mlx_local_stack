import java.util.ArrayList;
import java.util.List;

class PythagoreanTriplet {

    private final int a;
    private final int b;
    private final int c;

    PythagoreanTriplet(int a, int b, int c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    static TripletListBuilder makeTripletsList() {
        return new TripletListBuilder();
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) {
            return true;
        }
        if (!(o instanceof PythagoreanTriplet)) {
            return false;
        }
        PythagoreanTriplet other = (PythagoreanTriplet) o;
        return a == other.a && b == other.b && c == other.c;
    }

    @Override
    public int hashCode() {
        return 31 * (31 * a + b) + c;
    }

    @Override
    public String toString() {
        return "{" + a + ", " + b + ", " + c + "}";
    }

    static class TripletListBuilder {

        private int sum;
        private int maxFactor = Integer.MAX_VALUE;

        TripletListBuilder thatSumTo(int sum) {
            this.sum = sum;
            return this;
        }

        TripletListBuilder withFactorsLessThanOrEqualTo(int maxFactor) {
            this.maxFactor = maxFactor;
            return this;
        }

        List<PythagoreanTriplet> build() {
            List<PythagoreanTriplet> triplets = new ArrayList<>();
            // Euclid's formula: a = k(m^2 - n^2), b = k(2mn), c = k(m^2 + n^2)
            // with m > n > 0, gcd(m, n) = 1 and m, n of opposite parity.
            for (int m = 2; 2 * m * (m + 1) <= sum; m++) {
                for (int n = 1; n < m; n++) {
                    if ((m - n) % 2 == 0 || gcd(m, n) != 1) {
                        continue;
                    }
                    int primitiveSum = 2 * m * (m + n);
                    if (primitiveSum > sum) {
                        break;
                    }
                    if (sum % primitiveSum != 0) {
                        continue;
                    }
                    int k = sum / primitiveSum;
                    int a = k * (m * m - n * n);
                    int b = k * 2 * m * n;
                    int c = k * (m * m + n * n);
                    if (a > b) {
                        int t = a;
                        a = b;
                        b = t;
                    }
                    if (c <= maxFactor) {
                        triplets.add(new PythagoreanTriplet(a, b, c));
                    }
                }
            }
            triplets.sort((x, y) -> x.a != y.a ? x.a - y.a : x.b - y.b);
            return triplets;
        }

        private static int gcd(int x, int y) {
            while (y != 0) {
                int t = x % y;
                x = y;
                y = t;
            }
            return x;
        }

    }

}
