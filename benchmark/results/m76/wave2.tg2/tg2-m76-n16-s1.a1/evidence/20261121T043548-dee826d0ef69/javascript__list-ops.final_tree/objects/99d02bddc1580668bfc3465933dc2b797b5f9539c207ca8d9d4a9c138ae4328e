export class List {
  constructor(values = []) {
    this.values = values;
  }

  append(other) {
    const result = [];
    let i = 0;
    for (const item of this.values) {
      result[i++] = item;
    }
    for (const item of other.values) {
      result[i++] = item;
    }
    return new List(result);
  }

  concat(other) {
    const result = [];
    let i = 0;
    for (const item of this.values) {
      result[i++] = item;
    }
    for (const item of other.values) {
      if (item instanceof List) {
        for (const nested of item.values) {
          result[i++] = nested;
        }
      } else {
        result[i++] = item;
      }
    }
    return new List(result);
  }

  filter(predicate) {
    const result = [];
    let i = 0;
    for (const item of this.values) {
      if (predicate(item)) {
        result[i++] = item;
      }
    }
    return new List(result);
  }

  map(fn) {
    const result = [];
    let i = 0;
    for (const item of this.values) {
      result[i++] = fn(item);
    }
    return new List(result);
  }

  length() {
    return this.values.length;
  }

  foldl(fn, acc) {
    for (const item of this.values) {
      acc = fn(acc, item);
    }
    return acc;
  }

  foldr(fn, acc) {
    for (let i = this.values.length - 1; i >= 0; i -= 1) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  reverse() {
    const result = [];
    for (let i = this.values.length - 1; i >= 0; i -= 1) {
      result[this.values.length - 1 - i] = this.values[i];
    }
    return new List(result);
  }
}
