export class Binary {
  constructor(binary) {
    this.binary = binary;
  }

  toDecimal() {
    if (!/^[01]+$/.test(this.binary)) {
      return null;
    }

    return this.binary.split('').reduce((sum, digit) => {
      return sum * 2 + Number(digit);
    }, 0);
  }
}
