const weekdayIndex = {
  Sunday: 0,
  Monday: 1,
  Tuesday: 2,
  Wednesday: 3,
  Thursday: 4,
  Friday: 5,
  Saturday: 6,
};

const ordinal = { first: 1, second: 2, third: 3, fourth: 4 };

export const meetup = (year, month, week, weekday) => {
  const target = weekdayIndex[weekday];

  if (week === 'teenth') {
    for (let day = 13; day <= 19; day += 1) {
      const date = new Date(year, month - 1, day);
      if (date.getDay() === target) {
        return date;
      }
    }
    return null;
  }

  if (week === 'last') {
    const lastDay = new Date(year, month, 0).getDate();
    for (let day = lastDay; day >= lastDay - 6; day -= 1) {
      const date = new Date(year, month - 1, day);
      if (date.getDay() === target) {
        return date;
      }
    }
    return null;
  }

  const occurrence = ordinal[week];
  const firstOfMonth = new Date(year, month - 1, 1);
  const offset = (target - firstOfMonth.getDay() + 7) % 7;
  return new Date(year, month - 1, 1 + offset + 7 * (occurrence - 1));
};
