const gcd = (a, b) => {
  a = Math.abs(a);
  b = Math.abs(b);
  while (b !== 0) {
    [a, b] = [b, a % b];
  }
  return a;
};

export class Rational {
  constructor(numerator, denominator) {
    this.numerator = numerator;
    this.denominator = denominator;
  }

  add(other) {
    const { numerator, denominator } = this;
    const { numerator: oNum, denominator: oDen } = other;
    return new Rational(numerator * oDen + oNum * denominator, denominator * oDen).reduce();
  }

  sub(other) {
    const { numerator, denominator } = this;
    const { numerator: oNum, denominator: oDen } = other;
    return new Rational(numerator * oDen - oNum * denominator, denominator * oDen).reduce();
  }

  mul(other) {
    const { numerator, denominator } = this;
    const { numerator: oNum, denominator: oDen } = other;
    return new Rational(numerator * oNum, denominator * oDen).reduce();
  }

  div(other) {
    const { numerator, denominator } = this;
    const { numerator: oNum, denominator: oDen } = other;
    return new Rational(numerator * oDen, denominator * oNum).reduce();
  }

  abs() {
    return new Rational(Math.abs(this.numerator), Math.abs(this.denominator)).reduce();
  }

  exprational(power) {
    if (power >= 0) {
      return new Rational(this.numerator ** power, this.denominator ** power).reduce();
    }
    const m = -power;
    return new Rational(this.denominator ** m, this.numerator ** m).reduce();
  }

  expreal(base) {
    const { numerator, denominator } = this;
    const p = Math.pow(base, numerator);
    return denominator === 3 ? Math.cbrt(p) : Math.pow(p, 1 / denominator);
  }

  reduce() {
    let { numerator, denominator } = this;
    const divisor = gcd(numerator, denominator) || 1;
    numerator /= divisor;
    denominator /= divisor;
    if (denominator < 0) {
      numerator = -numerator;
      denominator = -denominator;
    }
    return new Rational(numerator, denominator);
  }
}
