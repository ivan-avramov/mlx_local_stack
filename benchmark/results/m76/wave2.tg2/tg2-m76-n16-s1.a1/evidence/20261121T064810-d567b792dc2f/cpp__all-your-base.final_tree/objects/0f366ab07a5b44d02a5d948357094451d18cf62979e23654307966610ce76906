#include "all_your_base.h"

#include <stdexcept>
#include <algorithm>

namespace all_your_base {

std::vector<unsigned int> convert(unsigned int in_base,
                                  const std::vector<unsigned int>& in_digits,
                                  unsigned int out_base) {
    if (in_base < 2 || out_base < 2) {
        throw std::invalid_argument("base must be at least 2");
    }

    unsigned long long value = 0;
    for (unsigned int digit : in_digits) {
        if (digit >= in_base) {
            throw std::invalid_argument("digit out of range for input base");
        }
        value = value * in_base + digit;
    }

    if (value == 0) {
        return {};
    }

    std::vector<unsigned int> out_digits;
    while (value > 0) {
        out_digits.push_back(static_cast<unsigned int>(value % out_base));
        value /= out_base;
    }
    std::reverse(out_digits.begin(), out_digits.end());
    return out_digits;
}

}  // namespace all_your_base
