#include "diamond.h"

namespace diamond {

namespace {

std::string row(char letter, int n) {
    const int i = letter - 'A';
    const int leading = n - i;

    std::string result(leading, ' ');
    result.push_back(letter);
    if (i > 0) {
        result.append(2 * i - 1, ' ');
        result.push_back(letter);
    }
    result.append(leading, ' ');
    return result;
}

}  // namespace

std::vector<std::string> rows(char ch) {
    const int n = ch - 'A';

    std::vector<std::string> result;
    result.reserve(2 * n + 1);

    for (int i = 0; i <= n; ++i) {
        result.push_back(row('A' + i, n));
    }
    for (int i = n - 1; i >= 0; --i) {
        result.push_back(row('A' + i, n));
    }

    return result;
}

}  // namespace diamond
