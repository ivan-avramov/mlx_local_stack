#include "allergies.h"

namespace allergies {

namespace {

const std::pair<const std::string, unsigned> kAllergens[] = {
    {"eggs", 1},
    {"peanuts", 2},
    {"shellfish", 4},
    {"strawberries", 8},
    {"tomatoes", 16},
    {"chocolate", 32},
    {"pollen", 64},
    {"cats", 128},
};

unsigned value_of(const std::string& allergen) {
    for (const auto& entry : kAllergens) {
        if (entry.first == allergen) {
            return entry.second;
        }
    }
    return 0;
}

}  // namespace

allergy_test::allergy_test(unsigned score) : score_(score) {}

bool allergy_test::is_allergic_to(const std::string& allergen) const {
    const unsigned value = value_of(allergen);
    return value != 0 && (score_ & value) == value;
}

std::unordered_set<std::string> allergy_test::get_allergies() const {
    std::unordered_set<std::string> result;
    for (const auto& entry : kAllergens) {
        if ((score_ & entry.second) == entry.second) {
            result.emplace(entry.first);
        }
    }
    return result;
}

}  // namespace allergies
