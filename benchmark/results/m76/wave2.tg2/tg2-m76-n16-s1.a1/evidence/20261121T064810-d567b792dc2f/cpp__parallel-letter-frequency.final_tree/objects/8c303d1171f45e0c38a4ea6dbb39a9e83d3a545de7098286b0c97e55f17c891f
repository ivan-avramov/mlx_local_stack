#if !defined(PARALLEL_LETTER_FREQUENCY_H)
#define PARALLEL_LETTER_FREQUENCY_H

#include <map>
#include <string_view>
#include <vector>

namespace parallel_letter_frequency {

// Returns the total frequency of each (lowercase) letter across all texts.
// Letter casing is ignored; letters that never occur are omitted, so the
// result is empty when no text contains any letter.
std::map<char, int> frequency(const std::vector<std::string_view>& texts);

}

#endif
