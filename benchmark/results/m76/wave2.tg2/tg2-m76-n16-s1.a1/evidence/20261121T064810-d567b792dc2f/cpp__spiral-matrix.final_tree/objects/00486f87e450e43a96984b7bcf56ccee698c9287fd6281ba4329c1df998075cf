#include "spiral_matrix.h"

namespace spiral_matrix {

std::vector<std::vector<uint32_t>> spiral_matrix(uint32_t size) {
    std::vector<std::vector<uint32_t>> matrix(size, std::vector<uint32_t>(size, 0));

    int row = 0;
    int col = 0;
    int dir = 0;  // 0 = right, 1 = down, 2 = left, 3 = up
    for (uint32_t value = 1; value <= size * size; ++value) {
        matrix[row][col] = value;
        int next_row = row + (dir == 1 ? 1 : dir == 3 ? -1 : 0);
        int next_col = col + (dir == 0 ? 1 : dir == 2 ? -1 : 0);
        if (next_row < 0 || next_row >= static_cast<int>(size) ||
            next_col < 0 || next_col >= static_cast<int>(size) ||
            matrix[next_row][next_col] != 0) {
            dir = (dir + 1) % 4;
            next_row = row + (dir == 1 ? 1 : dir == 3 ? -1 : 0);
            next_col = col + (dir == 0 ? 1 : dir == 2 ? -1 : 0);
        }
        row = next_row;
        col = next_col;
    }

    return matrix;
}

}  // namespace spiral_matrix
