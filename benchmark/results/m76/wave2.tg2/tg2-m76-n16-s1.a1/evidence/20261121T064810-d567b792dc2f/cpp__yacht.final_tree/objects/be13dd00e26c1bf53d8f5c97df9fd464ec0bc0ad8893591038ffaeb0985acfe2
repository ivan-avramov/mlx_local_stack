#include "yacht.h"

namespace yacht {

namespace {

int total(const std::initializer_list<int>& dice) {
	int sum = 0;
	for (int face : dice) {
		sum += face;
	}
	return sum;
}

}  // namespace

int score(std::initializer_list<int> dice, std::string category) {
	int counts[7] = {};
	for (int face : dice) {
		++counts[face];
	}

	if (category == "ones" || category == "twos" || category == "threes" ||
	    category == "fours" || category == "fives" || category == "sixes") {
		int face = 0;
		if (category == "ones") {
			face = 1;
		} else if (category == "twos") {
			face = 2;
		} else if (category == "threes") {
			face = 3;
		} else if (category == "fours") {
			face = 4;
		} else if (category == "fives") {
			face = 5;
		} else {
			face = 6;
		}
		return face * counts[face];
	}

	if (category == "full house") {
		int twos = 0;
		int threes = 0;
		for (int face = 1; face <= 6; ++face) {
			if (counts[face] == 2) {
				++twos;
			} else if (counts[face] == 3) {
				++threes;
			}
		}
		return (twos == 1 && threes == 1) ? total(dice) : 0;
	}

	if (category == "four of a kind") {
		for (int face = 1; face <= 6; ++face) {
			if (counts[face] >= 4) {
				return 4 * face;
			}
		}
		return 0;
	}

	if (category == "little straight" || category == "big straight") {
		int start = (category == "little straight") ? 1 : 2;
		for (int face = start; face < start + 5; ++face) {
			if (counts[face] != 1) {
				return 0;
			}
		}
		return 30;
	}

	if (category == "choice") {
		return total(dice);
	}

	if (category == "yacht") {
		for (int face = 1; face <= 6; ++face) {
			if (counts[face] == 5) {
				return 50;
			}
		}
		return 0;
	}

	return 0;
}

}  // namespace yacht
