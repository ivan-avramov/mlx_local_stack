#include "kindergarten_garden.h"

namespace kindergarten_garden {

namespace {

Plants plant_for(char c) {
    switch (c) {
        case 'G': return Plants::grass;
        case 'C': return Plants::clover;
        case 'R': return Plants::radishes;
        case 'V': return Plants::violets;
        default: return Plants::grass;
    }
}

}  // namespace

std::array<Plants, 4> plants(const std::string& diagram, const std::string& student) {
    // Students are assigned alphabetically: Alice, Bob, Charlie, David, Eve,
    // Fred, Ginny, Harriet, Ileana, Joseph, Kincaid, Larry. Since each name
    // starts with a different letter, the student's position is given by the
    // first letter of the name.
    const std::size_t index = static_cast<std::size_t>(student.front() - 'A');
    const std::size_t column = 2 * index;

    const std::size_t newline = diagram.find('\n');
    const std::string first_row = diagram.substr(0, newline);
    const std::string second_row = diagram.substr(newline + 1);

    return {
        plant_for(first_row[column]),
        plant_for(first_row[column + 1]),
        plant_for(second_row[column]),
        plant_for(second_row[column + 1]),
    };
}

}  // namespace kindergarten_garden
