#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    /// Every roll recorded so far, in order.
    rolls: Vec<u16>,
    /// The frame currently being played (0-indexed, 0..=9).
    /// Once the game is over this is 10.
    frame: usize,
    /// Number of rolls taken in the current frame.
    rolls_in_frame: usize,
    /// Pins still standing in the current pin set.
    pins_remaining: u16,
}

impl BowlingGame {
    pub fn new() -> Self {
        Self {
            rolls: Vec::new(),
            frame: 0,
            rolls_in_frame: 0,
            pins_remaining: 10,
        }
    }

    fn is_complete(&self) -> bool {
        self.frame >= 10
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.is_complete() {
            return Err(Error::GameComplete);
        }

        if pins > self.pins_remaining {
            return Err(Error::NotEnoughPinsLeft);
        }

        self.rolls.push(pins);
        self.pins_remaining -= pins;
        self.rolls_in_frame += 1;

        let frame_done = if self.frame == 9 {
            // The tenth frame allows up to three rolls. It is finished after
            // three rolls, or after two rolls if the frame is open (fewer
            // than 10 pins knocked down in those two rolls).
            if self.rolls_in_frame >= 3 {
                true
            } else if self.rolls_in_frame == 2 {
                let last_two = self.rolls[self.rolls.len() - 2] + self.rolls[self.rolls.len() - 1];
                last_two < 10
            } else {
                false
            }
        } else {
            // Frames 1-9 end on a strike (all pins down) or after two rolls.
            self.pins_remaining == 0 || self.rolls_in_frame == 2
        };

        if frame_done {
            self.frame += 1;
            self.rolls_in_frame = 0;
            self.pins_remaining = 10;
        } else if self.pins_remaining == 0 {
            // A strike or spare in the tenth frame that still needs a
            // bonus roll starts a fresh set of ten pins.
            self.pins_remaining = 10;
        }

        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        if !self.is_complete() {
            return None;
        }

        let rolls = &self.rolls;
        let mut total = 0u16;
        let mut i = 0usize;

        for frame in 0..10 {
            if frame < 9 {
                if rolls[i] == 10 {
                    // Strike: 10 plus the next two rolls.
                    total += 10 + rolls[i + 1] + rolls[i + 2];
                    i += 1;
                } else if rolls[i] + rolls[i + 1] == 10 {
                    // Spare: 10 plus the next roll.
                    total += 10 + rolls[i + 2];
                    i += 2;
                } else {
                    // Open frame.
                    total += rolls[i] + rolls[i + 1];
                    i += 2;
                }
            } else {
                // Tenth frame: every remaining roll counts once.
                total += rolls[i..].iter().sum::<u16>();
            }
        }

        Some(total)
    }
}
