#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    /// Every roll recorded so far, in order.
    rolls: Vec<u16>,
    /// Current frame index, 0..=10. A value of 10 means the game is over.
    frame: usize,
    /// Pins still standing in the current frame.
    pins_left: u16,
    /// Number of rolls taken in the current frame.
    rolls_in_frame: usize,
    /// Index in `rolls` of the first roll of the tenth frame.
    tenth_frame_start: usize,
}

impl BowlingGame {
    pub fn new() -> Self {
        Self {
            rolls: Vec::new(),
            frame: 0,
            pins_left: 10,
            rolls_in_frame: 0,
            tenth_frame_start: 0,
        }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        if self.frame >= 10 {
            return Err(Error::GameComplete);
        }
        if pins > 10 || pins > self.pins_left {
            return Err(Error::NotEnoughPinsLeft);
        }

        self.rolls.push(pins);
        self.pins_left -= pins;
        self.rolls_in_frame += 1;

        if self.frame < 9 {
            // Frames 1-9 end when all ten pins are down (strike or spare)
            // or once two rolls have been taken (open frame).
            if self.pins_left == 0 || self.rolls_in_frame == 2 {
                self.advance_frame();
            }
        } else {
            // The tenth frame allows up to three rolls: a strike or a spare
            // earns one or two fill balls, which are scored but do not
            // themselves earn further fill balls.
            let first_roll = self.rolls[self.tenth_frame_start];
            let complete = match self.rolls_in_frame {
                3 => true,
                2 => self.pins_left > 0 && first_roll != 10,
                _ => false,
            };
            if complete {
                self.frame = 10;
            } else if self.pins_left == 0 {
                // A strike or spare in the tenth frame resets the pins for
                // the next fill ball.
                self.pins_left = 10;
            }
        }
        Ok(())
    }

    fn advance_frame(&mut self) {
        self.frame += 1;
        self.pins_left = 10;
        self.rolls_in_frame = 0;
        if self.frame == 9 {
            self.tenth_frame_start = self.rolls.len();
        }
    }

    pub fn score(&self) -> Option<u16> {
        if self.frame < 10 {
            return None;
        }

        let mut score: u16 = 0;
        let mut i = 0;
        for frame in 0..10 {
            if frame < 9 {
                if self.rolls[i] == 10 {
                    // Strike: 10 plus the next two rolls.
                    score += 10 + self.rolls[i + 1] + self.rolls[i + 2];
                    i += 1;
                } else if self.rolls[i] + self.rolls[i + 1] == 10 {
                    // Spare: 10 plus the next roll.
                    score += 10 + self.rolls[i + 2];
                    i += 2;
                } else {
                    // Open frame: just the pins knocked down.
                    score += self.rolls[i] + self.rolls[i + 1];
                    i += 2;
                }
            } else {
                // Tenth frame: every pin knocked down counts.
                score += self.rolls[i..].iter().sum::<u16>();
            }
        }
        Some(score)
    }
}
