/// Given a list of poker hands, return a list of those hands which win.
///
/// Note the type signature: this function should return _the same_ reference to
/// the winning hand(s) as were passed in, not reconstructed strings which happen to be equal.
pub fn winning_hands<'a>(hands: &[&'a str]) -> Vec<&'a str> {
    let scores: Vec<_> = hands.iter().map(|hand| score(hand)).collect();
    let best = scores.iter().max().unwrap();
    hands
        .iter()
        .zip(scores.iter())
        .filter(|(_, s)| *s == best)
        .map(|(hand, _)| *hand)
        .collect()
}

/// Parse a rank token ("2".."10", "J", "Q", "K", "A") into 2..=14.
fn rank_of(token: &str) -> u32 {
    match token {
        "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9" => token.parse().unwrap(),
        "10" => 10,
        "J" => 11,
        "Q" => 12,
        "K" => 13,
        "A" => 14,
        _ => panic!("invalid rank: {token}"),
    }
}

/// Hand categories, higher is better.
const HIGH_CARD: u32 = 0;
const ONE_PAIR: u32 = 1;
const TWO_PAIR: u32 = 2;
const THREE_OF_A_KIND: u32 = 3;
const STRAIGHT: u32 = 4;
const FLUSH: u32 = 5;
const FULL_HOUSE: u32 = 6;
const FOUR_OF_A_KIND: u32 = 7;
const STRAIGHT_FLUSH: u32 = 8;

/// Score a hand as (category, tiebreakers in descending significance).
fn score(hand: &str) -> (u32, Vec<u32>) {
    let mut ranks: Vec<u32> = hand
        .split_whitespace()
        .map(|card| rank_of(&card[..card.len() - 1]))
        .collect();
    let mut sorted = ranks.clone();
    sorted.sort_unstable_by(|a, b| b.cmp(a));

    let counts: std::collections::HashMap<u32, u32> =
        ranks.iter().fold(std::collections::HashMap::new(), |mut m, &r| {
            *m.entry(r).or_insert(0) += 1;
            m
        });
    // Rank groups ordered by multiplicity (desc), then rank (desc).
    let mut groups: Vec<(u32, u32)> = counts.into_iter().collect();
    groups.sort_unstable_by(|a, b| b.1.cmp(&a.1).then(b.0.cmp(&a.0)));

    let flush = hand
        .split_whitespace()
        .map(|card| card.as_bytes()[card.len() - 1])
        .collect::<std::collections::HashSet<_>>()
        .len()
        == 1;

    // Straight detection: five distinct ranks, consecutive, with ace-low wheel.
    let distinct = sorted.windows(2).all(|w| w[0] != w[1]);
    let straight_high = if distinct && sorted[0] - sorted[4] == 4 {
        Some(sorted[0])
    } else if sorted == vec![14, 5, 4, 3, 2] {
        Some(5)
    } else {
        None
    };

    let multiplicity: Vec<u32> = groups.iter().map(|(_, c)| *c).collect();

    let category = if straight_high.is_some() && flush {
        STRAIGHT_FLUSH
    } else if multiplicity == vec![4, 1] {
        FOUR_OF_A_KIND
    } else if multiplicity == vec![3, 2] {
        FULL_HOUSE
    } else if flush {
        FLUSH
    } else if straight_high.is_some() {
        STRAIGHT
    } else if multiplicity == vec![3, 1, 1] {
        THREE_OF_A_KIND
    } else if multiplicity == vec![2, 2, 1] {
        TWO_PAIR
    } else if multiplicity == vec![2, 1, 1, 1] {
        ONE_PAIR
    } else {
        HIGH_CARD
    };

    let tiebreak = match category {
        STRAIGHT_FLUSH | STRAIGHT => vec![straight_high.unwrap()],
        _ => groups.iter().map(|(r, _)| *r).collect(),
    };

    (category, tiebreak)
}
