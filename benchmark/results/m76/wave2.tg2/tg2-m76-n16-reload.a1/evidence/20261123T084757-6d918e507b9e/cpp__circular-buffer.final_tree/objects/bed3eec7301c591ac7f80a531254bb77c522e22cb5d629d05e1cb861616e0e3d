#if !defined(CIRCULAR_BUFFER_H)
#define CIRCULAR_BUFFER_H

#include <cstddef>
#include <stdexcept>
#include <vector>

namespace circular_buffer {

template <typename T>
class circular_buffer {
public:
    explicit circular_buffer(const std::size_t capacity)
        : buffer_(capacity), read_index_(0), write_index_(0), size_(0) {}

    void write(const T& item) {
        if (size_ == buffer_.size()) {
            throw std::domain_error("Buffer is full");
        }
        buffer_[write_index_] = item;
        write_index_ = (write_index_ + 1) % buffer_.size();
        ++size_;
    }

    void overwrite(const T& item) {
        if (size_ == buffer_.size()) {
            // The oldest item sits at the write position; drop it.
            read_index_ = write_index_;
        } else {
            ++size_;
        }
        buffer_[write_index_] = item;
        write_index_ = (write_index_ + 1) % buffer_.size();
    }

    T read() {
        if (size_ == 0) {
            throw std::domain_error("Buffer is empty");
        }
        T item = buffer_[read_index_];
        read_index_ = (read_index_ + 1) % buffer_.size();
        --size_;
        return item;
    }

    void clear() {
        size_ = 0;
        read_index_ = 0;
        write_index_ = 0;
    }

private:
    std::vector<T> buffer_;
    std::size_t read_index_;
    std::size_t write_index_;
    std::size_t size_;
};

}  // namespace circular_buffer

#endif // CIRCULAR_BUFFER_H
