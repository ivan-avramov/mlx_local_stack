const DIRECTIONS = [
  [1, 0], // right
  [-1, 0], // left
  [0, 1], // down
  [0, -1], // up
  [1, 1], // down-right
  [-1, -1], // up-left
  [1, -1], // up-right
  [-1, 1], // down-left
];

class WordSearch {
  constructor(grid) {
    this.grid = grid;
    this.rows = grid.length;
    this.cols = grid.length > 0 ? grid[0].length : 0;
  }

  find(words) {
    const results = {};
    for (const word of words) {
      results[word] = this.findWord(word);
    }
    return results;
  }

  findWord(word) {
    for (let row = 0; row < this.rows; row++) {
      for (let col = 0; col < this.cols; col++) {
        for (const [dx, dy] of DIRECTIONS) {
          const match = this.tryMatch(word, row, col, dx, dy);
          if (match) {
            return {
              start: [row + 1, col + 1],
              end: [row + 1 + dy * (word.length - 1), col + 1 + dx * (word.length - 1)],
            };
          }
        }
      }
    }
    return undefined;
  }

  tryMatch(word, row, col, dx, dy) {
    for (let i = 0; i < word.length; i++) {
      const r = row + dy * i;
      const c = col + dx * i;
      if (r < 0 || r >= this.rows || c < 0 || c >= this.cols) {
        return false;
      }
      if (this.grid[r][c] !== word[i]) {
        return false;
      }
    }
    return true;
  }
}

export default WordSearch;
