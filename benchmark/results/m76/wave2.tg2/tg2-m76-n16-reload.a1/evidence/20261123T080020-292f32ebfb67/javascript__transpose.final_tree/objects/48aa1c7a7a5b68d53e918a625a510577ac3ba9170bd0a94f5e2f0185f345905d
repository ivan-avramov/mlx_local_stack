export const transpose = (rows) => {
  if (rows.length === 0) return [];

  const maxLength = Math.max(...rows.map((row) => row.length));
  const result = [];

  for (let col = 0; col < maxLength; col++) {
    // The output row extends only to the last input row that has a
    // character in this column; don't pad to the right.
    let lastRow = -1;
    for (let i = 0; i < rows.length; i++) {
      if (rows[i].length > col) lastRow = i;
    }

    let output = '';
    for (let i = 0; i <= lastRow; i++) {
      output += col < rows[i].length ? rows[i][col] : ' ';
    }
    result.push(output);
  }

  return result;
};
