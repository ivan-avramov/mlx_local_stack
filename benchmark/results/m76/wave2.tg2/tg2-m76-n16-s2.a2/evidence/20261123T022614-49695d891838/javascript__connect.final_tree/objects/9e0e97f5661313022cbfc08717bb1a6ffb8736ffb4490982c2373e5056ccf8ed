export class Board {
  constructor(lines) {
    this.grid = lines.map((line) => line.replace(/ /g, '').split(''));
  }

  winner() {
    if (this.#connects('X', 0, this.grid[0].length - 1)) {
      return 'X';
    }
    if (this.#connects('O', this.grid.length - 1, 0)) {
      return 'O';
    }
    return '';
  }

  #connects(player, startEdge, endEdge) {
    const rows = this.grid.length;
    const cols = this.grid[0].length;

    const start = (r, c) =>
      player === 'X' ? c === startEdge : r === startEdge;
    const end = (r, c) =>
      player === 'X' ? c === endEdge : r === endEdge;

    const neighbors = [
      [0, -1],
      [0, 1],
      [-1, 0],
      [-1, 1],
      [1, -1],
      [1, 0],
    ];

    const visited = new Set();
    const queue = [];

    for (let r = 0; r < rows; r += 1) {
      for (let c = 0; c < cols; c += 1) {
        if (this.grid[r][c] === player && start(r, c)) {
          queue.push([r, c]);
          visited.add(`${r},${c}`);
        }
      }
    }

    while (queue.length > 0) {
      const [r, c] = queue.shift();
      if (end(r, c)) {
        return true;
      }
      for (const [dr, dc] of neighbors) {
        const nr = r + dr;
        const nc = c + dc;
        if (
          nr >= 0 &&
          nr < rows &&
          nc >= 0 &&
          nc < cols &&
          this.grid[nr][nc] === player &&
          !visited.has(`${nr},${nc}`)
        ) {
          visited.add(`${nr},${nc}`);
          queue.push([nr, nc]);
        }
      }
    }

    return false;
  }
}
