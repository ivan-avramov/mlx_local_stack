//

export class QueenAttack {
  constructor({
    black: [blackRow, blackColumn] = [0, 3],
    white: [whiteRow, whiteColumn] = [7, 3],
  } = {}) {
    this.black = [blackRow, blackColumn];
    this.white = [whiteRow, whiteColumn];

    for (const [row, column] of [this.black, this.white]) {
      if (row < 0 || row > 7 || column < 0 || column > 7) {
        throw new Error('Queen must be placed on the board');
      }
    }

    if (
      blackRow === whiteRow &&
      blackColumn === whiteColumn
    ) {
      throw new Error('Queens cannot share the same space');
    }
  }

  toString() {
    const board = [];
    for (let row = 0; row < 8; row++) {
      const cells = [];
      for (let column = 0; column < 8; column++) {
        if (row === this.white[0] && column === this.white[1]) {
          cells.push('W');
        } else if (row === this.black[0] && column === this.black[1]) {
          cells.push('B');
        } else {
          cells.push('_');
        }
      }
      board.push(cells.join(' '));
    }
    return board.join('\n');
  }

  get canAttack() {
    const [whiteRow, whiteColumn] = this.white;
    const [blackRow, blackColumn] = this.black;
    return (
      whiteRow === blackRow ||
      whiteColumn === blackColumn ||
      Math.abs(whiteRow - blackRow) === Math.abs(whiteColumn - blackColumn)
    );
  }
}
