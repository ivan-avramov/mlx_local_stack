const DAYS = [
  'first',
  'second',
  'third',
  'fourth',
  'fifth',
  'sixth',
  'seventh',
  'eighth',
  'ninth',
  'tenth',
  'eleventh',
  'twelfth',
];

const GIFTS = [
  'a Partridge in a Pear Tree',
  'two Turtle Doves',
  'three French Hens',
  'four Calling Birds',
  'five Gold Rings',
  'six Geese-a-Laying',
  'seven Swans-a-Swimming',
  'eight Maids-a-Milking',
  'nine Ladies Dancing',
  'ten Lords-a-Leaping',
  'eleven Pipers Piping',
  'twelve Drummers Drumming',
];

const verse = (day) => {
  const gifts = [];
  for (let i = day - 1; i >= 0; i -= 1) {
    gifts.push(GIFTS[i]);
  }
  // Join with ", ", but the final gift is introduced with "and ".
  const giftsText =
    gifts.length > 1
      ? gifts.slice(0, -1).join(', ') + ', and ' + gifts[gifts.length - 1]
      : gifts[0];

  return `On the ${DAYS[day - 1]} day of Christmas my true love gave to me: ${giftsText}.\n`;
};

export const recite = (startVerse, endVerse = startVerse) => {
  const verses = [];
  for (let day = startVerse; day <= endVerse; day += 1) {
    verses.push(verse(day));
  }
  return verses.join('\n');
};
