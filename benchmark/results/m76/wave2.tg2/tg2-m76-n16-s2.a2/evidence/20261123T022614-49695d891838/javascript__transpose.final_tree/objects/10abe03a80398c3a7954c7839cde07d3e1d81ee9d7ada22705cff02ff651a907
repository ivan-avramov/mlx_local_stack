export const transpose = (input) => {
  const maxLen = input.reduce((max, row) => Math.max(max, row.length), 0);
  const output = [];

  for (let col = 0; col < maxLen; col += 1) {
    let line = '';
    let hasContentAfter = false;

    // Walk rows from last to first. Once we've seen a row that has a
    // character in this column, every earlier row contributes either its
    // character or a space. Rows after the last one with content are
    // skipped, so we never emit trailing padding spaces.
    for (let i = input.length - 1; i >= 0; i -= 1) {
      if (input[i].length > col) {
        hasContentAfter = true;
      }
      if (hasContentAfter) {
        line = (input[i].length > col ? input[i][col] : ' ') + line;
      }
    }

    output.push(line);
  }

  return output;
};
