const ONES = [
  'zero',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
  'eleven',
  'twelve',
  'thirteen',
  'fourteen',
  'fifteen',
  'sixteen',
  'seventeen',
  'eighteen',
  'nineteen',
];

const TENS = [
  '',
  '',
  'twenty',
  'thirty',
  'forty',
  'fifty',
  'sixty',
  'seventy',
  'eighty',
  'ninety',
];

const SCALES = ['', 'thousand', 'million', 'billion'];

const sayBelowHundred = (n) => {
  if (n < 20) {
    return ONES[n];
  }
  const tens = TENS[Math.floor(n / 10)];
  const ones = n % 10;
  return ones === 0 ? tens : `${tens}-${ONES[ones]}`;
};

const sayBelowThousand = (n) => {
  const hundreds = Math.floor(n / 100);
  const rest = n % 100;
  const parts = [];
  if (hundreds > 0) {
    parts.push(`${ONES[hundreds]} hundred`);
  }
  if (rest > 0) {
    parts.push(sayBelowHundred(rest));
  }
  return parts.join(' ');
};

export const say = (n) => {
  if (!Number.isInteger(n) || n < 0 || n > 999999999999) {
    throw new Error('Number must be between 0 and 999,999,999,999.');
  }
  if (n === 0) {
    return 'zero';
  }

  const chunks = [];
  let rest = n;
  while (rest > 0) {
    chunks.push(rest % 1000);
    rest = Math.floor(rest / 1000);
  }

  const parts = [];
  for (let i = chunks.length - 1; i >= 0; i--) {
    if (chunks[i] === 0) {
      continue;
    }
    const scale = SCALES[i];
    parts.push(scale === '' ? sayBelowThousand(chunks[i]) : `${sayBelowThousand(chunks[i])} ${scale}`);
  }

  return parts.join(' ');
};
