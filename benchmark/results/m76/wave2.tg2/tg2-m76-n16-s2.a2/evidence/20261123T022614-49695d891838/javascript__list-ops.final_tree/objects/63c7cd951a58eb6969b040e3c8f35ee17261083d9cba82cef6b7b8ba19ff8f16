export class List {
  constructor(values = []) {
    this.values = values;
  }

  append(other) {
    const result = [];
    let i = 0;
    for (let j = 0; j < this.values.length; j++) {
      result[i] = this.values[j];
      i++;
    }
    for (let j = 0; j < other.values.length; j++) {
      result[i] = other.values[j];
      i++;
    }
    return new List(result);
  }

  concat(other) {
    const result = [];
    let i = 0;
    for (let j = 0; j < this.values.length; j++) {
      result[i] = this.values[j];
      i++;
    }
    for (let j = 0; j < other.values.length; j++) {
      const item = other.values[j];
      if (item instanceof List) {
        for (let k = 0; k < item.values.length; k++) {
          result[i] = item.values[k];
          i++;
        }
      } else {
        result[i] = item;
        i++;
      }
    }
    return new List(result);
  }

  filter(predicate) {
    const result = [];
    let i = 0;
    for (let j = 0; j < this.values.length; j++) {
      if (predicate(this.values[j])) {
        result[i] = this.values[j];
        i++;
      }
    }
    return new List(result);
  }

  map(fn) {
    const result = [];
    for (let i = 0; i < this.values.length; i++) {
      result[i] = fn(this.values[i]);
    }
    return new List(result);
  }

  length() {
    return this.values.length;
  }

  foldl(fn, acc) {
    for (let i = 0; i < this.values.length; i++) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  foldr(fn, acc) {
    for (let i = this.values.length - 1; i >= 0; i--) {
      acc = fn(acc, this.values[i]);
    }
    return acc;
  }

  reverse() {
    const result = [];
    const n = this.values.length;
    for (let i = 0; i < n; i++) {
      result[i] = this.values[n - 1 - i];
    }
    return new List(result);
  }
}
