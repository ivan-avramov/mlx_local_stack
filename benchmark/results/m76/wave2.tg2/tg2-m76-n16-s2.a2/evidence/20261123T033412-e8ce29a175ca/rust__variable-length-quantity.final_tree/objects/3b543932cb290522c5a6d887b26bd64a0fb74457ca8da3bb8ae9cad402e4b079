#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    IncompleteNumber,
}

/// Convert a list of numbers to a stream of bytes encoded with variable length encoding.
pub fn to_bytes(values: &[u32]) -> Vec<u8> {
    let mut out = Vec::new();
    for &value in values {
        // Extract 7-bit groups from the least significant end.
        let mut groups = Vec::new();
        let mut v = value;
        loop {
            groups.push((v & 0x7F) as u8);
            v >>= 7;
            if v == 0 {
                break;
            }
        }
        // Reverse so the most significant group comes first.
        groups.reverse();
        // Mark every byte except the last as "more bytes follow".
        let len = groups.len();
        for byte in groups.iter_mut().take(len - 1) {
            *byte |= 0x80;
        }
        out.extend(groups);
    }
    out
}

/// Given a stream of bytes, extract all numbers which are encoded in there.
pub fn from_bytes(bytes: &[u8]) -> Result<Vec<u32>, Error> {
    let mut out = Vec::new();
    let mut value: u32 = 0;
    let mut incomplete = false;
    for &byte in bytes {
        value = (value << 7) | (byte & 0x7F) as u32;
        if byte & 0x80 == 0 {
            out.push(value);
            value = 0;
            incomplete = false;
        } else {
            incomplete = true;
        }
    }
    if incomplete {
        return Err(Error::IncompleteNumber);
    }
    Ok(out)
}
