pub fn abbreviate(phrase: &str) -> String {
    let mut acronym = String::new();
    let mut start_of_word = true;
    let mut prev_was_lower = false;

    for c in phrase.chars() {
        if c.is_whitespace() || c == '-' {
            // Whitespace and hyphens both separate words.
            start_of_word = true;
            prev_was_lower = false;
        } else if c.is_alphabetic() {
            if start_of_word {
                acronym.extend(c.to_uppercase());
                start_of_word = false;
            } else if c.is_uppercase() && prev_was_lower {
                // A lowercase-to-uppercase transition (e.g. "HyperText")
                // marks the start of a new acronym letter.
                acronym.extend(c.to_uppercase());
            }
            prev_was_lower = c.is_lowercase();
        }
        // All other punctuation is simply dropped.
    }

    acronym
}
