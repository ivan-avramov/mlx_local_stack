#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    NotEnoughPinsLeft,
    GameComplete,
}

pub struct BowlingGame {
    frames: Vec<Vec<u16>>,
}

impl BowlingGame {
    pub fn new() -> Self {
        Self {
            frames: vec![Vec::new()],
        }
    }

    /// The maximum number of pins the next roll may knock down,
    /// or `None` if the game is already complete.
    fn max_pins(&self) -> Option<u16> {
        let current = self.frames.len() - 1;
        let frame = &self.frames[current];

        if current < 9 {
            return match frame.len() {
                0 => Some(10),
                1 => Some(10 - frame[0]),
                _ => None,
            };
        }

        // Tenth frame: fill balls after a strike or spare.
        match frame.len() {
            0 => Some(10),
            1 => Some(if frame[0] == 10 { 10 } else { 10 - frame[0] }),
            2 => {
                if frame[0] == 10 {
                    Some(if frame[1] == 10 {
                        10
                    } else {
                        10 - frame[1]
                    })
                } else if frame[0] + frame[1] == 10 {
                    Some(10)
                } else {
                    None
                }
            }
            _ => None,
        }
    }

    pub fn roll(&mut self, pins: u16) -> Result<(), Error> {
        let max = match self.max_pins() {
            Some(max) => max,
            None => return Err(Error::GameComplete),
        };

        if pins > max {
            return Err(Error::NotEnoughPinsLeft);
        }

        let current = self.frames.len() - 1;
        self.frames[current].push(pins);

        let frame = &self.frames[current];
        let frame_closed = frame.len() >= 2 || frame[frame.len() - 1] == 10;
        if frame_closed && current < 9 {
            self.frames.push(Vec::new());
        }

        Ok(())
    }

    pub fn score(&self) -> Option<u16> {
        if self.frames.len() < 10 {
            return None;
        }

        let tenth = &self.frames[9];
        let tenth_complete = match tenth.len() {
            2 => tenth[0] + tenth[1] < 10,
            3 => true,
            _ => false,
        };
        if !tenth_complete {
            return None;
        }

        let rolls: Vec<u16> = self.frames.iter().flatten().copied().collect();

        let mut total = 0;
        let mut i = 0;
        for _ in 0..10 {
            if rolls[i] == 10 {
                total += 10 + rolls[i + 1] + rolls[i + 2];
                i += 1;
            } else if rolls[i] + rolls[i + 1] == 10 {
                total += 10 + rolls[i + 2];
                i += 2;
            } else {
                total += rolls[i] + rolls[i + 1];
                i += 2;
            }
        }

        Some(total)
    }
}
