//! Generate musical scales from a tonic and an interval pattern.
//!
//! Scales are built on the twelve-pitch chromatic scale. A scale is produced
//! by starting at the tonic and advancing by the intervals in the pattern,
//! wrapping around the chromatic circle. The spelling of each note (sharp or
//! flat) is chosen according to a *mode* derived from the tonic.

/// An error produced when the tonic or interval pattern is invalid.
#[derive(Debug)]
pub struct Error(String);

impl std::fmt::Display for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str(&self.0)
    }
}

impl std::error::Error for Error {}

/// Whether a scale's ambiguous pitches are spelled with sharps or flats.
#[derive(Clone, Copy, PartialEq, Eq)]
enum Mode {
    Sharps,
    Flats,
}

pub struct Scale {
    notes: Vec<String>,
}

impl Scale {
    /// Construct a new scale with the given tonic and interval pattern.
    ///
    /// The pattern is a string of interval characters: `m` (half step),
    /// `M` (whole step), or `A` (augmented second).
    pub fn new(tonic: &str, intervals: &str) -> Result<Scale, Error> {
        let mode = mode_of(tonic);
        let mut index = chromatic_index(tonic)?;
        let mut notes = vec![normalize_tonic(tonic)];
        for c in intervals.chars() {
            index = (index + interval_semitones(c)) % 12;
            notes.push(note_at(index, mode));
        }
        Ok(Scale { notes })
    }

    /// Construct a chromatic scale (twelve half steps) starting at `tonic`.
    pub fn chromatic(tonic: &str) -> Result<Scale, Error> {
        Scale::new(tonic, "mmmmmmmmmmmm")
    }

    /// Return the notes of the scale, tonic first.
    pub fn enumerate(&self) -> Vec<String> {
        self.notes.clone()
    }
}

/// The chromatic scale spelled with sharps, indexed by pitch class (C = 0).
const SHARP_NOTES: [&str; 12] = [
    "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B",
];

/// The chromatic scale spelled with flats, indexed by pitch class (C = 0).
const FLAT_NOTES: [&str; 12] = [
    "C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B",
];

/// The tonic's spelling with its letter uppercased and its accidental kept.
///
/// Input tonics may use a lowercase letter (e.g. `"e"` or `"bb"`); the emitted
/// scale uses the conventional uppercase letter (e.g. `"E"` or `"Bb"`).
fn normalize_tonic(tonic: &str) -> String {
    let mut chars = tonic.chars();
    let first = chars.next().map(|c| c.to_ascii_uppercase()).unwrap_or('\0');
    let rest: String = chars.collect();
    format!("{first}{rest}")
}

/// The pitch class (0–11, C = 0) of a single note.
fn chromatic_index(note: &str) -> Result<usize, Error> {
    let mut chars = note.chars();
    let letter = chars.next().ok_or_else(|| Error("empty note".into()))?;
    let accidental = chars.next();
    let base: i32 = match letter {
        'C' | 'c' => 0,
        'D' | 'd' => 2,
        'E' | 'e' => 4,
        'F' | 'f' => 5,
        'G' | 'g' => 7,
        'A' | 'a' => 9,
        'B' | 'b' => 11,
        _ => return Err(Error(format!("unknown note {note:?}"))),
    };
    let shift: i32 = match accidental {
        Some('#') => 1,
        Some('b') => -1,
        _ => 0,
    };
    Ok((base + shift).rem_euclid(12) as usize)
}

/// The number of semitones an interval character represents.
fn interval_semitones(interval: char) -> usize {
    match interval {
        'm' => 1, // half step / minor second
        'M' => 2, // whole step / major second
        'A' => 3, // augmented second
        other => panic!("unknown interval {other:?}"),
    }
}

/// The mode (sharps or flats) implied by a tonic.
///
/// A tonic carrying an accidental dictates the mode directly. A natural tonic
/// is assigned to the flat family only for the keys that conventionally use
/// flats (F, c, d, f, g); every other natural tonic uses sharps.
fn mode_of(tonic: &str) -> Mode {
    match tonic.chars().nth(1) {
        Some('#') => Mode::Sharps,
        Some('b') => Mode::Flats,
        _ => match tonic {
            "F" | "c" | "d" | "f" | "g" => Mode::Flats,
            _ => Mode::Sharps,
        },
    }
}

/// The spelling of the note at a given pitch class in the given mode.
fn note_at(index: usize, mode: Mode) -> String {
    match mode {
        Mode::Sharps => SHARP_NOTES[index].to_string(),
        Mode::Flats => FLAT_NOTES[index].to_string(),
    }
}
