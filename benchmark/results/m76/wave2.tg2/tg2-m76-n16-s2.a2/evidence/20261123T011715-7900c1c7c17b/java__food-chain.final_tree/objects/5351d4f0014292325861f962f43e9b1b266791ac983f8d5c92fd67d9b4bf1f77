class FoodChain {

    private static final String[] ANIMALS = {
        "fly", "spider", "bird", "cat", "dog", "goat", "cow", "horse"
    };

    private static final String[] SECOND_LINES = {
        "I don't know why she swallowed the fly. Perhaps she'll die.",
        "It wriggled and jiggled and tickled inside her.",
        "How absurd to swallow a bird!",
        "Imagine that, to swallow a cat!",
        "What a hog, to swallow a dog!",
        "Just opened her throat and swallowed a goat!",
        "I don't know how she swallowed a cow!",
        "She's dead, of course!"
    };

    private static final String[] CATCH_SUFFIXES = {
        "",
        " that wriggled and jiggled and tickled inside her",
        "",
        "",
        "",
        "",
        "",
        ""
    };

    String verse(int verse) {
        StringBuilder result = new StringBuilder();
        int index = verse - 1;

        result.append("I know an old lady who swallowed a ")
              .append(ANIMALS[index]).append(".\n");
        result.append(SECOND_LINES[index]);
        if (index > 0 && index < ANIMALS.length - 1) {
            result.append('\n');
            for (int i = index; i > 0; i--) {
                result.append("She swallowed the ")
                      .append(ANIMALS[i])
                      .append(" to catch the ")
                      .append(ANIMALS[i - 1])
                      .append(CATCH_SUFFIXES[i - 1])
                      .append(".\n");
            }
            result.append("I don't know why she swallowed the fly. Perhaps she'll die.");
        }

        return result.toString();
    }

    String verses(int startVerse, int endVerse) {
        StringBuilder result = new StringBuilder();
        for (int verse = startVerse; verse <= endVerse; verse++) {
            if (verse > startVerse) {
                result.append("\n\n");
            }
            result.append(verse(verse));
        }
        return result.toString();
    }

}
