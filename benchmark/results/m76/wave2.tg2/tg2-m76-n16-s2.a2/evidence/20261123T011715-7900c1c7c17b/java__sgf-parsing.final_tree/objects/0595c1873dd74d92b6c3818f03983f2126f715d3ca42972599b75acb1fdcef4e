import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class SgfParsing {

    public SgfNode parse(String input) throws SgfParsingException {
        if (input == null || input.length() < 2
                || input.charAt(0) != '(' || input.charAt(input.length() - 1) != ')') {
            throw new SgfParsingException("tree missing");
        }
        int[] pos = {0};
        SgfNode root = parseTree(input, pos);
        if (pos[0] != input.length()) {
            throw new SgfParsingException("unexpected trailing input");
        }
        return root;
    }

    private SgfNode parseTree(String input, int[] pos) throws SgfParsingException {
        pos[0]++; // skip '('
        if (input.charAt(pos[0]) == ')') {
            pos[0]++;
            throw new SgfParsingException("tree with no nodes");
        }
        SgfNode node = parseNode(input, pos);
        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);
            if (c == ';') {
                node.appendChild(parseNode(input, pos));
            } else if (c == '(') {
                node.appendChild(parseTree(input, pos));
            } else {
                break;
            }
        }
        if (pos[0] >= input.length() || input.charAt(pos[0]) != ')') {
            throw new SgfParsingException("tree not closed");
        }
        pos[0]++; // skip ')'
        return node;
    }

    private SgfNode parseNode(String input, int[] pos) throws SgfParsingException {
        pos[0]++; // skip ';'
        SgfNode node = new SgfNode();
        Map<String, List<String>> properties = new HashMap<>();
        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);
            if (c == ';' || c == '(' || c == ')') {
                break;
            }
            parseProperty(input, pos, properties);
        }
        node.setProperties(properties);
        return node;
    }

    private void parseProperty(String input, int[] pos, Map<String, List<String>> properties)
            throws SgfParsingException {
        int keyStart = pos[0];
        while (pos[0] < input.length() && input.charAt(pos[0]) != '[') {
            char c = input.charAt(pos[0]);
            if (c == ';' || c == '(' || c == ')') {
                throw new SgfParsingException("properties without delimiter");
            }
            pos[0]++;
        }
        if (pos[0] >= input.length()) {
            throw new SgfParsingException("properties without delimiter");
        }
        String key = input.substring(keyStart, pos[0]);
        if (key.isEmpty()) {
            throw new SgfParsingException("properties without delimiter");
        }
        for (int i = 0; i < key.length(); i++) {
            char c = key.charAt(i);
            if (c < 'A' || c > 'Z') {
                throw new SgfParsingException("property must be in uppercase");
            }
        }
        pos[0]++; // skip '['
        List<String> values = properties.computeIfAbsent(key, k -> new ArrayList<>());
        while (true) {
            values.add(parseValue(input, pos));
            if (pos[0] >= input.length() || input.charAt(pos[0]) != '[') {
                break;
            }
            pos[0]++; // skip '[' of the next value for the same key
        }
    }

    private String parseValue(String input, int[] pos) throws SgfParsingException {
        StringBuilder value = new StringBuilder();
        while (pos[0] < input.length()) {
            char c = input.charAt(pos[0]);
            if (c == ']') {
                pos[0]++;
                return value.toString();
            }
            if (c == '\\') {
                if (pos[0] + 1 >= input.length()) {
                    throw new SgfParsingException("unterminated value");
                }
                char next = input.charAt(pos[0] + 1);
                if (next == '\n') {
                    // newline immediately after a backslash is removed
                    pos[0] += 2;
                } else if (isWhitespace(next)) {
                    // other whitespace after a backslash becomes a space
                    value.append(' ');
                    pos[0] += 2;
                } else {
                    // any non-whitespace character after a backslash is inserted as-is
                    value.append(next);
                    pos[0] += 2;
                }
            } else {
                value.append(c);
                pos[0]++;
            }
        }
        throw new SgfParsingException("unterminated value");
    }

    private static boolean isWhitespace(char c) {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\u000b';
    }

}
