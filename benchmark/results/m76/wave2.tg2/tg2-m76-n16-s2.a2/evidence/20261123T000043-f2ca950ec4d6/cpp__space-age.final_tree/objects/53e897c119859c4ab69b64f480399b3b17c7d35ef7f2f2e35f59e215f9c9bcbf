#include "space_age.h"

namespace space_age {

namespace {

constexpr double SECONDS_IN_EARTH_YEAR = 31557600.0;

constexpr double ORBITAL_PERIOD_IN_EARTH_YEARS[] = {
    0.2408467,   // Mercury
    0.61519726,  // Venus
    1.0,         // Earth
    1.8808158,   // Mars
    11.862615,   // Jupiter
    29.447498,   // Saturn
    84.016846,   // Uranus
    164.79132    // Neptune
};

}  // namespace

space_age::space_age(double seconds) : _seconds(seconds) {}

double space_age::seconds() const
{
    return _seconds;
}

double space_age::on_earth() const
{
    return _seconds / SECONDS_IN_EARTH_YEAR;
}

double space_age::on_mercury() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[0];
}

double space_age::on_venus() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[1];
}

double space_age::on_mars() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[3];
}

double space_age::on_jupiter() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[4];
}

double space_age::on_saturn() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[5];
}

double space_age::on_uranus() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[6];
}

double space_age::on_neptune() const
{
    return on_earth() / ORBITAL_PERIOD_IN_EARTH_YEARS[7];
}

}  // namespace space_age
