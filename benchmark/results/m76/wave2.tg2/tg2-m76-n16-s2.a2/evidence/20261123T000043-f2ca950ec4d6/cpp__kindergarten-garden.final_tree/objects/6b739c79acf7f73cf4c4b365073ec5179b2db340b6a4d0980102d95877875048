#include "kindergarten_garden.h"

#include <array>

namespace kindergarten_garden {

namespace {

const std::array<std::string, 12> kStudents{
    "Alice", "Bob", "Charlie", "David", "Eve", "Fred",
    "Ginny", "Harriet", "Ileana", "Joseph", "Kincaid", "Larry"};

Plants to_plant(char cup) {
  switch (cup) {
    case 'G': return Plants::grass;
    case 'C': return Plants::clover;
    case 'R': return Plants::radishes;
    case 'V': return Plants::violets;
    default: return Plants::grass;
  }
}

}  // namespace

std::array<Plants, 4> plants(const std::string& garden, const std::string& student) {
  size_t index = 0;
  for (size_t i = 0; i < kStudents.size(); ++i) {
    if (kStudents[i] == student) {
      index = i;
      break;
    }
  }

  const size_t newline = garden.find('\n');
  const std::string first_row = garden.substr(0, newline);
  const std::string second_row = garden.substr(newline + 1);

  const size_t cup = index * 2;
  return {
      to_plant(first_row[cup]),
      to_plant(first_row[cup + 1]),
      to_plant(second_row[cup]),
      to_plant(second_row[cup + 1]),
  };
}

}  // namespace kindergarten_garden
