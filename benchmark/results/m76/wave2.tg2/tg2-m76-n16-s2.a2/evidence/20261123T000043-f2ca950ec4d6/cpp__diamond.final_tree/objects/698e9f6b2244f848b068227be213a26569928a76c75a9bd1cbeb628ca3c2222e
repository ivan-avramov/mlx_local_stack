#include "diamond.h"

namespace diamond {

std::vector<std::string> rows(char letter) {
    const int n = letter - 'A' + 1;
    const int width = 2 * n - 1;

    std::vector<std::string> result;
    result.reserve(2 * n - 1);

    for (int i = 0; i < 2 * n - 1; ++i) {
        const int idx = i < n ? i : 2 * n - 2 - i;
        const char ch = static_cast<char>('A' + idx);

        std::string row(width, ' ');
        if (idx == 0) {
            row[n - 1] = ch;
        } else {
            row[n - 1 - idx] = ch;
            row[n - 1 + idx] = ch;
        }
        result.push_back(row);
    }

    return result;
}

}  // namespace diamond
