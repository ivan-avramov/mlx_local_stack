#include "allergies.h"

#include <utility>

namespace allergies {

namespace {

const std::pair<const std::string, unsigned> kAllergens[] = {
    {"eggs", 1},
    {"peanuts", 2},
    {"shellfish", 4},
    {"strawberries", 8},
    {"tomatoes", 16},
    {"chocolate", 32},
    {"pollen", 64},
    {"cats", 128},
};

}  // namespace

allergy_test::allergy_test(unsigned score) : score_(score) {}

bool allergy_test::is_allergic_to(const std::string& allergen) const {
  return get_allergies().count(allergen) > 0;
}

std::unordered_set<std::string> allergy_test::get_allergies() const {
  std::unordered_set<std::string> result;
  for (const auto& [name, value] : kAllergens) {
    if (score_ & value) {
      result.emplace(name);
    }
  }
  return result;
}

}  // namespace allergies
