#include "knapsack.h"

#include <algorithm>
#include <vector>

namespace knapsack
{

int maximum_value(int max_weight, const std::vector<Item>& items)
{
    // dp[w] holds the best value achievable with a knapsack of capacity w
    // after considering the items processed so far.
    std::vector<int> dp(max_weight + 1, 0);

    for (const Item& item : items)
    {
        // Iterate capacity in descending order so each item is used at most
        // once (0/1 knapsack).
        for (int weight = max_weight; weight >= item.weight; --weight)
        {
            dp[weight] = std::max(dp[weight], dp[weight - item.weight] + item.value);
        }
    }

    return dp[max_weight];
}

} // namespace knapsack
