#include "spiral_matrix.h"

namespace spiral_matrix {

std::vector<std::vector<uint32_t>> spiral_matrix(uint32_t size) {
    std::vector<std::vector<uint32_t>> matrix(size, std::vector<uint32_t>(size, 0));

    uint32_t top = 0;
    uint32_t bottom = size;
    uint32_t left = 0;
    uint32_t right = size;
    uint32_t value = 1;

    while (top < bottom && left < right) {
        for (uint32_t i = 0; i < right - left; ++i) {
            matrix[top][left + i] = value++;
        }
        ++top;

        for (uint32_t i = 0; i < bottom - top; ++i) {
            matrix[top + i][right - 1] = value++;
        }
        --right;

        if (top < bottom) {
            for (uint32_t i = 0; i < right - left; ++i) {
                matrix[bottom - 1][right - 1 - i] = value++;
            }
            --bottom;
        }

        if (left < right) {
            for (uint32_t i = 0; i < bottom - top; ++i) {
                matrix[bottom - 1 - i][left] = value++;
            }
            ++left;
        }
    }

    return matrix;
}

}  // namespace spiral_matrix
