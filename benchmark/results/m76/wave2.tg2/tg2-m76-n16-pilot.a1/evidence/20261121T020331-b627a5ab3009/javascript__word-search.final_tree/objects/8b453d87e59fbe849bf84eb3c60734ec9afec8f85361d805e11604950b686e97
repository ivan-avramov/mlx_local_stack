class WordSearch {
  constructor(grid) {
    this.grid = grid;
  }

  find(words) {
    const results = {};
    for (const word of words) {
      results[word] = this.findWord(word);
    }
    return results;
  }

  findWord(word) {
    const rows = this.grid.length;
    const cols = rows > 0 ? this.grid[0].length : 0;
    const directions = [
      [1, 0], // left to right
      [-1, 0], // right to left
      [0, 1], // top to bottom
      [0, -1], // bottom to top
      [1, 1], // top left to bottom right
      [-1, -1], // bottom right to top left
      [1, -1], // bottom left to top right
      [-1, 1], // top right to bottom left
    ];

    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        for (const [dx, dy] of directions) {
          if (this.matches(word, row, col, dx, dy)) {
            return {
              start: [row + 1, col + 1],
              end: [row + dy * (word.length - 1) + 1, col + dx * (word.length - 1) + 1],
            };
          }
        }
      }
    }
    return undefined;
  }

  matches(word, row, col, dx, dy) {
    for (let i = 0; i < word.length; i++) {
      const r = row + dy * i;
      const c = col + dx * i;
      if (r < 0 || r >= this.grid.length || c < 0 || c >= this.grid[0].length) {
        return false;
      }
      if (this.grid[r][c] !== word[i]) {
        return false;
      }
    }
    return true;
  }
}

export default WordSearch;
