package erratum

import (
	"errors"
	"fmt"
)

func Use(opener ResourceOpener, input string) error {
	var res Resource
	var openErr error
	for {
		res, openErr = opener()
		var transient TransientError
		if openErr == nil || !errors.As(openErr, &transient) {
			break
		}
	}
	if openErr != nil {
		return openErr
	}
	defer res.Close()

	var frobErr error
	func() {
		defer func() {
			if r := recover(); r != nil {
				if fe, ok := r.(FrobError); ok {
					res.Defrob(fe.defrobTag)
				}
				if err, ok := r.(error); ok {
					frobErr = err
				} else {
					frobErr = fmt.Errorf("%v", r)
				}
			}
		}()
		res.Frob(input)
	}()
	return frobErr
}
