package foodchain

import (
	"fmt"
	"strings"
)

var animals = []string{
	"fly",
	"spider",
	"bird",
	"cat",
	"dog",
	"goat",
	"cow",
	"horse",
}

var comments = map[int]string{
	2: "It wriggled and jiggled and tickled inside her.",
	3: "How absurd to swallow a bird!",
	4: "Imagine that, to swallow a cat!",
	5: "What a hog, to swallow a dog!",
	6: "Just opened her throat and swallowed a goat!",
	7: "I don't know how she swallowed a cow!",
	8: "She's dead, of course!",
}

func Verse(v int) string {
	var b strings.Builder

	fmt.Fprintf(&b, "I know an old lady who swallowed a %s.\n", animals[v-1])

	switch v {
	case 1:
		fmt.Fprint(&b, "I don't know why she swallowed the fly. Perhaps she'll die.")
	case 8:
		fmt.Fprint(&b, "She's dead, of course!")
	default:
		fmt.Fprintf(&b, "%s\n", comments[v])
		for i := v; i >= 2; i-- {
			caught := animals[i-2]
			if caught == "spider" {
				caught += " that wriggled and jiggled and tickled inside her"
			}
			fmt.Fprintf(&b, "She swallowed the %s to catch the %s.\n", animals[i-1], caught)
		}
		fmt.Fprint(&b, "I don't know why she swallowed the fly. Perhaps she'll die.")
	}

	return b.String()
}

func Verses(start, end int) string {
	verses := make([]string, 0, end-start+1)
	for v := start; v <= end; v++ {
		verses = append(verses, Verse(v))
	}
	return strings.Join(verses, "\n\n")
}

func Song() string {
	return Verses(1, len(animals))
}
