package octal

import (
	"errors"
)

// ParseOctal converts an octal number represented as a string to its
// decimal equivalent, computing the value from first principles.
// Invalid input (non-octal characters) is treated as octal 0 and
// returns an error.
func ParseOctal(input string) (int64, error) {
	var result int64
	for _, digit := range input {
		if digit < '0' || digit > '7' {
			return 0, errors.New("invalid octal input")
		}
		result = result*8 + int64(digit-'0')
	}
	return result, nil
}
