package hexadecimal

import (
	"errors"
	"fmt"
	"math"
	"strings"
)

// ParseHex converts a hexadecimal string (e.g. "10af8c") to its decimal
// equivalent using first principles, without relying on any built-in
// conversion helpers.
//
// It returns an error whose message contains "syntax" when the input is
// not a valid hexadecimal string, and "range" when the value does not fit
// in an int64.
func ParseHex(in string) (int64, error) {
	if in == "" {
		return 0, errors.New("syntax error: empty input")
	}

	var result int64
	for _, r := range in {
		var digit int64
		switch {
		case r >= '0' && r <= '9':
			digit = int64(r - '0')
		case r >= 'a' && r <= 'f':
			digit = int64(r-'a') + 10
		case r >= 'A' && r <= 'F':
			digit = int64(r-'A') + 10
		default:
			return 0, fmt.Errorf("syntax error: invalid hexadecimal digit %q", r)
		}

		// result*16 + digit overflows int64 when
		// result > (MaxInt64 - digit) / 16.
		if result > (math.MaxInt64-digit)/16 {
			return 0, errors.New("range error: value out of range for int64")
		}
		result = result*16 + digit
	}

	return result, nil
}

// HandleErrors takes a list of inputs for ParseHex and returns a matching
// list of error cases: "none" when ParseHex succeeds, "syntax" or "range"
// according to the error returned.
func HandleErrors(inputs []string) []string {
	results := make([]string, len(inputs))
	for i, in := range inputs {
		_, err := ParseHex(in)
		switch {
		case err == nil:
			results[i] = "none"
		case strings.Contains(strings.ToLower(err.Error()), "range"):
			results[i] = "range"
		default:
			results[i] = "syntax"
		}
	}
	return results
}
