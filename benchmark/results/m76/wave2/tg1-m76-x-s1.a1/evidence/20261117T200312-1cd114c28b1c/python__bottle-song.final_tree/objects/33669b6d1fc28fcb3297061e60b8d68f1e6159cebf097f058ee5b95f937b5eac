_NUMBERS = {
    0: "no",
    1: "One",
    2: "Two",
    3: "Three",
    4: "Four",
    5: "Five",
    6: "Six",
    7: "Seven",
    8: "Eight",
    9: "Nine",
    10: "Ten",
}


def _bottles(n):
    return f"{_NUMBERS[n]} green bottle{'s' if n != 1 else ''}"


def recite(start, take=1):
    lines = []
    for n in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.extend(
            [
                f"{_bottles(n)} hanging on the wall,",
                f"{_bottles(n)} hanging on the wall,",
                "And if one green bottle should accidentally fall,",
                f"There'll be {_bottles(n - 1).lower()} hanging on the wall.",
            ]
        )
    return lines
