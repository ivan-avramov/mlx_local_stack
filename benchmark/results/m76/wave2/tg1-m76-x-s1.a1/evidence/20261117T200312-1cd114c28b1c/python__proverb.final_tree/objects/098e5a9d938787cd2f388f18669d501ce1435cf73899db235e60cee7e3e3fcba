def proverb(*pieces, qualifier=None):
    if not pieces:
        return []

    lines = [
        f"For want of a {current} the {next_piece} was lost."
        for current, next_piece in zip(pieces, pieces[1:])
    ]

    if qualifier is None:
        lines.append(f"And all for the want of a {pieces[0]}.")
    else:
        lines.append(f"And all for the want of a {qualifier} {pieces[0]}.")

    return lines
