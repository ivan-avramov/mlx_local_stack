NUMBERS = {
    0: "no",
    1: "one",
    2: "two",
    3: "three",
    4: "four",
    5: "five",
    6: "six",
    7: "seven",
    8: "eight",
    9: "nine",
    10: "ten",
}


def recite(start, take=1):
    lines = []
    for count in range(start, start - take, -1):
        if lines:
            lines.append("")
        plural = "s" if count != 1 else ""
        opening = f"{NUMBERS[count].capitalize()} green bottle{plural} hanging on the wall,"
        lines.extend(
            [
                opening,
                opening,
                "And if one green bottle should accidentally fall,",
                f"There'll be {NUMBERS[count - 1]} green bottle"
                + ("s" if count - 1 != 1 else "")
                + " hanging on the wall.",
            ]
        )
    return lines
