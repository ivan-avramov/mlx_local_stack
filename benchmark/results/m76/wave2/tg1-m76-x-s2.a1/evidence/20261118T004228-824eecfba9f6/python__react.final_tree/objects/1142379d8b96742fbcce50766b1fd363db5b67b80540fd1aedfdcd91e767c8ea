class Cell:
    def __init__(self):
        self._dependents = []

    def _add_dependent(self, dependent):
        self._dependents.append(dependent)


class InputCell(Cell):
    def __init__(self, initial_value):
        super().__init__()
        self._value = initial_value

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        self._value = new_value
        self._update_dependents()

    def _update_dependents(self):
        # Collect all affected compute cells in topological order (a cell's
        # inputs always appear before the cell itself).
        order = []
        visiting = set()
        visited = set()

        def visit(cell):
            if id(cell) in visited:
                return
            if id(cell) in visiting:
                return
            visiting.add(id(cell))
            for dependent in cell._dependents:
                visit(dependent)
            visiting.discard(id(cell))
            visited.add(id(cell))
            order.append(cell)

        for dependent in self._dependents:
            visit(dependent)

        order.reverse()
        for cell in order:
            cell._recompute()
        for cell in order:
            cell._fire_callbacks()


class ComputeCell(Cell):
    def __init__(self, inputs, compute_function):
        super().__init__()
        self._inputs = inputs
        self._compute_function = compute_function
        self._callbacks = []
        self._previous_value = None
        for input in inputs:
            input._add_dependent(self)
        self._value = self._compute_function([input.value for input in inputs])

    @property
    def value(self):
        return self._value

    def _recompute(self):
        self._previous_value = self._value
        self._value = self._compute_function([input.value for input in self._inputs])

    def _fire_callbacks(self):
        if self._value != self._previous_value:
            for callback in self._callbacks:
                callback(self._value)

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self._callbacks:
            self._callbacks.remove(callback)
