VOWELS = "aeiou"


def translate(text):
    return " ".join(_translate_word(word) for word in text.split(" "))


def _translate_word(word):
    # Rule 1: starts with a vowel, or with "xr" / "yt"
    if word[0] in VOWELS or word.startswith(("xr", "yt")):
        return word + "ay"

    # Rules 2-4: move the leading consonant cluster to the end.
    # "y" counts as a consonant only when it starts the word;
    # otherwise it is treated as a vowel.
    i = 1
    while i < len(word) and word[i] not in VOWELS and word[i] != "y":
        i += 1

    # Rule 3: if the cluster ends in "q", include the following "u".
    if word[i - 1] == "q" and i < len(word) and word[i] == "u":
        i += 1

    return word[i:] + word[:i] + "ay"
