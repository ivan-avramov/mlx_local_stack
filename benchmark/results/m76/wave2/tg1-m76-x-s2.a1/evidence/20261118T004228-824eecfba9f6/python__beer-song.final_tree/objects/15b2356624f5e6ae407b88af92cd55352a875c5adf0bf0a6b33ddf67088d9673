def _bottle_phrase(n):
    if n == 0:
        return "no more bottles"
    if n == 1:
        return "1 bottle"
    return f"{n} bottles"


def _verse(n):
    first = f"{_bottle_phrase(n).capitalize()} of beer on the wall, {_bottle_phrase(n)} of beer."
    if n > 0:
        action = "Take it down" if n == 1 else "Take one down"
        second = f"{action} and pass it around, {_bottle_phrase(n - 1)} of beer on the wall."
    else:
        second = "Go to the store and buy some more, 99 bottles of beer on the wall."
    return [first, second]


def recite(start, take=1):
    lines = []
    for i in range(take):
        if i > 0:
            lines.append("")
        lines.extend(_verse(start - i))
    return lines
