package piglatin

import "strings"

// Sentence translates an entire sentence from English to Pig Latin,
// applying the translation rules to each word individually.
func Sentence(sentence string) string {
	words := strings.Fields(sentence)
	for i, word := range words {
		words[i] = translate(word)
	}
	return strings.Join(words, " ")
}

// translate converts a single word to Pig Latin.
func translate(word string) string {
	if word == "" {
		return ""
	}

	// Rule 1: a word beginning with a vowel, or starting with "xr" or "yt",
	// simply gets "ay" appended.
	if isVowel(word[0]) || strings.HasPrefix(word, "xr") || strings.HasPrefix(word, "yt") {
		return word + "ay"
	}

	// Otherwise the word begins with a consonant cluster. Find where the
	// cluster ends: at the first vowel, after a "qu" digraph, or before a
	// "y" that follows at least one consonant (Rule 4). Everything before
	// that point moves to the end, then "ay" is appended.
	n := len(word)
	i := 0
	for i < n {
		c := word[i]
		if isVowel(c) {
			break
		}
		if c == 'q' && i+1 < n && word[i+1] == 'u' {
			i += 2 // Rule 3: "qu" is part of the consonant cluster
			break
		}
		if c == 'y' && i > 0 {
			break // Rule 4: "y" after consonants acts as a vowel
		}
		i++
	}

	return word[i:] + word[:i] + "ay"
}

func isVowel(c byte) bool {
	switch c {
	case 'a', 'e', 'i', 'o', 'u':
		return true
	}
	return false
}
