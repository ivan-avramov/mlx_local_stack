package octal

import (
	"errors"
)

// ParseOctal converts an octal number, represented as a string, to its
// decimal equivalent. Invalid input (any character outside '0'-'7') is
// treated as an error and yields 0.
func ParseOctal(input string) (int64, error) {
	var value int64
	for _, ch := range input {
		if ch < '0' || ch > '7' {
			return 0, errors.New("invalid octal input")
		}
		value = value*8 + int64(ch-'0')
	}
	return value, nil
}
