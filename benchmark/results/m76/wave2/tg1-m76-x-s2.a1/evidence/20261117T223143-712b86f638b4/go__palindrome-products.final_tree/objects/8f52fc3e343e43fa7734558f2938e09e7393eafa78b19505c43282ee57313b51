package palindrome

import (
	"errors"
	"strconv"
)

// Product holds a palindromic product and the factor pairs within the
// range that produce it.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of two
// numbers within the range [fmin, fmax] (both inclusive), along with
// all factor pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	var min, max Product
	found := false
	for a := fmin; a <= fmax; a++ {
		for b := a; b <= fmax; b++ {
			p := a * b
			if !isPalindrome(p) {
				continue
			}
			if !found {
				min = Product{p, [][2]int{{a, b}}}
				max = min
				found = true
			} else {
				switch {
				case p < min.Value:
					min = Product{p, [][2]int{{a, b}}}
				case p == min.Value:
					min.Factorizations = append(min.Factorizations, [2]int{a, b})
				case p > max.Value:
					max = Product{p, [][2]int{{a, b}}}
				case p == max.Value:
					max.Factorizations = append(max.Factorizations, [2]int{a, b})
				}
			}
		}
	}

	if !found {
		return Product{}, Product{}, errors.New("no palindromes found")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	s := strconv.Itoa(n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
