package kindergarten

import (
	"errors"
	"fmt"
	"sort"
	"strings"
)

// Garden holds the diagram rows and the alphabetically ordered list of
// children assigned to it.
type Garden struct {
	rows     []string
	children []string
	index    map[string]int
}

var plantNames = map[rune]string{
	'G': "grass",
	'C': "clover",
	'R': "radishes",
	'V': "violets",
}

// The diagram argument starts each row with a '\n'.  This allows Go's
// raw string literals to present diagrams in source code nicely as two
// rows flush left, for example,
//
//     diagram := `
//     VVCCGG
//     VVCCGG`

func NewGarden(diagram string, children []string) (*Garden, error) {
	rows := strings.Split(diagram, "\n")
	if len(rows) != 3 || rows[0] != "" {
		return nil, errors.New("diagram must start with a newline and contain exactly two rows")
	}
	if len(rows[1]) != len(rows[2]) {
		return nil, errors.New("diagram rows must be the same length")
	}
	if len(rows[1])%2 != 0 {
		return nil, errors.New("each row must contain an even number of cups")
	}
	for _, row := range rows[1:3] {
		for _, r := range row {
			if _, ok := plantNames[r]; !ok {
				return nil, fmt.Errorf("invalid cup code %q", r)
			}
		}
	}

	seen := make(map[string]bool, len(children))
	for _, child := range children {
		if seen[child] {
			return nil, fmt.Errorf("duplicate name %q", child)
		}
		seen[child] = true
	}

	// Sort a copy so the caller's slice is left untouched.
	ordered := make([]string, len(children))
	copy(ordered, children)
	sort.Strings(ordered)

	index := make(map[string]int, len(ordered))
	for i, child := range ordered {
		index[child] = i
	}

	return &Garden{
		rows:     rows[1:3],
		children: ordered,
		index:    index,
	}, nil
}

// Plants returns the four plants belonging to child, in the order
// top row left, top row right, bottom row left, bottom row right.
// ok is false if child is not in the garden.
func (g *Garden) Plants(child string) ([]string, bool) {
	i, ok := g.index[child]
	if !ok {
		return nil, false
	}
	return []string{
		plantNames[rune(g.rows[0][2*i])],
		plantNames[rune(g.rows[0][2*i+1])],
		plantNames[rune(g.rows[1][2*i])],
		plantNames[rune(g.rows[1][2*i+1])],
	}, true
}
