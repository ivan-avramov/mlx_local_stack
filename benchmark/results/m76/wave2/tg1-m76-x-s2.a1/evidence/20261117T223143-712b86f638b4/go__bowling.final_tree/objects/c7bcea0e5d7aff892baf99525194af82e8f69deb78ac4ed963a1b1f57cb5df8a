package bowling

import "errors"

var (
	errNegativeRoll = errors.New("Negative roll is invalid")
	errTooManyPins  = errors.New("Pin count exceeds pins on the lane")
	errGameOver     = errors.New("Cannot roll after game is over")
	errIncomplete   = errors.New("Score cannot be taken until the end of the game")
)

// Game keeps track of a bowling game, frame by frame.
// Each frame stores the pins knocked down by each of its rolls.
type Game struct {
	frames [][]int
}

// NewGame returns a new, unstarted Game.
func NewGame() *Game {
	return &Game{frames: [][]int{{}}}
}

// Roll records a throw of the ball that knocks down pins pins.
func (g *Game) Roll(pins int) error {
	if pins < 0 {
		return errNegativeRoll
	}
	if pins > 10 {
		return errTooManyPins
	}
	// A completed game leaves one trailing empty frame behind,
	// so more than ten frames means the game is over.
	if len(g.frames) > 10 {
		return errGameOver
	}

	frame := g.frames[len(g.frames)-1]
	switch len(frame) {
	case 1:
		if frame[0] < 10 && frame[0]+pins > 10 {
			return errTooManyPins
		}
	case 2:
		// Only reachable in the 10th frame: a strike followed by
		// a non-strike bonus roll leaves the lane with pins standing.
		if frame[0] == 10 && frame[1] < 10 && frame[1]+pins > 10 {
			return errTooManyPins
		}
	}

	g.frames[len(g.frames)-1] = append(frame, pins)
	if g.frameComplete(len(g.frames)-1) {
		g.frames = append(g.frames, []int{})
	}
	return nil
}

// frameComplete reports whether frame i has all the rolls it will ever get.
func (g *Game) frameComplete(i int) bool {
	f := g.frames[i]
	if i < 9 {
		return len(f) == 2 || f[0] == 10
	}
	// The 10th frame earns bonus rolls after a strike or a spare.
	if len(f) == 3 {
		return true
	}
	if len(f) == 2 {
		return f[0] < 10 && f[0]+f[1] < 10
	}
	return false
}

// Score returns the total score of a completed game.
func (g *Game) Score() (int, error) {
	if len(g.frames) < 10 || !g.frameComplete(9) {
		return 0, errIncomplete
	}

	total := 0
	for i := 0; i < 10; i++ {
		total += g.frameScore(i)
	}
	return total, nil
}

// frameScore returns the score of frame i, including strike and
// spare bonuses. The 10th frame is worth exactly the pins knocked down.
func (g *Game) frameScore(i int) int {
	f := g.frames[i]
	if i == 9 {
		sum := 0
		for _, pins := range f {
			sum += pins
		}
		return sum
	}

	rolls := g.allRolls()
	start := 0
	for j := 0; j <= i; j++ {
		start += len(g.frames[j])
	}
	switch {
	case f[0] == 10:
		return 10 + g.sumRolls(rolls, start, 2)
	case len(f) == 2 && f[0]+f[1] == 10:
		return 10 + g.sumRolls(rolls, start, 1)
	default:
		return f[0] + f[1]
	}
}

// allRolls flattens all frames into a single slice of rolls.
func (g *Game) allRolls() []int {
	var rolls []int
	for _, f := range g.frames {
		rolls = append(rolls, f...)
	}
	return rolls
}

// sumRolls returns the sum of at most count rolls starting at start.
func (g *Game) sumRolls(rolls []int, start, count int) int {
	sum := 0
	for j := start; j < start+count && j < len(rolls); j++ {
		sum += rolls[j]
	}
	return sum
}
