package markdown

// Refactored implementation.
//
// The original code scanned the input one character at a time, tracking
// header level, list state and a "have we seen a header" flag in parallel
// to build up the output. The refactored version processes the document
// line by line instead: emphasis markers are resolved first, then each
// line is classified as a header, a list item, or a paragraph, and the
// <ul> element is opened before the first list item and closed after the
// last one. The output for every supported input is unchanged.

import (
	"fmt"
	"strings"
)

// Render translates markdown to HTML.
func Render(markdown string) string {
	markdown = applyEmphasis(markdown)

	var html strings.Builder
	inList := false
	for _, line := range strings.Split(markdown, "\n") {
		if inList && !isListItem(line) {
			html.WriteString("</ul>")
			inList = false
		}
		if isListItem(line) {
			if !inList {
				html.WriteString("<ul>")
				inList = true
			}
			html.WriteString("<li>" + strings.TrimPrefix(line, "* ") + "</li>")
			continue
		}
		if level := headerLevel(line); level > 0 {
			// The header markers and the space that follows them are not
			// part of the header text.
			content := strings.TrimPrefix(line, strings.Repeat("#", level))
			content = strings.TrimPrefix(content, " ")
			html.WriteString(fmt.Sprintf("<h%d>%s</h%d>", level, content, level))
			continue
		}
		html.WriteString("<p>" + line + "</p>")
	}
	if inList {
		html.WriteString("</ul>")
	}
	return html.String()
}

// isListItem reports whether the line starts a list item, i.e. begins with "* ".
func isListItem(line string) bool {
	return strings.HasPrefix(line, "* ")
}

// headerLevel reports the level (1-6) of the header the line starts with,
// or 0 if the line is not a header. Seven or more leading '#' characters
// are not a header and are rendered as plain paragraph text.
func headerLevel(line string) int {
	level := 0
	for level < len(line) && line[level] == '#' {
		level++
	}
	if level > 6 {
		return 0
	}
	return level
}

// applyEmphasis replaces the first pair of __bold__ and _italic_ markers
// in the text with their HTML equivalents.
func applyEmphasis(text string) string {
	text = emphasize(text, "__", "strong")
	return emphasize(text, "_", "em")
}

// emphasize wraps the text between the first pair of markers in the given
// tag. If the text contains fewer than two markers it is returned unchanged.
func emphasize(text, marker, tag string) string {
	start := strings.Index(text, marker)
	if start < 0 {
		return text
	}
	rest := text[start+len(marker):]
	end := strings.Index(rest, marker)
	if end < 0 {
		return text
	}
	return text[:start] + "<" + tag + ">" + rest[:end] + "</" + tag + ">" + rest[end+len(marker):]
}
