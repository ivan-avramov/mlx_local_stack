package hexadecimal

import (
	"fmt"
	"math"
	"strings"
)

// ParseHex converts a hexadecimal string, e.g. "10af8c", to its decimal
// equivalent using first principles (no conversion libraries).
//
// It returns a syntax error for empty strings or strings containing
// characters that are not hexadecimal digits, and a range error when the
// value does not fit in an int64.
func ParseHex(in string) (int64, error) {
	if in == "" {
		return 0, fmt.Errorf("syntax error: empty string")
	}

	var out int64
	for _, c := range in {
		var digit int64
		switch {
		case c >= '0' && c <= '9':
			digit = int64(c - '0')
		case c >= 'a' && c <= 'f':
			digit = int64(c-'a') + 10
		case c >= 'A' && c <= 'F':
			digit = int64(c-'A') + 10
		default:
			return 0, fmt.Errorf("syntax error: %q is not a hexadecimal digit", c)
		}

		// out*16+digit must not overflow int64.
		if out > (math.MaxInt64-digit)/16 {
			return 0, fmt.Errorf("range error: value out of range")
		}
		out = out*16 + digit
	}
	return out, nil
}

// HandleErrors calls ParseHex on each input and returns a matching list of
// "none", "syntax", or "range" according to the error result.
func HandleErrors(inputs []string) []string {
	results := make([]string, len(inputs))
	for i, in := range inputs {
		_, err := ParseHex(in)
		switch {
		case err == nil:
			results[i] = "none"
		case strings.Contains(strings.ToLower(err.Error()), "range"):
			results[i] = "range"
		default:
			results[i] = "syntax"
		}
	}
	return results
}
