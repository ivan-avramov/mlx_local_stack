package matrix

import (
	"errors"
	"fmt"
	"strconv"
	"strings"
)

// Matrix is a rectangular grid of integers. It is an alias for *matrix so
// that a missing matrix is represented by a nil value.
type Matrix = *matrix

type matrix struct {
	rows [][]int
	cols int
}

// New parses s as a matrix of space-separated integers, one row per line.
// It returns an error if any row is empty, rows have unequal lengths, or a
// value is not an integer (including values that overflow int).
func New(s string) (Matrix, error) {
	m := &matrix{}
	for _, line := range strings.Split(s, "\n") {
		fields := strings.Fields(line)
		if len(fields) == 0 {
			return nil, errors.New("matrix: empty row")
		}
		row := make([]int, len(fields))
		for i, f := range fields {
			v, err := strconv.Atoi(f)
			if err != nil {
				return nil, fmt.Errorf("matrix: invalid number %q: %w", f, err)
			}
			row[i] = v
		}
		if len(m.rows) > 0 && len(row) != m.cols {
			return nil, errors.New("matrix: uneven rows")
		}
		m.cols = len(row)
		m.rows = append(m.rows, row)
	}
	return m, nil
}

// Cols returns the columns of the matrix, each as an independent copy.
func (m *matrix) Cols() [][]int {
	cols := make([][]int, m.cols)
	for c := range cols {
		col := make([]int, len(m.rows))
		for r, row := range m.rows {
			col[r] = row[c]
		}
		cols[c] = col
	}
	return cols
}

// Rows returns the rows of the matrix, each as an independent copy.
func (m *matrix) Rows() [][]int {
	rows := make([][]int, len(m.rows))
	for i, row := range m.rows {
		rows[i] = append([]int(nil), row...)
	}
	return rows
}

// Set sets the element at the given row and column to val. It reports whether
// the position was inside the matrix.
func (m *matrix) Set(row, col, val int) bool {
	if row < 0 || row >= len(m.rows) || col < 0 || col >= len(m.rows[row]) {
		return false
	}
	m.rows[row][col] = val
	return true
}
