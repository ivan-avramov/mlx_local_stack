def recite(start, take=1):
    lines = []
    for number in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.append(_first_line(number))
        lines.append(_second_line(number))
    return lines


def _first_line(number):
    return f"{_bottle_phrase(number)} on the wall, {_bottle_phrase(number).lower()}."


def _second_line(number):
    action = _take_action(number)
    remaining = 99 if number == 0 else number - 1
    return f"{action}, {_bottle_phrase(remaining).lower()} on the wall."


def _bottle_phrase(number):
    if number == 0:
        return "No more bottles of beer"
    if number == 1:
        return "1 bottle of beer"
    return f"{number} bottles of beer"


def _take_action(number):
    if number == 0:
        return "Go to the store and buy some more"
    if number == 1:
        return "Take it down and pass it around"
    return "Take one down and pass it around"
