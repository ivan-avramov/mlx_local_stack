def grep(pattern, flags, files):
    flag_list = flags.split()
    output = ""
    for file in files:
        with open(file, "r") as f:
            file_has_match = False
            for line_number, line in enumerate(f, start=1):
                line_no_nl = line.rstrip("\n")
                if "-x" in flag_list:
                    if "-i" in flag_list:
                        matched = line_no_nl.lower() == pattern.lower()
                    else:
                        matched = line_no_nl == pattern
                else:
                    if "-i" in flag_list:
                        matched = pattern.lower() in line.lower()
                    else:
                        matched = pattern in line
                if "-v" in flag_list:
                    matched = not matched
                if not matched:
                    continue
                if "-l" in flag_list:
                    if not file_has_match:
                        output += file + "\n"
                        file_has_match = True
                else:
                    prefix = ""
                    if len(files) > 1:
                        prefix += file + ":"
                    if "-n" in flag_list:
                        prefix += str(line_number) + ":"
                    output += prefix + line_no_nl + "\n"
    return output
