def _bottles(n):
    if n == 0:
        return "no more bottles of beer"
    if n == 1:
        return "1 bottle of beer"
    return f"{n} bottles of beer"


def _verse(n):
    first = _bottles(n).capitalize()
    if n == 0:
        return [
            f"{first} on the wall, no more bottles of beer.",
            "Go to the store and buy some more, 99 bottles of beer on the wall.",
        ]
    return [
        f"{first} on the wall, {_bottles(n)}.",
        f"Take {'it' if n == 1 else 'one'} down and pass it around, "
        f"{_bottles(n - 1)} on the wall.",
    ]


def recite(start, take=1):
    lines = []
    for verse in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.extend(_verse(verse))
    return lines
