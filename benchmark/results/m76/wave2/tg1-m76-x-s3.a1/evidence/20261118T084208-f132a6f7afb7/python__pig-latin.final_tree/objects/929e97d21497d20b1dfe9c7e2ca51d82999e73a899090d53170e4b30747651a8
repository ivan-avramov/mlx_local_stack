def translate(text):
    return " ".join(_translate_word(word) for word in text.split(" "))


def _translate_word(word):
    # Rule 1: word begins with a vowel, or starts with "xr" or "yt"
    if word[0] in "aeiou" or word.startswith(("xr", "yt")):
        return word + "ay"

    # Rules 2/4: find the first vowel (a, e, i, o, u) or "y", which ends
    # the leading consonant cluster.
    for i, ch in enumerate(word):
        if ch in "aeiou" or (ch == "y" and i > 0):
            break
    else:
        i = len(word)

    # Rule 3: a "qu" at the end of the consonant cluster moves with it.
    if word[i - 1 : i + 1] == "qu":
        i += 1

    return word[i:] + word[:i] + "ay"
