package bottlesong

import (
	"fmt"
	"strings"
)

var bottleWords = map[int]string{
	0: "no", 1: "one", 2: "two", 3: "three", 4: "four",
	5: "five", 6: "six", 7: "seven", 8: "eight", 9: "nine", 10: "ten",
}

func Recite(startBottles, takeDown int) []string {
	var lines []string
	for i := 0; i < takeDown; i++ {
		if i > 0 {
			lines = append(lines, "")
		}
		lines = append(lines, verse(startBottles-i)...)
	}
	return lines
}

func verse(count int) []string {
	return []string{
		verseLine(count),
		verseLine(count),
		"And if one green bottle should accidentally fall,",
		fmt.Sprintf("There'll be %s hanging on the wall.", bottles(count-1)),
	}
}

func verseLine(count int) string {
	line := bottles(count) + " hanging on the wall,"
	return strings.ToUpper(line[:1]) + line[1:]
}

func bottles(count int) string {
	if count == 1 {
		return bottleWords[count] + " green bottle"
	}
	return bottleWords[count] + " green bottles"
}
