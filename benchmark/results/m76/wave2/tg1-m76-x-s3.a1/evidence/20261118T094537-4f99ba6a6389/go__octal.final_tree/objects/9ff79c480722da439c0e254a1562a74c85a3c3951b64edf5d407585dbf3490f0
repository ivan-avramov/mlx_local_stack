package octal

import (
	"errors"
)

// ParseOctal converts an octal string (e.g. "1735263") to its decimal
// equivalent using first principles. Invalid input (empty string or a
// character outside 0-7) is treated as octal 0 and returns an error.
func ParseOctal(input string) (int64, error) {
	if input == "" {
		return 0, errors.New("ParseOctal: empty input")
	}

	var result int64
	for _, ch := range input {
		if ch < '0' || ch > '7' {
			return 0, errors.New("ParseOctal: invalid octal digit")
		}
		result = result*8 + int64(ch-'0')
	}
	return result, nil
}
