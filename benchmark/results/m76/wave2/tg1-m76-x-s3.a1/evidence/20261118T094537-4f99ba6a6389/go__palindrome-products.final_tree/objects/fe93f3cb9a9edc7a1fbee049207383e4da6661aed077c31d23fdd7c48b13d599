package palindrome

import (
	"errors"
	"fmt"
	"sort"
	"strconv"
)

// Product is a palindromic product of two factors within a range,
// together with all factor pairs within the range that produce it.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products returns the smallest and largest palindromic products of two
// numbers within the range [fmin, fmax] (both inclusive), along with
// all factor pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, fmt.Errorf("fmin > fmax")
	}

	var min, max Product
	foundMin, foundMax := false, false

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if !isPalindrome(p) {
				continue
			}
			if !foundMin || p < min.Value {
				min = Product{p, [][2]int{{i, j}}}
				foundMin = true
			} else if p == min.Value {
				min.Factorizations = append(min.Factorizations, [2]int{i, j})
			}
			if !foundMax || p > max.Value {
				max = Product{p, [][2]int{{i, j}}}
				foundMax = true
			} else if p == max.Value {
				max.Factorizations = append(max.Factorizations, [2]int{i, j})
			}
		}
	}

	if !foundMin {
		return Product{}, Product{}, errors.New("no palindromes")
	}

	sortFactorizations(min.Factorizations)
	sortFactorizations(max.Factorizations)
	return min, max, nil
}

func sortFactorizations(f [][2]int) {
	sort.Slice(f, func(a, b int) bool {
		if f[a][0] != f[b][0] {
			return f[a][0] < f[b][0]
		}
		return f[a][1] < f[b][1]
	})
}

// isPalindrome reports whether the digits of n read the same forwards
// and backwards.
func isPalindrome(n int) bool {
	s := strconv.Itoa(n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
