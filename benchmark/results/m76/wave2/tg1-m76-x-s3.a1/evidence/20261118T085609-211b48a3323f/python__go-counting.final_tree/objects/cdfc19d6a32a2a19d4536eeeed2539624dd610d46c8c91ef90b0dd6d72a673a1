WHITE = "W"
BLACK = "B"
NONE = ""


class Board:
    """Count territories of each player in a Go game

    Args:
        board (list[str]): A two-dimensional Go board
    """

    def __init__(self, board):
        self.board = board

    def territory(self, x, y):
        """Find the owner and the territories given a coordinate on
           the board

        Args:
            x (int): Column on the board
            y (int): Row on the board

        Returns:
            (str, set): A tuple, the first element being the owner
                        of that area.  One of "W", "B", "".  The
                        second being a set of coordinates, representing
                        the owner's territories.
        """
        if not (0 <= x < len(self.board[0]) and 0 <= y < len(self.board)):
            raise ValueError("Invalid coordinate")
        if self.board[y][x] != " ":
            return NONE, set()
        territory = self._connected_empty(x, y)
        return self._owner(territory), territory

    def territories(self):
        """Find the owners and the territories of the whole board

        Args:
            none

        Returns:
            dict(str, set): A dictionary whose key being the owner
                        , i.e. "W", "B", "".  The value being a set
                        of coordinates owned by the owner.
        """
        territories = {WHITE: set(), BLACK: set(), NONE: set()}
        seen = set()
        for y, row in enumerate(self.board):
            for x, cell in enumerate(row):
                if cell == " " and (x, y) not in seen:
                    territory = self._connected_empty(x, y)
                    seen.update(territory)
                    territories[self._owner(territory)] |= territory
        return territories

    def _connected_empty(self, x, y):
        """Return the set of empty intersections connected to (x, y)."""
        territory = set()
        stack = [(x, y)]
        while stack:
            cx, cy = stack.pop()
            if (cx, cy) in territory:
                continue
            territory.add((cx, cy))
            for nx, ny in self._neighbors(cx, cy):
                if self._in_bounds(nx, ny) and self.board[ny][nx] == " " \
                        and (nx, ny) not in territory:
                    stack.append((nx, ny))
        return territory

    @staticmethod
    def _neighbors(x, y):
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            yield x + dx, y + dy

    def _in_bounds(self, x, y):
        return 0 <= x < len(self.board[0]) and 0 <= y < len(self.board)

    def _owner(self, territory):
        """Return the owner of a connected empty region.

        A region belongs to a player only if every neighboring stone
        is that player's; otherwise it is neutral (NONE).
        """
        owners = set()
        for x, y in territory:
            for nx, ny in self._neighbors(x, y):
                if self._in_bounds(nx, ny) and self.board[ny][nx] != " ":
                    owners.add(self.board[ny][nx])
        if owners == {WHITE}:
            return WHITE
        if owners == {BLACK}:
            return BLACK
        return NONE
