class Cell:
    def __init__(self):
        self._dependents = []

    def _add_dependent(self, dependent):
        self._dependents.append(dependent)

    def _propagate(self):
        # Collect all affected compute cells in topological order so that
        # every cell is recomputed only after all of its inputs have
        # reached their new stable values.
        order = []
        visited = set()

        def visit(cell):
            for dependent in cell._dependents:
                if id(dependent) not in visited:
                    visited.add(id(dependent))
                    visit(dependent)
            order.append(cell)

        for dependent in self._dependents:
            if id(dependent) not in visited:
                visited.add(id(dependent))
                visit(dependent)
        order.reverse()
        for cell in order:
            cell._recompute()


class InputCell(Cell):
    def __init__(self, initial_value):
        super().__init__()
        self._value = initial_value

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        self._value = new_value
        self._propagate()


class ComputeCell(Cell):
    def __init__(self, inputs, compute_function):
        super().__init__()
        self._inputs = inputs
        self._compute_function = compute_function
        self._callbacks = []
        self._value = self._compute_function([cell.value for cell in self._inputs])
        for input_cell in self._inputs:
            input_cell._add_dependent(self)

    @property
    def value(self):
        return self._value

    def _recompute(self):
        old_value = self._value
        self._value = self._compute_function([cell.value for cell in self._inputs])
        if self._value != old_value:
            for callback in self._callbacks:
                callback(self._value)

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        self._callbacks = [cb for cb in self._callbacks if cb is not callback]
