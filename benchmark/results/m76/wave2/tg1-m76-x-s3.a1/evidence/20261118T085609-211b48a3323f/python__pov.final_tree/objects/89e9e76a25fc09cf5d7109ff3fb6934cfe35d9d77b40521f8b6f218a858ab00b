from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def from_pov(self, from_node):
        result = self._reorient(from_node)
        if result is None:
            raise ValueError("Tree could not be reoriented")
        return result

    def path_to(self, from_node, to_node):
        oriented = self.from_pov(from_node)
        path = []

        def find(node):
            path.append(node.label)
            if node.label == to_node:
                return True
            for child in node.children:
                if find(child):
                    return True
            path.pop()
            return False

        if not find(oriented):
            raise ValueError("No path found")
        return path

    def _reorient(self, from_node, parent=None):
        """Return a copy of this subtree re-rooted at from_node, or None
        if from_node is not in this subtree. `parent` is the reoriented
        parent node that should be attached to the new root."""
        if self.label == from_node:
            children = list(self.children)
            if parent is not None:
                children.append(parent)
            return Tree(self.label, children)
        for child in self.children:
            rest = [c for c in self.children if c is not child]
            if parent is not None:
                rest.append(parent)
            result = child._reorient(from_node, parent=Tree(self.label, rest))
            if result is not None:
                return result
        return None
