def can_chain(dominoes):
    """Return a chain of all dominoes where neighboring ends match and the
    first and last ends match each other, or None if no such chain exists.
    Each domino may be reversed, and each input domino is used exactly once.
    """
    if not dominoes:
        return []

    n = len(dominoes)
    used = [False] * n

    def backtrack(chain, right_end):
        if len(chain) == n:
            return chain if chain[0][0] == right_end else None
        for i in range(n):
            if used[i]:
                continue
            a, b = dominoes[i]
            for left, right in ((a, b), (b, a)):
                if left == right_end:
                    used[i] = True
                    result = backtrack(chain + [(left, right)], right)
                    used[i] = False
                    if result is not None:
                        return result
        return None

    for i in range(n):
        used[i] = True
        result = backtrack([dominoes[i]], dominoes[i][1])
        used[i] = False
        if result is not None:
            return result
    return None
