package bottlesong

import (
	"fmt"
	"strings"
)

// numberWords maps a bottle count to its word form (lowercase).
var numberWords = map[int]string{
	0:  "no",
	1:  "one",
	2:  "two",
	3:  "three",
	4:  "four",
	5:  "five",
	6:  "six",
	7:  "seven",
	8:  "eight",
	9:  "nine",
	10: "ten",
}

// Recite returns the lyrics for takeDown consecutive verses, starting from
// the verse that begins with startBottles bottles. Verses are separated by a
// blank line.
func Recite(startBottles, takeDown int) []string {
	var lyrics []string

	for i := 0; i < takeDown; i++ {
		count := startBottles - i
		next := count - 1

		if i > 0 {
			lyrics = append(lyrics, "")
		}

		lyrics = append(lyrics,
			fmt.Sprintf("%s green %s hanging on the wall,", capitalize(numberWords[count]), bottleWord(count)),
			fmt.Sprintf("%s green %s hanging on the wall,", capitalize(numberWords[count]), bottleWord(count)),
			"And if one green bottle should accidentally fall,",
			fmt.Sprintf("There'll be %s green %s hanging on the wall.", numberWords[next], bottleWord(next)),
		)
	}

	return lyrics
}

// bottleWord returns "bottle" for a single bottle and "bottles" otherwise.
func bottleWord(count int) string {
	if count == 1 {
		return "bottle"
	}
	return "bottles"
}

// capitalize returns s with its first rune upper-cased.
func capitalize(s string) string {
	return strings.ToUpper(s[:1]) + s[1:]
}
