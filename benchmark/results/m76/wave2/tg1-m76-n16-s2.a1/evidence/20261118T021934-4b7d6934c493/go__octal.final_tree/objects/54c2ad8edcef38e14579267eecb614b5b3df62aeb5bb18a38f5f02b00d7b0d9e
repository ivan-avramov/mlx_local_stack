package octal

import "errors"

// ParseOctal converts an octal number, represented as a string, to its
// decimal equivalent using first principles. Invalid input (any character
// outside '0'-'7') results in an error.
func ParseOctal(input string) (int64, error) {
	var result int64
	for i := 0; i < len(input); i++ {
		digit := input[i] - '0'
		if digit < 0 || digit > 7 {
			return 0, errors.New("invalid octal digit")
		}
		result = result*8 + int64(digit)
	}
	return result, nil
}
