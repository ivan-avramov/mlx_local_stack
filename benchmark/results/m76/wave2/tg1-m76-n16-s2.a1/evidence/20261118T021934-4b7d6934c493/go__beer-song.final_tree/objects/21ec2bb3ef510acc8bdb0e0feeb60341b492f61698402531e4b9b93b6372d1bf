package beer

import (
	"errors"
	"fmt"
)

// Song returns the entire song, from 99 bottles down to no more.
func Song() string {
	song, _ := Verses(99, 0)
	return song
}

// Verses returns the verses from start down to stop, inclusive.
func Verses(start, stop int) (string, error) {
	if start < 0 || start > 99 || stop < 0 || start < stop {
		return "", errors.New("invalid verse range")
	}

	var song string
	for n := start; n >= stop; n-- {
		verse, err := Verse(n)
		if err != nil {
			return "", err
		}
		song += verse + "\n"
	}
	return song, nil
}

// bottles renders the bottle count with the correct singular/plural form.
func bottles(n int) string {
	if n == 1 {
		return "1 bottle of beer"
	}
	if n == 0 {
		return "no more bottles of beer"
	}
	return fmt.Sprintf("%d bottles of beer", n)
}

// Verse returns a single verse of the song for the given bottle count.
func Verse(n int) (string, error) {
	if n < 0 || n > 99 {
		return "", errors.New("invalid verse")
	}

	if n == 0 {
		return "No more bottles of beer on the wall, " + bottles(n) + ".\n" +
			"Go to the store and buy some more, 99 bottles of beer on the wall.\n", nil
	}

	action := "Take one down"
	if n == 1 {
		action = "Take it down"
	}

	return fmt.Sprintf("%s on the wall, %s.\n%s and pass it around, %s on the wall.\n",
		bottles(n), bottles(n), action, bottles(n-1)), nil
}
