package palindrome

import (
	"errors"
	"fmt"
)

// Product represents a palindromic product and the factor pairs
// within the given range that produce it.
type Product struct {
	Product       int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of two
// numbers within the inclusive range [fmin, fmax], along with all
// factor pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, errors.New("fmin > fmax")
	}

	var min, max Product
	found := false

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if !isPalindrome(p) {
				continue
			}
			if !found {
				min = Product{p, [][2]int{{i, j}}}
				max = Product{p, [][2]int{{i, j}}}
				found = true
			} else {
				if p < min.Product {
					min = Product{p, [][2]int{{i, j}}}
				} else if p == min.Product {
					min.Factorizations = append(min.Factorizations, [2]int{i, j})
				}
				if p > max.Product {
					max = Product{p, [][2]int{{i, j}}}
				} else if p == max.Product {
					max.Factorizations = append(max.Factorizations, [2]int{i, j})
				}
			}
		}
	}

	if !found {
		return Product{}, Product{}, errors.New("no palindromes")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	s := fmt.Sprintf("%d", n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
