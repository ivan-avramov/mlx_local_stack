package hexadecimal

import "errors"

// maxInt64 is the largest value representable in an int64.
const maxInt64 = 9223372036854775807

var (
	errSyntax = errors.New("syntax error: invalid hexadecimal input")
	errRange  = errors.New("range error: value out of range for int64")
)

// ParseHex converts a hexadecimal number represented as a string
// (e.g. "10af8c") to its decimal equivalent, using first principles.
//
// It returns a syntax error for inputs that are empty or contain
// characters outside 0-9, a-f, A-F, and a range error when the value
// does not fit in an int64.
func ParseHex(in string) (int64, error) {
	if in == "" {
		return 0, errSyntax
	}

	var result int64
	for _, c := range in {
		var digit int64
		switch {
		case c >= '0' && c <= '9':
			digit = int64(c - '0')
		case c >= 'a' && c <= 'f':
			digit = int64(c-'a') + 10
		case c >= 'A' && c <= 'F':
			digit = int64(c-'A') + 10
		default:
			return 0, errSyntax
		}

		// Overflow check: result*16+digit must not exceed maxInt64.
		if result > (maxInt64-digit)/16 {
			return 0, errRange
		}
		result = result*16 + digit
	}
	return result, nil
}

// HandleErrors takes a list of inputs for ParseHex and returns a matching
// list containing "none", "syntax", or "range" according to the error
// returned by ParseHex for each input.
func HandleErrors(inputs []string) []string {
	results := make([]string, len(inputs))
	for i, in := range inputs {
		_, err := ParseHex(in)
		switch {
		case err == nil:
			results[i] = "none"
		case errors.Is(err, errSyntax):
			results[i] = "syntax"
		default:
			results[i] = "range"
		}
	}
	return results
}
