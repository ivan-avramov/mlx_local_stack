VOWELS = "aeiou"


def _translate_word(word):
    # Rule 1: starts with a vowel, "xr", or "yt"
    if word[0] in VOWELS or word[:2] in ("xr", "yt"):
        return word + "ay"

    # Rules 2-4: find where the consonant cluster ends.
    # "y" counts as a vowel when it is not the first letter.
    i = 1
    while i < len(word) and word[i] not in VOWELS and word[i] != "y":
        i += 1

    # Rule 3: a "qu" right after the consonant cluster moves with it.
    if i > 0 and word[i - 1] == "q" and i < len(word) and word[i] == "u":
        i += 1

    return word[i:] + word[:i] + "ay"


def translate(text):
    return " ".join(_translate_word(word) for word in text.split(" "))
