class School:
    def __init__(self):
        self._students = {}
        self._added = []

    def add_student(self, name, grade):
        added = name not in self._students
        if added:
            self._students[name] = grade
        self._added.append(added)
        return added

    def roster(self):
        return sorted(
            self._students,
            key=lambda name: (self._students[name], name),
        )

    def grade(self, grade_number):
        return sorted(
            name
            for name, grade in self._students.items()
            if grade == grade_number
        )

    def added(self):
        return list(self._added)
