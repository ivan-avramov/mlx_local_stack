def _bottles(count):
    if count == 0:
        return "No more bottles of beer"
    if count == 1:
        return "1 bottle of beer"
    return f"{count} bottles of beer"


def _verse(n):
    if n > 0:
        action = "Take it down" if n == 1 else "Take one down"
        return [
            f"{_bottles(n)} on the wall, {_bottles(n).lower()}.",
            f"{action} and pass it around, {_bottles(n - 1).lower()} on the wall.",
        ]
    return [
        f"{_bottles(0)} on the wall, {_bottles(0).lower()}.",
        "Go to the store and buy some more, 99 bottles of beer on the wall.",
    ]


def recite(start, take=1):
    lines = []
    for i in range(take):
        if i > 0:
            lines.append("")
        lines.extend(_verse(start - i))
    return lines
