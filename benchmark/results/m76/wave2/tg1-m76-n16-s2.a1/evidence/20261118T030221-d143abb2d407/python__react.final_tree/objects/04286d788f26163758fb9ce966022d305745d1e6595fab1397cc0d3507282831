class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._dependents = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        self._value = new_value
        self._propagate()

    def _propagate(self):
        # Collect all compute cells that transitively depend on this input,
        # in topological order (dependencies before dependents).
        affected = []
        seen = set()
        stack = [self]
        while stack:
            cell = stack.pop()
            for dependent in cell._dependents:
                if id(dependent) not in seen:
                    seen.add(id(dependent))
                    affected.append(dependent)
                    stack.append(dependent)

        for cell in affected:
            old_value = cell._value
            cell._recompute()
            if cell._value != old_value:
                for callback in cell._callbacks:
                    callback(cell._value)


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = inputs
        self._compute_function = compute_function
        self._callbacks = []
        self._dependents = []
        self._value = None
        for input_cell in inputs:
            input_cell._dependents.append(self)
        self._recompute()

    @property
    def value(self):
        return self._value

    def _recompute(self):
        self._value = self._compute_function([input_cell.value for input_cell in self._inputs])

    def add_callback(self, callback):
        self._callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self._callbacks:
            self._callbacks.remove(callback)
