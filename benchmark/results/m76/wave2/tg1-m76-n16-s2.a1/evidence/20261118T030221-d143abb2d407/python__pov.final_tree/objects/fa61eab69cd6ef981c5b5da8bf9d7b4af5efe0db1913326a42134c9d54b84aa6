from json import dumps


class Tree:
    def __init__(self, label, children=None):
        self.label = label
        self.children = children if children is not None else []

    def __dict__(self):
        return {self.label: [c.__dict__() for c in sorted(self.children)]}

    def __str__(self, indent=None):
        return dumps(self.__dict__(), indent=indent)

    def __lt__(self, other):
        return self.label < other.label

    def __eq__(self, other):
        return self.__dict__() == other.__dict__()

    def from_pov(self, from_node):
        result = self._reorient(from_node, None)
        if result.label != from_node:
            raise ValueError("Tree could not be reoriented")
        return result

    def _reorient(self, from_node, parent):
        if self.label == from_node:
            children = self.children + ([parent] if parent is not None else [])
            return Tree(self.label, children)
        children = []
        for i, child in enumerate(self.children):
            parent_children = [parent] if parent is not None else []
            pruned = Tree(
                self.label, self.children[:i] + self.children[i + 1:] + parent_children
            )
            reoriented = child._reorient(from_node, pruned)
            if reoriented.label == from_node:
                return reoriented
            children.append(reoriented)
        return Tree(self.label, children)

    def path_to(self, from_node, to_node):
        pov = self.from_pov(from_node)
        path = self._find_path(pov, to_node)
        if path is None:
            raise ValueError("No path found")
        return path

    def _find_path(self, node, to_node, path=None):
        if path is None:
            path = []
        path.append(node.label)
        if node.label == to_node:
            return path
        for child in node.children:
            result = self._find_path(child, to_node, path)
            if result is not None:
                return result
        path.pop()
        return None
