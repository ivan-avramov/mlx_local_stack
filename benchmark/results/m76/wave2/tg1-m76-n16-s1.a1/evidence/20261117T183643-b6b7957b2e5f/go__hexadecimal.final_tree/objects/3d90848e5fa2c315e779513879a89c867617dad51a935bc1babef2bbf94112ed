package hexadecimal

import (
	"errors"
	"fmt"
	"strings"
)

// ParseHex converts a hexadecimal string to its decimal equivalent,
// computed digit by digit without any conversion library.
func ParseHex(in string) (int64, error) {
	if in == "" {
		return 0, errors.New("syntax error: empty input")
	}

	var out int64
	for _, c := range in {
		var digit int64
		switch {
		case c >= '0' && c <= '9':
			digit = int64(c - '0')
		case c >= 'a' && c <= 'f':
			digit = int64(c-'a') + 10
		case c >= 'A' && c <= 'F':
			digit = int64(c-'A') + 10
		default:
			return 0, fmt.Errorf("syntax error: invalid hex digit %q", c)
		}

		// Check for overflow before shifting.
		if out > (1<<63-1-digit)/16 {
			return 0, fmt.Errorf("range error: value out of range")
		}
		out = out<<4 + digit
	}
	return out, nil
}

// HandleErrors runs ParseHex on each input and reports "none", "syntax",
// or "range" for each, depending on the error returned.
func HandleErrors(inputs []string) []string {
	results := make([]string, len(inputs))
	for i, in := range inputs {
		_, err := ParseHex(in)
		if err == nil {
			results[i] = "none"
		} else if strings.Contains(err.Error(), "syntax") {
			results[i] = "syntax"
		} else {
			results[i] = "range"
		}
	}
	return results
}
