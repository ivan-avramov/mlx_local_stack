package matrix

import (
	"errors"
	"strconv"
	"strings"
)

// Matrix represents a rectangular matrix of integers.
type Matrix [][]int

// New parses s as a matrix of integers. Rows are separated by newlines and
// elements within a row by whitespace. It returns an error if any row is
// empty, rows have unequal lengths, or any element is not an integer.
func New(s string) (Matrix, error) {
	var m Matrix
	for _, line := range strings.Split(s, "\n") {
		fields := strings.Fields(line)
		if len(fields) == 0 {
			return nil, errors.New("matrix: empty row")
		}
		row := make([]int, len(fields))
		for i, f := range fields {
			v, err := strconv.Atoi(f)
			if err != nil {
				return nil, err
			}
			row[i] = v
		}
		if len(m) > 0 && len(row) != len(m[0]) {
			return nil, errors.New("matrix: uneven rows")
		}
		m = append(m, row)
	}
	return m, nil
}

// Cols returns the columns of the matrix, each as a copy of the element
// data, without affecting the matrix.
func (m Matrix) Cols() [][]int {
	if len(m) == 0 {
		return nil
	}
	n := len(m[0])
	cols := make([][]int, n)
	for c := 0; c < n; c++ {
		col := make([]int, len(m))
		for r, row := range m {
			col[r] = row[c]
		}
		cols[c] = col
	}
	return cols
}

// Rows returns the rows of the matrix, each as a copy of the element
// data, without affecting the matrix.
func (m Matrix) Rows() [][]int {
	rows := make([][]int, len(m))
	for i, r := range m {
		rows[i] = make([]int, len(r))
		copy(rows[i], r)
	}
	return rows
}

// Set sets the element at (row, col) to val. It returns false if the
// coordinates are out of bounds.
func (m Matrix) Set(row, col, val int) bool {
	if row < 0 || row >= len(m) || col < 0 || col >= len(m[row]) {
		return false
	}
	m[row][col] = val
	return true
}
