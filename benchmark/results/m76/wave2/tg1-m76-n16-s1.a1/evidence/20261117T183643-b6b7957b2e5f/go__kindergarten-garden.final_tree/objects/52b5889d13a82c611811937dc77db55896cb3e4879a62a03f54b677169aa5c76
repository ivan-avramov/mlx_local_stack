package kindergarten

import (
	"errors"
	"sort"
	"strings"
)

// Garden holds the parsed diagram (two rows of cup codes) and the names of
// the children responsible for the cups, in alphabetical order.
type Garden struct {
	rows     [2]string
	children []string
}

var plantNames = map[rune]string{
	'G': "grass",
	'C': "clover",
	'R': "radishes",
	'V': "violets",
}

// NewGarden parses the diagram and the list of children. The diagram must
// start with a newline and contain exactly two rows of equal, even length,
// made up only of valid cup codes. The children must have unique names.
// The children argument is not modified.
func NewGarden(diagram string, children []string) (*Garden, error) {
	if !strings.HasPrefix(diagram, "\n") {
		return nil, errors.New("diagram must start with a newline")
	}
	rows := strings.Split(diagram, "\n")
	if len(rows) != 3 || rows[0] != "" {
		return nil, errors.New("diagram must have exactly two rows")
	}
	if len(rows[1]) != len(rows[2]) {
		return nil, errors.New("diagram rows must be the same length")
	}
	if len(rows[1])%2 != 0 {
		return nil, errors.New("diagram must contain an even number of cups")
	}
	for _, r := range rows[1] + rows[2] {
		if _, ok := plantNames[r]; !ok {
			return nil, errors.New("diagram contains an invalid cup code")
		}
	}
	sorted := make([]string, len(children))
	copy(sorted, children)
	sort.Strings(sorted)
	for i := 1; i < len(sorted); i++ {
		if sorted[i] == sorted[i-1] {
			return nil, errors.New("duplicate child name")
		}
	}
	return &Garden{
		rows:     [2]string{rows[1], rows[2]},
		children: sorted,
	}, nil
}

// Plants returns the four plants belonging to the given child, in the order
// first row left, first row right, second row left, second row right.
// ok is false if the child is not in the garden.
func (g *Garden) Plants(child string) ([]string, bool) {
	idx := sort.SearchStrings(g.children, child)
	if idx >= len(g.children) || g.children[idx] != child {
		return nil, false
	}
	i := idx * 2
	if i+1 >= len(g.rows[0]) {
		return nil, false
	}
	return []string{
		plantNames[rune(g.rows[0][i])],
		plantNames[rune(g.rows[0][i+1])],
		plantNames[rune(g.rows[1][i])],
		plantNames[rune(g.rows[1][i+1])],
	}, true
}
