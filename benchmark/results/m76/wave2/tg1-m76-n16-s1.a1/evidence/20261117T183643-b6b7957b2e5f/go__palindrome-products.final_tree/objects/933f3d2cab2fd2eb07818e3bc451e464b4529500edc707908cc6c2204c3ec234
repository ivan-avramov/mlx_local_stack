package palindrome

import (
	"errors"
	"fmt"
	"strconv"
)

// Product represents a palindromic product and the factor pairs that
// produce it.
type Product struct {
	Value          int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of two
// numbers within the inclusive range [fmin, fmax], along with all factor
// pairs within the range that produce each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, fmt.Errorf("fmin > fmax")
	}

	var min, max Product
	foundMin, foundMax := false, false

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			product := i * j
			if !isPalindrome(product) {
				continue
			}
			if !foundMin || product < min.Value {
				min = Product{Value: product, Factorizations: [][2]int{{i, j}}}
				foundMin = true
			} else if product == min.Value {
				min.Factorizations = append(min.Factorizations, [2]int{i, j})
			}
			if !foundMax || product > max.Value {
				max = Product{Value: product, Factorizations: [][2]int{{i, j}}}
				foundMax = true
			} else if product == max.Value {
				max.Factorizations = append(max.Factorizations, [2]int{i, j})
			}
		}
	}

	if !foundMin {
		return Product{}, Product{}, errors.New("no palindromes")
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	s := strconv.Itoa(n)
	for i, j := 0, len(s)-1; i < j; i, j = i+1, j-1 {
		if s[i] != s[j] {
			return false
		}
	}
	return true
}
