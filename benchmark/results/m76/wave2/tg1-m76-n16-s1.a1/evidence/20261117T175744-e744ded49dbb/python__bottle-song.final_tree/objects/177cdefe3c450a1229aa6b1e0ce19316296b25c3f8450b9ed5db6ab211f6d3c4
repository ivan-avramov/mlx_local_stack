_NUMBERS = {
    1: "One",
    2: "Two",
    3: "Three",
    4: "Four",
    5: "Five",
    6: "Six",
    7: "Seven",
    8: "Eight",
    9: "Nine",
    10: "Ten",
}


def _bottles(count, capitalize=True):
    if count == 0:
        return "no green bottles"
    word = "bottle" if count == 1 else "bottles"
    number = _NUMBERS[count]
    if not capitalize:
        number = number.lower()
    return f"{number} green {word}"


def recite(start, take=1):
    lines = []
    for i in range(take):
        count = start - i
        lines += [
            f"{_bottles(count)} hanging on the wall,",
            f"{_bottles(count)} hanging on the wall,",
            "And if one green bottle should accidentally fall,",
            f"There'll be {_bottles(count - 1, capitalize=False)} hanging on the wall.",
            "",
        ]
    return lines[:-1]
