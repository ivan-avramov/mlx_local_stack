VOWELS = "aeiou"


def _translate_word(word):
    # Rule 1: word begins with a vowel, or with "xr" or "yt"
    if word[0] in VOWELS or word[:2] in ("xr", "yt"):
        return word + "ay"

    # Find the end of the leading consonant cluster.
    # A "y" after at least one consonant acts as a vowel (Rule 4).
    i = 0
    while i < len(word) and word[i] not in VOWELS and not (word[i] == "y" and i > 0):
        i += 1

    # Rule 3: a "qu" at the end of the cluster moves along with it
    if i > 0 and word[i - 1] == "q" and word[i] == "u":
        i += 1
    elif word[i:i + 2] == "qu":
        i += 2

    return word[i:] + word[:i] + "ay"


def translate(text):
    return " ".join(_translate_word(word) for word in text.split())
