package bottlesong

import (
	"fmt"
	"unicode"
)

var numberWords = map[int]string{
	0:  "no",
	1:  "one",
	2:  "two",
	3:  "three",
	4:  "four",
	5:  "five",
	6:  "six",
	7:  "seven",
	8:  "eight",
	9:  "nine",
	10: "ten",
}

// bottlesPhrase returns the count phrase for a verse, e.g. "ten green bottles"
// or "one green bottle". The count word is lowercase; callers that start a
// line with it should capitalize it.
func bottlesPhrase(count int) string {
	plural := "s"
	if count == 1 {
		plural = ""
	}
	return fmt.Sprintf("%s green bottle%s", numberWords[count], plural)
}

// title uppercases the first rune of s.
func title(s string) string {
	r := []rune(s)
	r[0] = unicode.ToUpper(r[0])
	return string(r)
}

func Recite(startBottles, takeDown int) []string {
	var lines []string
	for i := 0; i < takeDown; i++ {
		n := startBottles - i
		if i > 0 {
			lines = append(lines, "")
		}
		lines = append(lines,
			fmt.Sprintf("%s hanging on the wall,", title(bottlesPhrase(n))),
			fmt.Sprintf("%s hanging on the wall,", title(bottlesPhrase(n))),
			"And if one green bottle should accidentally fall,",
			fmt.Sprintf("There'll be %s hanging on the wall.", bottlesPhrase(n-1)),
		)
	}
	return lines
}
