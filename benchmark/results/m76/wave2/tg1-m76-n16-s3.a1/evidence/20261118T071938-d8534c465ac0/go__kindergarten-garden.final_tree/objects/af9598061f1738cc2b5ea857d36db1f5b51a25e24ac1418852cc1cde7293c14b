package kindergarten

import (
	"errors"
	"sort"
	"strings"
)

// Garden holds the plants assigned to each child in the class.
type Garden struct {
	students map[string][]string
}

var plantNames = map[byte]string{
	'G': "grass",
	'C': "clover",
	'R': "radishes",
	'V': "violets",
}

// NewGarden builds a Garden from a two-row diagram and the class roster.
// The diagram argument starts each row with a '\n'.
//
//     diagram := `
//     VVCCGG
//     VVCCGG`
func NewGarden(diagram string, children []string) (*Garden, error) {
	if !strings.HasPrefix(diagram, "\n") {
		return nil, errors.New("diagram must start with a newline")
	}
	rows := strings.Split(diagram, "\n")
	if len(rows) != 3 {
		return nil, errors.New("diagram must have exactly two rows")
	}
	if len(rows[1]) != len(rows[2]) {
		return nil, errors.New("diagram rows must be the same length")
	}
	if len(rows[1])%2 != 0 {
		return nil, errors.New("diagram must contain an even number of cups")
	}
	for _, row := range rows[1:] {
		for i := 0; i < len(row); i++ {
			if _, ok := plantNames[row[i]]; !ok {
				return nil, errors.New("diagram contains an invalid cup code")
			}
		}
	}

	// Sort a copy of the roster; the caller's slice must not be modified.
	sorted := make([]string, len(children))
	copy(sorted, children)
	sort.Strings(sorted)

	seen := make(map[string]bool, len(sorted))
	for _, child := range sorted {
		if seen[child] {
			return nil, errors.New("duplicate child name")
		}
		seen[child] = true
	}

	if 2*len(sorted) > len(rows[1]) {
		return nil, errors.New("more children than cups in diagram")
	}

	g := &Garden{students: make(map[string][]string, len(sorted))}
	for i, child := range sorted {
		off := 2 * i
		g.students[child] = []string{
			plantNames[rows[1][off]],
			plantNames[rows[1][off+1]],
			plantNames[rows[2][off]],
			plantNames[rows[2][off+1]],
		}
	}
	return g, nil
}

// Plants returns the four plants for the given child, in the order
// first row left, first row right, second row left, second row right.
// ok is false if the child is not in the garden.
func (g *Garden) Plants(child string) ([]string, bool) {
	plants, ok := g.students[child]
	return plants, ok
}
