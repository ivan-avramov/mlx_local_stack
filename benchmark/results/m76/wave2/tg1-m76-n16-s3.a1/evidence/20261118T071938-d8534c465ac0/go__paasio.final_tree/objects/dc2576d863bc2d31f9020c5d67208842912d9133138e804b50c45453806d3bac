package paasio

import (
	"io"
	"sync"
)

// readCounter wraps an io.Reader and reports the total number of bytes
// successfully read along with the total number of calls to Read().
type readCounter struct {
	mu     sync.Mutex
	n      int64 // total bytes read
	nops   int   // total calls to Read()
	reader io.Reader
}

// writeCounter wraps an io.Writer and reports the total number of bytes
// successfully written along with the total number of calls to Write().
type writeCounter struct {
	mu     sync.Mutex
	n      int64 // total bytes written
	nops   int   // total calls to Write()
	writer io.Writer
}

// readWriteCounter wraps an io.ReadWriter and reports read and write
// statistics. A single mutex guards all four counters so that ReadCount and
// WriteCount always return results that are consistent with each other, even
// in the presence of concurrent Read and Write calls.
type readWriteCounter struct {
	mu     sync.Mutex
	rn     int64 // total bytes read
	rnops  int   // total calls to Read()
	wn     int64 // total bytes written
	wnops  int   // total calls to Write()
	rw     io.ReadWriter
}

func NewWriteCounter(writer io.Writer) WriteCounter {
	return &writeCounter{writer: writer}
}

func NewReadCounter(reader io.Reader) ReadCounter {
	return &readCounter{reader: reader}
}

func NewReadWriteCounter(readwriter io.ReadWriter) ReadWriteCounter {
	return &readWriteCounter{rw: readwriter}
}

func (rc *readCounter) Read(p []byte) (int, error) {
	n, err := rc.reader.Read(p)
	rc.mu.Lock()
	rc.n += int64(n)
	rc.nops++
	rc.mu.Unlock()
	return n, err
}

func (rc *readCounter) ReadCount() (int64, int) {
	rc.mu.Lock()
	defer rc.mu.Unlock()
	return rc.n, rc.nops
}

func (wc *writeCounter) Write(p []byte) (int, error) {
	n, err := wc.writer.Write(p)
	wc.mu.Lock()
	wc.n += int64(n)
	wc.nops++
	wc.mu.Unlock()
	return n, err
}

func (wc *writeCounter) WriteCount() (int64, int) {
	wc.mu.Lock()
	defer wc.mu.Unlock()
	return wc.n, wc.nops
}

func (rwc *readWriteCounter) Read(p []byte) (int, error) {
	n, err := rwc.rw.Read(p)
	rwc.mu.Lock()
	rwc.rn += int64(n)
	rwc.rnops++
	rwc.mu.Unlock()
	return n, err
}

func (rwc *readWriteCounter) Write(p []byte) (int, error) {
	n, err := rwc.rw.Write(p)
	rwc.mu.Lock()
	rwc.wn += int64(n)
	rwc.wnops++
	rwc.mu.Unlock()
	return n, err
}

func (rwc *readWriteCounter) ReadCount() (int64, int) {
	rwc.mu.Lock()
	defer rwc.mu.Unlock()
	return rwc.rn, rwc.rnops
}

func (rwc *readWriteCounter) WriteCount() (int64, int) {
	rwc.mu.Lock()
	defer rwc.mu.Unlock()
	return rwc.wn, rwc.wnops
}
