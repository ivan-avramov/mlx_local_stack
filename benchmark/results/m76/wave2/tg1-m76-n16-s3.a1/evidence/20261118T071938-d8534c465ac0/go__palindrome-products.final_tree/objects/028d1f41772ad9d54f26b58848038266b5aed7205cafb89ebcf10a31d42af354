package palindrome

import "fmt"

// Product represents a palindromic product and its factorizations
// within the given range.
type Product struct {
	Product       int
	Factorizations [][2]int
}

// Products finds the smallest and largest palindromic products of
// two numbers within the range [fmin, fmax] (both inclusive),
// along with all factor pairs for each.
func Products(fmin, fmax int) (Product, Product, error) {
	if fmin > fmax {
		return Product{}, Product{}, fmt.Errorf("fmin > fmax")
	}

	var min, max Product
	found := false

	for i := fmin; i <= fmax; i++ {
		for j := i; j <= fmax; j++ {
			p := i * j
			if !isPalindrome(p) {
				continue
			}
			if !found || p < min.Product {
				min = Product{p, [][2]int{{i, j}}}
			} else if p == min.Product {
				min.Factorizations = append(min.Factorizations, [2]int{i, j})
			}
			if !found || p > max.Product {
				max = Product{p, [][2]int{{i, j}}}
			} else if p == max.Product {
				max.Factorizations = append(max.Factorizations, [2]int{i, j})
			}
			found = true
		}
	}

	if !found {
		return Product{}, Product{}, fmt.Errorf("no palindromes found in range [%d, %d]", fmin, fmax)
	}
	return min, max, nil
}

// isPalindrome reports whether n reads the same forwards and backwards.
func isPalindrome(n int) bool {
	if n < 0 {
		return false
	}
	orig := n
	reversed := 0
	for n > 0 {
		reversed = reversed*10 + n%10
		n /= 10
	}
	return orig == reversed
}
