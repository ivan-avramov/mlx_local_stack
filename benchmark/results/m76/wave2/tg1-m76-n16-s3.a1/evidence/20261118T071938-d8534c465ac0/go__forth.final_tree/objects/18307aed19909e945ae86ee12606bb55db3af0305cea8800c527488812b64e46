package forth

import (
	"errors"
	"strconv"
	"strings"
)

// step is a single executable element of a word's definition.
type step func(stack []int) ([]int, error)

var (
	errEmptyStack = errors.New("empty stack")
	errOneValue   = errors.New("only one value on the stack")
	errDivZero    = errors.New("divide by zero")
	errUndef      = errors.New("undefined operation")
	errIllegal    = errors.New("illegal operation")
)

func popOne(stack []int) (int, error) {
	if len(stack) == 0 {
		return 0, errEmptyStack
	}
	return stack[len(stack)-1], nil
}

func popTwo(stack []int) (int, int, error) {
	if len(stack) == 0 {
		return 0, 0, errEmptyStack
	}
	if len(stack) == 1 {
		return 0, 0, errOneValue
	}
	return stack[len(stack)-2], stack[len(stack)-1], nil
}

func pushNum(n int) step {
	return func(stack []int) ([]int, error) {
		return append(stack, n), nil
	}
}

// binaryOp applies op to the top two values, leaving the result on the stack.
func binaryOp(op func(a, b int) (int, error)) step {
	return func(stack []int) ([]int, error) {
		a, b, err := popTwo(stack)
		if err != nil {
			return nil, err
		}
		r, err := op(a, b)
		if err != nil {
			return nil, err
		}
		stack[len(stack)-2] = r
		return stack[:len(stack)-1], nil
	}
}

func Forth(input []string) ([]int, error) {
	dict := map[string]step{
		"+":    binaryOp(func(a, b int) (int, error) { return a + b, nil }),
		"-":    binaryOp(func(a, b int) (int, error) { return a - b, nil }),
		"*":    binaryOp(func(a, b int) (int, error) { return a * b, nil }),
		"/":    binaryOp(func(a, b int) (int, error) {
			if b == 0 {
				return 0, errDivZero
			}
			return a / b, nil
		}),
		"dup": func(stack []int) ([]int, error) {
			v, err := popOne(stack)
			if err != nil {
				return nil, err
			}
			return append(stack, v), nil
		},
		"drop": func(stack []int) ([]int, error) {
			if _, err := popOne(stack); err != nil {
				return nil, err
			}
			return stack[:len(stack)-1], nil
		},
		"swap": func(stack []int) ([]int, error) {
			a, b, err := popTwo(stack)
			if err != nil {
				return nil, err
			}
			stack[len(stack)-2] = b
			stack[len(stack)-1] = a
			return stack, nil
		},
		"over": func(stack []int) ([]int, error) {
			a, _, err := popTwo(stack)
			if err != nil {
				return nil, err
			}
			return append(stack, a), nil
		},
	}

	stack := []int{}
	for _, line := range input {
		tokens := strings.Fields(line)
		if len(tokens) == 0 {
			continue
		}

		if tokens[0] == ":" {
			// A definition: : name body ;
			if len(tokens) < 3 || tokens[len(tokens)-1] != ";" {
				return nil, errIllegal
			}
			name := strings.ToLower(tokens[1])
			if _, err := strconv.Atoi(tokens[1]); err == nil {
				return nil, errIllegal // cannot redefine numbers
			}
			body := make([]step, 0, len(tokens)-2)
			for _, tok := range tokens[2 : len(tokens)-1] {
				if n, err := strconv.Atoi(tok); err == nil {
					body = append(body, pushNum(n))
				} else {
					w, ok := dict[strings.ToLower(tok)]
					if !ok {
						return nil, errUndef
					}
					body = append(body, w)
				}
			}
			dict[name] = func(s []int) ([]int, error) {
				for _, b := range body {
					var err error
					s, err = b(s)
					if err != nil {
						return nil, err
					}
				}
				return s, nil
			}
			continue
		}

		for _, tok := range tokens {
			if n, err := strconv.Atoi(tok); err == nil {
				stack = append(stack, n)
			} else {
				w, ok := dict[strings.ToLower(tok)]
				if !ok {
					return nil, errUndef
				}
				var err error
				stack, err = w(stack)
				if err != nil {
					return nil, err
				}
			}
		}
	}
	return stack, nil
}
