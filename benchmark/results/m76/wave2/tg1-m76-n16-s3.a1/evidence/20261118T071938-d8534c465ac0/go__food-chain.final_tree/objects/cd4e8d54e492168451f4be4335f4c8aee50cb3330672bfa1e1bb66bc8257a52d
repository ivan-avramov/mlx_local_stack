package foodchain

import "strings"

var animals = []struct {
	name    string
	comment string
}{
	{"fly", ""},
	{"spider", "It wriggled and jiggled and tickled inside her."},
	{"bird", "How absurd to swallow a bird!"},
	{"cat", "Imagine that, to swallow a cat!"},
	{"dog", "What a hog, to swallow a dog!"},
	{"goat", "Just opened her throat and swallowed a goat!"},
	{"cow", "I don't know how she swallowed a cow!"},
	{"horse", "She's dead, of course!"},
}

func Verse(v int) string {
	a := animals[v-1]
	lines := []string{"I know an old lady who swallowed a " + a.name + "."}
	if a.comment != "" {
		lines = append(lines, a.comment)
	}
	if v < 8 {
		for i := v - 1; i >= 1; i-- {
			target := animals[i-1]
			if target.name == "spider" {
				lines = append(lines, "She swallowed the "+animals[i].name+" to catch the spider that wriggled and jiggled and tickled inside her.")
			} else {
				lines = append(lines, "She swallowed the "+animals[i].name+" to catch the "+target.name+".")
			}
		}
		lines = append(lines, "I don't know why she swallowed the fly. Perhaps she'll die.")
	}
	return strings.Join(lines, "\n")
}

func Verses(start, end int) string {
	verses := make([]string, 0, end-start+1)
	for v := start; v <= end; v++ {
		verses = append(verses, Verse(v))
	}
	return strings.Join(verses, "\n\n")
}

func Song() string {
	return Verses(1, 8)
}
