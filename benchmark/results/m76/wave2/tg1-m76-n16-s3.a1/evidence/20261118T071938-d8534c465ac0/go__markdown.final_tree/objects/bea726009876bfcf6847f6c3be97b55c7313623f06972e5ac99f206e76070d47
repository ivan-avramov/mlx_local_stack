package markdown

import (
	"fmt"
	"strings"
)

// Render translates markdown to HTML.
//
// The original implementation scanned the input one character at a time in a
// single loop, tracking headers, lists and emphasis with several interacting
// flags. The rewrite splits the work into three clearly separated steps:
//
//  1. applyEmphasis replaces emphasis markers with HTML tags.
//  2. The text is split into lines.
//  3. Each line is rendered as a heading, a list item, or a paragraph.
//
// All test cases from the original implementation still pass.
func Render(markdown string) string {
	markdown = applyEmphasis(markdown)

	var html strings.Builder
	inList := false

	for _, line := range strings.Split(markdown, "\n") {
		switch {
		case strings.HasPrefix(line, "#"):
			if inList {
				html.WriteString("</ul>")
				inList = false
			}
			html.WriteString(renderHeading(line))
		case strings.HasPrefix(line, "*"):
			if !inList {
				html.WriteString("<ul>")
				inList = true
			}
			html.WriteString("<li>" + listItemText(line) + "</li>")
		default:
			if inList {
				html.WriteString("</ul>")
				inList = false
			}
			html.WriteString("<p>" + line + "</p>")
		}
	}

	if inList {
		html.WriteString("</ul>")
	}

	return html.String()
}

// applyEmphasis converts the first __...__ pair to <strong> tags and the
// first _..._ pair to <em> tags. Like the original implementation, only a
// single pair of each marker is converted.
func applyEmphasis(markdown string) string {
	markdown = replaceFirstPair(markdown, "__", "<strong>", "</strong>")
	markdown = replaceFirstPair(markdown, "_", "<em>", "</em>")
	return markdown
}

// replaceFirstPair replaces the first occurrence of marker with open and the
// next occurrence with close, matching the behavior of the original
// strings.Replace-based implementation.
func replaceFirstPair(s, marker, open, close string) string {
	i := strings.Index(s, marker)
	if i < 0 {
		return s
	}
	s = s[:i] + open + s[i+len(marker):]
	if j := strings.Index(s, marker); j >= 0 {
		s = s[:j] + close + s[j+len(marker):]
	}
	return s
}

// renderHeading renders a line whose first character is '#' as a heading.
// Markdown only supports six heading levels, so a line with seven or more
// leading '#' characters is rendered as a paragraph instead.
func renderHeading(line string) string {
	level := 0
	for level < len(line) && line[level] == '#' {
		level++
	}
	if level > 6 {
		return "<p>" + line + "</p>"
	}
	text := strings.TrimPrefix(line, strings.Repeat("#", level))
	text = strings.TrimPrefix(text, " ")
	return fmt.Sprintf("<h%d>%s</h%d>", level, text, level)
}

// listItemText returns the text of a list item, dropping the leading "* " marker.
func listItemText(line string) string {
	return strings.TrimPrefix(line, "* ")
}
