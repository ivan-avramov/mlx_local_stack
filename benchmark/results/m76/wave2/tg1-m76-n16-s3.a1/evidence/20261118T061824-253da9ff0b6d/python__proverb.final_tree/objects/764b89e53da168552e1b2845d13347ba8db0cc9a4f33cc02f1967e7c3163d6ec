def proverb(*pieces, qualifier=None):
    if not pieces:
        return []

    lines = [
        f"For want of a {piece} the {next_piece} was lost."
        for piece, next_piece in zip(pieces, pieces[1:])
    ]

    last_piece = pieces[0]
    if qualifier is not None:
        last_piece = f"{qualifier} {last_piece}"

    lines.append(f"And all for the want of a {last_piece}.")
    return lines
