NUMBERS = {
    0: "no",
    1: "One",
    2: "Two",
    3: "Three",
    4: "Four",
    5: "Five",
    6: "Six",
    7: "Seven",
    8: "Eight",
    9: "Nine",
    10: "Ten",
}


def _line(count, capitalize=True):
    number = NUMBERS[count]
    if not capitalize:
        number = number.lower()
    bottle = "bottle" if count == 1 else "bottles"
    return f"{number} green {bottle} hanging on the wall"


def recite(start, take=1):
    lines = []
    for count in range(start, start - take, -1):
        if lines:
            lines.append("")
        lines.append(_line(count) + ",")
        lines.append(_line(count) + ",")
        lines.append("And if one green bottle should accidentally fall,")
        lines.append("There'll be " + _line(count - 1, capitalize=False) + ".")
    return lines
