{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "-opencode.provider.vllm",
    "-opencode.provider.ollama",
    "-opencode.provider.lmstudio",
    "-opencode.config.compatibility"
  ],
  "compaction": {
    "auto": false
  },
  "agents": {
    "title": {
      "disabled": true
    }
  },
  "update": "disable",
  "share": "disabled",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*xercism*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*problem-specifications*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*xercism*",
      "effect": "deny"
    },
