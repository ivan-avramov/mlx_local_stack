    {
      "action": "webfetch",
      "resource": "*github.com/search*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*grep.app*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*sourcegraph.com*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*searchcode.com*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*XERCISM*",
      "effect": "deny"
